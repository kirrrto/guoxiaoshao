page { --green-mist: #F0FBF6; --green: #00C375; --green-dark: var(--green); background: #F0FBF6; color: #183C2D; font: 28rpx/1.6 -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif; }
view, text { box-sizing: border-box; }
button, input, textarea, scroll-view { box-sizing: border-box; }
.page { width: 100%; max-width: 1000rpx; padding: 24rpx 24rpx calc(40rpx + env(safe-area-inset-bottom)); margin: auto; overflow-wrap: anywhere; }
.card { min-width: 0; padding: 28rpx; border-radius: 24rpx; background: white; margin-bottom: 24rpx; }
.page-heading { margin: 12rpx 8rpx 28rpx; }
.page-title { font-size: 42rpx; font-weight: 700; }
.page-subtitle { margin-top: 8rpx; color: #47685A; font-size: 25rpx; }
.card-title, .row-between { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 12rpx; min-width: 0; }
.card-title { margin-bottom: 20rpx; font-size: 30rpx; font-weight: 600; }
.card-title .sub { font-size: 23rpx; font-weight: 400; color: #47685A; }
.btn { display: flex; align-items: center; justify-content: center; min-width: 0; max-width: 100%; min-height: 44px; padding: 18rpx 22rpx; margin: 0; border: 0; border-radius: 18rpx; font-size: 26rpx; line-height: 1.5; white-space: normal; overflow-wrap: anywhere; }
.btn::after { border: 0; }
.btn-block { width: 100%; }
.btn-primary { color: #073C2C; background: var(--green); }
.btn-outline { color: var(--green); background: white; border: 1rpx solid var(--green); }
.btn-ghost { color: var(--green); background: rgba(0, 195, 117, 0.10); }
.btn[disabled] { color: #65776C; background: #EAF1ED; }
.btn-row { display: flex; flex-wrap: wrap; gap: 14rpx; margin-top: 20rpx; }
.btn-row .btn { flex: 1 1 150rpx; }
.stat-row { display: flex; flex-wrap: wrap; gap: 12rpx; margin-bottom: 22rpx; }
.stat { flex: 1 1 110rpx; padding: 18rpx 12rpx; border-radius: 14rpx; background: #F0FBF6; text-align: center; }
.stat .num { font-size: 36rpx; font-weight: 700; color: var(--green); }
.stat .lbl { font-size: 22rpx; color: #47685A; }
.small { font-size: 24rpx; }
.tiny { font-size: 22rpx; }
.muted { color: #47685A; }
.mono { font-family: Menlo, Consolas, monospace; }
.mt { margin-top: 16rpx; }
.banner { padding: 20rpx; margin-bottom: 20rpx; border-radius: 16rpx; }
.banner-bad { color: #A13C3C; background: #FCECED; }
.loading-line { color: #47685A; text-align: center; padding: 32rpx; }
