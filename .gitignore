evidence/**/*.jpg
evidence/**/*.jpeg
evidence/**/*.webp
evidence/**/*.mp4
evidence/**/*.zip

# Raw upstream captures (large HTML/JSON bodies); hashes live in evidence/**/manifest files
evidence/raw/
