/* 提醒授权：「我的」、小哨页与授权面板共用。 */
.reminder-balances { display: flex; gap: var(--sp-16); margin-bottom: var(--sp-16); }
.reminder-balance { display: flex; flex: 1 1 0; flex-direction: column; gap: var(--sp-2); min-width: 0; }
.reminder-balance + .reminder-balance { padding-left: var(--sp-16); border-left: 1px solid var(--line); }
.reminder-balance-label, .reminder-balance-pending { color: var(--text-2); font-size: var(--fs-sub); overflow-wrap: anywhere; }
.reminder-balance-value { font-size: var(--fs-title); font-weight: 600; line-height: var(--lh-tight); }

.authorization-feedback { margin-top: var(--sp-12); color: var(--green-text); font-size: var(--fs-sub); }
.authorization-hint { margin-top: var(--sp-12); color: var(--text-2); font-size: var(--fs-sub); }
.authorization-sync-error {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: var(--sp-8);
  margin-top: var(--sp-12);
  padding: var(--sp-12);
  border-radius: var(--radius-control);
  background: var(--warn-soft);
  color: var(--warn);
  font-size: var(--fs-sub);
}
.authorization-sync-error > text { flex: 1 1 120px; min-width: 0; overflow-wrap: anywhere; }

.consent-recovery { margin-top: var(--sp-12); padding: var(--sp-16); border-radius: var(--radius-control); background: var(--warn-soft); }
.consent-recovery-title { color: var(--warn); font-weight: 600; }
.consent-recovery-desc, .consent-recovery-steps { margin-top: var(--sp-4); color: var(--text-2); font-size: var(--fs-sub); }
.consent-recovery-row { display: flex; justify-content: space-between; gap: var(--sp-12); margin-top: var(--sp-8); font-size: var(--fs-sub); }
.consent-recovery-name { flex: 1 1 auto; min-width: 0; overflow-wrap: anywhere; }
.consent-recovery-state { flex: none; color: var(--warn); font-weight: 600; }
.consent-recovery-action.btn { margin-top: var(--sp-12); }
