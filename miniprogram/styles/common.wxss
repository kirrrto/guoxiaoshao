/* 果小哨设计体系 · 公共组件层（页面与 apply-shared 组件共用）。令牌定义在 app.wxss。
   原生 button 自带 184px 宽度、自动外边距与 disabled 配色；凡是挂在 button 上的类
   都用双类选择器覆盖，disabled 再加一层属性选择器。 */
view, text, button, input, textarea, image, scroll-view, picker { box-sizing: border-box; }

/* ── 页面骨架 ─────────────────────────────────────────── */
.page {
  width: 100%;
  max-width: 600px;
  margin: 0 auto;
  padding: var(--sp-4) var(--sp-16) calc(var(--sp-32) + env(safe-area-inset-bottom));
  overflow-wrap: anywhere;
}
/* 原生底栏自己占位，tab 页只留呼吸空间。 */
.page.tab-page { padding-bottom: var(--sp-24); }

@media (min-width: 900px) {
  .page.desktop-split-page {
    max-width: 1200px;
    padding-left: var(--sp-24);
    padding-right: var(--sp-24);
  }
}

.page-heading {
  display: flex;
  align-items: center;
  gap: var(--sp-12);
  min-height: 48px;
  margin: 0 0 var(--sp-12);
}
.page-title {
  flex: 1 1 auto;
  min-width: 0;
  font-size: var(--fs-title);
  font-weight: 600;
  line-height: var(--lh-tight);
  word-break: keep-all;
}
/* 品牌标：图片自带方形底，用同比例圆角裁出图标形。 */
.page-mark { display: block; flex: none; width: 28px; height: 28px; border-radius: 22.5%; }
.page-mark-glyph { border-radius: 0; }

/* 托盘：一组内容的唯一容器。不描边、不投影、不嵌套。 */
.card {
  --control: var(--surface-top);
  min-width: 0;
  margin: 0 0 var(--sp-12);
  padding: var(--sp-16);
  border-radius: var(--radius-tray);
  background: var(--surface);
}
/* 只装列表行的托盘收紧上下留白；以列表行收尾的托盘只收紧底部。 */
.card.card-list { padding-top: var(--sp-4); padding-bottom: var(--sp-4); }
.card.card-rows-end { padding-bottom: var(--sp-4); }
.card-title {
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: var(--sp-4) var(--sp-12);
  margin-bottom: var(--sp-12);
  font-size: var(--fs-headline);
  font-weight: 600;
  line-height: var(--lh-snug);
}
.card-title .sub { color: var(--text-2); font-size: var(--fs-sub); font-weight: 400; }

/* 托盘之外的分区标题：上方留白大于下方。 */
.section-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--sp-12);
  min-height: var(--tap);
  margin: var(--sp-20) 0 var(--sp-4);
}
.section-title { min-width: 0; font-size: var(--fs-headline); font-weight: 600; line-height: var(--lh-snug); }
.section-label { margin: var(--sp-16) 0 var(--sp-8); color: var(--text-3); font-size: var(--fs-sub); line-height: var(--lh-snug); }

/* ── 文字与排列工具 ───────────────────────────────────── */
.small { font-size: var(--fs-sub); }
.tiny { font-size: var(--fs-caption); }
.bold { font-weight: 600; }
.text-2 { color: var(--text-2); }
.muted { color: var(--text-3); }
.text-bad { color: var(--bad); }
/* 货号等编码沿用系统字体的等宽数字，不换等宽字体。 */
.mono { word-break: break-all; }
.row { display: flex; align-items: center; gap: var(--sp-8); min-width: 0; }
.row-between { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: var(--sp-8); min-width: 0; }
.row > view, .row > text, .row-between > view, .row-between > text { min-width: 0; max-width: 100%; }
.row-between > view:first-child { flex: 1 1 110px; }
.wrap { flex-wrap: wrap; }
.gap { gap: var(--sp-8); }
.mt { margin-top: var(--sp-8); }
.mb { margin-bottom: var(--sp-8); }

/* ── 按钮：主（绿）、次（中性填充）、文字 三级 ─────────── */
.btn.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: var(--sp-8);
  width: auto;
  min-width: 0;
  max-width: 100%;
  height: auto;
  min-height: var(--btn-height);
  margin: 0;
  padding: var(--sp-12) var(--sp-20);
  border: 0;
  border-radius: var(--radius-control);
  background: var(--control);
  color: var(--text);
  font-size: var(--fs-body);
  font-weight: 600;
  line-height: var(--lh-snug);
  text-align: center;
  white-space: normal;
  overflow-wrap: anywhere;
  transition: opacity var(--dur-fast) var(--ease), background-color var(--dur-fast) var(--ease), transform var(--dur-fast) var(--ease);
}
.btn.btn-primary { background: var(--green); color: var(--green-ink); font-size: var(--fs-headline); }
.btn.btn-text { background: transparent; color: var(--text-2); font-weight: 400; }
.btn.btn-danger { background: var(--bad-soft); color: var(--bad); }
.btn.btn-block { width: 100%; }
.btn.btn-sm { min-height: var(--tap); padding: var(--sp-8) var(--sp-16); font-size: var(--fs-sub); }
.btn.btn.mt { margin-top: var(--sp-12); }
.btn.btn.mb { margin-bottom: var(--sp-12); }
.btn.btn[disabled], .btn.btn.disabled { background: var(--control); color: var(--text); opacity: 0.4; }
.btn.btn-primary[disabled], .btn.btn-primary.disabled { background: var(--green); color: var(--green-ink); }
.btn.btn-text[disabled] { background: transparent; color: var(--text-2); }
.btn.btn-danger[disabled] { background: var(--bad-soft); color: var(--bad); }
.btn.btn-primary-pressed { opacity: 0.86; transform: scale(0.985); }
.btn.ui-control-pressed { background: var(--pressed); }
.btn-row { display: flex; flex-wrap: wrap; align-items: stretch; gap: var(--sp-8); margin-top: var(--sp-12); }
.btn-row .btn.btn { flex: 1 1 120px; }

/* 行内小动作：与文字同行的「修改」「复制」「刷新」。 */
.ui-action.ui-action {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: var(--sp-8);
  width: auto;
  min-width: var(--tap);
  max-width: 100%;
  height: auto;
  min-height: var(--tap);
  margin: 0;
  padding: var(--sp-8) var(--sp-12);
  border: 0;
  border-radius: var(--radius-control);
  background: var(--control);
  color: var(--text);
  font-size: var(--fs-sub);
  font-weight: 400;
  line-height: var(--lh-snug);
  text-align: center;
  white-space: normal;
  overflow-wrap: anywhere;
  transition: background-color var(--dur-fast) var(--ease);
}
.ui-action.ui-action--plain { padding-left: var(--sp-4); padding-right: var(--sp-4); background: transparent; color: var(--text-2); }
.ui-action.ui-action--block { display: flex; width: 100%; }
.ui-action.ui-action--danger { color: var(--bad); }
.ui-action.ui-action[disabled] { background: var(--control); color: var(--text); opacity: 0.4; }
.ui-action.ui-action--plain[disabled] { background: transparent; color: var(--text-2); }
.ui-action.ui-control-pressed { background: var(--pressed); }
.ui-action-label { min-width: 0; overflow-wrap: anywhere; }

/* 列表行：标签在左，可选的数值与方向标在右。行与行之间只用细线。 */
.ui-disclosure.ui-disclosure {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--sp-12);
  width: 100%;
  max-width: 100%;
  height: auto;
  min-height: 52px;
  margin: 0;
  padding: var(--sp-12) 0;
  border: 0;
  border-top: 1px solid var(--line);
  border-radius: 0;
  background: transparent;
  color: var(--text);
  font-size: var(--fs-body);
  font-weight: 400;
  line-height: var(--lh-snug);
  text-align: left;
  white-space: normal;
  transition: background-color var(--dur-fast) var(--ease);
}
.ui-disclosure.ui-disclosure:first-child { border-top: 0; }
.ui-disclosure.ui-disclosure[disabled] { background: transparent; color: var(--text); opacity: 0.4; }
.ui-disclosure.ui-control-pressed { background: var(--pressed); }
.ui-disclosure-label { flex: 1 1 0; min-width: 0; overflow-wrap: anywhere; }
.ui-disclosure-meta { display: inline-flex; flex: 0 1 auto; align-items: center; gap: var(--sp-8); min-width: 0; color: var(--text-2); font-size: var(--fs-sub); }
.ui-label-with-icon, .ui-entry-main { display: flex; flex: 1 1 0; align-items: center; gap: var(--sp-12); min-width: 0; }
.ui-entry-copy { display: flex; flex: 1 1 0; flex-direction: column; align-items: flex-start; gap: var(--sp-2); min-width: 0; text-align: left; }
.ui-entry-copy > .ui-disclosure-label { flex: none; }
.ui-entry-note { color: var(--text-2); font-size: var(--fs-sub); line-height: var(--lh-snug); overflow-wrap: anywhere; }
.ui-disclosure-group-item + .ui-disclosure-group-item { border-top: 1px solid var(--line); }
.ui-disclosure-group .ui-disclosure.ui-disclosure { border-top: 0; }

/* 图形标记：方向标、对勾、加号、关闭都由边框绘制，不用字符充当图标。 */
.ui-icon { display: block; flex: none; width: 20px; height: 20px; filter: var(--icon-filter); }
.ui-chevron { display: inline-block; flex: none; width: 7px; height: 7px; margin: 0 var(--sp-2); border-top: 1.5px solid currentColor; border-right: 1.5px solid currentColor; color: var(--text-3); transform: rotate(45deg); }
.ui-chevron--down { transform: rotate(135deg); }
.ui-chevron--up { transform: rotate(-45deg); }
.ui-check { display: inline-block; flex: none; width: 5px; height: 9px; border-right: 2px solid currentColor; border-bottom: 2px solid currentColor; transform: rotate(40deg); }
.ui-plus, .ui-close { position: relative; display: inline-block; flex: none; width: 12px; height: 12px; }
.ui-plus::before, .ui-plus::after, .ui-close::before, .ui-close::after { content: ''; position: absolute; left: 0; top: 5px; width: 12px; height: 2px; border-radius: var(--radius-pill); background: currentColor; }
.ui-plus::after { transform: rotate(90deg); }
.ui-close::before { transform: rotate(45deg); }
.ui-close::after { transform: rotate(-45deg); }

/* ── 状态：胶囊、提示条 ───────────────────────────────── */
/* 三种权重让状态不只靠颜色区分：实心点 + 绿底、空心点 + 中性底、虚线环 + 无底。 */
.pill {
  display: inline-flex;
  align-items: center;
  flex: 0 1 auto;
  gap: var(--sp-4);
  max-width: 100%;
  min-height: 24px;
  padding: var(--sp-2) var(--sp-8);
  border-radius: var(--radius-pill);
  font-size: var(--fs-caption);
  font-weight: 600;
  line-height: var(--lh-snug);
  overflow-wrap: anywhere;
}
.pill-ok { background: var(--green-soft); color: var(--green-text); }
.pill-warn { background: var(--warn-soft); color: var(--warn); }
.pill-bad { background: var(--bad-soft); color: var(--bad); }
.pill-muted { background: var(--control); color: var(--text-2); }
.pill-unknown { padding-left: 0; padding-right: 0; background: transparent; color: var(--warn); }
.pill-dot::before { content: ''; flex: none; width: 6px; height: 6px; border-radius: 50%; background: currentColor; }
.pill-muted.pill-dot::before { border: 1.5px solid currentColor; background: transparent; }
.pill-warn.pill-dot::before, .pill-unknown.pill-dot::before { width: 8px; height: 8px; border: 1.5px dashed currentColor; background: transparent; }

.banner {
  --control: var(--surface-top);
  margin-bottom: var(--sp-12);
  padding: var(--sp-12) var(--sp-16);
  border-radius: var(--radius-control);
  background: var(--surface);
  color: var(--text-2);
  font-size: var(--fs-sub);
  line-height: var(--lh-normal);
  overflow-wrap: anywhere;
}
.card .banner { --control: var(--surface); background: var(--surface-top); }
.banner:last-child { margin-bottom: 0; }
.banner.banner-ok { background: var(--green-soft); color: var(--green-text); }
.banner.banner-warn { background: var(--warn-soft); color: var(--warn); }
.banner.banner-bad { background: var(--bad-soft); color: var(--bad); }
.network-notice { margin-bottom: var(--sp-12); padding: var(--sp-8) var(--sp-16); border-radius: var(--radius-control); background: var(--warn-soft); color: var(--warn); font-size: var(--fs-sub); }
.stale-note { color: var(--warn); }
/* 请求进度贴近触发它的操作；连接慢时转为警示色。 */
.refresh-feedback { margin-bottom: var(--sp-8); color: var(--text-2); font-size: var(--fs-sub); }
.request-progress { margin-top: var(--sp-8); color: var(--text-2); font-size: var(--fs-sub); text-align: center; }
.request-progress--slow { color: var(--warn); }

/* ── 表单行、统计、列表 ───────────────────────────────── */
.field { display: flex; align-items: center; justify-content: space-between; gap: var(--sp-12); min-width: 0; min-height: 52px; padding: var(--sp-8) 0; border-top: 1px solid var(--line); }
.field:first-child { border-top: 0; }
.field .label { flex: 0 0 auto; max-width: 40%; color: var(--text); }
.field .value { flex: 1 1 0; min-width: 0; color: var(--text-2); text-align: right; overflow-wrap: anywhere; }
.list-item { padding: var(--sp-12) 0; border-top: 1px solid var(--line); }
.list-item:first-child { border-top: 0; }
.stat-row { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: var(--sp-8); margin-top: var(--sp-8); }
.stat { min-width: 0; }
.stat .num { font-size: var(--fs-title); font-weight: 600; line-height: var(--lh-tight); overflow-wrap: anywhere; }
.stat .lbl { margin-top: var(--sp-2); color: var(--text-3); font-size: var(--fs-caption); }

/* ── 空、加载、失败 ───────────────────────────────────── */
.empty { padding: var(--sp-24) var(--sp-12); color: var(--text-3); font-size: var(--fs-sub); text-align: center; }
.loading-line { padding: var(--sp-16) 0; color: var(--text-3); font-size: var(--fs-sub); text-align: center; }
.footer-note { padding: var(--sp-12) 0 0; color: var(--text-3); font-size: var(--fs-caption); text-align: center; }
.load-error-title { font-size: var(--fs-headline); font-weight: 600; line-height: var(--lh-snug); }
.load-error-detail { margin: var(--sp-4) 0 var(--sp-16); color: var(--text-2); font-size: var(--fs-sub); overflow-wrap: anywhere; }
.skeleton-card { margin-bottom: var(--sp-12); padding: var(--sp-16); border-radius: var(--radius-tray); background: var(--surface); }
.skeleton-line, .skeleton-bar { background: var(--skeleton); }
.skeleton-line { height: 14px; margin-top: var(--sp-12); border-radius: var(--radius-pill); }
.skeleton-title { width: 42%; height: 20px; margin-top: 0; }
.skeleton-short { width: 64%; }
.skeleton-bar { height: var(--btn-height); margin-top: var(--sp-16); border-radius: var(--radius-control); }

/* ── 商品图托 ─────────────────────────────────────────── */
.product-tile { display: flex; align-items: center; justify-content: center; flex: none; overflow: hidden; border-radius: var(--radius-tile); background: var(--image-tile); }
.product-tile image { display: block; width: 100%; height: 100%; mix-blend-mode: var(--image-blend); }

/* ── 动效：只表达状态变化；减少动态时保持静止 ─────────── */
@keyframes panel-appear {
  from { opacity: 0; transform: translateY(4px); }
  to { opacity: 1; transform: translateY(0); }
}
@keyframes skeleton-pulse {
  50% { opacity: 0.5; }
}
/* 哨响：小哨刚看到有货时，状态点向外扩散三次后静止。 */
@keyframes whistle-ping {
  0% { box-shadow: var(--ping-from); }
  100% { box-shadow: var(--ping-to); }
}
.ui-live-dot { flex: none; width: 10px; height: 10px; border-radius: 50%; background: var(--green); }
@media (prefers-reduced-motion: no-preference) {
  .ui-reveal { animation: panel-appear var(--dur) var(--ease); }
  .ui-chevron { transition: transform var(--dur) var(--ease); }
  .skeleton-line, .skeleton-bar { animation: skeleton-pulse 1.2s ease-in-out 3; }
  .ui-live-dot { animation: whistle-ping 1.6s var(--ease) 3; }
}
@media (prefers-reduced-motion: reduce) {
  .btn.btn, .ui-action.ui-action, .ui-disclosure.ui-disclosure { transition: none; }
  .btn.btn-primary-pressed { transform: none; }
}
