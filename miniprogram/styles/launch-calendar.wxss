/* Shared launch calendar + opening poster. Imported by query and guide pages. */
.calendar-heading { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; flex-wrap: wrap; }
/* Product title stays above milestone dates in the type scale. */
.calendar-title { font-size: 48rpx; font-weight: 750; letter-spacing: -1rpx; line-height: 1.2; }
.calendar-milestones { display: flex; gap: 24rpx; padding: 26rpx 0; }
.calendar-milestones > view { flex: 1; min-width: 0; }
.calendar-milestones > view + view { padding-left: 24rpx; border-left: 1rpx solid var(--line); }
.calendar-date { display: block; font-size: 40rpx; font-weight: 700; line-height: 1.2; color: var(--green-dark); }
.calendar-month { margin-bottom: 14rpx; font-size: 25rpx; font-weight: 600; }
.calendar-grid { display: flex; flex-wrap: wrap; }
.calendar-weekday, .calendar-cell { width: 14.2857%; text-align: center; }
.calendar-weekday { font-size: 22rpx; color: var(--text-3); padding-bottom: 8rpx; }
.calendar-cell { display: flex; flex-direction: column; align-items: center; justify-content: center; min-height: 58rpx; border: 2rpx solid transparent; border-radius: 12rpx; font-size: 24rpx; line-height: 1.3; }
.calendar-event { font-size: 18rpx; min-height: 22rpx; }
.calendar-cell--event { background: var(--green-soft); color: var(--green-dark); font-weight: 650; }
.calendar-cell--today { border-color: var(--green); }

/* A single image and two dates give the launch notice one clear reading path. */
.poster-hero { padding: 28rpx 24rpx 24rpx; border-radius: 24rpx; background: var(--surface-soft); text-align: center; overflow: hidden; }
.poster-title { font-size: 56rpx; font-weight: 750; line-height: 1.2; letter-spacing: -1.5rpx; color: var(--text); }
.poster-hero-media { position: relative; height: 320rpx; margin-top: 16rpx; overflow: hidden; border-radius: 16rpx; background: var(--image-tile, #ECF1EF); }
/* Official portrait assets include generous empty margins. Crop that margin,
   keeping the full device centered and separate from the title and dates. */
.poster-hero-image { position: absolute; display: block; width: 100%; height: 620rpx; top: 50%; transform: translateY(-50%); pointer-events: none; }
.opening-calendar-brand { font-size: 14px; color: var(--text-2); font-weight: 500; }
.poster-milestones { display: flex; padding: 30rpx 0 24rpx; gap: 24rpx; }
.poster-milestone { flex: 1; min-width: 0; text-align: center; }
.poster-milestone + .poster-milestone { border-left: 1rpx solid var(--line); }
.poster-milestone-date { display: block; font-size: 44rpx; font-weight: 700; line-height: 1.25; color: var(--green-dark); font-variant-numeric: tabular-nums; }
.poster-milestone-label { margin-top: 8rpx; font-size: 14px; line-height: 1.5; color: var(--text-2); }
.poster-source { text-align: center; font-size: 12px; color: var(--text-3); }

@media (min-width: 600px) {
  .calendar-heading { gap: 10px; }
  .calendar-title { font-size: 30px; letter-spacing: -.4px; }
  .calendar-milestones { gap: 16px; padding: 18px 0; }
  .calendar-milestones > view + view { padding-left: 16px; }
  .calendar-date { font-size: 26px; }
  .calendar-month { font-size: 14px; margin-bottom: 10px; }
  .calendar-weekday { font-size: 12px; padding-bottom: 6px; }
  .calendar-cell { min-height: 34px; font-size: 14px; border-radius: 6px; }
  .calendar-event { font-size: 11px; min-height: 13px; }
  .poster-hero { padding: 20px; border-radius: 16px; }
  .poster-hero-media { height: 180px; margin-top: 12px; border-radius: 12px; }
  .poster-hero-image { height: 350px; }
  .poster-title { font-size: 34px; letter-spacing: -.6px; }
  .poster-milestones { padding: 20px 0 16px; gap: 16px; }
  .poster-milestone-date { font-size: 28px; }
  .poster-milestone-label { margin-top: 6px; }
}
