{
  "pages": [
    "pages/query/index",
    "pages/follow/index",
    "pages/markets/index",
    "pages/mine/index"
  ],
  "subPackages": [
    { "root": "pages/history", "pages": ["index"] },
    { "root": "pages/notice-board", "pages": ["index"] },
    { "root": "pages/notification-test", "pages": ["index"] },
    { "root": "pages/guide", "pages": ["index"] },
    { "root": "pages/deadlines", "pages": ["index"] }
  ],
  "window": {
    "backgroundColor": "@pageBackground",
    "backgroundTextStyle": "@pullTextStyle",
    "navigationBarBackgroundColor": "@navBackground",
    "navigationBarTitleText": "果小哨",
    "navigationBarTextStyle": "@navTextStyle"
  },
  "tabBar": {
    "color": "@tabColor",
    "selectedColor": "@tabSelectedColor",
    "backgroundColor": "@tabBackground",
    "borderStyle": "@tabBorderStyle",
    "list": [
      { "pagePath": "pages/query/index", "text": "查询", "iconPath": "images/tab/query.png", "selectedIconPath": "images/tab/query-active.png" },
      { "pagePath": "pages/follow/index", "text": "小哨", "iconPath": "images/tab/follow.png", "selectedIconPath": "images/tab/follow-active.png" },
      { "pagePath": "pages/markets/index", "text": "其他站点", "iconPath": "images/tab/markets.png", "selectedIconPath": "images/tab/markets-active.png" },
      { "pagePath": "pages/mine/index", "text": "我的", "iconPath": "images/tab/mine.png", "selectedIconPath": "images/tab/mine-active.png" }
    ]
  },
  "sitemapLocation": "sitemap.json",
  "darkmode": true,
  "resizable": true,
  "themeLocation": "theme.json",
  "style": "v2",
  "lazyCodeLoading": "requiredComponents"
}
