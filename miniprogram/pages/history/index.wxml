<view class="page tab-page history-page">
  <view wx:if="{{loadError}}" class="card">
    <view class="banner banner-bad">加载失败：{{loadError}}</view>
    <button class="btn btn-outline btn-block" bindtap="onRetryLoad">重试</button>
  </view>

  <block wx:elif="{{!ready}}">
    <view class="card"><view class="loading-line">正在加载目录…</view></view>
  </block>

  <block wx:else>
    <view wx:if="{{!accountReady}}" class="banner banner-info small">{{accountError || '正在连接微信账户，你可以先选择查询条件。'}}<button wx:if="{{accountError}}" class="btn btn-outline btn-sm mt" bindtap="onRetryAccount">重试账户连接</button></view>
    <view class="page-heading"><view class="page-title">供应变化历史</view><view class="page-subtitle">按配置、日期与门店查看已有观测记录</view></view>
    <view class="card history-browse-card">
      <view class="card-title"><text>最近浏览</text><text class="sub">浏览不扣次数</text></view>
      <view wx:if="{{browseLoading && !browse}}" class="small muted mt">正在加载浏览记录…</view>
      <view wx:if="{{browse}}" class="small text-2 mt">
        <view wx:if="{{!browse.recentViews.length}}">还没有浏览记录。可在下方选择配置、门店与日期查看供应变化。</view>
        <view wx:for="{{browse.recentViews}}" wx:key="index" class="history-recent mt"><view class="history-recent-copy"><view>{{item.title}}</view><view class="tiny muted">{{item.dayKey}} · {{item.scopeText}}</view></view><button class="btn btn-outline btn-sm history-restore" data-index="{{index}}" disabled="{{querying || loadingMore}}" bindtap="onRestoreBrowse">恢复条件</button></view>
      </view>
      <view wx:if="{{restoreNotice}}" class="banner {{restoreWarning ? 'banner-warn' : 'banner-info'}} small mt">{{restoreNotice}}</view>
      <view wx:if="{{taskMessage}}" class="banner {{taskWarning ? 'banner-warn' : 'banner-ok'}} small mt">{{taskMessage}}</view>
      <view wx:if="{{browseError}}" class="banner banner-warn small mt">{{browseError}}<button class="btn btn-outline btn-sm mt" disabled="{{browseLoading}}" bindtap="onRetryBrowse">重新加载</button></view>
      <view class="tiny muted mt">进入本页并成功加载即可完成每日浏览任务；下方库存历史查询另按账户规则计次。</view>
    </view>
    <view class="card history-selection-card">
      <view class="card-title">
        <text>选择机型、门店与日期</text>
        <text class="sub" bindtap="onExplain">数据说明 ›</text>
      </view>
      <target-picker catalog="{{catalog}}" value="{{pickerValue}}" max-stores="{{10}}" stores-optional="{{true}}" bindchange="onPickerChange" />
      <view wx:if="{{accountReady && !boot.member}}" class="banner banner-info small mt">受限新品开售 30 天内，免费用户仅可看昨天及更早记录。余额不足可前往「我的」签到。</view>

      <picker mode="date" value="{{dayKey}}" start="2026-01-01" end="{{today}}" bindchange="onDateChange">
        <view class="field date-field">
          <text class="label">日期（北京时间）</text>
          <view class="row">
            <text class="value">{{dayKey === today ? '今天 ' + dayKey : dayKey}}</text>
            <text class="arrow">›</text>
          </view>
        </view>
      </picker>

      <view wx:if="{{restriction}}" class="banner banner-warn mt">{{restriction}}</view>
      <button wx:if="{{!boot.member && boot.balance < boot.historyCost}}" class="btn btn-ghost btn-sm mb" bindtap="onGoMine">去签到 / 查看次数</button>

      <button class="btn btn-primary btn-block mt {{querying ? 'disabled' : ''}}" disabled="{{querying || !accountReady}}" bindtap="onQuery">
        {{!accountReady ? '正在连接账户…' : (querying ? '加载中…' : (boot.member ? '查看历史' : '查看历史（消耗 ' + boot.historyCost + ' 次，余 ' + boot.balance + ' 次）'))}}
      </button>
      <view class="footer-note history-scope-note">仅查询本小程序已积累的历史；未采集的过去记录无法补查。不选门店时，展示各地已有记录，不代表全国覆盖。</view>
      <view wx:if="{{!boot.member}}" class="tiny muted history-scope-note">查询需有足够余额；未查到历史事件，次数自动退还。</view>
    </view>

    <view wx:if="{{result}}" class="card history-result-card">
      <view class="card-title">
        <text class="ellipsis">{{result.product.title}}</text>
        <text class="sub">{{result.dayText}}</text>
      </view>

      <view class="history-data-notice">
        <view class="history-data-title">{{result.coverageTitle}}</view>
        <view class="small text-2 mt">{{result.coverageNote}}</view>
        <view wx:if="{{result.billingText}}" class="small history-billing-note mt">{{result.billingText}}</view>
      </view>

      <view wx:if="{{result.hasEventRecords}}" class="section-label">已记录事件统计</view>
      <view wx:if="{{result.hasEventRecords}}" class="stat-row">
        <view class="stat"><view class="num">{{result.summary.available}}</view><view class="lbl">首次可取货</view></view>
        <view class="stat"><view class="num">{{result.summary.restocks}}</view><view class="lbl">确认补货</view></view>
        <view class="stat"><view class="num">{{result.summary.recoveries}}</view><view class="lbl">恢复</view></view>
        <view class="stat"><view class="num">{{result.summary.ended}}</view><view class="lbl">供应结束</view></view>
      </view>
      <view wx:if="{{result.hasEventRecords}}" class="tiny muted mt">上方四项按事件类型分别计数，其他状态变化只列入下方事件记录，因此四项之和可能小于事件总数。</view>
      <view wx:if="{{result.hasEventRecords && result.lastHour !== null}}" class="small text-2 mt">{{(result.lastHourComplete ? '' : '已加载记录中，') + result.lastHourWindowText + '记录到确认补货 ' + result.lastHour + ' 次'}}</view>

      <view class="section-label">当天观测凭据</view>
      <view class="small text-2">{{result.coverageSummary}}</view>
      <view wx:if="{{result.coverageCheckedText}}" class="tiny muted mt">采样摘要单独更新于 {{result.coverageCheckedText}}</view>
      <view wx:for="{{result.coverageStores}}" wx:key="storeNumber" class="history-coverage-row">
        <view class="small bold">{{item.storeName}}</view>
        <view class="tiny text-2">有效 {{item.knownCount}} 次 · 未确认 {{item.unknownCount}} 次</view>
        <view class="tiny muted">首末观测 {{item.rangeText}}</view>
      </view>
      <view class="tiny muted mt">凭据从启用记录后积累；首末观测之间不代表持续监测，较早的数据可能没有采样摘要。</view>

      <view wx:if="{{result.latestRestricted}}" class="banner banner-info small mt">当前配置处于免费用户新品限制期，本页仅提供所选日期历史，不显示当前库存。</view>
      <view wx:if="{{result.hasEventRecords}}" class="section-label">事件记录 · 已加载 {{result.events.length}} / {{result.pagination.total}}</view>
      <view wx:if="{{moreError}}" class="banner banner-warn small mt">{{moreError}}</view>
      <button wx:if="{{result.pagination.hasMore}}" class="btn btn-ghost btn-block mt" disabled="{{loadingMore}}" bindtap="onLoadMore">{{loadingMore ? '加载中…' : '加载更多（不额外扣次）'}}</button>
      <view wx:for="{{result.events}}" wx:key="id" class="event">
        <view class="event-time mono">{{item.timeText}}</view>
        <view class="event-body">
          <view class="row-between">
            <text class="small bold">{{item.storeName}}</text>
            <text class="pill pill-{{item.cls}} tiny">{{item.label}}</text>
          </view>
          <view class="tiny muted mt" wx:if="{{item.detailText}}">{{item.detailText}}</view>
          <view class="tiny muted" wx:if="{{item.quote}}">{{item.quote}}</view>
          <view class="tiny muted">来源：{{item.sourceText}}</view>
        </view>
      </view>
    </view>

    <view wx:if="{{result && result.latest.length}}" class="card history-latest-card">
        <view class="card-title">所选门店最近观测</view>
        <view class="small text-2 mt">此处为最近读取的状态，与上方所选日期的历史独立。</view>
        <view class="row-between mt"><text class="tiny muted">服务当前状态</text><view class="pill pill-dot pill-{{collector.cls}} tiny">{{collector.label}}</view></view>
        <view wx:for="{{result.latest}}" wx:key="storeNumber" class="row-between latest-row">
          <view>
            <text class="small">{{item.storeName}}</text>
            <view wx:if="{{item.observedText}}" class="tiny muted">{{item.observedText}}<text wx:if="{{item.sinceText}}"> · 距本轮首次记录 {{item.sinceText}}</text></view>
            <view wx:if="{{item.observationNote}}" class="tiny muted">{{item.observationNote}}</view>
            <view wx:if="{{item.lastKnownText}}" class="tiny muted">{{item.lastKnownText}}</view>
            <view wx:if="{{item.freshnessText}}" class="tiny {{item.observationState === 'fresh' ? 'muted' : 'stale-note'}}">{{item.freshnessText}}</view>
          </view>
          <view class="pill pill-dot pill-{{item.statusCls}} tiny">{{item.statusLabel}}</view>
        </view>
    </view>
  </block>
</view>
