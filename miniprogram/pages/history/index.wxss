/* 历史页。公共组件见 styles/common.wxss，令牌见 app.wxss。 */
.history-explain.ui-action { flex: none; }

/* ── 查询条件：日期、配置、操作 ───────────────────────── */
.history-date-row { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: var(--sp-8) var(--sp-12); padding-bottom: var(--sp-16); }
.history-date-picker { display: block; flex: 1 1 auto; min-width: 0; }
.history-date-control { display: flex; flex-direction: column; align-items: flex-start; justify-content: center; min-height: var(--tap); }
.history-date-control--disabled { opacity: 0.5; }
.history-date-pressed { opacity: 0.6; }
.history-date-line { display: flex; align-items: center; gap: var(--sp-8); }
.history-date-value { font-size: var(--fs-display); font-weight: 600; line-height: var(--lh-tight); white-space: nowrap; }
.history-date-caption { color: var(--text-3); font-size: var(--fs-caption); }
/* 分段选择：底槽略深，选中项抬起为白色。 */
.history-date-shortcuts { display: flex; flex: none; gap: var(--sp-2); padding: var(--sp-2); border-radius: var(--radius-pill); background: var(--line); }
.history-date-shortcuts .history-date-chip {
  display: flex;
  align-items: center;
  justify-content: center;
  width: auto;
  min-width: 48px;
  height: auto;
  min-height: var(--tap);
  margin: 0;
  padding: 0 var(--sp-12);
  border: 0;
  border-radius: var(--radius-pill);
  background: transparent;
  color: var(--text-2);
  font-size: var(--fs-sub);
  font-weight: 400;
  line-height: var(--lh-snug);
}
.history-date-shortcuts .history-date-chip--selected { background: var(--surface-top); color: var(--text); font-weight: 600; }
.history-date-shortcuts .history-date-chip[disabled] { background: transparent; color: var(--text-2); opacity: 0.5; }
.history-date-shortcuts .history-date-chip--selected[disabled] { background: var(--surface-top); color: var(--text); }
.history-config-summary { display: flex; align-items: center; gap: var(--sp-12); padding: var(--sp-12) 0; border-top: 1px solid var(--line); }
.history-product-media { width: 56px; height: 56px; }
.product-tile .history-product-image { width: 86%; height: 86%; }
.product-tile .history-product-placeholder { width: 24px; height: 24px; }
.history-config-copy { flex: 1 1 0; min-width: 0; overflow-wrap: anywhere; }
.history-config-title { font-weight: 600; line-height: var(--lh-snug); }
.history-store-scope { margin-top: var(--sp-2); color: var(--text-2); font-size: var(--fs-sub); }
.history-edit.ui-action { flex: none; white-space: nowrap; }
.history-query-row { margin-top: var(--sp-4); }
.history-query-cost { margin-top: var(--sp-12); color: var(--text-3); font-size: var(--fs-caption); text-align: center; }

/* ── 结果：时间轴 ─────────────────────────────────────── */
.history-result-heading { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: var(--sp-2) var(--sp-12); }
.history-data-title { font-size: var(--fs-headline); font-weight: 600; line-height: var(--lh-snug); }
.history-result-date { color: var(--text-2); font-size: var(--fs-sub); white-space: nowrap; }
.history-result-target { margin-top: var(--sp-2); color: var(--text-2); font-size: var(--fs-sub); overflow-wrap: anywhere; }
.history-data-notice { margin-top: var(--sp-12); padding: var(--sp-12); border-radius: var(--radius-control); background: var(--control); overflow-wrap: anywhere; }
.history-data-detail { color: var(--text-2); font-size: var(--fs-sub); }
.history-data-detail + .history-data-detail { margin-top: var(--sp-4); }
.history-last-restock { margin-top: var(--sp-8); color: var(--text-2); font-size: var(--fs-sub); }
.history-timeline-heading { display: flex; align-items: baseline; justify-content: space-between; gap: var(--sp-12); margin-top: var(--sp-20); font-weight: 600; }
.history-timeline-count { color: var(--text-3); font-size: var(--fs-caption); font-weight: 400; }
.event { min-width: 0; }
.event-time { display: flex; align-items: center; gap: var(--sp-12); margin-top: var(--sp-16); font-size: var(--fs-headline); font-weight: 600; line-height: var(--lh-snug); white-space: nowrap; }
.event-time::after { content: ''; flex: 1 1 0; height: 1px; background: var(--line); }
.event-body { min-width: 0; margin-left: var(--sp-4); padding: var(--sp-8) 0 var(--sp-8) var(--sp-12); border-left: 2px solid var(--line); }
.event-main { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: var(--sp-2) var(--sp-12); }
.event-store { flex: 1 1 110px; min-width: 0; font-weight: 600; line-height: var(--lh-snug); overflow-wrap: anywhere; }
.event-status { display: inline-flex; align-items: center; gap: var(--sp-4); max-width: 100%; color: var(--text-2); font-size: var(--fs-caption); font-weight: 600; }
.event-status::before { content: ''; flex: none; width: 6px; height: 6px; border-radius: 50%; background: currentColor; }
.event-status--ok { padding: var(--sp-2) var(--sp-8); border-radius: var(--radius-pill); background: var(--green-soft); color: var(--green-text); }
.event-status--warn { color: var(--warn); }
.event-status--warn::before { width: 8px; height: 8px; border: 1.5px dashed currentColor; background: transparent; }
.event-status--bad { padding: var(--sp-2) var(--sp-8); border-radius: var(--radius-pill); background: var(--control); color: var(--bad); }
.event-detail { margin-top: var(--sp-2); color: var(--text-2); font-size: var(--fs-caption); overflow-wrap: anywhere; }
.event-quote { color: var(--text-3); }
.history-disclosure.ui-disclosure { margin-top: var(--sp-16); border-top: 1px solid var(--line); }
.history-coverage { padding-bottom: var(--sp-4); }
.history-insights { margin-top: var(--sp-16); overflow-wrap: anywhere; }
.history-time-bands { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--sp-8); margin-top: var(--sp-12); }
.history-time-band { display: flex; flex-direction: column; gap: var(--sp-2); }
.history-coverage-row { margin-top: var(--sp-12); padding-top: var(--sp-12); border-top: 1px solid var(--line); overflow-wrap: anywhere; }

/* ── 浏览奖励与工具 ───────────────────────────────────── */
.history-task-bar { display: flex; align-items: center; justify-content: space-between; gap: var(--sp-12); margin: 0 var(--sp-4) var(--sp-12); }
.history-task-note { flex: 1 1 0; min-width: 0; color: var(--text-2); font-size: var(--fs-sub); }
.history-task-claim.btn { flex: none; }
.history-latest-card + .history-browse-card { border-top: 1px solid var(--line); }
.history-latest-panel, .history-browse-panel { padding-bottom: var(--sp-12); }
.latest-service { display: flex; align-items: center; justify-content: space-between; gap: var(--sp-12); padding-bottom: var(--sp-8); }
.latest-row { display: flex; align-items: flex-start; justify-content: space-between; gap: var(--sp-12); padding: var(--sp-12) 0; border-top: 1px solid var(--line); }
.latest-copy { flex: 1 1 0; min-width: 0; overflow-wrap: anywhere; }
.latest-meta { margin-top: var(--sp-2); color: var(--text-3); font-size: var(--fs-caption); }
.latest-meta.stale-note { color: var(--warn); }
.history-recent { display: flex; align-items: center; gap: var(--sp-12); padding: var(--sp-8) 0; border-top: 1px solid var(--line); }
.history-recent-copy { flex: 1 1 0; min-width: 0; overflow-wrap: anywhere; }
.history-restore.ui-action { flex: none; }
