.history-page { padding-left: 24rpx; padding-right: 24rpx; }
.history-page .card { padding: 24rpx; margin-bottom: 20rpx; border-radius: 24rpx; }
.history-heading { display: flex; justify-content: space-between; align-items: center; gap: 16rpx; margin: 0 6rpx 22rpx; }
.history-heading .page-title { font-size: 38rpx; letter-spacing: 0; }
.history-explain.ui-action { flex: none; gap: 8rpx; padding: 10rpx 14rpx; }
.history-explain .ui-icon { width: 16px; height: 16px; }
.history-config-summary { display: flex; align-items: center; gap: 18rpx; }
.history-product-media { display: flex; align-items: center; justify-content: center; flex: none; width: 86rpx; height: 102rpx; border-radius: 14rpx; background: var(--surface-soft); }
.history-product-image { width: 76rpx; height: 90rpx; }
.history-product-placeholder { width: 28px; height: 28px; }
.history-config-copy { flex: 1; min-width: 0; overflow-wrap: anywhere; }
.history-config-title { font-size: max(14px, 28rpx); font-weight: 600; line-height: 1.45; }
.history-edit.ui-action { flex: none; gap: 10rpx; padding: 8rpx 12rpx; min-width: 56px; }
.history-store-scope { display: flex; align-items: flex-start; gap: 10rpx; margin-top: 16rpx; font-size: max(12px, 24rpx); line-height: 1.55; color: var(--text-2); }
.history-store-scope .ui-icon { width: 16px; height: 16px; margin-top: 2rpx; }
.history-store-scope > text { flex: 1; min-width: 0; overflow-wrap: anywhere; }
.history-config-empty { padding: 6rpx 0; }
.history-date-row { display: flex; align-items: stretch; gap: 12rpx; margin-top: 20rpx; padding-top: 20rpx; border-top: 1rpx solid var(--line); }
.history-date-shortcuts { display: flex; gap: 8rpx; flex: none; }
.history-date-chip.ui-action { justify-content: center; min-width: 44px; min-height: 44px; padding: 8rpx 10rpx; border-radius: 16rpx; font-size: max(12px, 24rpx); }
.history-date-chip--selected.ui-action { color: var(--green-dark); border-color: var(--control-line); background: var(--green-soft); font-weight: 600; }
.history-date-picker { display: block; flex: 1; min-width: 0; }
.history-date-control { display: flex; align-items: center; justify-content: space-between; gap: 10rpx; min-height: 44px; height: 100%; box-sizing: border-box; padding: 10rpx 14rpx; border: 1rpx solid var(--line); border-radius: 16rpx; background: var(--surface-soft); color: var(--text-2); }
.history-date-control .ui-icon { width: 16px; height: 16px; }
.history-date-control .ui-chevron { width: 6px; height: 6px; }
.history-date-value { flex: 1; min-width: 0; color: var(--text); font-size: max(12px, 25rpx); font-weight: 600; line-height: 1.5; white-space: nowrap; font-variant-numeric: tabular-nums; }
.history-date-control--disabled { opacity: .55; }
.history-restriction-note { margin-top: 12rpx; }
.history-selection-card .btn-primary { margin-top: 20rpx; }
.history-query-cost { display: flex; align-items: baseline; justify-content: space-between; flex-wrap: wrap; gap: 6rpx 16rpx; margin-top: 14rpx; font-size: max(12px, 24rpx); line-height: 1.5; color: var(--text-2); }
.history-query-cost > text:first-child { color: var(--green-dark); }
.history-scope-note { margin-top: 8rpx; line-height: 1.5; }
.history-task-bar { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; margin: 0 4rpx 20rpx; padding: 14rpx 18rpx; border-radius: 16rpx; background: var(--surface-soft); border: 1rpx solid var(--line); }
.history-task-note { flex: 1; min-width: 0; margin: 0; line-height: 1.5; }
.history-task-claim.btn { flex: none; width: auto; height: auto; min-height: 44px; margin: 0; padding: 6rpx 16rpx; font-size: max(12px, 24rpx); line-height: 1.45; }
.history-result-heading { display: flex; justify-content: space-between; align-items: baseline; gap: 16rpx; }
.history-result-date { font-size: max(16px, 34rpx); font-weight: 700; font-variant-numeric: tabular-nums; }
.history-result-target { margin-top: 6rpx; font-size: max(12px, 25rpx); color: var(--text-2); overflow-wrap: anywhere; }
.history-data-notice { margin-top: 18rpx; padding: 18rpx 20rpx; border-radius: 16rpx; background: var(--surface-soft); border: 1rpx solid var(--line); overflow-wrap: anywhere; }
.history-data-notice--recorded { background: var(--green-soft); border-color: rgba(0, 195, 117, 0.34); }
.history-data-title { font-size: max(14px, 28rpx); font-weight: 600; line-height: 1.5; color: var(--text); }
.history-data-detail { margin-top: 6rpx; }
.history-billing-note { color: var(--green-dark); }
.history-timeline-heading { display: flex; align-items: baseline; justify-content: space-between; gap: 12rpx; margin: 24rpx 0 6rpx; font-size: max(12px, 25rpx); color: var(--text-2); font-weight: 600; }
.history-timeline-heading > text:last-child { font-weight: 400; }
.event { display: flex; gap: 16rpx; position: relative; padding: 18rpx 0; }
.event-rail { position: relative; flex: none; width: 140rpx; min-width: 68px; padding-right: 18rpx; }
.event-rail::after { content: ''; position: absolute; top: 14rpx; bottom: -36rpx; right: 0; width: 1rpx; background: var(--line); }
.event--last .event-rail::after { display: none; }
.event-time { color: var(--text-2); font-size: max(12px, 23rpx); line-height: 1.7; font-variant-numeric: tabular-nums; white-space: nowrap; word-break: normal; }
.event-dot { position: absolute; z-index: 1; right: -5rpx; top: 10rpx; width: 10rpx; height: 10rpx; border-radius: 50%; background: var(--text-3); box-shadow: 0 0 0 6rpx var(--card); }
.event-dot--ok { background: var(--green-dark); }
.event-dot--bad { background: var(--bad); }
.event-dot--warn { background: var(--warn); }
.event-body { flex: 1; min-width: 0; padding-bottom: 8rpx; }
.event-main { display: flex; align-items: flex-start; justify-content: space-between; flex-wrap: wrap; gap: 8rpx 10rpx; }
.event-store { flex: 1 1 120rpx; min-width: 0; overflow-wrap: anywhere; }
.event-status { flex: none; max-width: 100%; padding: 2rpx 12rpx; border-radius: 10rpx; }
.event-detail { margin-top: 8rpx; line-height: 1.55; overflow-wrap: anywhere; }
.event-source { margin-top: 6rpx; }
.history-disclosure.ui-disclosure { margin: 20rpx 0 10rpx; }
.history-insights { margin-top: 18rpx; padding: 20rpx; background: var(--surface-soft); border-radius: 16rpx; line-height: 1.6; overflow-wrap: anywhere; }
.history-time-bands { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12rpx; margin-top: 16rpx; }
.history-time-band { display: flex; flex-direction: column; gap: 4rpx; padding: 12rpx; border: 1rpx solid var(--line); border-radius: 12rpx; }
.history-coverage-row { padding: 16rpx 0; border-bottom: 1rpx solid var(--line); line-height: 1.6; overflow-wrap: anywhere; }
.history-coverage-row:last-of-type { border-bottom: none; }
.history-tools-card .ui-disclosure.ui-disclosure { margin-top: 0; padding: 12rpx 16rpx; min-height: 44px; }
.history-latest-card + .history-browse-card { margin-top: 18rpx; padding-top: 18rpx; border-top: 1rpx solid var(--line); }
.history-latest-card { overflow-wrap: anywhere; }
.latest-row { gap: 16rpx; padding: 18rpx 0; border-bottom: 1rpx solid var(--line); }
.latest-row:last-child { border-bottom: none; }
.history-latest-card .latest-row > view:first-child { flex: 1; min-width: 0; }
.history-recent { display: flex; align-items: center; gap: 16rpx; padding: 14rpx 0; border-bottom: 1rpx solid var(--line); }
.history-recent-copy { flex: 1; min-width: 0; overflow-wrap: anywhere; }
.history-restore { flex: 0 0 auto; min-width: 76px; max-width: 44%; }
@media (max-width: 340px) {
  .history-date-control { gap: 8rpx; padding-left: 10rpx; padding-right: 10rpx; }
  .history-date-control .ui-icon { display: none; }
  .history-config-summary { gap: 14rpx; }
  .history-product-media { width: 72rpx; height: 88rpx; }
  .history-product-image { width: 64rpx; height: 80rpx; }
}

.request-progress, .refresh-feedback { padding: 18rpx 22rpx; margin-top: 16rpx; border-radius: 16rpx; background: var(--surface-soft); color: var(--text-2); font-size: 24rpx; line-height: 1.6; }
.refresh-feedback { margin: 0 0 20rpx; }
.request-progress--slow { border-left: 4rpx solid var(--green); }
