.notice-page { padding-bottom: 40rpx; }

.empty-notice-title {
  font-size: 32rpx;
  font-weight: 700;
  line-height: 1.5;
  margin-bottom: 8rpx;
}

.notice-card {
  margin-bottom: 16rpx;
}

.notice-card-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 10rpx;
}

.notice-card-title {
  font-size: 30rpx;
  font-weight: 700;
  line-height: 1.5;
  flex: 1 1 auto;
  min-width: 0;
}

.notice-card-stamp {
  flex: 0 0 auto;
  font-size: 22rpx;
  color: var(--text-2);
  line-height: 1.4;
}

.notice-card-text {
  font-size: 27rpx;
  line-height: 1.7;
  color: var(--text-1);
  overflow-wrap: anywhere;
  white-space: pre-wrap;
}

.notice-card--info .notice-card-title { color: var(--green-dark); }
.notice-card--ok .notice-card-title { color: var(--green-dark); }
.notice-card--warn .notice-card-title { color: var(--warn); }

.notice-foot {
  margin: 8rpx 8rpx 0;
  line-height: 1.6;
}
