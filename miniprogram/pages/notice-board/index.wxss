.notice-page { padding-bottom: 40rpx; }
.notice-heading { display: flex; align-items: center; gap: 16rpx; }
.notice-heading .brand-page-copy { flex: 1; min-width: 0; }
.notice-heading .ui-action { flex: none; }
.notice-service-footer { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 12rpx; margin-top: 16rpx; }
.notice-section-title { margin: 28rpx 6rpx 16rpx; font-size: 28rpx; font-weight: 600; color: var(--text-2); }
.notice-card-meta { display: flex; flex-wrap: wrap; gap: 8rpx 16rpx; margin-bottom: 14rpx; font-size: 22rpx; line-height: 1.6; color: var(--text-2); }

.empty-notice-title {
  font-size: 32rpx;
  font-weight: 700;
  line-height: 1.5;
  margin-bottom: 8rpx;
}

.notice-card {
  margin-bottom: 16rpx;
  border-left: 6rpx solid var(--green-dark);
}
.notice-card--warn {
  border-left-color: var(--warn);
}

.notice-card-head {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 10rpx;
}

.notice-card-title {
  font-size: 30rpx;
  font-weight: 700;
  line-height: 1.5;
  flex: 1 1 auto;
  min-width: 0;
}

.notice-card-stamp {
  flex: 0 0 auto;
  font-size: 22rpx;
  color: var(--text-2);
  line-height: 1.4;
}

.notice-card-text {
  font-size: 27rpx;
  line-height: 1.7;
  color: var(--text);
  overflow-wrap: anywhere;
  white-space: pre-wrap;
}

.notice-card--info .notice-card-title { color: var(--green-dark); }
.notice-card--ok .notice-card-title { color: var(--green-dark); }
.notice-card--warn .notice-card-title { color: var(--warn); }

.notice-foot {
  margin: 8rpx 8rpx 0;
  line-height: 1.6;
}
