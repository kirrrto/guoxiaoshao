/* 公告与服务。 */
.notice-card-head { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: var(--sp-8) var(--sp-12); }
.notice-card-title { flex: 1 1 auto; min-width: 0; font-size: var(--fs-headline); font-weight: 600; line-height: var(--lh-snug); }
.notice-card-meta { display: flex; flex-wrap: wrap; gap: var(--sp-2) var(--sp-12); margin-top: var(--sp-2); color: var(--text-3); font-size: var(--fs-caption); }
.notice-card-text { margin-top: var(--sp-8); color: var(--text-2); font-size: var(--fs-sub); line-height: var(--lh-normal); overflow-wrap: anywhere; white-space: pre-wrap; }
.notice-service-footer { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: var(--sp-8); margin-top: var(--sp-12); }
.notice-service-footer .notice-card-meta { margin-top: 0; }
.empty-notice-title { color: var(--text-2); }
/* 警示类公告整块换成警示底色，不用侧边色条。 */
.notice-card--warn.card { background: var(--warn-soft); }
.notice-card--warn .notice-card-title { color: var(--warn); }
.notice-card--warn .notice-card-text { color: var(--text); }
