<wxs module="i18n" src="../../i18n/render.wxs" />
<view class="page notice-page">
  <view class="page-heading notice-heading">
    <view class="page-title">{{i18n.t(ui,'公告与服务')}}</view>
    <button class="ui-action ui-action--plain" hover-class="ui-control-pressed" disabled="{{refreshing}}" loading="{{refreshing}}" bindtap="onRetry">{{i18n.t(ui,'刷新')}}</button>
  </view>
  <view wx:if="{{loadError}}" class="card load-error" aria-role="alert">
    <view class="load-error-title">{{i18n.t(ui,'公告暂未更新')}}</view><view class="load-error-detail">{{i18n.t(ui,(loadError))}}</view>
    <button class="btn btn-primary btn-block" disabled="{{refreshing}}" bindtap="onRetry">{{i18n.t(ui,'重新读取')}}</button>
  </view>
  <view wx:if="{{!ready}}" class="card loading-line" aria-busy="true">{{i18n.t(ui,'正在读取公告与服务状态…')}}</view>
  <block wx:else>
    <view wx:if="{{service}}" class="card notice-service">
      <view class="notice-card-head"><text class="notice-card-title">{{i18n.t(ui,'后台最近状态')}}</text><view class="pill pill-{{service.tone}}">{{i18n.t(ui,(service.label))}}</view></view>
      <view wx:if="{{loadError || service.detail}}" class="notice-card-text">{{i18n.t(ui,(loadError ? '当前未能更新，以下为上次读取的服务状态。' : service.detail))}}</view>
      <view class="notice-service-footer"><text class="notice-card-meta">{{i18n.m(ui,'读取于 {0}',[(refreshedText)])}}</text><button class="ui-action" hover-class="ui-control-pressed" bindtap="onGoFollows">{{i18n.t(ui,'查看我的小哨')}}</button></view>
    </view>
    <view wx:if="{{!hasContent && !loadError}}" class="card empty-notice"><view class="empty-notice-title">{{i18n.t(ui,'暂无有效公告')}}</view></view>
    <view wx:for="{{items}}" wx:key="key" class="card notice-card notice-card--{{item.tone}}">
      <view class="notice-card-head"><text class="notice-card-title">{{ui && item.titleEn ? item.titleEn : item.hasOriginalTitle ? item.title : i18n.t(ui,item.title)}}</text></view>
      <view wx:if="{{item.publishedAt || item.stamp}}" class="notice-card-meta"><text wx:if="{{item.publishedAt}}">{{i18n.m(ui,'发布 {0}',[(item.publishedAt)])}}</text><text wx:if="{{item.stamp}}">{{i18n.t(ui,(item.stamp))}}</text></view>
      <view wx:if="{{ui && (!item.textEn || (item.hasOriginalTitle && !item.titleEn))}}" class="notice-card-meta">{{i18n.t(ui,'含公告原文')}}</view>
      <view class="notice-card-text">{{ui && item.textEn ? item.textEn : item.text}}</view>
    </view>
    <button class="btn btn-block" hover-class="ui-control-pressed" bindtap="onGoHelp">{{i18n.t(ui,'没有收到提醒？查看排查步骤')}}</button>
  </block>
</view>
