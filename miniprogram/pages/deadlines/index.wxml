<wxs module="i18n" src="../../i18n/render.wxs" />
<view class="page deadline-page">
  <view class="page-heading"><view class="page-title">{{i18n.t(ui,'到期提醒')}}</view><text class="deadline-service-state">{{i18n.t(ui,(loading ? '读取中' : !serviceAvailable ? '暂不可用' : capability.enabled ? '免费试用' : '仅保存事项'))}}</text></view>
  <view wx:if="{{error}}" class="banner banner-warn" aria-role="alert">{{i18n.t(ui,(error))}}</view>
  <view wx:if="{{feedback}}" class="deadline-feedback" aria-role="status">{{i18n.t(ui,(feedback))}}</view>
  <view wx:if="{{pending && !busy}}" class="banner banner-warn">
    <view>{{i18n.t(ui,'原操作尚待确认，请先完成同步。')}}</view>
    <button class="btn btn-primary btn-block mt" loading="{{busy}}" disabled="{{busy}}" bindtap="onRetryPending">{{i18n.t(ui,(pendingLabel))}}</button>
  </view>
  <view wx:if="{{loading && !ready}}" class="loading-line" aria-busy="true">{{i18n.t(ui,'正在读取到期事项…')}}</view>
  <button wx:elif="{{!serviceAvailable}}" class="btn btn-primary btn-block" loading="{{loading}}" disabled="{{loading || busy}}" bindtap="load">{{i18n.t(ui,'重新读取')}}</button>
  <block wx:if="{{ready}}">
    <view wx:if="{{serviceAvailable && !capability.enabled}}" class="banner banner-info deadline-service-note">{{i18n.t(ui,'当前可保存事项，微信到期提醒尚未开启。到期前请主动查看。')}}</view>
    <view wx:if="{{editing}}" class="card deadline-editor">
      <view class="card-title">{{i18n.t(ui,(editingId ? '编辑事项' : '添加到期事项'))}}</view>
      <view class="deadline-field"><text class="deadline-label">{{i18n.t(ui,'事项名称')}}</text><input class="deadline-input" value="{{draft.title}}" maxlength="40" placeholder="{{i18n.t(ui,'例如：视频会员续费')}}" placeholder-class="deadline-placeholder" aria-label="{{i18n.t(ui,'事项名称')}}" data-field="title" bindinput="onField" disabled="{{busy || pending}}" /></view>
      <view class="deadline-field"><text class="deadline-label">{{i18n.t(ui,'类型')}}</text><picker mode="selector" range="{{i18n.options(ui,(categories),'label')}}" range-key="label" value="{{categoryIndex}}" bindchange="onCategory" disabled="{{busy || pending}}" aria-label="{{i18n.t(ui,'事项类型')}}"><view class="deadline-picker"><text>{{i18n.t(ui,(categories[categoryIndex].label))}}</text><view class="ui-chevron ui-chevron--down" aria-hidden="true"></view></view></picker></view>
      <view class="deadline-field"><text class="deadline-label">{{i18n.t(ui,'到期日期')}}</text><picker mode="date" value="{{draft.dueDate}}" data-field="dueDate" bindchange="onField" disabled="{{busy || pending}}" aria-label="{{i18n.t(ui,'到期日期')}}"><view class="deadline-picker"><text>{{i18n.t(ui,(draft.dueDate))}}</text><view class="ui-chevron ui-chevron--down" aria-hidden="true"></view></view></picker></view>
      <view class="deadline-field"><text class="deadline-label">{{i18n.t(ui,'提前几天')}}</text><input class="deadline-input" type="number" value="{{draft.advanceDays}}" maxlength="3" placeholder="{{i18n.t(ui,'0 为到期当天')}}" placeholder-class="deadline-placeholder" aria-label="{{i18n.t(ui,'提前天数，0为当天，最多365天')}}" data-field="advanceDays" bindinput="onField" disabled="{{busy || pending}}" /></view>
      <view class="deadline-field"><text class="deadline-label">{{i18n.t(ui,'提醒时刻')}}</text><picker mode="time" value="{{draft.remindTime}}" data-field="remindTime" bindchange="onField" disabled="{{busy || pending}}" aria-label="{{i18n.t(ui,'提醒时刻，北京时间')}}"><view class="deadline-picker"><text>{{i18n.t(ui,(draft.remindTime))}}</text><view class="ui-chevron ui-chevron--down" aria-hidden="true"></view></view></picker></view>
      <view wx:if="{{previewTime}}" class="deadline-preview">{{i18n.m(ui,'计划 {0} 提醒（北京时间）',[(previewTime)])}}</view>
      <view class="deadline-editor-note">{{i18n.t(ui,(capability.enabled ? '保存后需微信授权一次提醒。' : '当前仅保存事项，不会发送微信通知。'))}}</view>
      <view wx:if="{{formError}}" class="small text-bad mt" aria-role="alert">{{i18n.t(ui,(formError))}}</view>
      <button wx:if="{{editConflict}}" class="btn btn-block mt" hover-class="ui-control-pressed" disabled="{{busy || pending || loading}}" bindtap="onReloadEditor">{{i18n.t(ui,'用最新内容替换草稿')}}</button>
      <view class="btn-row"><button class="btn" hover-class="ui-control-pressed" disabled="{{busy || pending}}" bindtap="onCancel">{{i18n.t(ui,'取消')}}</button><button class="btn btn-primary" hover-class="btn-primary-pressed" loading="{{busy}}" disabled="{{busy || pending || editConflict || !serviceAvailable}}" bindtap="onSave">{{i18n.t(ui,(busy ? '保存中' : '保存事项'))}}</button></view>
    </view>
    <button wx:elif="{{serviceAvailable}}" class="btn btn-primary btn-block deadline-add" hover-class="btn-primary-pressed" disabled="{{busy || pending || loading}}" bindtap="onNew">{{i18n.t(ui,'添加到期事项')}}</button>
    <view class="section-heading deadline-list-heading"><text class="section-title">{{i18n.t(ui,'我的事项')}}</text><text class="deadline-list-count">{{i18n.m(ui,'{0} / {1}',[(items.length),(limit)])}}</text></view>
    <view wx:if="{{!items.length}}" class="deadline-empty">{{i18n.t(ui,'还没有到期事项')}}</view>
    <view wx:for="{{items}}" wx:key="id" class="card deadline-item">
      <view class="deadline-item-title">{{item.title}}</view>
      <view class="deadline-item-date">{{i18n.m(ui,'{0} · {1}',[(item.dueText),(item.categoryLabel)])}}</view>
      <view class="deadline-item-plan">{{i18n.m(ui,'计划提醒 {0}（北京时间）',[(item.remindText)])}}</view>
      <view class="deadline-status deadline-status--{{item.tone}}">{{i18n.t(ui,(item.statusLabel))}}</view>
      <view class="deadline-item-note">{{i18n.t(ui,(item.statusNote))}}</view>
      <button wx:if="{{item.canAuthorize && capability.enabled && serviceAvailable}}" class="btn btn-primary btn-block mt" hover-class="btn-primary-pressed" data-id="{{item.id}}" loading="{{busy}}" disabled="{{busy || pending}}" bindtap="onAuthorize">{{i18n.t(ui,'允许一次微信提醒')}}</button>
      <view class="deadline-item-actions"><button class="ui-action" hover-class="ui-control-pressed" data-id="{{item.id}}" disabled="{{busy || pending || !item.canEdit || !serviceAvailable}}" bindtap="onEdit" aria-label="{{i18n.t(ui,'编辑') + item.title}}">{{i18n.t(ui,'编辑')}}</button><button class="ui-action ui-action--plain ui-action--danger" hover-class="ui-control-pressed" data-id="{{item.id}}" disabled="{{busy || pending || !item.canEdit || !serviceAvailable}}" bindtap="onRemove" aria-label="{{i18n.t(ui,'删除') + item.title}}">{{i18n.t(ui,'删除')}}</button></view>
    </view>
  </block>
</view>
