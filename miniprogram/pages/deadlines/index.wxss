/* 到期提醒：手动填写名称、日期、提前天数与时刻。 */
.deadline-service-state { flex: none; color: var(--text-3); font-size: var(--fs-sub); }
.deadline-feedback { margin-bottom: var(--sp-12); color: var(--green-text); font-size: var(--fs-sub); }
.deadline-add.btn { margin-bottom: var(--sp-8); }

/* ── 编辑 ─────────────────────────────────────────────── */
.deadline-field { margin-bottom: var(--sp-16); }
.deadline-label { display: block; margin-bottom: var(--sp-4); color: var(--text-2); font-size: var(--fs-sub); }
.deadline-input, .deadline-picker { min-height: var(--btn-height); padding: 0 var(--sp-12); border-radius: var(--radius-control); background: var(--control); color: var(--text); font-size: var(--fs-body); }
.deadline-input { width: 100%; height: var(--btn-height); }
.deadline-placeholder { color: var(--text-3); }
.deadline-picker { display: flex; align-items: center; justify-content: space-between; gap: var(--sp-12); }
.deadline-preview { margin-bottom: var(--sp-4); font-weight: 600; line-height: var(--lh-snug); overflow-wrap: anywhere; }
.deadline-editor-note { color: var(--text-2); font-size: var(--fs-sub); }

/* ── 事项 ─────────────────────────────────────────────── */
.deadline-list-count { color: var(--text-3); font-size: var(--fs-sub); }
.deadline-empty { padding: var(--sp-8) 0; color: var(--text-2); font-size: var(--fs-sub); }
.deadline-item-title { font-size: var(--fs-headline); font-weight: 600; line-height: var(--lh-snug); overflow-wrap: anywhere; word-break: break-all; }
.deadline-item-date, .deadline-item-plan { margin-top: var(--sp-2); color: var(--text-2); font-size: var(--fs-sub); }
.deadline-status { margin-top: var(--sp-12); font-weight: 600; line-height: var(--lh-snug); }
.deadline-status--ok { color: var(--green-text); }
.deadline-status--warn { color: var(--warn); }
.deadline-status--bad { color: var(--bad); }
.deadline-status--muted { color: var(--text-2); }
.deadline-item-note { margin-top: var(--sp-2); color: var(--text-2); font-size: var(--fs-sub); overflow-wrap: anywhere; }
.deadline-item-actions { display: flex; justify-content: flex-end; gap: var(--sp-8); margin-top: var(--sp-12); padding-top: var(--sp-8); border-top: 1px solid var(--line); }
