/* 攻略页：全站唯一承载规则与解释的页面。 */
.guide-target, .guide-focused-help { overflow-wrap: anywhere; }
.guide-answer { color: var(--text-2); font-size: var(--fs-sub); line-height: var(--lh-normal); overflow-wrap: anywhere; }
.guide-faq-answer { padding: 0 0 var(--sp-16); }

/* 四个阶段：步骤条控制同一托盘内的内容。 */
.guide-stepper { position: relative; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); margin: 0 calc(var(--sp-8) * -1) var(--sp-12); }
.guide-stepper::before { content: ''; position: absolute; left: 12.5%; right: 12.5%; top: 22px; height: 1px; background: var(--line); }
.guide-stepper .guide-stepper-item {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: var(--sp-4);
  width: auto;
  min-width: 0;
  max-width: 100%;
  height: auto;
  min-height: var(--tap);
  margin: 0;
  padding: var(--sp-8) var(--sp-2);
  border: 0;
  border-radius: var(--radius-control);
  background: transparent;
  color: var(--text-2);
  font-size: var(--fs-caption);
  font-weight: 400;
  line-height: var(--lh-snug);
}
.guide-stepper .guide-stepper-pressed { background: var(--pressed); }
.guide-stepper-dot { display: flex; align-items: center; justify-content: center; width: 28px; height: 28px; border: 1.5px solid var(--line); border-radius: 50%; background: var(--surface-top); color: var(--text-2); font-size: var(--fs-sub); font-weight: 600; line-height: 1; }
.guide-stepper-label { max-width: 100%; text-align: center; overflow-wrap: anywhere; }
.guide-stepper .guide-stepper-item--on { color: var(--text); font-weight: 600; }
.guide-stepper-item--on .guide-stepper-dot { border-color: var(--green); background: var(--green); color: var(--green-ink); }
.guide-stage-copy { padding-top: var(--sp-12); border-top: 1px solid var(--line); }
.guide-stage-title { font-weight: 600; line-height: var(--lh-snug); }
.guide-pickup-title { margin-top: var(--sp-16); padding-top: var(--sp-16); border-top: 1px solid var(--line); }

.guide-step { display: flex; align-items: flex-start; gap: var(--sp-12); margin-top: var(--sp-16); }
.guide-step-number { display: flex; flex: none; align-items: center; justify-content: center; width: 22px; height: 22px; border-radius: 50%; background: var(--surface-top); color: var(--text-2); font-size: var(--fs-caption); font-weight: 600; line-height: 1; }
.guide-step-copy { flex: 1 1 0; min-width: 0; }
.guide-step-title { font-weight: 600; line-height: var(--lh-snug); }
.guide-step-text { margin-top: var(--sp-2); color: var(--text-2); font-size: var(--fs-sub); line-height: var(--lh-normal); overflow-wrap: anywhere; }
