@import '../../styles/common.wxss';
@import '../../styles/launch-calendar.wxss';
.guide-page { max-width: 960px; margin: 0 auto; padding-bottom: calc(40rpx + env(safe-area-inset-bottom)); }
.guide-hero { padding: 26rpx 12rpx 38rpx; }
/* Keep the title distinct without repeating the guide's purpose. */
.guide-title {
  color: var(--green-dark);
  font-size: 52rpx;
  line-height: 1.25;
  letter-spacing: -1.2rpx;
  font-weight: 750;
}
.guide-subtitle {
  margin-top: 14rpx;
  font-size: 28rpx;
  line-height: 1.5;
  color: var(--text-2);
}
/* Native button rules outrank a single class and force a full-width stack.
   Two equal columns keep the four stages on one screen at iPhone mini width. */
.guide-stages { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12rpx; margin-bottom: 20rpx; min-width: 0; }
button.guide-stage.guide-stage { box-sizing: border-box; width: 100%; min-width: 0; max-width: 100%; height: auto; margin: 0; border: 1rpx solid var(--line); border-radius: 20rpx; background: var(--card); color: var(--text-2); min-height: 44px; padding: 16rpx 14rpx; display: flex; align-items: center; justify-content: flex-start; gap: 10rpx; font-size: 26rpx; line-height: 1.3; text-align: left; white-space: nowrap; overflow: hidden; }
button.guide-stage.guide-stage::after { border: none; }
button.guide-stage.guide-stage.guide-stage--on { border-color: var(--green); background: var(--green-soft); color: var(--green-dark); font-weight: 600; }
.guide-stage-number { flex: none; opacity: .65; font-size: 22rpx; }
.guide-stage-label { min-width: 0; overflow: hidden; text-overflow: ellipsis; }
.guide-section-title { font-size: 32rpx; font-weight: 650; }
.guide-step { display: flex; align-items: flex-start; gap: 18rpx; margin: 30rpx 0; }
.guide-step-number { flex: none; display: flex; align-items: center; justify-content: center; width: 42rpx; height: 42rpx; background: var(--green-soft); color: var(--green-dark); border-radius: 50%; font-size: 24rpx; font-weight: 600; }
.guide-step-copy { flex: 1; min-width: 0; }
.guide-step-title { font-size: 29rpx; font-weight: 600; }
.guide-step-copy .small { line-height: 1.75; }
.guide-calendar { padding-top: 28rpx; }
.guide-faq { margin-top: 18rpx; }
.guide-answer { padding: 20rpx 14rpx 8rpx; line-height: 1.75; }
.guide-page .btn { height: auto; min-height: 44px; line-height: 1.5; padding: 20rpx 26rpx; white-space: normal; }
.guide-page .footer-note { line-height: 1.7; }
@media (min-width: 600px) {
  .guide-hero { padding: 20px 8px 26px; }
  .guide-title { font-size: 34px; letter-spacing: -.6px; }
  .guide-subtitle { font-size: 16px; margin-top: 10px; }
  .guide-stages { grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 12px; margin-bottom: 16px; }
  button.guide-stage.guide-stage { padding: 12px; gap: 8px; font-size: 15px; border-radius: 12px; }
  .guide-stage-number { font-size: 12px; }
  .guide-section-title { font-size: 20px; }
  .guide-step { gap: 12px; margin: 24px 0; }
  .guide-step-number { width: 24px; height: 24px; font-size: 14px; }
  .guide-step-title { font-size: 17px; }
  .guide-calendar { max-width: 640px; margin: 0 auto; padding-top: 20px; }
  .guide-faq { margin-top: 12px; }
  .guide-answer { padding: 14px 10px 4px; }
  .guide-page .btn { padding: 12px 18px; }
}
