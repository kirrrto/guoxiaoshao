<wxs module="i18n" src="../../i18n/render.wxs" />
<view class="page guide-page">
  <view class="page-heading brand-page-heading"><image class="page-mark brand-page-logo" src="/images/brand/logo-mint-144.png" mode="aspectFit" aria-hidden="true" /><view class="page-title">{{i18n.t(ui,'选购与取货攻略')}}</view></view>

  <view wx:if="{{targetSummary}}" class="card guide-target"><view class="card-title guide-section-title">{{i18n.t(ui,(targetSummary.title))}}</view><view class="small text-2">{{i18n.t(ui,(targetSummary.stores))}}</view><view class="tiny muted mt">{{i18n.t(ui,'请在 Apple 官方渠道核对同一配置和门店；本页不会查询或锁定库存。')}}</view></view>
  <view wx:if="{{focusedFaq}}" class="card guide-focused-help">
    <view class="card-title guide-section-title">{{i18n.t(ui,(focusedFaq.title))}}</view><view class="guide-answer">{{i18n.t(ui,(focusedFaq.text))}}</view>
    <block wx:if="{{allowanceFaq}}"><view class="card-title guide-section-title mt">{{i18n.t(ui,(allowanceFaq.title))}}</view><view class="guide-answer">{{i18n.t(ui,(allowanceFaq.text))}}</view></block>
    <button class="btn btn-primary btn-block mt" hover-class="btn-primary-pressed" bindtap="onReturnTask">{{i18n.t(ui,(returnLabel))}}</button>
  </view>
  <view wx:if="{{section === 'notification' || section === 'monitor' || section === 'faq'}}" class="card guide-reminder-check">
    <view class="card-title guide-section-title">{{i18n.t(ui,'按这三步确认提醒')}}</view>
    <view class="guide-step"><view class="guide-step-number">1</view><view class="guide-step-copy"><view class="guide-step-title">{{i18n.t(ui,'库存有没有及时检查')}}</view><view class="guide-step-text">{{i18n.t(ui,'看门店观测时间；「待更新」不等于无货。')}}</view><button class="ui-action mt" hover-class="ui-control-pressed" bindtap="onCheckFollows">{{i18n.t(ui,'查看关注与库存')}}</button></view></view>
    <view class="guide-step"><view class="guide-step-number">2</view><view class="guide-step-copy"><view class="guide-step-title">{{i18n.t(ui,'消息是否已经发出')}}</view><view class="guide-step-text">{{i18n.t(ui,'核对提醒记录、剩余授权次数与免打扰设置。')}}</view><button class="ui-action mt" hover-class="ui-control-pressed" bindtap="onCheckReminders">{{i18n.t(ui,'查看提醒记录与设置')}}</button></view></view>
    <view class="guide-step"><view class="guide-step-number">3</view><view class="guide-step-copy"><view class="guide-step-title">{{i18n.t(ui,'微信能否正常收信')}}</view><view class="guide-step-text">{{i18n.t(ui,'试收一条测试消息（消耗 1 次查询额度，不查库存）。')}}</view><button class="ui-action mt" hover-class="ui-control-pressed" bindtap="onTestNotification">{{i18n.t(ui,'测试收信')}}</button></view></view>
  </view>

  <!-- 选购四步：步骤条与内容同在一个托盘，切换不离开当前位置。 -->
  <view class="card guide-steps">
    <view class="card-title guide-section-title guide-steps-heading">{{i18n.t(ui,'选购攻略')}}</view>
    <view class="guide-stepper" aria-label="{{i18n.t(ui,'选购阶段')}}">
      <button wx:for="{{stages}}" wx:key="id" class="guide-stepper-item {{stageId === item.id ? 'guide-stepper-item--on' : ''}}" hover-class="guide-stepper-pressed" aria-pressed="{{stageId === item.id}}" data-id="{{item.id}}" bindtap="onSelectStage"><text class="guide-stepper-dot">{{i18n.t(ui,(index + 1))}}</text><text class="guide-stepper-label">{{i18n.t(ui,(item.label))}}</text></button>
    </view>
    <view class="guide-stage-copy"><view class="guide-stage-title">{{i18n.t(ui,(stage.title))}}</view><view class="guide-step-text">{{i18n.t(ui,(stage.note))}}</view></view>
    <view wx:for="{{stage.steps}}" wx:key="title" class="guide-step"><view class="guide-step-number">{{i18n.t(ui,(index + 1))}}</view><view class="guide-step-copy"><view class="guide-step-title">{{i18n.t(ui,(item.title))}}</view><view class="guide-step-text">{{i18n.t(ui,(item.text))}}</view></view></view>
    <block wx:if="{{stage.pickupSteps}}">
      <view class="guide-stage-title guide-pickup-title">{{i18n.t(ui,'下单后如何取货')}}</view>
      <view wx:for="{{stage.pickupSteps}}" wx:key="title" class="guide-step"><view class="guide-step-number">{{i18n.t(ui,(stage.steps.length + index + 1))}}</view><view class="guide-step-copy"><view class="guide-step-title">{{i18n.t(ui,(item.title))}}</view><view class="guide-step-text">{{i18n.t(ui,(item.text))}}</view></view></view>
      <button class="btn btn-primary btn-block mt" hover-class="btn-primary-pressed" bindtap="onReturnTask">{{i18n.t(ui,(returnLabel))}}</button>
    </block>
    <button wx:else class="btn btn-primary btn-block mt" hover-class="btn-primary-pressed" bindtap="onStageAction">{{i18n.t(ui,(stage.actionText))}}</button>
  </view>

  <view class="section-heading"><text class="section-title">{{i18n.t(ui,'常见问题')}}</text></view>
  <view class="card card-list">
    <view class="ui-disclosure-group">
      <view wx:for="{{faqs}}" wx:key="id" wx:if="{{(!focusedFaq || focusedFaq.id !== item.id) && (!allowanceFaq || allowanceFaq.id !== item.id)}}" class="ui-disclosure-group-item"><button class="ui-disclosure" hover-class="ui-control-pressed" aria-expanded="{{faqOpen === item.id}}" data-id="{{item.id}}" bindtap="onToggleFaq"><text class="ui-disclosure-label">{{i18n.t(ui,(item.title))}}</text><view class="ui-chevron {{faqOpen === item.id ? 'ui-chevron--up' : 'ui-chevron--down'}}" aria-hidden="true"></view></button><view wx:if="{{faqOpen === item.id}}" class="guide-answer guide-faq-answer">{{i18n.t(ui,(item.text))}}</view></view>
    </view>
  </view>

  <view class="section-heading"><text class="section-title">{{i18n.t(ui,'还需要帮助')}}</text></view>
  <view class="card card-list">
    <view class="ui-disclosure-group">
      <view class="ui-disclosure-group-item"><button class="ui-disclosure" hover-class="ui-control-pressed" open-type="contact" session-from="gxs_guide"><view class="ui-label-with-icon"><image class="ui-icon" src="/images/ui/support.png" mode="aspectFit" aria-hidden="true" /><text class="ui-disclosure-label">{{i18n.t(ui,'联系客服')}}</text></view><view class="ui-chevron" aria-hidden="true"></view></button></view>
      <view class="ui-disclosure-group-item"><button class="ui-disclosure ui-entry" hover-class="ui-control-pressed" bindtap="onTestNotification"><view class="ui-entry-main"><image class="ui-icon" src="/images/ui/notification.png" mode="aspectFit" aria-hidden="true" /><view class="ui-entry-copy"><text class="ui-disclosure-label">{{i18n.t(ui,'先试收一条测试通知')}}</text><text class="ui-entry-note">{{i18n.t(ui,'主动授权后发送 · 消耗 1 次额度')}}</text></view></view><view class="ui-chevron" aria-hidden="true"></view></button></view>
      <view class="ui-disclosure-group-item"><button class="ui-disclosure" hover-class="ui-control-pressed" bindtap="onGoMine"><view class="ui-label-with-icon"><image class="ui-icon" src="/images/ui/receipt.png" mode="aspectFit" aria-hidden="true" /><text class="ui-disclosure-label">{{i18n.t(ui,'查看会员权益与购买记录')}}</text></view><view class="ui-chevron" aria-hidden="true"></view></button></view>
      <view class="ui-disclosure-group-item"><button class="ui-disclosure ui-entry" hover-class="ui-control-pressed" bindtap="onCopyDiagnostics"><view class="ui-entry-main"><image class="ui-icon" src="/images/ui/info.png" mode="aspectFit" aria-hidden="true" /><view class="ui-entry-copy"><text class="ui-disclosure-label">{{i18n.t(ui,'复制诊断摘要')}}</text><text class="ui-entry-note">{{i18n.t(ui,'仅含版本、平台、固定错误码、页面与时间')}}</text></view></view></button></view>
    </view>
  </view>
  <button wx:if="{{!stage.pickupSteps && !focusedFaq}}" class="btn btn-block" hover-class="ui-control-pressed" bindtap="onReturnTask">{{i18n.t(ui,(returnLabel))}}</button>
</view>
