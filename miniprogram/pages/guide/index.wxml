<view class="page guide-page">
  <view class="page-heading brand-page-heading"><image class="brand-page-logo" src="/images/brand/logo-mint-144.png" mode="aspectFit" aria-hidden="true" /><view class="brand-page-copy"><view class="page-title">选购与取货攻略</view><view class="page-subtitle">从选择配置，到收到提醒后下单。</view></view></view>

  <view wx:if="{{targetSummary}}" class="card guide-target"><view class="small text-2">正在查看的配置</view><view class="guide-section-title mt">{{targetSummary.title}}</view><view class="small text-2 mt">{{targetSummary.stores}}</view><view class="tiny muted mt">请在 Apple 官方渠道核对同一配置和门店；本页不会查询或锁定库存。</view></view>
  <view wx:if="{{focusedFaq}}" class="card guide-focused-help"><view class="guide-section-title">{{focusedFaq.title}}</view><view class="small text-2 mt">{{focusedFaq.text}}</view><button class="btn btn-primary btn-block mt" bindtap="onReturnTask">{{returnLabel}}</button></view>
  <view wx:if="{{section === 'notification' || section === 'monitor' || section === 'faq'}}" class="card guide-reminder-check">
    <view class="guide-section-title">按这三步确认提醒</view>
    <view class="guide-step"><view class="guide-step-number">1</view><view class="guide-step-copy"><view class="guide-step-title">库存有没有及时检查</view><view class="small text-2 mt">看门店观测时间；「待更新」不等于无货。</view><button class="ui-action mt" bindtap="onCheckFollows">查看关注与库存</button></view></view>
    <view class="guide-step"><view class="guide-step-number">2</view><view class="guide-step-copy"><view class="guide-step-title">消息是否已经发出</view><view class="small text-2 mt">核对提醒记录、剩余授权次数与免打扰设置。</view><button class="ui-action mt" bindtap="onCheckReminders">查看提醒记录与设置</button></view></view>
    <view class="guide-step"><view class="guide-step-number">3</view><view class="guide-step-copy"><view class="guide-step-title">微信能否正常收信</view><view class="small text-2 mt">试收一条测试消息（消耗 1 次查询额度，不查库存）。</view><button class="ui-action mt" bindtap="onTestNotification">测试收信</button></view></view>
  </view>

  <!-- 选购四步：步骤条与内容同卡，切换不离开当前位置 -->
  <view class="card guide-steps">
    <view class="guide-section-title guide-steps-heading">选购攻略</view>
    <view class="guide-stepper" aria-label="选购阶段">
      <button wx:for="{{stages}}" wx:key="id" class="guide-stepper-item {{stageId === item.id ? 'guide-stepper-item--on' : ''}}" hover-class="ui-control-pressed" aria-pressed="{{stageId === item.id}}" data-id="{{item.id}}" bindtap="onSelectStage"><text class="guide-stepper-dot">{{index + 1}}</text><text class="guide-stepper-label">{{item.label}}</text></button>
    </view>
    <view class="guide-stage-copy"><view class="guide-section-title">{{stage.title}}</view><view class="small text-2 mt">{{stage.note}}</view></view>
    <view wx:for="{{stage.steps}}" wx:key="title" class="guide-step"><view class="guide-step-number">{{index + 1}}</view><view class="guide-step-copy"><view class="guide-step-title">{{item.title}}</view><view class="small text-2 mt">{{item.text}}</view></view></view>
    <block wx:if="{{section === 'pickup'}}"><view class="guide-section-title">下单后如何取货</view><view wx:for="{{pickupSteps}}" wx:key="title" class="guide-step"><view class="guide-step-number">{{index + 4}}</view><view class="guide-step-copy"><view class="guide-step-title">{{item.title}}</view><view class="small text-2 mt">{{item.text}}</view></view></view><button class="btn btn-primary btn-block" bindtap="onReturnTask">{{returnLabel}}</button></block>
    <button wx:else class="btn btn-primary btn-block" bindtap="onStageAction">{{stage.actionText}}</button>
  </view>

  <view class="card">
    <view class="guide-section-title">常见问题</view>
    <view class="ui-disclosure-group">
      <view wx:for="{{faqs}}" wx:key="id" wx:if="{{!focusedFaq || focusedFaq.id !== item.id}}" class="ui-disclosure-group-item"><button class="ui-disclosure" hover-class="ui-control-pressed" aria-expanded="{{faqOpen === item.id}}" data-id="{{item.id}}" bindtap="onToggleFaq"><text class="ui-disclosure-label">{{item.title}}</text><view class="ui-chevron {{faqOpen === item.id ? 'ui-chevron--up' : 'ui-chevron--down'}}" aria-hidden="true"></view></button><view wx:if="{{faqOpen === item.id}}" class="guide-answer small text-2">{{item.text}}</view></view>
    </view>
  </view>

  <view class="card">
    <view class="guide-section-title">还需要帮助</view>
    <view class="ui-disclosure-group">
      <view class="ui-disclosure-group-item"><button class="ui-disclosure ui-entry" hover-class="ui-control-pressed" open-type="contact" session-from="gxs_guide"><view class="ui-entry-main"><image class="ui-icon" src="/images/ui/support.png" mode="aspectFit" aria-hidden="true" /><view class="ui-entry-copy"><text class="ui-disclosure-label">联系客服</text><text class="ui-entry-note">会员、支付或提醒问题，可在线咨询</text></view></view><view class="ui-chevron" aria-hidden="true"></view></button></view>
      <view class="ui-disclosure-group-item"><button class="ui-disclosure ui-entry" hover-class="ui-control-pressed" bindtap="onTestNotification"><view class="ui-entry-main"><image class="ui-icon" src="/images/ui/notification.png" mode="aspectFit" aria-hidden="true" /><view class="ui-entry-copy"><text class="ui-disclosure-label">先试收一条测试通知</text><text class="ui-entry-note">主动授权后发送 · 消耗 1 次额度</text></view></view><view class="ui-chevron" aria-hidden="true"></view></button></view>
      <view class="ui-disclosure-group-item"><button class="ui-disclosure ui-entry" hover-class="ui-control-pressed" bindtap="onGoMine"><view class="ui-entry-main"><image class="ui-icon" src="/images/ui/receipt.png" mode="aspectFit" aria-hidden="true" /><view class="ui-entry-copy"><text class="ui-disclosure-label">查看会员权益与购买记录</text></view></view><view class="ui-chevron" aria-hidden="true"></view></button></view>
      <view class="ui-disclosure-group-item"><button class="ui-disclosure ui-entry" hover-class="ui-control-pressed" bindtap="onCopyDiagnostics"><view class="ui-entry-copy"><text class="ui-disclosure-label">复制诊断摘要</text><text class="ui-entry-note">仅含版本、平台、固定错误码、页面与时间</text></view><view class="ui-chevron" aria-hidden="true"></view></button></view>
    </view>
  </view>
  <button wx:if="{{section !== 'pickup' && !focusedFaq}}" class="btn btn-outline btn-block" bindtap="onReturnTask">{{returnLabel}}</button>
  <view class="footer-note"><view>果小哨提供库存参考与提醒，购买请在 Apple 官方渠道完成。</view><view>官方取货帮助核对于 {{checkedOn}}。</view></view>
</view>
