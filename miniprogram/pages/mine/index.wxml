<page-meta page-style="{{redemptionOpen ? 'overflow:hidden;' : ''}}" />
<view class="page tab-page mine-page">
  <view wx:if="{{loadError}}" class="card load-error" role="alert">
    <view class="load-error-title">暂时没有连上</view>
    <view class="load-error-detail">{{loadError}}</view>
    <view class="load-error-hint">检查网络后点重试；网络恢复时也会自动重新加载。</view>
    <button class="btn btn-primary btn-block" bindtap="onRetryLoad">重试</button>
  </view>

  <block wx:elif="{{!ready}}">
    <view class="skeleton" aria-busy="true">
      <view class="skeleton-card"><view class="skeleton-line skeleton-title"></view><view class="skeleton-line"></view><view class="skeleton-line skeleton-short"></view><view class="skeleton-bar"></view></view>
      <view class="skeleton-card"><view class="skeleton-line skeleton-title"></view><view class="skeleton-line"></view><view class="skeleton-line skeleton-short"></view></view>
      <view class="loading-line">正在读取账户信息…</view>
    </view>
  </block>

  <block wx:else>
    <view wx:if="{{refreshError}}" class="banner banner-warn">{{refreshError}}</view>
    <!-- 账户名片 -->
    <view class="account-header">
      <image class="account-logo" src="/images/brand/logo-mint-144.png" mode="aspectFit" aria-hidden="true" />
      <view class="account-header-content">
        <view class="account-header-heading">
          <text class="account-brand">果小哨</text>
          <text class="account-status {{membership.active ? 'member-badge' : 'pill pill-muted'}}">{{membership.active ? '会员' : (membership.expired ? '会员已到期' : '免费用户')}}</text>
        </view>
        <button class="ui-action ui-action--neutral identity-copy" hover-class="ui-control-pressed" bindtap="onCopyId" aria-label="复制用户编号"><text class="ui-action-label">用户 {{boot.identity.openidMasked}}</text><text class="identity-copy-label">复制</text></button>
      </view>
    </view>

    <!-- 会员 -->
    <view id="membership-card" class="card membership-card {{membership.active ? 'membership-active' : ''}}">
      <view class="card-title">
        <text>{{membership.active ? '果小哨会员' : (membership.expired ? '会员已到期' : '让小哨持续帮你留意')}}</text>
        <text wx:if="{{membership.active}}" class="member-badge">已开通</text>
      </view>
      <view class="member-overview">
        <view wx:if="{{membership.active}}" class="member-duration"><text class="member-number">{{membership.daysLeft}}</text><text>天剩余</text></view>
        <view wx:else class="member-duration"><text class="member-number">{{boot.priceText}}</text><text>/ {{boot.memberProduct.days}} 天</text></view>
        <view class="member-renewal">{{membership.active ? '到期 ' + membership.expiresText : '单次购买 · 不自动续费'}}</view>
      </view>
      <view class="plan-why">查询不扣次数 · 关注取货变化</view>
      <block wx:if="{{membership.active}}">
        <view class="member-allowance"><text>已关注 {{boot.followCount}} / {{boot.limits.maxFollows}} 个配置</text><text>每配置最多 {{boot.limits.maxStoresPerFollow}} 家门店</text></view>
        <view class="tiny muted mt">续费顺延剩余天数，不自动续费。</view>
      </block>
      <block wx:else>
        <view wx:if="{{membership.expired}}" class="banner banner-warn small">已于 {{membership.expiresText}} 到期，监测与提醒停止；关注配置与次数仍保留。</view>
        <view wx:elif="{{boot.freeReminder}}" class="small text-2 mt">可先到「小哨」免费体验：关注 1 个配置、1 条到货提醒。</view>
      </block>
      <view class="member-authorization">微信提醒需逐次授权；到货、断货次数分别使用。</view>
      <button class="ui-disclosure mt" hover-class="ui-control-pressed" bindtap="onToggleMembershipRules" aria-expanded="{{showMembershipRules}}"><text class="ui-disclosure-label">权益与购买须知</text><view class="ui-disclosure-meta"><text>{{showMembershipRules ? '收起' : '展开'}}</text><view class="ui-chevron {{showMembershipRules ? 'ui-chevron--up' : 'ui-chevron--down'}}" aria-hidden="true"></view></view></button>
      <block wx:if="{{showMembershipRules}}">
        <view class="plan-compare">
          <view class="plan-head">
            <text class="plan-feature">权益</text>
            <text class="plan-col">免费</text>
            <text class="plan-col plan-member">会员</text>
          </view>
          <view class="plan-row">
            <text class="plan-feature">取货查询</text>
            <text class="plan-col">扣次数</text>
            <text class="plan-col plan-member">不限次</text>
          </view>
          <view class="plan-row">
            <text class="plan-feature">补货历史</text>
            <text class="plan-col">扣次数</text>
            <text class="plan-col plan-member">不限次</text>
          </view>
          <view class="plan-row">
            <text class="plan-feature">到货提醒</text>
            <text class="plan-col">体验 1 条</text>
            <text class="plan-col plan-member">关注可提醒</text>
          </view>
          <view class="plan-row">
            <text class="plan-feature">持续关注</text>
            <text class="plan-col">体验 1 个</text>
            <text class="plan-col plan-member">自动监测</text>
          </view>
          <view class="plan-row">
            <text class="plan-feature">新品 30 天</text>
            <text class="plan-col">不可实时查</text>
            <text class="plan-col plan-member">可查</text>
          </view>
        </view>
        <view class="benefit-list mt">
          <view>{{boot.purchaseNotice || '一次性虚拟服务，一经售出不予退款。'}}</view>
          <view>容量/颜色分占关注名额；暂停仍占，删除才释放。</view>
          <view>提醒需微信订阅授权，免打扰时段不发送。</view>
        </view>
      </block>
      <view class="membership-entry-list {{membership.active ? 'membership-entry-secondary' : ''}}">
        <button class="member-entry payment-entry" disabled="{{!boot.paymentReady || redeeming || paymentBusy || paymentChecking || paymentPendingId}}" bindtap="onBuyMembership">{{paymentBusy ? '正在处理支付…' : membership.active ? '续费会员' : '立即开通'}} · {{boot.priceText}}</button>
      </view>
      <view wx:if="{{!boot.paymentReady}}" class="payment-note">{{boot.paymentReason}}</view>
      <view wx:if="{{paymentPendingId || paymentMessage || paymentError}}" class="payment-panel">
        <view wx:if="{{paymentMessage}}" class="payment-status">{{paymentMessage}}</view>
        <view wx:if="{{paymentError}}" class="payment-error">{{paymentError}}</view>
        <view wx:if="{{paymentPendingId}}" class="payment-order-id">订单号：{{paymentPendingId}}</view>
        <view wx:if="{{paymentPendingId}}" class="payment-actions">
          <button class="member-entry payment-check" disabled="{{paymentBusy || paymentChecking || redeeming}}" bindtap="onCheckPayment">{{paymentChecking ? '正在查询支付结果…' : '查询支付结果'}}</button>
          <button wx:if="{{paymentCanRetry && boot.paymentReady}}" class="member-entry payment-check" disabled="{{paymentBusy || paymentChecking || redeeming}}" bindtap="onBuyMembership">继续支付这笔订单</button>
          <button class="member-entry payment-abandon" disabled="{{paymentBusy || paymentChecking || redeeming}}" bindtap="onAbandonPayment">放弃这笔订单</button>
        </view>
        <view wx:if="{{paymentPendingId}}" class="payment-note">订单会为当前账号保留，系统不会自动再次扣款。付款没有完成时，可以放弃这笔订单后重新购买。</view>
      </view>
      <view wx:if="{{redemptionOpen}}" class="redemption-mask" catchtap="onOpenRedemption" catchtouchmove="noop">
        <view class="redemption-modal" catchtap="noop">
          <view class="redemption-title">兑换会员</view>
          <view class="redemption-description">输入你收到的兑换码，为当前微信账号开通会员。</view>
          <input class="redemption-input" type="text" value="{{redemptionCode}}" placeholder="请输入兑换码" placeholder-class="redemption-placeholder" maxlength="64" disabled="{{redeeming}}" confirm-type="done" adjust-position="{{true}}" cursor-spacing="24" bindinput="onRedemptionInput" bindconfirm="onRedeemCode" focus="{{redemptionOpen}}" />
          <button class="member-entry redemption-entry" disabled="{{redeeming || paymentBusy || paymentChecking || !redemptionCode}}" bindtap="onRedeemCode">{{redeeming ? '兑换中，请稍候…' : '确认兑换'}}</button>
          <view class="redemption-hint">同一账号重复提交不会重复增加会员时间。</view>
          <view wx:if="{{redemptionError}}" class="redemption-message redemption-message-error">{{redemptionError}}</view>
          <view wx:if="{{redemptionResult}}" class="redemption-message redemption-message-{{redemptionResult.kind}}"><view class="bold">{{redemptionResult.title}}</view><view class="mt">{{redemptionResult.detail}}</view></view>
          <button class="ui-action ui-action--neutral ui-action--block redemption-close" hover-class="ui-control-pressed" disabled="{{redeeming}}" bindtap="onOpenRedemption">关闭</button>
        </view>
      </view>
      <button class="ui-disclosure mt" hover-class="ui-control-pressed" bindtap="onToggleOrders" aria-expanded="{{showOrders}}"><text class="ui-disclosure-label">会员记录</text><view class="ui-disclosure-meta"><text>{{showOrders ? '收起' : '展开'}}</text><view class="ui-chevron {{showOrders ? 'ui-chevron--up' : 'ui-chevron--down'}}" aria-hidden="true"></view></view></button>
      <block wx:if="{{showOrders}}">
        <view wx:if="{{ordersLoading && !orders.length}}" class="loading-line">正在加载会员记录…</view>
        <view wx:elif="{{ordersError}}" class="record-error"><text>{{ordersError}}</text><button class="ui-action" hover-class="ui-control-pressed" bindtap="onRetryOrders">重试</button></view>
        <view wx:elif="{{!orders.length}}" class="empty small">暂无会员记录</view>
        <view wx:for="{{orders}}" wx:key="orderId" class="row-between ledger-row">
          <view>
            <text class="small">{{item.days}} 天会员 · {{item.sourceLabel}}<text wx:if="{{item.amountText}}"> · {{item.amountText}}</text></text>
            <view class="tiny muted">{{item.timeText}} · {{item.orderId}}</view>
            <view wx:if="{{item.refundText}}" class="tiny muted">{{item.refundText}}</view>
          </view>
          <text class="pill pill-{{item.status === 'fulfilled' ? 'ok' : 'muted'}} tiny">{{item.statusLabel}}</text>
        </view>
      </block>
    </view>

    <!-- 次数 -->
    <view class="card quota-card">
      <view class="card-title">
        <text>查询余额</text>
        <text class="sub">今日已获 {{quota.grantedToday}}/{{quota.dailyGrantCap}} · 上限 {{quota.balanceCap}}</text>
      </view>
      <view class="row-between">
        <view>
          <text class="balance">{{quota.balance}}</text>
          <text class="small muted"> 次可用</text>
          <view class="tiny muted">{{membership.active ? '会员不扣次；余额可留到到期后用' : '查询 ' + quota.queryCost + ' 次 · 历史 ' + quota.historyCost + ' 次'}}</view>
        </view>
        <button class="btn btn-primary btn-sm {{quota.signedInToday || signing ? 'disabled' : ''}}" disabled="{{quota.signedInToday || signing}}" bindtap="onSignin">
          {{signing ? '签到中…' : (quota.signedInToday ? '今日已签到' : '每日签到')}}
        </button>
      </view>
      <view wx:if="{{!membership.active && !quota.signedInToday && quota.balance < quota.queryCost}}" class="banner banner-ok small mt">第一次用？先签到领次数，再去查询页选机型和门店。</view>

      <button class="ui-disclosure mt" hover-class="ui-control-pressed" bindtap="onToggleQuotaDetails" aria-expanded="{{showQuotaDetails}}"><text class="ui-disclosure-label">次数任务与明细</text><view class="ui-disclosure-meta"><text>{{showQuotaDetails ? '收起' : '展开'}}</text><view class="ui-chevron {{showQuotaDetails ? 'ui-chevron--up' : 'ui-chevron--down'}}" aria-hidden="true"></view></view></button>
      <block wx:if="{{showQuotaDetails}}">
      <view class="section-label">每日体验任务</view>
      <view wx:for="{{tasks}}" wx:key="id" class="row-between task">
        <view>
          <text class="small">{{item.title}}</text>
          <text class="tiny muted"> +{{item.reward}} 次</text>
        </view>
        <text wx:if="{{item.done}}" class="pill pill-ok tiny">已完成</text>
        <button wx:else class="ui-action" hover-class="ui-control-pressed" bindtap="onGoHistory"><text class="ui-action-label">{{item.pendingLabel || '去完成'}}</text><view class="ui-chevron" aria-hidden="true"></view></button>
      </view>

      <button class="ui-disclosure mt" hover-class="ui-control-pressed" bindtap="onToggleLedger" aria-expanded="{{showLedger}}"><text class="ui-disclosure-label">次数明细</text><view class="ui-disclosure-meta"><text>{{showLedger ? '收起' : '展开'}}</text><view class="ui-chevron {{showLedger ? 'ui-chevron--up' : 'ui-chevron--down'}}" aria-hidden="true"></view></view></button>
      <block wx:if="{{showLedger}}">
        <view wx:if="{{!ledger.length}}" class="empty small">暂无记录</view>
        <view wx:for="{{ledger}}" wx:key="id" class="row-between ledger-row">
          <view>
            <text class="small">{{item.label}}</text>
            <view class="tiny muted">{{item.timeText}}</view>
          </view>
          <text class="bold {{item.delta > 0 ? 'plus' : 'minus'}}">{{item.deltaText}}</text>
        </view>
      </block>
      </block>
    </view>

    <!-- 提醒设置 -->
    <view id="reminder-settings" class="card">
      <view class="card-title">
        <view class="whistle-section-title"><image class="section-whistle" src="/images/brand/whistle-green.png" mode="aspectFit" aria-hidden="true" /><text>小哨提醒</text></view>
        <view class="pill pill-dot pill-{{boot.collector.cls}} tiny">{{boot.collector.label}}</view>
      </view>
      <button class="ui-disclosure mt" hover-class="ui-control-pressed" bindtap="onToggleReminderSettings" aria-expanded="{{showReminderSettings}}"><text class="ui-disclosure-label">通知与免打扰</text><view class="ui-disclosure-meta"><text>{{showReminderSettings ? '收起' : '展开'}}</text><view class="ui-chevron {{showReminderSettings ? 'ui-chevron--up' : 'ui-chevron--down'}}" aria-hidden="true"></view></view></button>
      <block wx:if="{{showReminderSettings}}">
      <view class="field">
        <text class="label">接收补货提醒</text>
        <switch checked="{{settings.notifyEnabled}}" disabled="{{savingSettings}}" color="#00C375" bindchange="onNotifyToggle" />
      </view>
      <view class="field">
        <text class="label">免打扰时段</text>
        <switch checked="{{settings.dnd.enabled}}" disabled="{{savingSettings}}" color="#00C375" bindchange="onDndToggle" />
      </view>
      <block wx:if="{{settings.dnd.enabled}}">
        <picker mode="time" value="{{dndStart}}" disabled="{{savingSettings}}" bindchange="onDndStart">
          <view class="field"><text class="label">开始</text><view class="row"><text class="value">{{dndStart}}</text><view class="ui-chevron" aria-hidden="true"></view></view></view>
        </picker>
        <picker mode="time" value="{{dndEnd}}" disabled="{{savingSettings}}" bindchange="onDndEnd">
          <view class="field"><text class="label">结束</text><view class="row"><text class="value">{{dndEnd}}</text><view class="ui-chevron" aria-hidden="true"></view></view></view>
        </picker>
      </block>
      <view class="tiny muted mt">免打扰时不推送，监测与历史继续。起止相同＝全天。</view>
      </block>
    </view>

    <!-- 个人提醒记录；与共享库存历史分开管理 -->
    <view class="card notification-card">
      <view class="notification-heading">
        <view class="notification-heading-copy"><view class="notification-heading-title whistle-section-title"><image class="section-whistle" src="/images/brand/whistle-green.png" mode="aspectFit" aria-hidden="true" /><text>小哨提醒记录</text></view><view class="tiny muted">{{notifications.length ? '已显示 ' + notifications.length + ' 条' : '个人提醒记录'}}</view></view>
        <button wx:if="{{showNotifications && notifications.length}}" class="ui-action ui-action--neutral notification-button notification-clear" hover-class="ui-control-pressed" disabled="{{notificationActionBusy || notificationConfirming || !notificationsClearBefore}}" bindtap="onClearNotifications">{{notificationActionBusy === 'clear' ? '清空中…' : '清空'}}</button>
      </view>
      <button class="ui-disclosure mt" hover-class="ui-control-pressed" bindtap="onToggleNotifications" aria-expanded="{{showNotifications}}"><text class="ui-disclosure-label">查看记录</text><view class="ui-disclosure-meta"><text>{{showNotifications ? '收起' : '展开'}}</text><view class="ui-chevron {{showNotifications ? 'ui-chevron--up' : 'ui-chevron--down'}}" aria-hidden="true"></view></view></button>
      <block wx:if="{{showNotifications}}">
      <view class="tiny muted notification-scope">提醒记录保留最近 10 天。删除和清空只影响本列表，不取消关注、不撤回微信消息、不删库存历史。</view>
      <view wx:if="{{notificationsLoading && !notifications.length}}" class="loading-line">正在加载提醒记录…</view>
      <view wx:elif="{{notificationsLoading}}" class="loading-line">正在更新提醒记录…</view>
      <view wx:if="{{notificationsError}}" class="record-error"><text>{{notificationsError}}</text><button class="ui-action notification-button notification-retry" hover-class="ui-control-pressed" disabled="{{notificationsLoading || notificationActionBusy || notificationConfirming}}" bindtap="onRetryNotifications">重试加载</button></view>
      <view wx:if="{{notificationsActionError}}" class="record-error"><text>{{notificationsActionError}}</text><button class="ui-action notification-button notification-retry" hover-class="ui-control-pressed" disabled="{{notificationActionBusy || notificationConfirming}}" bindtap="onRetryNotificationAction">重试操作</button></view>
      <view wx:if="{{!notificationsLoading && !notificationsError && !notificationsActionError && !notifications.length}}" class="empty small"><image class="record-empty-whistle" src="/images/brand/whistle-green.png" mode="aspectFit" aria-hidden="true" /><view>小哨还没有提醒记录</view></view>
      <view wx:for="{{notifications}}" wx:key="id" class="notification-item">
        <view class="notification-product">{{item.productTitle || item.partNumber}}</view>
        <view class="notification-meta"><text class="pill pill-{{item.statusCls}} tiny">{{item.statusLabel}}</text><text class="tiny muted">{{item.timeText}}</text></view>
        <view class="notification-detail">{{item.storeName || item.storeNumber}} · {{item.eventLabel}}</view>
        <view wx:if="{{item.reasonText}}" class="notification-reason">{{item.reasonText}}</view>
        <view class="notification-actions"><button wx:if="{{item.action}}" class="ui-action notification-button notification-retry" hover-class="ui-control-pressed" data-id="{{item.id}}" disabled="{{notificationActionBusy || notificationConfirming}}" bindtap="onNotificationAction">{{item.actionLabel}}</button><button class="ui-action ui-action--neutral notification-button notification-delete" hover-class="ui-control-pressed" data-id="{{item.id}}" disabled="{{notificationActionBusy || notificationConfirming}}" bindtap="onDeleteNotification">{{notificationDeletingId === item.id ? '删除中…' : '删除记录'}}</button></view>
      </view>
      <view wx:if="{{notificationsMoreError}}" class="record-error"><text>{{notificationsMoreError}}</text><button class="ui-action notification-button notification-retry" hover-class="ui-control-pressed" disabled="{{notificationsLoadingMore || notificationsLoading || notificationActionBusy || notificationConfirming}}" bindtap="onLoadMoreNotifications">重试加载</button></view>
      <button wx:elif="{{notificationsHasMore}}" class="ui-action ui-action--block notification-button notification-more" hover-class="ui-control-pressed" disabled="{{notificationsLoadingMore || notificationsLoading || notificationActionBusy || notificationConfirming}}" bindtap="onLoadMoreNotifications">{{notificationsLoadingMore ? '正在加载…' : '加载更早提醒'}}</button>
      <view wx:elif="{{notifications.length && notificationsPaginationKnown && !notificationsLoading && !notificationsError}}" class="tiny muted notification-end">已显示全部提醒记录</view>
      </block>
    </view>

    <!-- 其他 -->
    <view class="card">
      <button class="ui-disclosure account-link" hover-class="ui-control-pressed" bindtap="onToggleReleaseNotes" aria-expanded="{{showReleaseNotes}}"><text class="ui-disclosure-label">更新公告</text><view class="ui-disclosure-meta"><text>{{showReleaseNotes ? '收起' : '查看'}}</text><view class="ui-chevron {{showReleaseNotes ? 'ui-chevron--up' : 'ui-chevron--down'}}" aria-hidden="true"></view></view></button>
      <view wx:if="{{showReleaseNotes}}" class="release-notes">
        <view wx:for="{{releaseNotes}}" wx:key="version" class="release-note">
          <view class="release-note-heading"><text class="release-note-version">v{{item.version}}</text><text wx:if="{{item.version === version}}" class="pill pill-ok release-note-current">当前版本</text></view>
          <view class="release-note-title">{{item.title}}</view>
          <view wx:if="{{item.dateText}}" class="release-note-date">{{item.dateText}}</view>
          <view wx:for="{{item.highlights}}" wx:for-item="highlight" wx:key="*this" class="release-note-highlight"><view class="release-note-dot" aria-hidden="true"></view><text>{{highlight}}</text></view>
          <view wx:if="{{item.note}}" class="release-note-caption">{{item.note}}</view>
        </view>
      </view>
      <button class="ui-disclosure account-link" hover-class="ui-control-pressed" bindtap="onOpenRedemption"><text class="ui-disclosure-label">兑换码开通</text><view class="ui-chevron" aria-hidden="true"></view></button>
      <button class="ui-disclosure account-link" hover-class="ui-control-pressed" bindtap="onHelp"><text class="ui-disclosure-label">使用说明</text><view class="ui-chevron" aria-hidden="true"></view></button>
      <button class="ui-disclosure account-link" hover-class="ui-control-pressed" bindtap="onPrivacy"><text class="ui-disclosure-label">隐私说明</text><view class="ui-chevron" aria-hidden="true"></view></button>
      <button class="ui-disclosure account-link" hover-class="ui-control-pressed" bindtap="onDisclaimer"><text class="ui-disclosure-label">免责声明</text><view class="ui-chevron" aria-hidden="true"></view></button>
      <button class="ui-disclosure account-link feedback" open-type="feedback" hover-class="ui-control-pressed"><text class="ui-disclosure-label">意见反馈</text><view class="ui-chevron" aria-hidden="true"></view></button>
    </view>

    <view class="footer-note">果小哨 {{versionLabel}} · 为心仪好物留个哨</view>
  </block>
</view>
