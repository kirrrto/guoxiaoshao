<wxs module="i18n" src="../../i18n/render.wxs" />
<page-meta page-style="color-scheme:{{_themeMode || 'light'}};{{(redemptionOpen || authorizationOpen) ? 'overflow:hidden;' : ''}}" />
<view class="page tab-page mine-page">
  <picker class="mine-language" mode="selector" range="{{uiLanguage === 'en' ? englishLanguageLabels : languageLabels}}" value="{{uiLanguagePreference === 'en' ? 2 : (uiLanguagePreference === 'zh-CN' ? 1 : 0)}}" bindchange="onLanguageChoice" aria-label="{{i18n.t(ui,'语言 / Language')}}">
    <view class="ui-action ui-action--plain"><text>{{i18n.t(ui,'语言 / Language')}}</text><view class="ui-chevron" aria-hidden="true"></view></view>
  </picker>
  <view wx:if="{{networkOffline}}" class="network-notice" aria-role="status">{{i18n.t(ui,'网络已断开，恢复后自动刷新')}}</view>
  <view wx:if="{{loadError}}" class="card load-error" aria-role="alert">
    <view class="load-error-title">{{i18n.t(ui,'暂时没有连上')}}</view>
    <view class="load-error-detail">{{i18n.t(ui,(loadError))}}</view>
    <button class="btn btn-primary btn-block" bindtap="onRetryLoad">{{i18n.t(ui,'重试')}}</button>
  </view>

  <block wx:elif="{{!ready}}">
    <view class="skeleton" aria-busy="true">
      <view class="skeleton-card"><view class="skeleton-line skeleton-title"></view><view class="skeleton-line"></view><view class="skeleton-line skeleton-short"></view><view class="skeleton-bar"></view></view>
      <view class="skeleton-card"><view class="skeleton-line skeleton-title"></view><view class="skeleton-line"></view><view class="skeleton-line skeleton-short"></view></view>
      <view class="loading-line">{{i18n.t(ui,'正在读取账户信息…')}}</view>
    </view>
  </block>

  <block wx:else>
    <view wx:if="{{refreshError}}" class="banner banner-warn">{{i18n.t(ui,(refreshError))}}</view>

    <!-- 账户与会员：身份一行，会员卡一张，套餐选择只在开通或续费时出现。 -->
    <view id="membership-card" class="membership-card {{membership.active ? (membership.planId === 'member_365d' ? 'membership-annual' : 'membership-active') : ''}} {{contextualCheckout && checkoutTarget && !membership.active ? 'membership-contextual' : ''}}">
      <view wx:if="{{!contextualCheckout || !checkoutTarget || membership.active}}" class="account-header">
        <view class="account-logo {{membership.active ? 'account-logo-member' : ''}}">
          <image wx:if="{{membership.active}}" class="member-pass-brand" src="/images/brand/logo-member-black-gold-96.png" mode="aspectFit" aria-label="{{i18n.t(ui,'果小哨会员标志')}}" />
          <image wx:else src="/images/brand/logo-mint-144.png" mode="aspectFit" aria-hidden="true" />
        </view>
        <view class="account-header-content">
          <view class="account-title account-status account-status-{{membership.active ? 'member' : (membership.expired ? 'expired' : 'free')}}">{{i18n.t(ui,(membership.active ? (membership.planLabel !== '会员' ? membership.planLabel : '会员已开通') : (membership.expired ? '会员已到期' : '免费用户')))}}</view>
          <button class="ui-action ui-action--plain identity-copy" hover-class="ui-control-pressed" bindtap="onCopyId" aria-label="{{i18n.t(ui,'复制用户编号')}}"><text class="ui-action-label">{{i18n.m(ui,'用户 {0}',[(boot.identity.openidMasked)])}}</text><text class="identity-copy-label">{{i18n.t(ui,'复制')}}</text></button>
        </view>
      </view>
      <view wx:if="{{!membership.active && contextualCheckout && checkoutTarget}}" class="page-heading member-card-title">
        <view class="page-title member-card-heading">{{i18n.t(ui,'为这款持续留意')}}</view>
      </view>

      <view wx:if="{{contextualCheckout && (checkoutTarget || checkoutMessage || checkoutLoading)}}" class="card checkout-context" aria-live="polite">
        <view wx:if="{{membership.active}}" class="card-title">{{i18n.t(ui,'继续完成关注设置')}}</view>
        <view wx:if="{{checkoutLoading}}" class="small muted">{{i18n.t(ui,'正在确认所选配置…')}}</view>
        <block wx:elif="{{checkoutTarget}}">
          <view class="checkout-target">
            <view wx:if="{{checkoutTarget.imageDisplayUrl}}" class="product-tile checkout-image"><image src="{{checkoutTarget.imageDisplayUrl}}" webp="{{true}}" mode="aspectFit" aria-hidden="true" binderror="onCheckoutImageError" /></view>
            <view class="checkout-target-copy"><view class="checkout-target-title">{{i18n.t(ui,(checkoutTarget.title))}}</view><view class="checkout-stores">{{i18n.t(ui,(checkoutTarget.storeText))}}</view></view>
          </view>
          <button wx:if="{{membership.active}}" class="btn btn-primary btn-block mt" disabled="{{paymentBusy || paymentChecking || paymentConfirming}}" bindtap="onContinueCheckout">{{i18n.t(ui,membership.isTester ? '继续设置关注' : '会员已生效 · 继续设置关注')}}</button>
        </block>
        <view wx:if="{{checkoutMessage}}" class="checkout-problem">{{i18n.t(ui,(checkoutMessage))}}</view>
        <button wx:if="{{checkoutMessage || membership.active}}" class="btn btn-block mt" hover-class="ui-control-pressed" disabled="{{paymentBusy || paymentConfirming}}" bindtap="onReturnToQuery">{{i18n.t(ui,(checkoutMessage ? '重新确认配置与门店' : '返回查询'))}}</button>
      </view>

      <view wx:if="{{!membership.active && membership.expired}}" class="member-expired-note">{{i18n.m(ui,'已于 {0} 到期，监测与提醒停止；关注配置与次数仍保留。',[(membership.expiresText)])}}</view>

      <!-- 会员卡：未开通时是权益，已开通时是有效期与实际名额。 -->
      <view wx:if="{{membership.active}}" class="member-pass">
        <image class="member-pass-watermark" src="/images/brand/whistle-pass.png" mode="aspectFit" aria-hidden="true" />
        <view wx:if="{{membership.isTester}}" class="member-overview"><text class="member-renewal">{{i18n.t(ui,'库存查询不扣次数')}}</text></view>
        <view wx:elif="{{membership.expiresShortText || membership.daysLeft != null}}" class="member-overview">
          <text wx:if="{{membership.daysLeft != null}}" class="member-renewal">{{i18n.m(ui,'剩余 {0} 天',[(membership.daysLeft)])}}</text>
          <view wx:if="{{membership.expiresShortText}}" class="member-validity"><text class="member-validity-label">{{i18n.t(ui,'有效期至')}} </text><text class="member-validity-date">{{i18n.t(ui,(membership.expiresShortText))}}</text></view>
        </view>
        <view class="member-delivery-grid" aria-label="{{i18n.t(ui,'当前会员实际权益')}}">
          <button class="member-delivery-cell member-delivery-link" hover-class="member-delivery-pressed" disabled="{{paymentBusy || paymentChecking || paymentConfirming}}" bindtap="onOpenFollows" aria-label="{{i18n.t(ui,('已保存关注 ' + boot.followCount + ' / ' + boot.limits.maxFollows + ' 个配置，查看关注'))}}">
            <text class="member-delivery-label">{{i18n.t(ui,'已保存关注')}}</text>
            <view class="member-delivery-value">{{i18n.t(ui,(boot.followCount))}}<text class="member-delivery-total"> {{i18n.m(ui,'/ {0} 个配置',[(boot.limits.maxFollows)])}}</text><view class="ui-chevron" aria-hidden="true"></view></view>
          </button>
          <view class="member-delivery-cell">
            <text class="member-delivery-label">{{i18n.t(ui,'每个配置')}}</text>
            <view class="member-delivery-value">{{i18n.t(ui,(boot.limits.maxStoresPerFollow))}}<text class="member-delivery-total"> {{i18n.t(ui,'家门店')}}</text></view>
          </view>
        </view>
        <view wx:if="{{membership.annualExpiresText}}" class="member-enhanced">{{i18n.m(ui,'年卡 5 配置 × 5 门店权益至 {0}',[(membership.annualExpiresText)])}}</view>
        <view wx:elif="{{membership.enhancedExpiresText}}" class="member-enhanced">{{i18n.m(ui,'额外名额有效至 {0}',[(membership.enhancedExpiresText)])}}</view>
        <button wx:if="{{membership.enhanced}}" class="ui-action ui-action--plain member-regional-link" hover-class="member-delivery-pressed" disabled="{{paymentBusy || paymentChecking || paymentConfirming}}" bindtap="onOpenRegionalWatches"><text class="ui-action-label">{{i18n.t(ui,'查询或关注日本、台湾、香港和美国门店')}}</text><view class="ui-chevron" aria-hidden="true"></view></button>
      </view>
      <view wx:elif="{{!paymentPendingId && (!contextualCheckout || !checkoutTarget)}}" class="member-pass member-vip-offer">
        <image class="member-pass-watermark" src="/images/brand/whistle-pass.png" mode="aspectFit" aria-hidden="true" />
        <view class="member-pass-title member-card-heading">{{i18n.t(ui,'果小哨会员')}}</view>
        <view class="member-pass-benefits" aria-label="{{i18n.t(ui,'会员核心权益')}}">
          <view class="member-pass-benefit"><view class="ui-check" aria-hidden="true"></view><text>{{i18n.t(ui,'库存查询不扣次数')}}</text></view>
          <view class="member-pass-benefit"><view class="ui-check" aria-hidden="true"></view><text>{{i18n.t(ui,'可授权接收取货变化提醒')}}</text></view>
          <view class="member-pass-benefit"><view class="ui-check" aria-hidden="true"></view><text>{{i18n.t(ui,'新品开售 30 天内实时查询')}}</text></view>
        </view>
        <button wx:if="{{showPurchaseShop && !membershipUpgradeOpen}}" class="btn btn-primary btn-block member-vip-cta" hover-class="btn-primary-pressed" disabled="{{subscribing || paymentBusy || paymentChecking || paymentConfirming || redeeming}}" bindtap="onOpenMembershipRenew">{{i18n.t(ui,'开通会员')}}</button>
      </view>
      <view wx:elif="{{!paymentPendingId}}" class="checkout-core-benefits">{{i18n.t(ui,'会员库存查询不扣次。保存关注并授权后，提醒服务可用时会发送取货变化消息。')}}</view>

      <button wx:if="{{membership.active && !boot.followCount}}" class="btn btn-primary btn-block member-delivery-action" hover-class="btn-primary-pressed" disabled="{{paymentBusy || paymentChecking || paymentConfirming}}" bindtap="onOpenFollows">{{i18n.t(ui,'添加第一个关注')}}</button>
      <view wx:if="{{showPurchaseShop && membership.active && !membershipUpgradeOpen && !paymentPendingId}}" class="membership-member-actions">
        <button class="btn membership-manage" hover-class="ui-control-pressed" disabled="{{subscribing || redeeming || paymentBusy || paymentChecking || paymentConfirming}}" bindtap="onOpenMembershipRenew">{{i18n.t(ui,'延长会员')}}</button>
        <button class="btn membership-manage" hover-class="ui-control-pressed" disabled="{{subscribing || redeeming || paymentBusy || paymentChecking || paymentConfirming}}" bindtap="onOpenMembershipUpgrade">{{i18n.t(ui,'升级套餐')}}</button>
      </view>
      <button wx:if="{{showPurchaseShop && !membership.active && !membershipUpgradeOpen && !paymentPendingId && (contextualCheckout && checkoutTarget)}}" class="btn btn-primary btn-block mt" hover-class="btn-primary-pressed" disabled="{{subscribing || paymentBusy || paymentChecking || paymentConfirming || redeeming}}" bindtap="onOpenMembershipRenew">{{i18n.t(ui,'开通会员')}}</button>
      <view wx:if="{{!showPurchaseShop && !membership.isTester && !paymentPendingId}}" class="payment-note purchase-unavailable-note">{{i18n.t(ui,(purchaseUnavailableNote))}}</view>

      <view wx:if="{{showPurchaseShop && !paymentPendingId && membershipUpgradeOpen}}" id="membership-offer" class="membership-shop">
        <view class="section-heading membership-shop-heading">
          <text class="section-title membership-shop-title">{{i18n.t(ui,(membership.active ? (purchaseMode === 'upgrade' ? '升级套餐' : '延长会员') : '选择套餐'))}}</text>
          <button wx:if="{{membershipUpgradeOpen && !paymentPendingId}}" class="ui-action ui-action--plain membership-shop-close" hover-class="ui-control-pressed" disabled="{{subscribing || redeeming || paymentBusy || paymentChecking || paymentConfirming}}" bindtap="onCloseMembershipUpgrade">{{i18n.t(ui,'收起')}}</button>
        </view>
        <view wx:if="{{membership.active && purchaseMode === 'upgrade' && !displayMemberProducts.length}}" class="card membership-upgrade-empty">
          <view class="small text-2">{{i18n.t(ui,(membershipUpgradeEmptyText))}}</view>
          <button class="btn btn-primary btn-block mt" hover-class="btn-primary-pressed" disabled="{{subscribing || redeeming || paymentBusy || paymentChecking || paymentConfirming}}" bindtap="onOpenMembershipRenew">{{i18n.t(ui,'延长会员')}}</button>
        </view>
        <block wx:if="{{displayMemberProducts.length}}">
          <view class="membership-packages {{contextualCheckout && !membership.active ? 'membership-packages-context' : ''}}" aria-label="{{i18n.t(ui,'选择会员套餐')}}">
            <button wx:for="{{displayMemberProducts}}" wx:key="planId" class="membership-package {{selectedPlanId === item.planId ? 'membership-package-selected' : ''}}" hover-class="membership-package-pressed" data-plan-id="{{item.planId}}" disabled="{{subscribing || redeeming || paymentBusy || paymentChecking || paymentPendingId || paymentConfirming}}" bindtap="onSelectMemberProduct" aria-label="{{i18n.t(ui,item.nameText)}} · {{i18n.t(ui,item.durationText)}} · {{i18n.t(ui,item.benefitShort)}} · {{i18n.t(ui,item.watchScope)}} · {{item.standardPriceText ? i18n.m(ui,'优惠价{0}，标准价{1}',[item.priceText,item.standardPriceText]) : item.priceText}}{{selectedPlanId === item.planId ? i18n.t(ui,'，已选') : ''}}">
              <view class="membership-package-radio" aria-hidden="true"><view class="ui-check"></view></view>
              <view class="membership-package-heading">
                <view class="membership-package-name-line"><text class="membership-package-name">{{i18n.t(ui,(item.nameText))}}</text><text class="membership-package-duration">{{i18n.t(ui,(item.durationText))}}</text><text wx:if="{{item.recommendedText}}" class="membership-recommended-tag">{{i18n.t(ui,(item.recommendedText))}}</text></view>
                <text class="membership-package-benefit">{{i18n.t(ui,(item.benefitShort))}}</text>
              </view>
              <view class="membership-package-pricing">
                <text class="membership-package-price">{{i18n.t(ui,(item.priceText))}}</text>
                <view class="membership-package-price-note"><text wx:if="{{item.standardPriceText}}" class="membership-standard-price">{{i18n.t(ui,(item.standardPriceText))}}</text><text wx:if="{{item.dailyPriceText}}" class="membership-daily-price">{{i18n.t(ui,(item.dailyPriceText))}}</text></view>
              </view>
              <text class="membership-package-benefit membership-package-scope">{{i18n.t(ui,item.watchScope)}}</text>
            </button>
          </view>
          <view class="small text-2 mt">{{i18n.t(ui,'各站点共用关注名额。其他站点开放监测后，系统会自动检查已关注的配置，微信到货提醒需另行授权。')}}</view>
          <view wx:if="{{membership.active && membershipUpgradePreview}}" class="membership-extension">
            <text class="membership-extension-detail">{{i18n.t(ui,(membershipUpgradePreview.extensionText))}}</text>
            <text wx:if="{{membershipUpgradePreview.expiresAtText}}" class="membership-extension-date">{{i18n.m(ui,'预计到期 {0}',[(membershipUpgradePreview.expiresAtText)])}}</text>
            <text wx:if="{{purchaseMode === 'upgrade'}}" class="membership-extension-note">{{i18n.t(ui,'按所选套餐全价购买，不抵扣差价。')}}</text>
          </view>
          <button class="btn btn-primary btn-block member-entry payment-entry" hover-class="btn-primary-pressed" disabled="{{subscribing || !boot.paymentReady || redeeming || paymentBusy || paymentChecking || paymentPendingId || paymentConfirming || (!membership.active && (checkoutLoading || checkoutMessage))}}" bindtap="onBuyMembership">{{i18n.m(ui,'{0} · {1}',[(paymentBusy ? '请稍候…' : membership.active ? (purchaseMode === 'upgrade' ? '确认购买' : '确认续费') : contextualCheckout ? '确认购买 ' + boot.memberProduct.days + ' 天会员' : '立即开通'),(boot.priceText)])}}</button>
          <view class="checkout-terms"><text class="checkout-term">{{i18n.t(ui,'虚拟服务一经售出不予退款；')}}</text><text class="checkout-term">{{i18n.t(ui,'不自动续费，付款确认后生效。')}}</text></view>
          <button class="ui-action ui-action--plain checkout-terms-link" hover-class="ui-control-pressed" bindtap="onMembershipHelp"><text class="ui-action-label">{{i18n.t(ui,'名额与续费常见问题')}}</text><view class="ui-chevron" aria-hidden="true"></view></button>
        </block>
        <button wx:if="{{contextualCheckout}}" class="btn btn-text btn-block checkout-secondary" hover-class="ui-control-pressed" disabled="{{paymentBusy || paymentConfirming}}" bindtap="onReturnToQuery">{{i18n.t(ui,'暂不购买 · 返回查询')}}</button>
        <view wx:if="{{contextualCheckout && boot.features.growthEvents && !membership.active}}" class="card card-list checkout-feedback-card">
          <button class="ui-disclosure" hover-class="ui-control-pressed" bindtap="onTogglePurchaseFeedback" aria-expanded="{{showPurchaseFeedback}}"><text class="ui-disclosure-label">{{i18n.t(ui,'购买反馈')}}</text><view class="ui-chevron {{showPurchaseFeedback ? 'ui-chevron--up' : 'ui-chevron--down'}}" aria-hidden="true"></view></button>
          <view wx:if="{{showPurchaseFeedback}}" class="checkout-feedback">
            <view wx:if="{{purchaseFeedbackSent}}" class="small text-2">{{i18n.t(ui,'已收到反馈')}}</view>
            <block wx:else><button wx:for="{{purchaseFeedbackOptions}}" wx:key="code" class="ui-action" hover-class="ui-control-pressed" data-code="{{item.code}}" bindtap="onPurchaseFeedback">{{i18n.t(ui,(item.label))}}</button></block>
          </view>
        </view>
      </view>

      <view wx:if="{{paymentPendingId || paymentMessage || paymentError}}" class="card payment-panel">
        <view wx:if="{{paymentPendingId}}" class="card-title payment-recovery-title">{{i18n.t(ui,'继续处理原订单')}}</view>
        <view wx:if="{{paymentPendingId && paymentOrderSummary}}" class="payment-status bold">{{i18n.t(ui,(paymentOrderSummary))}}</view>
        <view wx:if="{{paymentMessage}}" class="payment-status">{{i18n.t(ui,(paymentMessage))}}</view>
        <view wx:if="{{paymentError}}" class="payment-error">{{i18n.t(ui,(paymentError))}}</view>
        <view wx:if="{{paymentPendingId}}" class="payment-order-id">{{i18n.m(ui,'订单号：{0}',[(paymentPendingId)])}}</view>
        <view wx:if="{{paymentPendingId}}" class="payment-actions">
          <button class="btn btn-block member-entry payment-check {{!paymentCanRetry ? 'btn-primary payment-recovery-primary' : ''}}" disabled="{{subscribing || paymentBusy || paymentChecking || redeeming || paymentConfirming}}" bindtap="onCheckPayment">{{i18n.t(ui,(paymentChecking ? '正在查询支付结果…' : '查询支付结果'))}}</button>
          <button class="btn btn-block member-entry payment-check {{paymentCanRetry ? 'btn-primary payment-recovery-primary' : ''}}" disabled="{{subscribing || paymentBusy || paymentChecking || redeeming || paymentConfirming}}" bindtap="onBuyMembership">{{i18n.t(ui,'继续支付这笔订单')}}</button>
          <button class="btn btn-text btn-block member-entry payment-abandon" disabled="{{subscribing || paymentBusy || paymentChecking || redeeming || paymentConfirming}}" bindtap="onAbandonPayment">{{i18n.t(ui,'放弃这笔订单')}}</button>
        </view>
        <view wx:if="{{paymentPendingId}}" class="payment-note">{{i18n.t(ui,'系统不会自动再次扣款。放弃前会核对付款结果。')}}</view>
        <view wx:if="{{paymentPendingId || paymentError}}" class="payment-support"><button class="ui-action payment-support-button" open-type="contact" session-from="gxs_payment" hover-class="ui-control-pressed">{{i18n.t(ui,'联系客服')}}</button></view>
      </view>
      <button wx:if="{{contextualCheckout && checkoutTarget && !membership.active}}" class="ui-action ui-action--plain identity-copy checkout-identity" hover-class="ui-control-pressed" bindtap="onCopyId" aria-label="{{i18n.t(ui,'复制用户编号')}}"><text class="ui-action-label">{{i18n.m(ui,'当前账户 {0}',[(boot.identity.openidMasked)])}}</text><text class="identity-copy-label">{{i18n.t(ui,'复制')}}</text></button>

      <view wx:if="{{redemptionOpen}}" class="redemption-mask ui-scrim-enter" catchtap="onOpenRedemption" catchtouchmove="noop">
        <view class="redemption-modal ui-dialog-enter" catchtap="noop" aria-role="dialog" aria-modal="true" aria-label="{{i18n.t(ui,'兑换会员')}}">
          <view class="redemption-title">{{i18n.t(ui,'兑换会员')}}</view>
          <input class="redemption-input" type="text" value="{{redemptionCode}}" aria-label="{{i18n.t(ui,'会员兑换码')}}" placeholder="{{i18n.t(ui,'请输入兑换码')}}" placeholder-class="redemption-placeholder" maxlength="64" disabled="{{redeeming}}" confirm-type="done" adjust-position="{{true}}" cursor-spacing="24" bindinput="onRedemptionInput" bindconfirm="onRedeemCode" focus="{{redemptionOpen}}" />
          <button class="btn btn-primary btn-block member-entry redemption-entry" disabled="{{subscribing || redeeming || paymentBusy || paymentChecking || !redemptionCode}}" bindtap="onRedeemCode">{{i18n.t(ui,(redeeming ? '兑换中，请稍候…' : '确认兑换'))}}</button>
          <view wx:if="{{redemptionError}}" class="redemption-message redemption-message-error" aria-role="alert">{{i18n.t(ui,(redemptionError))}}</view>
          <view wx:if="{{redemptionResult}}" class="redemption-message redemption-message-{{redemptionResult.kind}}" aria-live="polite"><view class="bold">{{i18n.t(ui,(redemptionResult.title))}}</view><view class="mt">{{i18n.t(ui,(redemptionResult.detail))}}</view></view>
          <button class="btn btn-text btn-block redemption-close" hover-class="ui-control-pressed" disabled="{{subscribing || redeeming}}" bindtap="onOpenRedemption">{{i18n.t(ui,'关闭')}}</button>
        </view>
      </view>
    </view>

    <!-- 微信提醒：授权次数、通知设置与个人提醒记录。 -->
    <view id="reminder-center" class="card card-rows-end reminder-card">
      <view class="mine-reminder-heading">
        <view class="mine-reminder-summary">
          <view class="card-title">{{i18n.t(ui,'微信提醒')}}</view>
          <view class="mine-reminder-status">{{i18n.t(ui,(reminderCenterStatus))}}</view>
          <view wx:if="{{boot.member && subscription.templateCount}}" class="mine-reminder-balance">{{i18n.m(ui,'到货 {0} 次{1}',[(subscription.credits),(authorization.pendingRestock ? '（待同步 +' + authorization.pendingRestock + '）' : '')])}}<text wx:if="{{subscription.soldoutEnabled}}"> {{i18n.m(ui,'· 断货 {0} 次{1}',[(subscription.soldoutCredits),(authorization.pendingSoldout ? '（待同步 +' + authorization.pendingSoldout + '）' : '')])}}</text></view>
        </view>
        <button class="ui-action mine-reminder-action {{reminderTopUpNeeded && !subscriptionPending && !authorization.errorMessage && !authorization.storageBlocked ? 'mine-reminder-action--primary' : ''}}" hover-class="ui-control-pressed" disabled="{{paymentBusy || paymentChecking || paymentConfirming || paymentPendingId || redemptionOpen || redeeming || subscribing || authorization.storageBlocked}}" loading="{{subscribing}}" bindtap="onSubscribe">{{i18n.t(ui,(subscribing ? '等待微信授权…' : !subscription.templateCount && !subscription.soldoutEnabled ? '查看服务说明' : !boot.member ? '了解会员提醒' : '补充提醒次数'))}}</button>
      </view>
      <view wx:if="{{consent && consent.anyBlocked}}" class="consent-recovery" aria-role="status">
        <view class="consent-recovery-title">{{i18n.t(ui,'微信提醒权限未开启')}}</view>
        <view class="consent-recovery-desc">{{i18n.t(ui,'微信已拒绝以下消息；库存监测继续，但对应提醒暂无法接收。')}}</view>
        <view class="consent-recovery-row" wx:for="{{consent.blocked}}" wx:key="id"><text class="consent-recovery-name">{{i18n.t(ui,(item.title))}}</text><text class="consent-recovery-state">{{i18n.t(ui,(item.label))}}</text></view>
        <button class="btn btn-primary btn-block consent-recovery-action" bindtap="onOpenSubscribeSetting">{{i18n.t(ui,'前往微信设置')}}</button>
        <view class="consent-recovery-steps">{{i18n.t(ui,'微信设置 → 订阅消息 → 改为「接收」后返回补充次数。')}}</view>
      </view>
      <view wx:if="{{authorizationFeedback}}" class="authorization-feedback" aria-live="polite">{{i18n.t(ui,(authorizationFeedback))}}</view>
      <view wx:if="{{authorization.errorMessage || subscriptionPending}}" class="authorization-sync-error"><text>{{i18n.t(ui,(authorization.errorMessage || '微信授权待同步，尚未计入可用次数。'))}}</text><button class="ui-action" disabled="{{authorization.syncing}}" loading="{{authorization.syncing}}" bindtap="onRetryAuthorizationSync">{{i18n.t(ui,'重试同步')}}</button></view>

      <button id="reminder-settings" class="ui-disclosure ui-entry reminder-row" hover-class="ui-control-pressed" bindtap="onToggleReminderSettings" aria-expanded="{{showReminderSettings}}" aria-label="{{i18n.t(ui,('通知与免打扰，' + dndSummary))}}">
        <view class="ui-entry-copy"><text class="ui-disclosure-label">{{i18n.t(ui,'通知与免打扰')}}</text><text wx:if="{{settings}}" class="ui-entry-note">{{i18n.t(ui,(settings.notifyEnabled ? (settings.dnd.enabled ? dndStatus : '补货提醒已开启') : '补货提醒已关闭'))}}</text></view>
        <view class="ui-chevron {{showReminderSettings ? 'ui-chevron--up' : 'ui-chevron--down'}}" aria-hidden="true"></view>
      </button>
      <view wx:if="{{showReminderSettings}}" class="reminder-settings-panel ui-reveal">
        <view class="field">
          <text class="label">{{i18n.t(ui,'接收补货提醒')}}</text>
          <switch aria-label="{{i18n.t(ui,'接收补货提醒')}}" checked="{{settings.notifyEnabled}}" disabled="{{savingSettings}}" color="#00C375" bindchange="onNotifyToggle" />
        </view>
        <view class="field">
          <text class="label">{{i18n.t(ui,'免打扰时段')}}</text>
          <switch aria-label="{{i18n.t(ui,'免打扰时段')}}" checked="{{settings.dnd.enabled}}" disabled="{{savingSettings}}" color="#00C375" bindchange="onDndToggle" />
        </view>
        <block wx:if="{{settings.dnd.enabled}}">
          <view class="dnd-status-note" aria-live="polite">{{i18n.m(ui,'{0} · 监测继续',[(dndStatus)])}}</view>
          <view wx:for="{{dndPeriods}}" wx:key="index" class="dnd-period">
            <view class="dnd-period-heading"><text>{{i18n.m(ui,'时段 {0}{1}',[(index + 1),(item.allDay ? ' · 全天' : item.overnight ? ' · 跨午夜' : '')])}}</text><button wx:if="{{dndPeriods.length > 1}}" class="ui-action ui-action--plain ui-action--danger" disabled="{{savingSettings}}" data-index="{{index}}" bindtap="onRemoveDndPeriod" aria-label="{{i18n.t(ui,('删除时段 ' + (index + 1)))}}">{{i18n.t(ui,'删除')}}</button></view>
            <view class="dnd-time-row"><picker class="dnd-time-picker" mode="time" value="{{item.start}}" disabled="{{savingSettings}}" data-index="{{index}}" bindchange="onDndStart"><view class="dnd-time"><text class="dnd-time-label">{{i18n.t(ui,'开始')}}</text><text>{{i18n.t(ui,(item.start))}}</text><view class="ui-chevron ui-chevron--down" aria-hidden="true"></view></view></picker><picker class="dnd-time-picker" mode="time" value="{{item.end}}" disabled="{{savingSettings}}" data-index="{{index}}" bindchange="onDndEnd"><view class="dnd-time"><text class="dnd-time-label">{{i18n.t(ui,'结束')}}</text><text>{{i18n.t(ui,(item.end))}}</text><view class="ui-chevron ui-chevron--down" aria-hidden="true"></view></view></picker></view>
          </view>
          <view class="dnd-presets">
            <button wx:if="{{dndPeriods.length < maxDndPeriods}}" class="ui-action dnd-preset" disabled="{{savingSettings}}" data-preset="night" bindtap="onAddDndPreset"><view class="ui-plus" aria-hidden="true"></view><text>{{i18n.t(ui,'夜间 23:00–08:00')}}</text></button>
            <button wx:if="{{dndPeriods.length < maxDndPeriods}}" class="ui-action dnd-preset" disabled="{{savingSettings}}" data-preset="lunch" bindtap="onAddDndPreset"><view class="ui-plus" aria-hidden="true"></view><text>{{i18n.t(ui,'午休 12:00–13:00')}}</text></button>
            <button class="ui-action dnd-add" disabled="{{savingSettings || dndPeriods.length >= maxDndPeriods}}" bindtap="onAddDndPeriod"><view class="ui-plus" aria-hidden="true"></view><text>{{i18n.m(ui,'新增免打扰时段（{0} / {1}）',[(dndPeriods.length),(maxDndPeriods)])}}</text></button>
          </view>
        </block>
        <view class="reminder-settings-note">{{i18n.t(ui,'北京时间每日生效，结束后不补发旧提醒。')}}</view>
      </view>
      <button wx:if="{{!paymentPendingId}}" class="ui-disclosure reminder-row member-notification-experience notification-test-entry" hover-class="ui-control-pressed" disabled="{{paymentBusy || paymentChecking || paymentConfirming}}" bindtap="onTestNotification"><text class="ui-disclosure-label">{{i18n.t(ui,'体验微信提醒')}}</text><view class="ui-chevron" aria-hidden="true"></view></button>
      <button id="notification-records" class="ui-disclosure reminder-row" hover-class="ui-control-pressed" bindtap="onToggleNotifications" aria-expanded="{{showNotifications}}"><text class="ui-disclosure-label">{{i18n.t(ui,'提醒记录')}}</text><view class="ui-disclosure-meta"><text wx:if="{{notifications.length}}">{{i18n.m(ui,'{0} 条',[(notifications.length)])}}</text><view class="ui-chevron {{showNotifications ? 'ui-chevron--up' : 'ui-chevron--down'}}" aria-hidden="true"></view></view></button>
      <view wx:if="{{showNotifications}}" class="notification-panel ui-reveal">
        <view wx:if="{{notificationsLoading && !notifications.length}}" class="loading-line">{{i18n.t(ui,'正在加载提醒记录…')}}</view>
        <view wx:elif="{{notificationsLoading}}" class="loading-line">{{i18n.t(ui,'正在更新提醒记录…')}}</view>
        <view wx:if="{{notificationsError}}" class="record-error"><text>{{i18n.t(ui,(notificationsError))}}</text><button class="ui-action notification-button notification-retry" hover-class="ui-control-pressed" disabled="{{notificationsLoading || notificationActionBusy || notificationConfirming}}" bindtap="onRetryNotifications">{{i18n.t(ui,'重试加载')}}</button></view>
        <view wx:if="{{notificationsActionError}}" class="record-error"><text>{{i18n.t(ui,(notificationsActionError))}}</text><button class="ui-action notification-button notification-retry" hover-class="ui-control-pressed" disabled="{{notificationActionBusy || notificationConfirming}}" bindtap="onRetryNotificationAction">{{i18n.t(ui,'重试操作')}}</button></view>
        <view wx:if="{{!notificationsLoading && !notificationsError && !notificationsActionError && !notifications.length}}" class="empty"><image class="record-empty-whistle" src="/images/brand/whistle-green.png" mode="aspectFit" aria-hidden="true" /><view>{{i18n.t(ui,'最近 10 天暂无提醒记录')}}</view><button class="ui-action mt" hover-class="ui-control-pressed" bindtap="onOpenFollows">{{i18n.t(ui,'查看关注与库存')}}</button></view>
        <view wx:for="{{notifications}}" wx:key="id" class="notification-item">
          <view class="notification-heading"><text class="notification-product">{{i18n.t(ui,(item.productTitle || item.partNumber))}}</text><text class="pill pill-{{item.statusCls}}">{{i18n.t(ui,(item.statusLabel))}}</text></view>
          <view class="notification-detail">{{i18n.m(ui,'{0} · {1} · {2}',[(item.storeName || item.storeNumber),(item.eventLabel),(item.timeText)])}}</view>
          <view wx:if="{{item.reasonText}}" class="notification-reason">{{i18n.t(ui,(item.reasonText))}}</view>
          <view wx:if="{{item.deliveryNote}}" class="notification-reason">{{i18n.t(ui,(item.deliveryNote))}}</view>
          <view class="notification-actions"><button wx:if="{{item.action}}" class="ui-action notification-button notification-retry" hover-class="ui-control-pressed" data-id="{{item.id}}" disabled="{{notificationActionBusy || notificationConfirming}}" bindtap="onNotificationAction">{{i18n.t(ui,(item.actionLabel))}}</button><button class="ui-action ui-action--plain ui-action--danger notification-button notification-delete" hover-class="ui-control-pressed" data-id="{{item.id}}" disabled="{{notificationActionBusy || notificationConfirming}}" bindtap="onDeleteNotification">{{i18n.t(ui,(notificationDeletingId === item.id ? '删除中…' : '删除记录'))}}</button></view>
        </view>
        <view wx:if="{{notificationsMoreError}}" class="record-error"><text>{{i18n.t(ui,(notificationsMoreError))}}</text><button class="ui-action notification-button notification-retry" hover-class="ui-control-pressed" disabled="{{notificationsLoadingMore || notificationsLoading || notificationActionBusy || notificationConfirming}}" bindtap="onLoadMoreNotifications">{{i18n.t(ui,'重试加载')}}</button></view>
        <button wx:elif="{{notificationsHasMore}}" class="btn btn-block notification-button notification-more" hover-class="ui-control-pressed" disabled="{{notificationsLoadingMore || notificationsLoading || notificationActionBusy || notificationConfirming}}" bindtap="onLoadMoreNotifications">{{i18n.t(ui,(notificationsLoadingMore ? '正在加载…' : '加载更早提醒'))}}</button>
        <view wx:elif="{{notifications.length && notificationsPaginationKnown && !notificationsLoading && !notificationsError}}" class="notification-end">{{i18n.t(ui,'已显示全部提醒记录')}}</view>
        <button wx:if="{{notifications.length}}" class="btn btn-text btn-block notification-button notification-clear" hover-class="ui-control-pressed" disabled="{{notificationActionBusy || notificationConfirming || !notificationsClearBefore}}" bindtap="onClearNotifications">{{i18n.t(ui,(notificationActionBusy === 'clear' ? '清空中…' : '清空提醒记录'))}}</button>
      </view>
    </view>

    <view id="quota-card" class="card quota-summary">
      <view class="quota-summary-copy">
        <view class="card-title">{{i18n.t(ui,'剩余查询次数')}}</view>
        <view class="balance" aria-live="polite">{{quota.balance}}</view>
      </view>
      <button wx:if="{{!quota.signedInToday}}" class="btn btn-sm quota-signin {{signing ? 'disabled' : ''}}" hover-class="ui-control-pressed" disabled="{{signing}}" bindtap="onSignin">{{i18n.t(ui,(signing ? '签到中…' : '每日签到'))}}</button>
      <view wx:else class="signin-done"><view class="ui-check" aria-hidden="true"></view><text>{{i18n.t(ui,'今日已签到')}}</text></view>
    </view>

    <view wx:if="{{testReturnAvailable || tasks.length}}" class="card card-list">
      <button wx:if="{{testReturnAvailable}}" class="ui-disclosure" hover-class="ui-control-pressed" bindtap="onReturnToTest"><text class="ui-disclosure-label">{{i18n.t(ui,'返回原测试')}}</text><view class="ui-chevron" aria-hidden="true"></view></button>
      <view wx:for="{{tasks}}" wx:key="id" class="task">
        <view class="task-copy"><text>{{i18n.t(ui,(item.title))}}</text></view>
        <button wx:if="{{item.claimable}}" class="ui-action" hover-class="ui-control-pressed" bindtap="onOpenPendingReward"><text class="ui-action-label">{{i18n.t(ui,'领取奖励')}}</text><view class="ui-chevron" aria-hidden="true"></view></button>
        <text wx:else class="task-reward">{{i18n.t(ui,(item.pendingLabel))}}</text>
      </view>
    </view>

    <!-- 账户工具：记录与兑换一组，帮助与条款一组。 -->
    <view class="card card-list account-tools">
      <button id="membership-records" class="ui-disclosure account-link" hover-class="ui-control-pressed" bindtap="onToggleOrders" aria-expanded="{{showOrders}}"><view class="ui-label-with-icon"><image class="ui-icon" src="/images/ui/receipt.png" mode="aspectFit" aria-hidden="true" /><text class="ui-disclosure-label">{{i18n.t(ui,'购买记录')}}</text></view><view class="ui-chevron {{showOrders ? 'ui-chevron--up' : 'ui-chevron--down'}}" aria-hidden="true"></view></button>
      <view wx:if="{{showOrders}}" class="order-records ui-reveal">
        <view wx:if="{{ordersLoading && !orders.length}}" class="loading-line">{{i18n.t(ui,'正在加载会员记录…')}}</view>
        <view wx:elif="{{ordersError}}" class="record-error"><text>{{i18n.t(ui,(ordersError))}}</text><button class="ui-action" hover-class="ui-control-pressed" disabled="{{ordersLoading || orderActionBusy || orderConfirming}}" bindtap="onRetryOrders">{{i18n.t(ui,'重试加载')}}</button></view>
        <view wx:elif="{{!orders.length}}" class="empty">{{i18n.t(ui,'暂无会员记录')}}</view>
        <view wx:if="{{ordersActionError}}" class="record-error"><text>{{i18n.t(ui,(ordersActionError))}}</text><button class="ui-action order-record-button" hover-class="ui-control-pressed" disabled="{{orderActionBusy || orderConfirming}}" bindtap="onRetryOrderAction">{{i18n.t(ui,'重试操作')}}</button></view>
        <view wx:if="{{ordersActionNote}}" class="order-record-note">{{i18n.t(ui,(ordersActionNote))}}</view>
        <view wx:if="{{ordersClearUnavailable}}" class="order-record-note">{{i18n.t(ui,'部分记录需要新版服务支持清理，请稍后刷新。')}}</view>
        <view wx:for="{{orders}}" wx:key="orderId" class="order-record">
          <view class="order-record-heading">
            <text class="order-record-title">{{i18n.t(ui,(item.titleText))}}<text wx:if="{{item.amountText}}"> {{i18n.m(ui,'· {0}',[(item.amountText)])}}</text></text>
            <text class="pill pill-{{item.status === 'fulfilled' ? 'ok' : 'muted'}}">{{i18n.t(ui,(item.statusLabel))}}</text>
          </view>
          <view class="order-record-meta">{{i18n.t(ui,(item.timeText))}}</view>
          <view class="order-record-meta order-record-id">{{i18n.m(ui,'订单号：{0}',[(item.orderId)])}}</view>
          <view wx:if="{{item.refundText}}" class="order-record-meta">{{i18n.t(ui,(item.refundText))}}</view>
          <view class="order-record-actions">
            <text wx:if="{{!item.canClear}}" class="order-record-meta">{{i18n.t(ui,(item.clearNote))}}</text>
            <button wx:if="{{item.canClear}}" class="ui-action ui-action--plain ui-action--danger order-record-button" hover-class="ui-control-pressed" data-id="{{item.orderId}}" disabled="{{orderActionBusy || orderConfirming}}" bindtap="onDeleteOrder">{{i18n.t(ui,(orderDeletingId === item.orderId ? '删除中…' : '删除记录'))}}</button>
          </view>
        </view>
        <button wx:if="{{orders.length}}" class="btn btn-text btn-block order-record-button order-record-clear" hover-class="ui-control-pressed" disabled="{{!ordersClearableCount || orderActionBusy || orderConfirming}}" bindtap="onClearOrders">{{i18n.t(ui,(orderActionBusy === 'clear' ? '清空中…' : '清空当前显示的记录'))}}</button>
      </view>
      <button wx:if="{{!membership.isTester}}" class="ui-disclosure account-link" hover-class="ui-control-pressed" bindtap="onOpenRedemption" disabled="{{subscribing}}"><view class="ui-label-with-icon"><image class="ui-icon" src="/images/ui/ticket.png" mode="aspectFit" aria-hidden="true" /><text class="ui-disclosure-label">{{i18n.t(ui,'兑换码开通')}}</text></view><view class="ui-chevron" aria-hidden="true"></view></button>
      <button class="ui-disclosure account-link" hover-class="ui-control-pressed" bindtap="onToggleReleaseNotes" aria-expanded="{{showReleaseNotes}}"><view class="ui-label-with-icon"><image class="ui-icon" src="/images/ui/news.png" mode="aspectFit" aria-hidden="true" /><text class="ui-disclosure-label">{{i18n.t(ui,'更新公告')}}</text></view><view class="ui-chevron {{showReleaseNotes ? 'ui-chevron--up' : 'ui-chevron--down'}}" aria-hidden="true"></view></button>
      <view wx:if="{{showReleaseNotes}}" class="release-notes ui-reveal">
        <view wx:for="{{visibleReleaseNotes}}" wx:key="version" class="release-note">
          <view class="release-note-heading"><text class="release-note-version">{{i18n.m(ui,'v{0}',[(item.version)])}}</text><text wx:if="{{item.version === version}}" class="pill pill-ok release-note-current">{{i18n.t(ui,'当前版本')}}</text><text wx:if="{{item.dateText}}" class="release-note-date">{{i18n.t(ui,(item.dateText))}}</text></view>
          <view class="release-note-title">{{i18n.t(ui,(item.title))}}</view>
          <view wx:for="{{item.highlights}}" wx:for-item="highlight" wx:key="*this" class="release-note-highlight">{{i18n.t(ui,(highlight))}}</view>
          <view wx:if="{{item.note}}" class="release-note-caption">{{i18n.t(ui,(item.note))}}</view>
        </view>
        <view class="release-pagination" aria-label="{{i18n.t(ui,'更新公告翻页')}}">
          <button class="ui-action release-page-button" hover-class="ui-control-pressed" disabled="{{releaseNotesPage <= 1}}" bindtap="onPreviousReleaseNotes">{{i18n.t(ui,'上一页')}}</button>
          <text class="release-page-count" aria-live="polite">{{i18n.m(ui,'{0} / {1}',[(releaseNotesPage),(releaseNotesPageCount)])}}</text>
          <button class="ui-action release-page-button" hover-class="ui-control-pressed" disabled="{{releaseNotesPage >= releaseNotesPageCount}}" bindtap="onNextReleaseNotes">{{i18n.t(ui,'下一页')}}</button>
          <button class="ui-action release-notes-collapse" hover-class="ui-control-pressed" bindtap="onToggleReleaseNotes" aria-expanded="{{showReleaseNotes}}">{{i18n.t(ui,'收起')}}</button>
        </view>
      </view>
    </view>
    <view class="card card-list account-tools">
      <button class="ui-disclosure account-link" hover-class="ui-control-pressed" bindtap="onHelp"><view class="ui-label-with-icon"><image class="ui-icon" src="/images/ui/guide.png" mode="aspectFit" aria-hidden="true" /><text class="ui-disclosure-label">{{i18n.t(ui,'使用攻略与常见问题')}}</text></view><view class="ui-chevron" aria-hidden="true"></view></button>
      <button class="ui-disclosure account-link" open-type="contact" session-from="gxs_mine" hover-class="ui-control-pressed"><view class="ui-label-with-icon"><image class="ui-icon" src="/images/ui/support.png" mode="aspectFit" aria-hidden="true" /><text class="ui-disclosure-label">{{i18n.t(ui,'联系客服')}}</text></view><view class="ui-chevron" aria-hidden="true"></view></button>
      <button class="ui-disclosure account-link feedback" open-type="feedback" hover-class="ui-control-pressed"><view class="ui-label-with-icon"><image class="ui-icon" src="/images/ui/feedback.png" mode="aspectFit" aria-hidden="true" /><text class="ui-disclosure-label">{{i18n.t(ui,'意见反馈')}}</text></view><view class="ui-chevron" aria-hidden="true"></view></button>
      <button class="ui-disclosure account-link" hover-class="ui-control-pressed" bindtap="onPrivacy"><view class="ui-label-with-icon"><image class="ui-icon" src="/images/ui/privacy.png" mode="aspectFit" aria-hidden="true" /><text class="ui-disclosure-label">{{i18n.t(ui,'隐私说明')}}</text></view><view class="ui-chevron" aria-hidden="true"></view></button>
      <button class="ui-disclosure account-link" hover-class="ui-control-pressed" bindtap="onDisclaimer"><view class="ui-label-with-icon"><image class="ui-icon" src="/images/ui/info.png" mode="aspectFit" aria-hidden="true" /><text class="ui-disclosure-label">{{i18n.t(ui,'免责声明')}}</text></view><view class="ui-chevron" aria-hidden="true"></view></button>
    </view>

    <view class="footer-note">{{i18n.m(ui,'果小哨 {0}',[(versionLabel)])}}</view>
  </block>
  <button wx:if="{{loadError || !ready}}" class="ui-action ui-action--plain" hover-class="ui-control-pressed" bindtap="onPrivacy">{{i18n.t(ui,'隐私说明')}}</button>
</view>

<reminder-nudge enabled="{{ready}}" blocked="{{authorizationOpen || redemptionOpen || redeeming || paymentBusy || paymentChecking || paymentPendingId || paymentConfirming || orderConfirming}}" />

<config-sheet wx:if="{{authorizationOpen}}" visible="{{authorizationOpen}}" title="{{i18n.t(ui,'补充微信提醒次数')}}" confirm-text="{{i18n.t(ui,'完成')}}" disabled="{{subscribing}}" external-close="{{true}}" bindconfirm="onCloseAuthorizationPanel" bindrequestclose="onCloseAuthorizationPanel" bindclose="onCloseAuthorizationPanel">
  <reminder-authorization subscription="{{subscription}}" authorization="{{authorization}}" member="{{boot.member}}" busy="{{subscribing}}" feedback="{{authorizationFeedback}}" bindauthorize="onSubscribe" bindretry="onRetryAuthorizationSync" />
</config-sheet>
