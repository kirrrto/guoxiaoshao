@import "../../styles/reminder-center.wxss";

.mine-language { display: block; margin-left: auto; width: fit-content; }

/* ── 身份行 ───────────────────────────────────────────── */
.account-header { display: flex; align-items: center; gap: var(--sp-12); min-height: 56px; margin: 0 0 var(--sp-12); }
/* 标志图片四周带浅色留白：放大后由同形圆角裁掉。 */
.account-logo { flex: none; width: 48px; height: 48px; overflow: hidden; border-radius: 24%; }
.account-logo image { display: block; width: 100%; height: 100%; transform: scale(1.1); }
.account-logo-member image { transform: scale(1.03); }
.account-header-content { flex: 1 1 0; min-width: 0; }
.account-title { font-size: var(--fs-title); font-weight: 600; line-height: var(--lh-tight); overflow-wrap: anywhere; }
.identity-copy.ui-action { justify-content: flex-start; gap: var(--sp-8); padding-left: 0; padding-right: 0; color: var(--text-3); }
.identity-copy .ui-action-label { min-width: 0; word-break: break-all; text-align: left; }
.identity-copy-label { flex: none; color: var(--text-2); font-weight: 600; }
/* 44px 点击区保留，视觉上贴近标题。 */
.account-header .identity-copy { margin: calc(var(--sp-8) * -1) 0; }
.member-card-title.page-heading { margin-bottom: var(--sp-8); }
.member-expired-note { margin: 0 0 var(--sp-12); color: var(--warn); font-size: var(--fs-sub); }

/* ── 会员卡 ───────────────────────────────────────────── */
.member-pass {
  position: relative;
  overflow: hidden;
  margin: 0 0 var(--sp-12);
  padding: var(--sp-20);
  border: 1px solid var(--pass-edge);
  border-radius: var(--radius-tray);
  background-color: var(--pass);
  background-image: var(--pass-fill);
  color: var(--pass-text);
}
.member-pass-watermark { position: absolute; right: -30px; bottom: -38px; width: 164px; height: 164px; opacity: 0.12; }
.member-pass-title { position: relative; font-size: var(--fs-title); font-weight: 600; line-height: var(--lh-tight); }
.member-pass-benefits { position: relative; display: flex; flex-direction: column; gap: var(--sp-8); margin-top: var(--sp-16); }
.member-pass-benefit { display: flex; align-items: center; gap: var(--sp-12); line-height: var(--lh-snug); }
.member-pass-benefit .ui-check { margin: 0 var(--sp-2) var(--sp-2) var(--sp-4); color: var(--pass-gold); }
.member-vip-cta.btn { position: relative; margin-top: var(--sp-20); }

.member-overview { position: relative; display: flex; flex-direction: column; gap: var(--sp-4); }
.member-renewal { font-size: var(--fs-title); font-weight: 600; line-height: var(--lh-tight); }
.membership-annual .member-renewal { color: var(--pass-gold); }
.member-validity { color: var(--pass-text-2); font-size: var(--fs-sub); }
.member-delivery-grid {
  position: relative;
  display: flex;
  flex-wrap: wrap;
  gap: var(--sp-4) var(--sp-32);
  margin-top: var(--sp-16);
  padding-top: var(--sp-12);
  border-top: 1px solid var(--pass-line);
}
.member-delivery-cell.member-delivery-cell {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  justify-content: center;
  gap: var(--sp-2);
  width: auto;
  min-width: 0;
  min-height: var(--tap);
  margin: 0;
  padding: 0;
  border: 0;
  border-radius: 0;
  background: transparent;
  color: var(--pass-text);
  font-size: var(--fs-body);
  font-weight: 400;
  line-height: var(--lh-snug);
  text-align: left;
}
.member-delivery-cell.member-delivery-link[disabled] { background: transparent; color: var(--pass-text); opacity: 0.6; }
.member-delivery-cell.member-delivery-pressed { opacity: 0.6; }
.member-delivery-label { color: var(--pass-text-2); font-size: var(--fs-caption); }
.member-delivery-value { display: flex; align-items: baseline; font-size: var(--fs-headline); font-weight: 600; }
.member-delivery-total { color: var(--pass-text-2); font-size: var(--fs-sub); font-weight: 400; white-space: pre; }
.member-delivery-value .ui-chevron { align-self: center; margin-left: var(--sp-8); color: var(--pass-text-2); }
.member-enhanced { position: relative; margin-top: var(--sp-8); color: var(--pass-text-2); font-size: var(--fs-caption); }
.member-pass .member-regional-link.ui-action { position: relative; padding-left: 0; color: var(--pass-text); }
.member-pass .member-regional-link[disabled] { color: var(--pass-text-2); }
.member-regional-link.member-delivery-pressed { opacity: 0.6; }

.member-delivery-action.btn { margin-bottom: var(--sp-12); }
.membership-member-actions { display: flex; gap: var(--sp-8); margin: 0 0 var(--sp-12); }
.membership-member-actions .btn.membership-manage { flex: 1 1 0; }
.payment-note { margin-top: var(--sp-12); color: var(--text-2); font-size: var(--fs-sub); overflow-wrap: anywhere; }
.purchase-unavailable-note { margin: 0 var(--sp-4) var(--sp-12); color: var(--text-3); }

/* ── 套餐选择：一组行，选中行抬起为白色 ────────────────── */
.membership-shop { margin-bottom: var(--sp-12); }
.membership-shop-heading.section-heading { margin-top: 0; }
.membership-packages { display: flex; flex-direction: column; gap: var(--sp-4); padding: var(--sp-4); border-radius: var(--radius-tray); background: var(--surface); }
.membership-packages .membership-package {
  display: grid;
  grid-template-columns: auto minmax(0, 1fr) auto;
  align-items: center;
  gap: var(--sp-2) var(--sp-12);
  width: 100%;
  max-width: 100%;
  min-width: 0;
  min-height: 68px;
  margin: 0;
  padding: var(--sp-12);
  border: 0;
  border-radius: var(--radius-control);
  background: transparent;
  color: var(--text);
  font-size: var(--fs-body);
  font-weight: 400;
  line-height: var(--lh-snug);
  text-align: left;
  transition: background-color var(--dur-fast) var(--ease);
}
.membership-packages .membership-package-selected { background: var(--surface-top); }
.membership-packages .membership-package[disabled] { background: transparent; color: var(--text); opacity: 0.5; }
.membership-packages .membership-package-selected[disabled] { background: var(--surface-top); }
.membership-packages .membership-package-pressed { background: var(--pressed); }
.membership-package-radio { display: flex; align-items: center; justify-content: center; width: 22px; height: 22px; border: 1.5px solid var(--text-3); border-radius: 50%; color: transparent; }
.membership-package-radio .ui-check { margin-bottom: var(--sp-2); }
.membership-package-selected .membership-package-radio { border-color: var(--green); background: var(--green); color: var(--green-ink); }
.membership-package-heading { display: flex; flex-direction: column; gap: var(--sp-2); min-width: 0; }
.membership-package-name-line { display: flex; flex-wrap: wrap; align-items: center; gap: var(--sp-2) var(--sp-8); min-width: 0; }
.membership-package-name { font-size: var(--fs-headline); font-weight: 600; }
.membership-package-duration, .membership-package-benefit { color: var(--text-2); font-size: var(--fs-sub); }
.membership-package-scope { grid-column: 2 / -1; }
.membership-recommended-tag { padding: 0 var(--sp-8); border-radius: var(--radius-pill); background: var(--green-soft); color: var(--green-text); font-size: var(--fs-caption); font-weight: 600; line-height: var(--lh-normal); }
.membership-package-pricing { display: flex; flex-direction: column; align-items: flex-end; gap: var(--sp-2); min-width: 0; }
.membership-package-price { font-size: var(--fs-headline); font-weight: 600; white-space: nowrap; }
.membership-package-price-note { display: flex; align-items: baseline; gap: var(--sp-8); color: var(--text-3); font-size: var(--fs-caption); white-space: nowrap; }
.membership-standard-price { text-decoration: line-through; }
.membership-extension { display: flex; flex-direction: column; gap: var(--sp-2); margin: var(--sp-12) var(--sp-4) 0; color: var(--text-2); font-size: var(--fs-sub); }
.membership-extension-detail { color: var(--text); }
.payment-entry.btn { margin-top: var(--sp-12); }
.checkout-terms { margin-top: var(--sp-12); color: var(--text-3); font-size: var(--fs-caption); text-align: center; }
/* 每个分句整体换行，退款条款不在词中折断。 */
.checkout-term { display: inline-block; max-width: 100%; }
.checkout-terms-link.ui-action { display: flex; margin: 0 auto; }
.membership-upgrade-empty.card { margin-bottom: 0; }

/* ── 带着所选配置来开通 ───────────────────────────────── */
.checkout-target { display: flex; align-items: center; gap: var(--sp-12); min-width: 0; }
.checkout-image { width: 56px; height: 56px; }
.checkout-target-copy { flex: 1 1 0; min-width: 0; }
.checkout-target-title { font-size: var(--fs-headline); font-weight: 600; line-height: var(--lh-snug); overflow-wrap: anywhere; }
.checkout-stores { margin-top: var(--sp-2); color: var(--text-2); font-size: var(--fs-sub); overflow-wrap: anywhere; }
.checkout-problem { margin-top: var(--sp-8); }
.checkout-core-benefits { margin: 0 var(--sp-4) var(--sp-12); color: var(--text-2); font-size: var(--fs-sub); }
.checkout-secondary.btn { margin-top: var(--sp-4); }
.checkout-feedback-card.card { margin: var(--sp-8) 0 0; }
.checkout-feedback { display: flex; flex-wrap: wrap; gap: var(--sp-8); padding-bottom: var(--sp-12); }
.checkout-identity.ui-action { display: flex; margin: 0 auto var(--sp-12); }

/* ── 待处理订单 ───────────────────────────────────────── */
.payment-status { overflow-wrap: anywhere; }
.payment-error { margin-top: var(--sp-8); color: var(--bad); overflow-wrap: anywhere; }
.payment-order-id { margin-top: var(--sp-8); color: var(--text-3); font-size: var(--fs-caption); word-break: break-all; }
.payment-actions { display: flex; flex-direction: column; gap: var(--sp-8); margin-top: var(--sp-16); }
.payment-support { margin-top: var(--sp-12); }

/* ── 兑换弹窗 ─────────────────────────────────────────── */
.redemption-mask { position: fixed; left: 0; top: 0; right: 0; bottom: 0; z-index: 1000; display: flex; align-items: center; justify-content: center; padding: var(--sp-24); background: var(--scrim); }
.redemption-modal { --control: var(--surface); width: 100%; max-width: 320px; max-height: 80vh; overflow-y: auto; padding: var(--sp-24) var(--sp-20) var(--sp-12); border-radius: var(--radius-tray); background: var(--elevated); }
.redemption-title { margin-bottom: var(--sp-16); font-size: var(--fs-headline); font-weight: 600; line-height: var(--lh-snug); }
.redemption-input { display: block; width: 100%; height: var(--btn-height); margin-bottom: var(--sp-12); padding: 0 var(--sp-16); border-radius: var(--radius-control); background: var(--surface); color: var(--text); font-size: var(--fs-body); }
.redemption-placeholder { color: var(--text-3); }
.redemption-message { margin-top: var(--sp-12); padding: var(--sp-12); border-radius: var(--radius-control); font-size: var(--fs-sub); overflow-wrap: anywhere; }
.redemption-message-error { background: var(--bad-soft); color: var(--bad); }
.redemption-message-ok { background: var(--green-soft); color: var(--green-text); }
.redemption-message-info { background: var(--surface); color: var(--text-2); }
.redemption-close.btn { margin-top: var(--sp-4); }

/* ── 微信提醒 ─────────────────────────────────────────── */
.mine-reminder-heading { display: flex; align-items: flex-start; justify-content: space-between; gap: var(--sp-12); padding-bottom: var(--sp-12); }
.mine-reminder-summary { flex: 1 1 0; min-width: 0; }
.mine-reminder-summary .card-title { margin-bottom: var(--sp-2); }
.mine-reminder-status, .mine-reminder-balance { color: var(--text-2); font-size: var(--fs-sub); }
.mine-reminder-action.ui-action { flex: 0 1 auto; font-weight: 600; }
.mine-reminder-action--primary.ui-action, .mine-reminder-action--primary.ui-action[disabled] { background: var(--green); color: var(--green-ink); }
.reminder-card .consent-recovery, .reminder-card .authorization-sync-error, .reminder-card .authorization-feedback { margin: 0 0 var(--sp-12); }
.reminder-settings-panel { padding-bottom: var(--sp-12); }
.dnd-status-note { padding: var(--sp-8) 0; color: var(--text-2); font-size: var(--fs-sub); }
.dnd-period { padding: var(--sp-4) 0 var(--sp-12); border-top: 1px solid var(--line); }
.dnd-period-heading { display: flex; align-items: center; justify-content: space-between; gap: var(--sp-12); min-height: var(--tap); color: var(--text-2); font-size: var(--fs-sub); }
.dnd-time-row { display: flex; gap: var(--sp-8); }
.dnd-time-picker { flex: 1 1 0; min-width: 0; }
.dnd-time { display: flex; align-items: center; justify-content: space-between; gap: var(--sp-8); min-height: var(--tap); padding: var(--sp-8) var(--sp-12); border-radius: var(--radius-control); background: var(--control); }
.dnd-time-label { color: var(--text-2); font-size: var(--fs-sub); }
.dnd-presets { display: flex; flex-wrap: wrap; gap: var(--sp-8); padding: var(--sp-12) 0 var(--sp-4); border-top: 1px solid var(--line); }
.dnd-presets .dnd-preset { flex: 1 1 140px; }
.dnd-presets .dnd-add { flex: 1 1 100%; }
.reminder-settings-note { padding-top: var(--sp-8); color: var(--text-3); font-size: var(--fs-caption); }

.notification-panel { padding-bottom: var(--sp-4); }
.notification-item { padding: var(--sp-12) 0 var(--sp-4); border-top: 1px solid var(--line); }
.notification-heading { display: flex; align-items: flex-start; justify-content: space-between; gap: var(--sp-12); }
.notification-product { flex: 1 1 0; min-width: 0; font-weight: 600; line-height: var(--lh-snug); overflow-wrap: anywhere; }
.notification-detail { margin-top: var(--sp-4); color: var(--text-2); font-size: var(--fs-sub); overflow-wrap: anywhere; }
.notification-reason { margin-top: var(--sp-4); color: var(--text-3); font-size: var(--fs-sub); overflow-wrap: anywhere; }
.notification-actions { display: flex; justify-content: flex-end; flex-wrap: wrap; gap: var(--sp-8); }
.notification-end { padding-top: var(--sp-12); color: var(--text-3); font-size: var(--fs-caption); text-align: center; }
.record-error { display: flex; align-items: center; flex-wrap: wrap; gap: var(--sp-12); padding: var(--sp-12) 0; color: var(--text-2); font-size: var(--fs-sub); }
.record-error > text:first-child { flex: 1 1 110px; min-width: 0; }
.record-empty-whistle { display: block; width: 32px; height: 32px; margin: 0 auto var(--sp-8); opacity: 0.5; }

/* ── 查询与体验次数 ───────────────────────────────────── */
.quota-summary { display: flex; align-items: center; justify-content: space-between; gap: var(--sp-12); padding-bottom: var(--sp-12); }
.quota-summary-copy { flex: 1 1 0; min-width: 0; }
.quota-summary .card-title { margin-bottom: var(--sp-2); }
.quota-balance { color: var(--text-2); font-size: var(--fs-sub); }
.balance { color: var(--text); font-size: var(--fs-title); font-weight: 600; line-height: var(--lh-tight); }
.quota-signin.btn { flex: none; }
.signin-done { display: inline-flex; flex: none; align-items: center; gap: var(--sp-8); min-height: var(--tap); color: var(--text-3); font-size: var(--fs-sub); }
.signin-done .ui-check { margin: 0 var(--sp-2) var(--sp-2); }
.quota-caps { padding: var(--sp-4) 0 var(--sp-12); color: var(--text-2); font-size: var(--fs-sub); }
.task { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: var(--sp-8); min-height: 52px; padding: var(--sp-4) 0; border-top: 1px solid var(--line); }
.task-copy { flex: 1 1 110px; min-width: 0; }
.task-reward { color: var(--text-3); font-size: var(--fs-sub); }
.ledger-row { display: flex; align-items: center; justify-content: space-between; gap: var(--sp-12); padding: var(--sp-12) 0; border-top: 1px solid var(--line); }
.ledger-copy { display: flex; flex: 1 1 0; flex-direction: column; min-width: 0; }
.ledger-time { color: var(--text-3); font-size: var(--fs-caption); }
.ledger-delta { flex: none; font-weight: 600; }
.plus { color: var(--green-text); }
.minus { color: var(--text-2); }

/* ── 账户工具：购买记录与更新公告就地展开 ──────────────── */
.order-records { padding-bottom: var(--sp-4); }
.order-record { padding: var(--sp-12) 0 var(--sp-4); border-top: 1px solid var(--line); }
.order-record-heading { display: flex; align-items: flex-start; justify-content: space-between; gap: var(--sp-12); }
.order-record-title { flex: 1 1 0; min-width: 0; font-weight: 600; line-height: var(--lh-snug); }
.order-record-meta { margin-top: var(--sp-2); color: var(--text-3); font-size: var(--fs-caption); overflow-wrap: anywhere; }
.order-record-id { word-break: break-all; }
.order-record-actions { display: flex; align-items: center; justify-content: flex-end; gap: var(--sp-8); min-height: var(--sp-8); }
.order-record-actions > text { flex: 1 1 0; }
.order-record-note { padding: var(--sp-8) 0; color: var(--text-2); font-size: var(--fs-sub); }
.release-notes { padding-bottom: var(--sp-12); }
.release-note { padding: var(--sp-12) 0; border-top: 1px solid var(--line); }
.release-note-heading { display: flex; align-items: center; flex-wrap: wrap; gap: var(--sp-8); }
.release-note-version { font-size: var(--fs-headline); font-weight: 600; line-height: var(--lh-snug); }
.release-note-date { margin-left: auto; color: var(--text-3); font-size: var(--fs-caption); }
.release-note-title { margin-top: var(--sp-4); font-weight: 600; overflow-wrap: anywhere; }
.release-note-highlight { margin-top: var(--sp-4); color: var(--text-2); font-size: var(--fs-sub); overflow-wrap: anywhere; }
.release-note-caption { margin-top: var(--sp-8); color: var(--text-3); font-size: var(--fs-caption); overflow-wrap: anywhere; }
.release-pagination { display: flex; align-items: center; gap: var(--sp-8); padding-top: var(--sp-12); border-top: 1px solid var(--line); }
.release-page-count { min-width: var(--tap); color: var(--text-2); font-size: var(--fs-sub); text-align: center; }
.release-notes-collapse.ui-action { margin-left: auto; }

/* 普通手机上分行显示两种参考价，让大字号下的套餐和名额仍然可读。 */
@media (max-width: 400px) {
  .membership-package-price-note { flex-direction: column; align-items: flex-end; gap: 0; }
}
/* 最窄的屏幕把名额与标价留给主信息，日均价让位。 */
@media (max-width: 340px) {
  .membership-daily-price { display: none; }
}
