<wxs module="i18n" src="../../i18n/render.wxs" />
<page-meta page-style="color-scheme:{{_themeMode || 'light'}};{{(editing || authorizationOpen) ? 'overflow:hidden;' : ''}}" />
<view class="page tab-page follow-page desktop-split-page">
  <view wx:if="{{networkOffline}}" class="network-notice" aria-role="status">{{i18n.t(ui,'网络已断开，恢复后自动刷新')}}</view>
  <view class="page-heading whistle-heading">
    <image class="page-mark page-mark-glyph whistle-mark" src="/images/brand/whistle-green.png" mode="aspectFit" aria-hidden="true" />
    <view class="page-title">{{i18n.t(ui,'我的小哨')}}</view>
    <button class="ui-action ui-action--plain compact-action" hover-class="ui-control-pressed" loading="{{refreshing}}" disabled="{{refreshing || saving}}" bindtap="onRefreshStatus">{{i18n.t(ui,(refreshing ? '读取中' : '刷新状态'))}}</button>
  </view>

  <view class="follow-workspace">
    <view class="follow-sidebar">
      <view wx:if="{{ready && followsLoaded && follows.length && !loadError}}" class="follow-list-pane">
        <view class="section-heading follow-list-heading"><text class="section-title">{{i18n.t(ui,'已保存的关注')}}</text></view>
        <view class="card follow-list">
          <button wx:for="{{follows}}" wx:key="followId" class="follow-list-choice {{(item.followId === selectedFollowId) ? 'follow-list-choice--selected' : ''}}" hover-class="ui-control-pressed" data-id="{{item.followId}}" aria-pressed="{{item.followId === selectedFollowId}}" aria-label="{{i18n.t(ui,(item.cardTitle + (item.cardSubtitle ? '，' + item.cardSubtitle : '') + (item.storeSummary ? '，' + item.storeSummary : '') + (item.followId === selectedFollowId ? '，已选' : '')))}}" bindtap="onSelectFollow">
            <view class="follow-choice-copy">
              <text class="follow-choice-title">{{i18n.t(ui,(item.cardTitle))}}</text>
              <text wx:if="{{item.cardSubtitle}}" class="follow-choice-meta">{{i18n.t(ui,(item.cardSubtitle))}}</text>
              <text wx:if="{{item.storeSummary}}" class="follow-choice-meta">{{i18n.t(ui,(item.storeSummary))}}</text>
            </view>
            <view wx:if="{{item.followId === selectedFollowId}}" class="ui-check" aria-hidden="true"></view>
          </button>
        </view>
      </view>
      <!-- 到期提醒：下一次计划提醒时间在前，事项与微信状态在后。 -->
      <view class="card deadline-home">
        <view class="deadline-home-heading">
          <view class="deadline-heading-copy"><view class="card-title section-title">{{i18n.t(ui,'到期提醒')}}</view><text class="deadline-service-label">{{i18n.t(ui,(deadlineServiceLabel))}}</text></view>
          <button wx:if="{{deadlineCanOpen && !deadlineCount}}" class="btn btn-sm {{deadlineRecordOnly && follows.length ? '' : 'btn-primary'}} deadline-home-action" hover-class="btn-primary-pressed" disabled="{{deadlinesLoading}}" bindtap="onOpenDeadlines">{{i18n.t(ui,'添加到期事项')}}</button>
          <button wx:if="{{deadlineCanOpen && deadlineCount}}" class="ui-action ui-action--plain deadline-home-manage" hover-class="ui-control-pressed" disabled="{{deadlinesLoading}}" bindtap="onOpenDeadlines" aria-label="{{i18n.m(ui,'管理到期事项，共 {0} 条',[(deadlineCount)])}}">{{i18n.m(ui,'管理到期事项（{0}）',[(deadlineCount)])}}<view class="ui-chevron" aria-hidden="true"></view></button>
        </view>
        <view class="deadline-agenda">
          <view wx:if="{{deadlinesError}}" class="deadline-home-error" aria-role="alert"><text>{{i18n.t(ui,(deadlinesError))}}</text><button class="ui-action" hover-class="ui-control-pressed" disabled="{{deadlinesLoading}}" bindtap="onRetryDeadlines">{{i18n.t(ui,'重试')}}</button></view>
          <view wx:elif="{{deadlinesLoading && !deadlinesLoaded}}" class="deadline-home-empty" aria-busy="true">{{i18n.t(ui,'正在读取到期事项…')}}</view>
          <view wx:elif="{{!deadlineCount}}" class="deadline-home-empty">{{i18n.t(ui,'暂无到期事项')}}</view>
          <view wx:if="{{deadlineCanOpen && deadlineRecordOnly}}" class="deadline-record-only">{{i18n.t(ui,'微信通知尚未开启。')}}</view>
          <view wx:for="{{deadlines}}" wx:key="id" class="deadline-home-row">
            <view class="deadline-home-item"><text class="deadline-home-title">{{item.title}}</text><text class="deadline-home-date">{{i18n.t(ui,(item.dueText))}}</text></view>
            <view wx:if="{{deadlineCanOpen && nextDeadline && item.id === nextDeadline.id}}" class="deadline-home-next">
              <text>{{i18n.t(ui,'下一次计划提醒')}}</text><text class="deadline-next-time">{{i18n.t(ui,(item.remindText))}}</text>
            </view>
            <view class="deadline-home-delivery"><text class="deadline-home-state deadline-home-state--{{item.tone}}">{{i18n.t(ui,(item.statusLabel))}}</text><text>{{i18n.t(ui,(item.statusNote))}}</text></view>
          </view>
        </view>
      </view>
    </view>

    <view class="follow-detail-pane">
      <view class="section-heading inventory-home-heading">
        <view class="inventory-heading-copy">
          <text class="section-title">{{i18n.t(ui,'苹果库存')}}</text>
          <text wx:if="{{ready && followsLoaded && !loadError}}" class="inventory-allowance">{{i18n.m(ui,'关注配置{0}',[(boot.member ? '已用 ' + (follows.length + otherMarketCount) + ' / ' + limits.maxFollows + ' 个名额' : ' ' + follows.length + ' 个')])}}</text>
        </view>
        <button class="ui-action ui-action--plain" hover-class="ui-control-pressed" bindtap="onOpenInventory">{{i18n.t(ui,'查询库存')}}</button>
      </view>
      <view wx:if="{{loadError}}" class="card load-error" aria-role="alert">
        <view class="load-error-title">{{i18n.t(ui,'暂时没有连上')}}</view>
        <view class="load-error-detail">{{i18n.t(ui,(loadError))}}</view>
        <button class="btn btn-primary btn-block" bindtap="onRetryLoad">{{i18n.t(ui,'重试')}}</button>
      </view>

      <block wx:elif="{{!ready}}">
        <view class="skeleton" aria-busy="true">
          <view class="skeleton-card"><view class="skeleton-line skeleton-title"></view><view class="skeleton-line"></view><view class="skeleton-line skeleton-short"></view><view class="skeleton-bar"></view></view>
          <view class="loading-line">{{i18n.t(ui,'正在读取你的关注…')}}</view>
        </view>
      </block>

      <block wx:else>
        <view wx:if="{{liveSync.state === 'syncing' || liveSync.state === 'offline' || liveSync.state === 'retrying'}}" class="follow-sync-bar" aria-role="status"><view class="follow-sync-copy"><text class="follow-sync-dot follow-sync-dot--{{liveSync.state}}"></text><text>{{i18n.t(ui,(liveSync.state === 'syncing' ? '正在更新页面' : liveSync.state === 'offline' ? '网络已断开' : '连接暂时中断，稍后重试'))}}</text></view><view class="follow-sync-times"><text wx:if="{{liveSync.lastReadText}}" class="follow-sync-time">{{i18n.m(ui,'{0}读取',[(liveSync.lastReadText)])}}</text><text wx:if="{{liveSync.nextReadText}}" class="follow-sync-time">{{i18n.m(ui,'下次 {0}',[(liveSync.nextReadText)])}}</text></view></view>
        <view wx:if="{{stockOverview}}" class="follow-inventory-status follow-inventory-status--{{stockOverview.tone}}"><text class="bold">{{i18n.t(ui,(stockOverview.label))}}</text><text>{{i18n.t(ui,(stockOverview.detail))}}</text></view>
        <view wx:if="{{refreshError}}" class="banner banner-warn" aria-role="alert">{{i18n.t(ui,(refreshError))}}</view>
        <view wx:elif="{{refreshFeedback}}" class="follow-refresh-feedback" aria-role="status">{{i18n.t(ui,(refreshFeedback))}}</view>
        <view wx:if="{{activation}}" class="card activation-card" aria-live="polite">
          <view class="card-title activation-title">{{i18n.t(ui,(activation.title))}}</view>
          <view wx:if="{{activation.targetTitle}}" class="bold">{{i18n.t(ui,(activation.targetTitle))}}</view>
          <view class="activation-steps"><view wx:for="{{activation.steps}}" wx:key="id" class="activation-step {{item.done ? 'activation-step--done' : ''}}"><view class="activation-dot"><view wx:if="{{item.done}}" class="ui-check" aria-hidden="true"></view><text wx:else>{{i18n.t(ui,(index + 1))}}</text></view><text>{{i18n.t(ui,(item.label))}}</text></view></view>
          <view class="small text-2">{{i18n.t(ui,(activation.detail))}}</view>
          <button wx:if="{{activation.action}}" class="btn btn-block mt" hover-class="ui-control-pressed" disabled="{{saving || editing || refreshing || subscribing}}" bindtap="onActivationAction">{{i18n.t(ui,(activation.actionLabel))}}</button>
        </view>

        <view wx:if="{{alert}}" id="restock-alert" class="card alert-card">
          <view class="card-title"><text>{{i18n.t(ui,(alert.soldOut ? '断货提醒' : '到货提醒'))}}</text><button class="ui-action ui-action--plain" hover-class="ui-control-pressed" bindtap="onCloseAlert">{{i18n.t(ui,'关闭')}}</button></view>
          <view wx:if="{{alert.loading}}" class="loading-line">{{i18n.t(ui,'正在读取这条提醒…')}}</view>
          <view wx:elif="{{alert.error}}">
            <view class="small text-2" aria-role="alert">{{i18n.t(ui,(alert.error))}}</view>
            <button wx:if="{{alert.retryable}}" class="btn btn-block mt" hover-class="ui-control-pressed" bindtap="onRetryAlert">{{i18n.t(ui,'重新读取这条提醒')}}</button>
          </view>
          <block wx:else>
            <text class="alert-product" user-select>{{i18n.t(ui,(alert.productTitle))}}</text>
            <text class="alert-meta mono" user-select>{{i18n.m(ui,'{0} · Apple {1}',[(alert.partNumber),(alert.storeName)])}}</text>
            <view class="alert-row"><text class="text-2">{{i18n.t(ui,(alert.eventLabel))}}</text><text>{{i18n.m(ui,'{0}（{1}）',[(alert.foundText),(alert.agoText)])}}</text></view>
            <view class="alert-row"><text class="text-2">{{i18n.t(ui,'最近状态')}}</text><view class="pill pill-dot pill-{{alert.nowCls}}">{{i18n.t(ui,(alert.nowLabel))}}</view></view>
            <view wx:if="{{alert.archived}}" class="alert-explanation">{{i18n.t(ui,(alert.nowText))}}</view>
            <view wx:else class="alert-explanation">{{i18n.m(ui,'{0}。请以官网实际取货信息为准。',[(alert.nowText)])}}</view>
            <button class="btn btn-primary btn-block mt" hover-class="btn-primary-pressed" bindtap="onCopyAlert">{{i18n.t(ui,'复制型号和门店')}}</button>
            <view wx:if="{{!alert.soldOut && (!alert.archived || alert.feedback)}}" class="alert-feedback">
              <text class="small text-2">{{i18n.t(ui,(alert.feedback === 'bought' ? '已记录买到反馈' : (alert.feedback ? '已记录你的反馈' : '买到了吗？')))}}</text>
              <view wx:if="{{!alert.archived && alert.feedback !== 'bought'}}" class="alert-feedback-actions">
                <button class="ui-action" hover-class="ui-control-pressed" data-outcome="bought" disabled="{{alertBusy}}" bindtap="onAlertFeedback">{{i18n.t(ui,(alert.followActive ? '买到了，暂停此关注' : '买到了'))}}</button>
                <button class="ui-action" hover-class="ui-control-pressed" data-outcome="missed" disabled="{{alertBusy}}" bindtap="onAlertFeedback">{{i18n.t(ui,'没抢到')}}</button>
                <button class="ui-action" hover-class="ui-control-pressed" data-outcome="skipped" disabled="{{alertBusy}}" bindtap="onAlertFeedback">{{i18n.t(ui,'没去买')}}</button>
              </view>
            </view>
          </block>
        </view>

        <view class="follow-content">
          <view id="follow-configurations" class="follow-configurations">
            <view wx:if="{{!followsLoaded}}" class="card loading-line" aria-busy="true">{{i18n.t(ui,'正在确认已保存的关注…')}}</view>
            <view wx:elif="{{!follows.length}}" class="card follow-empty">
              <view class="card-title empty-title">{{i18n.t(ui,(otherMarketCount ? '暂无中国大陆库存关注' : '暂无库存关注'))}}</view>
              <view wx:if="{{!boot.member}}" class="small text-2">{{i18n.t(ui,'关注与到货提醒为会员专属，免费用户可按次查询。')}}</view>
              <button class="btn btn-primary btn-block" hover-class="btn-primary-pressed" bindtap="onAdd">{{i18n.t(ui,(boot.member ? '添加关注' : '了解会员'))}}</button>
              <button wx:if="{{otherMarketCount}}" class="ui-action" hover-class="ui-control-pressed" bindtap="openMarkets">{{i18n.t(ui,'查看其他站点的关注')}}</button>
            </view>

            <!-- 关注卡：配置身份 → 状态与观测时间 → 下一步；有货时整张卡转绿。 -->
            <view wx:for="{{follows}}" wx:key="followId" id="follow-entry-{{index}}" class="card follow {{(item.followId === selectedFollowId) ? 'follow--selected' : ''}} {{item.hasAvailable ? 'follow-available' : ''}}">
              <view class="follow-product">
                <view wx:if="{{item.imageDisplayUrl}}" class="product-tile follow-image"><image src="{{item.imageDisplayUrl}}" webp="{{true}}" mode="aspectFit" aria-label="{{i18n.t(ui,(item.imageAlt))}}" data-index="{{index}}" binderror="onFollowImageError" /></view>
                <view wx:else class="product-tile follow-image follow-image-placeholder"><image class="ui-icon" src="/images/ui/device.png" mode="aspectFit" aria-hidden="true" /></view>
                <view class="follow-head"><view class="follow-title"><text class="bold">{{i18n.t(ui,(item.cardTitle))}}</text></view><text wx:if="{{item.cardSubtitle}}" class="follow-variant">{{i18n.t(ui,(item.cardSubtitle))}}</text><text class="follow-status follow-status--{{item.statusCls}}"><text class="follow-status-dot"></text>{{i18n.t(ui,(item.statusLabel))}}</text></view>
              </view>
              <view wx:if="{{item.monitoringText}}" class="follow-note">{{i18n.t(ui,(item.monitoringText))}}</view>
              <view class="follow-stock-panel follow-stock-panel--{{item.observationTone}}">
                <view class="follow-stock-heading"><view class="follow-stock-state"><view wx:if="{{item.hasAvailable && item.status === 'active' && !networkOffline}}" class="ui-live-dot" aria-hidden="true"></view><text class="follow-stock-label">{{i18n.t(ui,(item.observationLabel))}}</text></view><text wx:if="{{item.observationAge}}" class="follow-stock-time">{{i18n.t(ui,(item.observationAge))}}</text></view>
                <view class="follow-stock-detail">{{i18n.t(ui,(item.stockDetail))}}</view>
                <view wx:if="{{item.observationIncomplete}}" class="follow-partial-note">{{i18n.m(ui,'另 {0} 家门店待更新',[(item.pendingStoreCount)])}}</view>
              </view>
              <view wx:if="{{item.hasAvailable}}" class="follow-primary-actions">
                <button class="btn btn-primary btn-block" hover-class="btn-primary-pressed" data-id="{{item.followId}}" bindtap="onPickupInfo">{{i18n.t(ui,'查看取货信息')}}</button>
              </view>
              <button class="follow-detail-entry" hover-class="ui-control-pressed" aria-expanded="{{item.detailsExpanded}}" data-id="{{item.followId}}" bindtap="onToggleFollowDetails"><text class="follow-detail-count">{{i18n.m(ui,'{0} 家门店',[(item.stores.length)])}}</text><view class="follow-detail-label"><text>{{i18n.t(ui,(item.detailsExpanded ? '收起详情' : '详情与管理'))}}</text><view class="ui-chevron {{item.detailsExpanded ? 'ui-chevron--up' : 'ui-chevron--down'}}" aria-hidden="true"></view></view></button>
              <view wx:if="{{item.detailsExpanded}}" class="follow-details ui-reveal">
                <view wx:for="{{item.stores}}" wx:for-item="s" wx:key="storeNumber" class="store-row">
                  <view class="store-heading"><text class="store-name">{{i18n.t(ui,(s.storeLabel))}}</text><view class="pill pill-dot pill-{{s.observationState === 'fresh' && s.status === 'unavailable' ? 'muted' : s.compactTone}}">{{i18n.t(ui,(s.compactStatus))}}</view></view>
                  <view wx:if="{{s.checkText}}" class="store-observation">{{i18n.t(ui,(s.checkText))}}</view>
                  <view wx:if="{{s.lastResultTimeText}}" class="store-detail-note">{{i18n.t(ui,(s.lastResultTimeText))}}</view>
                  <view wx:if="{{s.compactNote}}" class="store-detail-note">{{i18n.t(ui,(s.compactNote))}}</view>
                </view>
                <view wx:if="{{followActionId === item.followId && followActionError}}" class="follow-action-error" aria-role="alert"><text>{{i18n.t(ui,(followActionError))}}</text><button class="ui-action" hover-class="ui-control-pressed" loading="{{refreshing}}" disabled="{{refreshing}}" bindtap="onRefreshStatus">{{i18n.t(ui,'刷新状态')}}</button></view>
                <view class="btn-row follow-actions">
                  <button wx:if="{{item.canQuery}}" class="btn follow-optional-query" hover-class="ui-control-pressed" data-id="{{item.followId}}" disabled="{{saving || editing}}" bindtap="onQueryFollow">{{i18n.t(ui,'单独查询库存')}}</button>
                  <button class="btn" hover-class="ui-control-pressed" disabled="{{saving || followBusyId}}" data-id="{{item.followId}}" bindtap="onEdit">{{i18n.t(ui,(item.editLabel))}}</button>
                  <button wx:if="{{item.limitPaused && !item.productRetired}}" class="btn" hover-class="ui-control-pressed" disabled="{{saving || followBusyId}}" bindtap="showMemberModal">{{i18n.t(ui,'查看套餐')}}</button>
                  <button wx:elif="{{boot.member && item.canToggle}}" class="btn" hover-class="ui-control-pressed" loading="{{followBusyId === item.followId}}" disabled="{{saving || followBusyId}}" data-id="{{item.followId}}" data-status="{{item.status}}" bindtap="onToggle">{{i18n.t(ui,(item.status === 'active' ? '暂停' : '恢复'))}}</button>
                </view>
                <view class="follow-management"><text class="follow-part mono" user-select>{{i18n.t(ui,(item.partNumber))}}</text><button class="ui-action ui-action--plain ui-action--danger danger-action" hover-class="ui-control-pressed" disabled="{{saving || followBusyId}}" data-id="{{item.followId}}" bindtap="onRemove">{{i18n.t(ui,'删除关注')}}</button></view>
              </view>
            </view>
            <view wx:if="{{followsLoaded && follows.length}}" class="follow-add-footer"><button class="btn btn-block" hover-class="ui-control-pressed" disabled="{{saving || followBusyId}}" bindtap="onAdd"><view class="ui-plus" aria-hidden="true"></view><text>{{i18n.t(ui,'添加关注')}}</text></button></view>
          </view>

          <view id="reminder-health" class="card reminder-status-strip {{readiness.ready && !primaryTopUp && !subscriptionPending && !authorization.errorMessage && !authorizationFeedback && !(consent && consent.anyBlocked) ? 'reminder-status-routine' : ''}}" aria-live="polite">
            <view class="reminder-status-row"><view class="reminder-status-copy"><text class="bold">{{i18n.t(ui,(readiness.code === 'ready' || readiness.code === 'restock_ready' ? '微信提醒授权已备好' : readiness.title))}}</text><text wx:if="{{boot.member && subscription.templateCount}}" class="reminder-inline-balance">{{i18n.m(ui,'到货 {0} 次{1}',[(subscription.credits),(authorization.pendingRestock ? '（待同步 +' + authorization.pendingRestock + '）' : '')])}}<text wx:if="{{subscription.soldoutEnabled}}"> {{i18n.m(ui,'· 断货 {0} 次{1}',[(subscription.soldoutCredits),(authorization.pendingSoldout ? '（待同步 +' + authorization.pendingSoldout + '）' : '')])}}</text></text></view><button class="ui-action ui-action--plain reminder-details-toggle" hover-class="ui-control-pressed" bindtap="onToggleServiceDetails" aria-expanded="{{showServiceDetails}}">{{i18n.t(ui,(showServiceDetails ? '收起' : '状态详情'))}}<view class="ui-chevron {{showServiceDetails ? 'ui-chevron--up' : 'ui-chevron--down'}}" aria-hidden="true"></view></button></view>
            <view wx:if="{{!showServiceDetails && readiness.action === 'service'}}" class="reminder-health-warning" aria-role="status">{{i18n.t(ui,(readinessTaskDetail))}}</view>
            <view wx:if="{{consent && consent.anyBlocked}}" class="consent-recovery" aria-role="status">
              <view class="consent-recovery-title">{{i18n.t(ui,'微信提醒权限未开启')}}</view>
              <view class="consent-recovery-desc">{{i18n.t(ui,'微信已拒绝以下消息；库存监测继续，但对应提醒暂无法接收。')}}</view>
              <view class="consent-recovery-row" wx:for="{{consent.blocked}}" wx:key="id"><text class="consent-recovery-name">{{i18n.t(ui,(item.title))}}</text><text class="consent-recovery-state">{{i18n.t(ui,(item.label))}}</text></view>
              <button class="btn btn-primary btn-block consent-recovery-action" bindtap="onOpenSubscribeSetting">{{i18n.t(ui,'前往微信设置')}}</button>
              <view class="consent-recovery-steps">{{i18n.t(ui,'微信设置 → 订阅消息 → 改为「接收」后返回补充次数。')}}</view>
            </view>
            <button wx:if="{{boot.member && subscription.templateCount}}" class="btn {{primaryTopUp ? 'btn-primary btn-block' : 'btn-sm reminder-direct-compact'}} reminder-direct-button" hover-class="btn-primary-pressed" disabled="{{subscribing || authorization.storageBlocked || editing || saving}}" loading="{{subscribing}}" bindtap="onSubscribe">{{i18n.t(ui,(subscribing ? '等待微信授权…' : '补充提醒次数'))}}</button>
            <view wx:if="{{authorizationFeedback}}" class="authorization-feedback" aria-live="polite">{{i18n.t(ui,(authorizationFeedback))}}</view>
            <view wx:if="{{subscriptionPending || authorization.errorMessage}}" class="authorization-sync-error" aria-role="status"><text>{{i18n.t(ui,(authorization.errorMessage || '微信已允许，次数待同步'))}}</text><button class="ui-action" disabled="{{authorization.syncing}}" loading="{{authorization.syncing}}" bindtap="onRetryAuthorizationSync">{{i18n.t(ui,'重试同步')}}</button></view>
            <button wx:if="{{!readiness.ready && readiness.action && readiness.action !== 'subscribe' && readiness.action !== 'add' && readiness.action !== 'follows'}}" class="btn btn-sm mt" hover-class="ui-control-pressed" bindtap="onReadinessAction">{{i18n.t(ui,(readiness.actionLabel))}}</button>
            <view wx:if="{{showServiceDetails}}" class="service-details ui-reveal">
              <view wx:if="{{!readiness.ready}}" class="service-detail">{{i18n.t(ui,(readinessTaskDetail))}}</view>
              <view id="reminder-service-details" class="service-row"><view class="service-heading"><text class="service-title">{{i18n.t(ui,'后台检测')}}</text><view class="pill pill-dot pill-{{collector.cls}}">{{i18n.t(ui,(collector.label))}}</view></view><view class="service-detail">{{i18n.t(ui,(collector.detail))}}</view></view>
              <view class="service-row"><view class="service-heading"><text class="service-title">{{i18n.t(ui,'消息发送')}}</text><view class="pill pill-dot pill-{{delivery.cls}}">{{i18n.t(ui,(delivery.label))}}</view></view><view class="service-detail">{{i18n.t(ui,(delivery.detail))}}</view></view>
              <view class="service-row"><view class="service-heading"><text class="service-title">{{i18n.t(ui,(boot.member ? '会员至 ' + boot.expiresText : (boot.expired ? '会员已到期' : '免费用户')))}}</text><button class="ui-action ui-action--plain" hover-class="ui-control-pressed" bindtap="onGoReminderSettings"><text class="ui-action-label">{{i18n.t(ui,'前往提醒设置')}}</text><view class="ui-chevron" aria-hidden="true"></view></button></view><view class="service-detail">{{i18n.t(ui,'每条提醒消耗 1 次授权，免打扰期间不发送。')}}</view></view>
              <view class="status-footer"><text class="service-detail">{{i18n.t(ui,(refreshedText ? '页面读取 ' + refreshedText : ''))}}</text><button class="ui-action ui-action--plain" hover-class="ui-control-pressed" bindtap="onServiceDetails"><text class="ui-action-label">{{i18n.t(ui,'服务详情')}}</text><view class="ui-chevron" aria-hidden="true"></view></button></view>
              <view class="reminder-shortcuts"><button class="ui-action" hover-class="ui-control-pressed" bindtap="onManageReminders">{{i18n.t(ui,'管理提醒记录')}}</button><button class="ui-action" hover-class="ui-control-pressed" bindtap="onTestNotification">{{i18n.t(ui,'测试收信')}}</button></view>
            </view>
          </view>
        </view>
      </block>
    </view>
  </view>
</view>

<config-sheet wx:if="{{editing}}" id="follow-config-sheet" visible="{{editing}}" title="{{i18n.t(ui,(editor.isNew ? '添加关注' : '调整关注'))}}" confirm-text="{{i18n.t(ui,'保存关注')}}" busy="{{saving}}" disabled="{{!editorCanSave}}" dirty="{{editorDirty}}" summary="{{editorSummary}}" external-close="{{true}}" bindconfirm="onSave" bindrequestclose="onRequestCloseEditor" bindclose="onCancelEdit">
  <target-picker id="follow-target-picker" disabled="{{saving}}" catalog-version="{{catalogVersion}}" value="{{editor.pickerValue}}" max-stores="{{limits.maxStoresPerFollow}}" supported-only="{{true}}" in-sheet="{{true}}" bindchange="onEditorChange" />
  <view slot="notice" wx:if="{{saveError}}" class="banner banner-warn" aria-role="alert">{{i18n.t(ui,(saveError))}}</view>
</config-sheet>

<reminder-nudge enabled="{{ready && followsLoaded}}" blocked="{{authorizationOpen || editing || saving || subscribing || refreshing || alert || followBusyId}}" />

<config-sheet wx:if="{{authorizationOpen}}" visible="{{authorizationOpen}}" title="{{i18n.t(ui,'补充微信提醒次数')}}" confirm-text="{{i18n.t(ui,'完成')}}" disabled="{{subscribing}}" external-close="{{true}}" bindconfirm="onCloseAuthorizationPanel" bindrequestclose="onCloseAuthorizationPanel" bindclose="onCloseAuthorizationPanel">
  <reminder-authorization subscription="{{subscription}}" authorization="{{authorization}}" member="{{boot.member}}" busy="{{subscribing}}" feedback="{{authorizationFeedback}}" bindauthorize="onSubscribe" bindretry="onRetryAuthorizationSync" />
  <view wx:if="{{creditBoostTip}}" class="small text-2 mt">{{i18n.t(ui,(creditBoostTip))}}</view>
</config-sheet>
