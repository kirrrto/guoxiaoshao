<view class="page tab-page">
  <view wx:if="{{loadError}}" class="card">
    <view class="banner banner-bad">加载失败：{{loadError}}</view>
    <button class="btn btn-outline btn-block" bindtap="onRetryLoad">重试</button>
  </view>

  <block wx:elif="{{!ready}}">
    <view class="card"><view class="loading-line">正在加载关注列表…</view></view>
  </block>

  <block wx:else>
    <view class="page-heading whistle-heading"><view class="whistle-mark"><image class="whistle-heading-image" src="/images/brand/whistle-green.png" mode="aspectFit" aria-hidden="true" /></view><view class="whistle-heading-copy"><view class="page-title">小哨</view><view class="page-subtitle">关注配置，取货有变化再提醒</view></view></view>
    <view wx:if="{{refreshError}}" class="banner banner-warn">{{refreshError}}</view>
    <view wx:if="{{boot.freeReminder}}" class="banner banner-ok">新用户免费体验：可关注 1 个配置，并收到 1 条到货提醒。</view>
    <view wx:if="{{alert}}" id="restock-alert" class="card alert-card">
      <view class="card-title">
        <text>到货提醒</text>
        <text class="service-link" bindtap="onCloseAlert">关闭</text>
      </view>
      <view wx:if="{{alert.loading}}" class="loading-line">正在读取这条提醒…</view>
      <view wx:elif="{{alert.error}}" class="small text-2">{{alert.error}}</view>
      <block wx:else>
        <text class="bold alert-product" user-select>{{alert.productTitle}}</text>
        <text class="tiny muted mono alert-meta" user-select>{{alert.partNumber}} · Apple {{alert.storeName}}</text>
        <view class="alert-row"><text class="small text-2">{{alert.eventLabel}}</text><text class="small">{{alert.foundText}}（{{alert.agoText}}）</text></view>
        <view class="alert-row"><text class="small text-2">现在</text><view class="pill pill-dot pill-{{alert.nowCls}}">{{alert.nowLabel}}</view></view>
        <view class="tiny muted">{{alert.nowText}}。门店库存变化很快，请尽快在 Apple Store App 或官网确认下单。</view>
        <view class="btn-row">
          <button class="btn btn-primary btn-sm" bindtap="onCopyAlert">复制型号和门店</button>
          <button wx:if="{{boot.member && alert.followActive}}" class="btn btn-outline btn-sm" disabled="{{subscribing}}" bindtap="onSubscribe">再加一次提醒</button>
        </view>
        <view class="alert-feedback">
          <text class="small text-2">{{alert.feedback === 'bought' ? '已买到，祝使用愉快' : (alert.feedback ? '已记录你的反馈' : '买到了吗？')}}</text>
          <view wx:if="{{alert.feedback !== 'bought'}}" class="alert-feedback-actions">
            <button class="btn btn-ghost btn-sm" data-outcome="bought" disabled="{{alertBusy}}" bindtap="onAlertFeedback">买到了</button>
            <button class="btn btn-ghost btn-sm" data-outcome="missed" disabled="{{alertBusy}}" bindtap="onAlertFeedback">没抢到</button>
            <button class="btn btn-ghost btn-sm" data-outcome="skipped" disabled="{{alertBusy}}" bindtap="onAlertFeedback">没去买</button>
          </view>
        </view>
      </block>
    </view>
    <view id="reminder-health" class="card monitor-panel">
      <view class="card-title monitor-heading">
        <text class="monitor-title">{{readiness.title}}</text>
        <button class="btn btn-ghost btn-sm compact-action" loading="{{refreshing}}" disabled="{{refreshing}}" bindtap="onRefreshStatus">{{refreshing ? '刷新中' : '刷新'}}</button>
      </view>
      <view class="readiness-summary readiness-{{readiness.tone}}" aria-live="polite">
        <view class="readiness-detail">{{readiness.detail}}</view>
        <button wx:if="{{readiness.action}}" class="btn btn-primary readiness-action" disabled="{{subscribing || refreshing || saving}}" bindtap="onReadinessAction">{{subscribing && readiness.action === 'subscribe' ? '处理中…' : readiness.actionLabel}}</button>
      </view>
      <view class="status-footer">
        <text class="tiny muted">{{followsLoaded ? readiness.activeCount + ' 配置 · ' + readiness.storeCount + ' 店' : ''}}{{subscription.templateCount && boot.member ? ' · 剩余提醒 ' + subscription.credits + ' 次' : ''}} · {{boot.member ? '会员至 ' + boot.expiresText : (boot.expired ? '会员已到期' : (boot.freeReminder ? '免费体验中' : '免费用户'))}}</text>
        <text class="service-link" bindtap="onToggleServiceDetails">{{showServiceDetails ? '收起详情 ▴' : '详情 ▾'}}</text>
      </view>
      <block wx:if="{{showServiceDetails}}">
        <view class="service-row">
          <view class="service-heading"><text class="service-title">后台检测</text><view class="pill pill-dot pill-{{collector.cls}}">{{collector.label}}</view></view>
          <view class="service-detail">{{collector.detail}}</view>
        </view>
        <view class="service-row">
          <view class="service-heading"><text class="service-title">消息发送</text><view class="pill pill-dot pill-{{delivery.cls}}">{{delivery.label}}</view></view>
          <view class="service-detail">{{delivery.detail}}</view>
        </view>
        <view class="service-row authorization-row">
          <view class="authorization-copy"><view class="service-title">提醒次数</view><view class="service-detail">{{!subscription.templateCount ? (boot.templateTitle ? boot.templateTitle : '待模板配置') : (boot.member ? '剩余 ' + subscription.credits + ' 次，每次补货提醒消耗 1 次，可连续点击累加' : (boot.freeReminder ? (subscription.credits ? '已授权，补货时免费提醒 1 次' : '免费体验 1 条到货提醒，需授权 1 次') : '到货提醒为会员专属'))}}</view></view>
          <button class="btn btn-ghost btn-sm compact-action" disabled="{{subscribing}}" bindtap="onSubscribe">{{subscribing ? '处理中' : (subscriptionPending ? '同步授权' : (!subscription.templateCount ? '查看原因' : (boot.member ? '增加提醒次数' : (boot.freeReminder ? '授权提醒' : '了解会员'))))}}</button>
        </view>
        <view class="status-footer"><text class="tiny muted">{{refreshedText ? '最近读取 ' + refreshedText : ''}}</text><text class="service-link" bindtap="onServiceDetails">服务详情 ›</text></view>
        <view class="tiny muted subscription-rule">订阅消息声音跟随微信设置；免打扰时段不发送。</view>
        <view wx:if="{{!boot.member}}" class="member-summary">
          <text class="small text-2">{{boot.expired ? '会员已到期，监测与提醒已停' : (boot.freeReminder ? '免费体验：1 个配置、1 条提醒' : (boot.freeReminderUsed ? '免费体验提醒已用完' : '免费用户不自动提醒'))}}</text>
          <text class="small" style="color: var(--green-dark);" bindtap="onGoMine">了解会员 ›</text>
        </view>
      </block>
    </view>

    <!-- 编辑器 -->
    <view wx:if="{{editing}}" class="card">
      <view class="card-title">
        <text>{{editor.isNew ? '添加关注' : '编辑关注'}}</text>
        <text class="sub">每机型最多 {{limits.maxStoresPerFollow}} 家门店</text>
      </view>
      <target-picker catalog-version="{{catalogVersion}}" value="{{editor.pickerValue}}" max-stores="{{limits.maxStoresPerFollow}}" supported-only="{{true}}" bindchange="onEditorChange" />
      <view class="btn-row">
        <button class="btn btn-outline" bindtap="onCancelEdit">取消</button>
        <button class="btn btn-primary {{saving ? 'disabled' : ''}}" disabled="{{saving}}" bindtap="onSave">{{saving ? '保存中…' : '保存'}}</button>
      </view>
    </view>

    <!-- 关注列表 -->
    <view id="follow-configurations" class="card">
      <view class="card-title">
        <text>我的关注 <text class="follow-count">{{follows.length}}/{{limits.maxFollows}}</text></text>
        <button wx:if="{{!editing}}" class="btn btn-primary btn-sm compact-action" bindtap="onAdd">＋ 添加</button>
      </view>

      <view wx:if="{{!follows.length}}" class="empty">
        <view class="empty-symbol"><image class="empty-whistle" src="/images/brand/whistle-green.png" mode="aspectFit" aria-hidden="true" /></view>
        <view>给心仪的配置留个小哨</view>
        <view class="tiny mt">{{boot.member || boot.freeReminder ? '点击添加，选择型号、容量、颜色和门店' : '会员可添加关注；购买开放情况见「我的」'}}</view>
      </view>

      <view wx:for="{{follows}}" wx:key="followId" id="follow-entry-{{index}}" class="follow">
        <view class="follow-product">
          <image wx:if="{{item.imageUrl}}" class="follow-image" src="{{item.imageUrl}}" mode="aspectFit" aria-label="{{item.imageAlt}}" data-index="{{index}}" binderror="onFollowImageError" />
          <view class="follow-head">
            <view class="follow-title">
              <text class="bold">{{item.productTitle}}</text>
              <view class="tiny muted mono">{{item.partNumber}}</view>
            </view>
            <text class="pill pill-{{item.statusCls}}">{{item.statusLabel}}</text>
          </view>
        </view>
        <view wx:if="{{item.monitoringText}}" class="tiny muted follow-note">{{item.monitoringText}}</view>
        <view wx:for="{{item.stores}}" wx:for-item="s" wx:key="storeNumber" class="store-row">
          <view class="store-heading">
            <text class="small store-name">{{s.city ? s.city + ' · ' : ''}}{{s.storeName}}</text>
            <view class="pill pill-dot pill-{{s.statusCls}} tiny">{{s.statusLabel}}</view>
          </view>
          <view class="tiny muted">
            {{s.observedText}}
            <text wx:if="{{s.sinceText}}"> · 距本轮首次记录 {{s.sinceText}}</text>
          </view>
          <view wx:if="{{s.lastKnownText}}" class="tiny muted mt">{{s.lastKnownText}}</view>
          <view wx:if="{{s.observationState !== 'fresh'}}" class="tiny stale-note">{{s.freshnessText}}</view>
          <view wx:elif="{{s.observationNote}}" class="tiny muted mt">{{s.observationNote}}</view>
        </view>
        <view class="btn-row follow-actions">
          <button class="btn btn-ghost btn-sm" data-id="{{item.followId}}" bindtap="onEdit">编辑</button>
          <button wx:if="{{boot.member || boot.freeReminder}}" class="btn btn-outline btn-sm" data-id="{{item.followId}}" data-status="{{item.status}}" bindtap="onToggle">{{item.status === 'active' ? '暂停关注' : '开启关注'}}</button>
          <button class="btn btn-danger btn-sm" data-id="{{item.followId}}" bindtap="onRemove">删除</button>
        </view>
      </view>
    </view>

    <view class="footer-note"><view>每个配置最多 {{limits.maxStoresPerFollow}} 家门店。不同容量或颜色各占一个名额。</view><view>页面约每分钟读取一次已有观测，自动检测由后台服务执行。</view></view>
  </block>
</view>
