<page-meta page-style="{{editing ? 'overflow:hidden;' : ''}}" />
<view class="page tab-page">
  <view wx:if="{{loadError}}" class="card load-error" role="alert">
    <view class="load-error-title">暂时没有连上</view>
    <view class="load-error-detail">{{loadError}}</view>
    <view class="load-error-hint">检查网络后重试，已保存的关注会保留。</view>
    <button class="btn btn-primary btn-block" bindtap="onRetryLoad">重试</button>
  </view>

  <block wx:elif="{{!ready}}">
    <view class="page-heading whistle-heading"><view class="whistle-mark"><image class="whistle-heading-image" src="/images/brand/whistle-green.png" mode="aspectFit" aria-hidden="true" /></view><view class="whistle-heading-copy"><view class="page-title">小哨</view><view class="page-subtitle">关注配置，取货有变化再提醒</view></view></view>
    <view class="skeleton" aria-busy="true">
      <view class="skeleton-card"><view class="skeleton-line skeleton-title"></view><view class="skeleton-line"></view><view class="skeleton-line skeleton-short"></view><view class="skeleton-bar"></view></view>
      <view class="loading-line">正在读取你的关注…</view>
    </view>
  </block>

  <block wx:else>
    <view class="page-heading whistle-heading">
      <view class="whistle-heading-copy"><view class="page-title">我的小哨</view><view class="page-subtitle">{{followsLoaded && follows.length ? readiness.activeCount + ' 个配置已开启 · 取货有变化再提醒' : '选好配置和门店，有变化再提醒你'}}</view></view>
      <button class="btn btn-ghost btn-sm compact-action" loading="{{refreshing}}" disabled="{{refreshing || saving}}" bindtap="onRefreshStatus">刷新</button>
    </view>
    <view wx:if="{{refreshError}}" class="banner banner-warn" role="alert">{{refreshError}}</view>

    <view wx:if="{{alert}}" id="restock-alert" class="card alert-card">
      <view class="card-title"><text>{{alert.soldOut ? '断货提醒' : '到货提醒'}}</text><button class="ui-action ui-action--neutral" hover-class="ui-control-pressed" bindtap="onCloseAlert">关闭</button></view>
      <view wx:if="{{alert.loading}}" class="loading-line">正在读取这条提醒…</view>
      <view wx:elif="{{alert.error}}">
        <view class="small text-2" role="alert">{{alert.error}}</view>
        <button wx:if="{{alert.retryable}}" class="btn btn-outline btn-block mt" bindtap="onRetryAlert">重新读取这条提醒</button>
      </view>
      <block wx:else>
        <text class="bold alert-product" user-select>{{alert.productTitle}}</text>
        <text class="tiny muted mono alert-meta" user-select>{{alert.partNumber}} · Apple {{alert.storeName}}</text>
        <view class="alert-row"><text class="small text-2">{{alert.eventLabel}}</text><text class="small">{{alert.foundText}}（{{alert.agoText}}）</text></view>
        <view class="alert-row"><text class="small text-2">最近状态</text><view class="pill pill-dot pill-{{alert.nowCls}}">{{alert.nowLabel}}</view></view>
        <view class="small text-2 alert-explanation">{{alert.nowText}}。请以官网实际取货信息为准。</view>
        <view class="btn-row"><button class="btn btn-primary" bindtap="onCopyAlert">复制型号和门店</button></view>
        <view wx:if="{{!alert.soldOut}}" class="alert-feedback">
          <text class="small text-2">{{alert.feedback === 'bought' ? '已记录买到反馈' : (alert.feedback ? '已记录你的反馈' : '买到了吗？')}}</text>
          <view wx:if="{{alert.feedback !== 'bought'}}" class="alert-feedback-actions">
            <button class="btn btn-ghost btn-sm" data-outcome="bought" disabled="{{alertBusy}}" bindtap="onAlertFeedback">{{alert.followActive ? '买到了，暂停此关注' : '买到了'}}</button>
            <button class="btn btn-ghost btn-sm" data-outcome="missed" disabled="{{alertBusy}}" bindtap="onAlertFeedback">没抢到</button>
            <button class="btn btn-ghost btn-sm" data-outcome="skipped" disabled="{{alertBusy}}" bindtap="onAlertFeedback">没去买</button>
          </view>
        </view>
      </block>
    </view>

    <view wx:if="{{readiness.action && readiness.action !== 'subscribe' && readiness.action !== 'add' && readiness.action !== 'follows'}}" class="card readiness-task readiness-{{readiness.tone}}" aria-live="polite">
      <view class="readiness-title">{{readiness.title}}</view>
      <view class="readiness-detail">{{readinessTaskDetail}}</view>
      <button class="btn btn-outline readiness-action" disabled="{{refreshing || saving}}" bindtap="onReadinessAction">{{readiness.actionLabel}}</button>
    </view>

    <view class="follow-content {{(authorizationSession ? authorizationPanelFirst : (readiness.action === 'subscribe' && !readiness.ready)) ? 'needs-authorization' : ''}}">
      <view id="follow-configurations" class="follow-configurations">
        <view class="section-heading">
          <view><text class="section-title">关注配置</text><text class="follow-count">{{boot.member ? follows.length + ' / ' + limits.maxFollows : (follows.length ? '已保存 ' + follows.length + ' 个' : '会员专属')}}</text></view>
          <button class="ui-action" hover-class="ui-control-pressed" disabled="{{!followsLoaded || saving || followBusyId}}" bindtap="onAdd">＋ 添加</button>
        </view>
        <view wx:if="{{!followsLoaded}}" class="card loading-line" aria-busy="true">正在确认已保存的关注…</view>
        <view wx:elif="{{!follows.length}}" class="card empty follow-empty">
          <view class="empty-symbol"><image class="empty-whistle" src="/images/brand/whistle-green.png" mode="aspectFit" aria-hidden="true" /></view>
          <view class="empty-title">给心仪的配置留个小哨</view>
          <view class="small mt">{{boot.member ? '选好型号、容量、颜色和门店后，后台帮你留意变化。' : '关注与到货提醒为会员专属；免费用户可用查询次数实时看货。'}}</view>
          <button class="btn btn-primary btn-block" bindtap="onAdd">{{boot.member ? '添加关注' : '了解会员'}}</button>
        </view>

        <view wx:for="{{follows}}" wx:key="followId" id="follow-entry-{{index}}" class="card follow {{item.hasAvailable ? 'follow-available' : ''}}">
          <view class="follow-product">
            <image wx:if="{{item.imageUrl}}" class="follow-image" src="{{item.imageUrl}}" mode="aspectFit" aria-label="{{item.imageAlt}}" data-index="{{index}}" binderror="onFollowImageError" />
            <view class="follow-head"><view class="follow-title"><text class="bold">{{item.productTitle}}</text></view><text class="pill pill-{{item.statusCls}}">{{item.statusLabel}}</text></view>
          </view>
          <view wx:if="{{item.monitoringText}}" class="small text-2 follow-note">{{item.monitoringText}}</view>
          <view wx:if="{{item.status === 'paused'}}" class="small text-2 follow-note">暂停仍占一个配置名额；下方为已记录的观测。</view>
          <view wx:for="{{item.stores}}" wx:for-item="s" wx:key="storeNumber" class="store-row">
            <view class="store-heading"><text class="store-name">{{s.storeLabel}}</text><view class="pill pill-dot pill-{{s.observationState === 'fresh' && s.status === 'unavailable' ? 'muted' : s.statusCls}}">{{s.statusLabel}}</view></view>
            <view class="store-observation">{{s.observationState === 'fresh' ? '观测 ' : (s.observationState === 'stale' || s.observationState === 'unknown' ? '上次检查 ' : '')}}{{s.observedText}}</view>
            <view wx:if="{{s.limitPaused || s.observationState !== 'fresh'}}" class="observation-warning">{{s.freshnessText}}</view>
            <block wx:if="{{item.detailsExpanded}}">
              <view wx:if="{{s.lastKnownText}}" class="small text-2 mt">{{s.lastKnownText}}</view>
              <view wx:if="{{s.sinceText}}" class="small text-2 mt">距本轮首次记录 {{s.sinceText}}</view>
              <view wx:elif="{{s.observationNote}}" class="small text-2 mt">{{s.observationNote}}</view>
            </block>
          </view>
          <view wx:if="{{followActionId === item.followId && followActionError}}" class="follow-action-error" role="alert"><text>{{followActionError}}</text><button class="ui-action" hover-class="ui-control-pressed" loading="{{refreshing}}" disabled="{{refreshing}}" bindtap="onRefreshStatus">刷新状态</button></view>
          <view class="btn-row follow-actions">
            <button wx:if="{{item.hasAvailable}}" class="btn btn-primary" data-id="{{item.followId}}" bindtap="onPickupInfo">取货信息</button>
            <button class="btn btn-outline" disabled="{{saving || followBusyId}}" data-id="{{item.followId}}" bindtap="onEdit">调整</button>
            <button wx:if="{{item.limitPaused}}" class="btn btn-ghost" disabled="{{saving || followBusyId}}" bindtap="showMemberModal">查看套餐</button>
            <button wx:elif="{{boot.member}}" class="btn btn-ghost" loading="{{followBusyId === item.followId}}" disabled="{{saving || followBusyId}}" data-id="{{item.followId}}" data-status="{{item.status}}" bindtap="onToggle">{{item.status === 'active' ? '暂停' : '恢复'}}</button>
          </view>
          <view class="follow-secondary"><text class="small text-2">{{item.stores.length}} 家门店 · 一个配置名额</text><button class="ui-action" hover-class="ui-control-pressed" aria-expanded="{{item.detailsExpanded}}" data-id="{{item.followId}}" bindtap="onToggleFollowDetails"><text class="ui-action-label">{{item.detailsExpanded ? '收起详情' : '详情与管理'}}</text><view class="ui-chevron {{item.detailsExpanded ? 'ui-chevron--up' : 'ui-chevron--down'}}" aria-hidden="true"></view></button></view>
          <view wx:if="{{item.detailsExpanded}}" class="follow-management"><text class="small text-2 mono" user-select>{{item.partNumber}}</text><button class="ui-action ui-action--neutral danger-action" hover-class="ui-control-pressed" disabled="{{saving || followBusyId}}" data-id="{{item.followId}}" bindtap="onRemove">删除关注</button></view>
        </view>
      </view>

      <view id="reminder-health" class="card monitor-panel">
        <view class="section-heading"><text class="section-title">微信提醒</text><button class="ui-action" hover-class="ui-control-pressed" aria-expanded="{{showServiceDetails}}" bindtap="onToggleServiceDetails"><text class="ui-action-label">{{showServiceDetails ? '收起详情' : '设置与状态'}}</text><view class="ui-chevron {{showServiceDetails ? 'ui-chevron--up' : 'ui-chevron--down'}}" aria-hidden="true"></view></button></view>
        <view id="reminder-authorization" class="reminder-credits-panel">
          <view wx:if="{{subscription.templateCount && boot.member}}" class="reminder-balances">
            <view class="reminder-balance"><view class="reminder-balance-main"><text class="reminder-balance-label">到货</text><text class="reminder-balance-value">{{subscription.credits}}<text class="reminder-balance-unit"> 次</text></text></view><text class="reminder-balance-pending">{{authorization.pendingRestock ? '待同步 +' + authorization.pendingRestock : '已同步可用'}}</text></view>
            <view wx:if="{{subscription.soldoutEnabled}}" class="reminder-balance"><view class="reminder-balance-main"><text class="reminder-balance-label">断货</text><text class="reminder-balance-value">{{subscription.soldoutCredits}}<text class="reminder-balance-unit"> 次</text></text></view><text class="reminder-balance-pending">{{authorization.pendingSoldout ? '待同步 +' + authorization.pendingSoldout : '已同步可用'}}</text></view>
          </view>
          <button id="increase-reminders" class="btn btn-primary btn-block" disabled="{{subscribing || authorization.storageBlocked}}" loading="{{subscribing}}" bindtap="onSubscribe">{{subscribing ? '等待微信授权…' : (!subscription.templateCount ? '查看原因' : (boot.member ? '增加提醒次数' : '了解会员'))}}</button>
          <view class="authorization-feedback small" aria-live="polite">{{authorizationFeedback || (subscriptionPending ? '微信授权记录待同步，可继续点击。' : (boot.member && subscription.templateCount ? '微信允许后可继续点击，无需等待同步。' : ''))}}</view>
          <view wx:if="{{authorization.errorMessage}}" class="authorization-sync-error" role="alert"><text>{{authorization.errorMessage}}</text><button wx:if="{{authorization.pendingCount || authorization.storageBlocked}}" class="ui-action" hover-class="ui-control-pressed" loading="{{authorization.syncing}}" disabled="{{authorization.syncing}}" bindtap="onRetryAuthorizationSync">重试同步</button></view>
          <view class="small text-2 authorization-hint">{{!subscription.templateCount ? (boot.templateTitle || '待模板配置') : (boot.member ? (subscription.soldoutEnabled ? '每次允许，到货、断货各 +1；也可只允许其中一项。' : '每次允许，到货提醒 +1。') : '关注与到货提醒为会员专属')}}</view>
          <view wx:if="{{creditBoostTip}}" class="small credit-boost-tip">{{creditBoostTip}}</view>
        </view>
        <view wx:if="{{readiness.action === 'subscribe' && readiness.code !== 'ready'}}" class="credit-notice"><text class="bold">{{readiness.title}}</text><view class="small text-2 mt">{{readiness.detail}}</view></view>
        <view class="health-summary"><view class="pill pill-{{readiness.tone}}">{{readiness.ready ? '提醒条件已就绪' : readiness.title}}</view><text class="small text-2">{{collector.state === 'running' ? '后台已连接，观测时间见配置卡' : '后台：' + collector.label}}</text></view>
        <block wx:if="{{showServiceDetails}}">
          <view id="reminder-service-details" class="service-row"><view class="service-heading"><text class="service-title">后台检测</text><view class="pill pill-dot pill-{{collector.cls}}">{{collector.label}}</view></view><view class="service-detail">{{collector.detail}}</view></view>
          <view class="service-row"><view class="service-heading"><text class="service-title">消息发送</text><view class="pill pill-dot pill-{{delivery.cls}}">{{delivery.label}}</view></view><view class="service-detail">{{delivery.detail}}</view></view>
          <view class="service-row"><text class="small text-2">{{boot.member ? '会员至 ' + boot.expiresText : (boot.expired ? '会员已到期' : '免费用户')}}</text><view class="service-detail">每条微信消息消耗对应类型的 1 次授权；免打扰期间不发送，声音跟随微信设置。</view><button class="ui-action" hover-class="ui-control-pressed" bindtap="onGoReminderSettings"><text class="ui-action-label">前往提醒设置</text><view class="ui-chevron" aria-hidden="true"></view></button></view>
          <view class="status-footer"><text class="small text-2">{{refreshedText ? '页面读取 ' + refreshedText : ''}}</text><button class="ui-action" hover-class="ui-control-pressed" bindtap="onServiceDetails"><text class="ui-action-label">服务详情</text><view class="ui-chevron" aria-hidden="true"></view></button></view>
          <view class="small text-2 subscription-rule">每个配置最多 {{limits.maxStoresPerFollow}} 家门店，不同容量或颜色各占一个名额。后台确认变化后才提醒，页面刷新不等于重新检测库存。</view>
        </block>
      </view>
    </view>
    <view class="footer-note">最近观测仅供参考，请以官网实际取货信息为准。</view>
  </block>
</view>

<config-sheet wx:if="{{editing}}" id="follow-config-sheet" visible="{{editing}}" title="{{editor.isNew ? '添加关注' : '调整关注'}}" subtitle="每个配置最多 {{limits.maxStoresPerFollow}} 家门店" confirm-text="保存关注" busy="{{saving}}" disabled="{{!editorCanSave}}" dirty="{{editorDirty}}" summary="{{editorSummary}}" external-close="{{true}}" bindconfirm="onSave" bindrequestclose="onRequestCloseEditor" bindclose="onCancelEdit">
  <target-picker id="follow-target-picker" catalog-version="{{catalogVersion}}" value="{{editor.pickerValue}}" max-stores="{{limits.maxStoresPerFollow}}" supported-only="{{true}}" in-sheet="{{true}}" bindchange="onEditorChange" />
  <view slot="notice" wx:if="{{saveError}}" class="banner banner-warn small" role="alert">{{saveError}}</view>
</config-sheet>

<reminder-nudge enabled="{{ready && followsLoaded}}" blocked="{{editing || saving || subscribing || refreshing || alert || followBusyId}}" />
