@import "../../styles/reminder-center.wxss";

/* 小哨页。公共组件见 styles/common.wxss，令牌见 app.wxss。 */
.compact-action.ui-action { flex: none; }
.follow-list-pane { display: none; }

/* ── 到期提醒 ─────────────────────────────────────────── */
.deadline-home-heading { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: var(--sp-8) var(--sp-12); margin-bottom: var(--sp-8); }
.deadline-heading-copy { display: flex; flex: 1 1 auto; flex-wrap: wrap; align-items: baseline; gap: var(--sp-2) var(--sp-8); min-width: 0; }
.deadline-heading-copy .card-title { margin-bottom: 0; }
.deadline-service-label { color: var(--text-3); font-size: var(--fs-sub); }
.deadline-home-action.btn { flex: none; }
.deadline-home-manage.ui-action { flex: 0 1 auto; }
.deadline-home-empty { color: var(--text-2); font-size: var(--fs-sub); }
.deadline-record-only { color: var(--text-3); font-size: var(--fs-sub); }
.deadline-home-row { padding: var(--sp-12) 0; border-top: 1px solid var(--line); }
.deadline-home-row:first-child { padding-top: 0; border-top: 0; }
.deadline-home-row:last-child { padding-bottom: 0; }
.deadline-record-only + .deadline-home-row { margin-top: var(--sp-12); }
.deadline-home-item { display: flex; flex-wrap: wrap; align-items: baseline; gap: var(--sp-2) var(--sp-12); }
.deadline-home-title { flex: 1 1 90px; min-width: 0; font-weight: 600; line-height: var(--lh-snug); overflow-wrap: anywhere; }
.deadline-home-date { color: var(--text-2); font-size: var(--fs-sub); }
.deadline-home-next { display: flex; flex-wrap: wrap; align-items: baseline; gap: var(--sp-2) var(--sp-8); margin-top: var(--sp-4); color: var(--text-2); font-size: var(--fs-sub); }
.deadline-next-time { color: var(--text); font-size: var(--fs-title); font-weight: 600; line-height: var(--lh-tight); }
.deadline-home-delivery { display: flex; flex-direction: column; gap: var(--sp-2); margin-top: var(--sp-4); color: var(--text-2); font-size: var(--fs-sub); overflow-wrap: anywhere; }
.deadline-home-state { display: flex; align-items: center; gap: var(--sp-8); font-weight: 600; }
.deadline-home-state::before { content: ''; flex: none; width: 6px; height: 6px; border-radius: 50%; background: currentColor; }
.deadline-home-state--ok { color: var(--green-text); }
.deadline-home-state--warn { color: var(--warn); }
.deadline-home-state--bad { color: var(--bad); }
.deadline-home-error { display: flex; flex-wrap: wrap; align-items: center; gap: var(--sp-8); color: var(--warn); font-size: var(--fs-sub); }
.deadline-home-error > text { flex: 1 1 120px; min-width: 0; overflow-wrap: anywhere; }

/* ── 苹果库存：分区标题与同步状态 ─────────────────────── */
.inventory-heading-copy { display: flex; flex: 1 1 auto; flex-wrap: wrap; align-items: baseline; gap: var(--sp-2) var(--sp-8); min-width: 0; }
.inventory-allowance { color: var(--text-3); font-size: var(--fs-sub); }
.follow-sync-bar { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: var(--sp-4) var(--sp-12); margin-bottom: var(--sp-8); color: var(--text-2); font-size: var(--fs-caption); }
.follow-sync-copy { display: flex; align-items: center; gap: var(--sp-8); min-width: 0; }
.follow-sync-dot { flex: none; width: 6px; height: 6px; border-radius: 50%; background: var(--text-3); }
.follow-sync-dot--offline, .follow-sync-dot--retrying { background: var(--warn); }
.follow-sync-times { display: flex; flex-wrap: wrap; gap: var(--sp-2) var(--sp-8); }
.follow-inventory-status { display: flex; flex-direction: column; gap: var(--sp-2); margin-bottom: var(--sp-12); color: var(--text-2); font-size: var(--fs-sub); }
.follow-inventory-status .bold { color: var(--text); }
.follow-inventory-status--warn .bold { color: var(--warn); }
.follow-refresh-feedback { margin-bottom: var(--sp-12); color: var(--text-2); font-size: var(--fs-sub); overflow-wrap: anywhere; }

/* 需要处理的提醒授权排在关注列表前，日常状态排在后。 */
.follow-content { display: flex; flex-direction: column; }
.follow-configurations { order: 10; }
.reminder-status-strip { order: 5; }
.reminder-status-routine { order: 20; }

/* ── 关注卡 ───────────────────────────────────────────── */
.follow-product { display: flex; align-items: center; gap: var(--sp-12); min-width: 0; }
.follow-image { width: 56px; height: 56px; }
.follow-image-placeholder image { width: 24px; height: 24px; }
.follow-head { display: flex; flex: 1 1 0; flex-direction: column; gap: var(--sp-2); min-width: 0; }
.follow-title { font-size: var(--fs-headline); line-height: var(--lh-snug); overflow-wrap: anywhere; }
.follow-variant { color: var(--text-2); font-size: var(--fs-sub); }
.follow-status { display: flex; align-items: center; gap: var(--sp-8); color: var(--text-2); font-size: var(--fs-sub); }
.follow-status-dot { flex: none; width: 6px; height: 6px; border-radius: 50%; background: currentColor; }
.follow-status--ok { color: var(--green-text); }
.follow-status--warn { color: var(--warn); }
.follow-note { margin-top: var(--sp-12); color: var(--text-2); font-size: var(--fs-sub); overflow-wrap: anywhere; }

/* 观测行：状态词与观测时间成对出现。 */
.follow-stock-panel { margin-top: var(--sp-16); }
.follow-stock-heading { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: var(--sp-2) var(--sp-12); }
.follow-stock-state { display: flex; align-items: center; gap: var(--sp-8); min-width: 0; }
.follow-stock-label { font-size: var(--fs-title); font-weight: 600; line-height: var(--lh-tight); }
.follow-stock-panel--warn .follow-stock-label { color: var(--warn); }
.follow-stock-time { color: var(--text-2); font-size: var(--fs-sub); }
.follow-stock-detail { margin-top: var(--sp-4); color: var(--text-2); font-size: var(--fs-sub); overflow-wrap: anywhere; }
.follow-partial-note { margin-top: var(--sp-4); color: var(--warn); font-size: var(--fs-sub); }
.follow-primary-actions { margin-top: var(--sp-16); }

/* 有货：整张卡转为薄荷绿，辅助文字随之取绿色调。 */
.card.follow-available { background: var(--green-soft); }
.follow-available .follow-variant, .follow-available .follow-stock-time, .follow-available .follow-stock-detail { color: var(--green-text); }

.follow .follow-detail-entry {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--sp-12);
  width: 100%;
  max-width: 100%;
  min-width: 0;
  height: auto;
  min-height: var(--tap);
  margin: var(--sp-12) 0 0;
  padding: var(--sp-8) 0 0;
  border: 0;
  border-top: 1px solid var(--line);
  border-radius: 0;
  background: transparent;
  color: var(--text-2);
  font-size: var(--fs-sub);
  font-weight: 400;
  line-height: var(--lh-snug);
  text-align: left;
}
.follow-detail-count { min-width: 0; white-space: nowrap; }
.follow-detail-label { display: flex; flex: none; align-items: center; gap: var(--sp-8); color: var(--text); white-space: nowrap; }
.follow-details { padding-top: var(--sp-8); }
.store-row { padding: var(--sp-12) 0; border-top: 1px solid var(--line); }
.store-heading { display: flex; align-items: flex-start; justify-content: space-between; flex-wrap: wrap; gap: var(--sp-4) var(--sp-12); }
.store-name { flex: 1 1 100px; min-width: 0; font-weight: 600; line-height: var(--lh-snug); overflow-wrap: anywhere; }
.store-heading .pill { flex: 0 1 auto; }
.store-observation { margin-top: var(--sp-2); color: var(--text-2); font-size: var(--fs-sub); }
.store-detail-note { margin-top: var(--sp-2); color: var(--text-3); font-size: var(--fs-caption); }
.follow-action-error { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: var(--sp-8); margin-bottom: var(--sp-12); padding: var(--sp-12); border-radius: var(--radius-control); background: var(--warn-soft); color: var(--warn); font-size: var(--fs-sub); }
.follow-action-error > text { flex: 1 1 100px; min-width: 0; }
.follow-actions.btn-row { margin-top: 0; padding-top: var(--sp-12); border-top: 1px solid var(--line); }
.follow-actions .btn.follow-optional-query { flex: 1 1 100%; }
.follow-management { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: var(--sp-4) var(--sp-12); margin-top: var(--sp-4); }
.follow-part { color: var(--text-3); font-size: var(--fs-caption); }
.follow-add-footer { margin: 0 0 var(--sp-12); }
.follow-empty .card-title { margin-bottom: var(--sp-4); }
.follow-empty .btn.btn { margin-top: var(--sp-16); }

/* ── 开通后的设置步骤、到货提醒落地卡 ─────────────────── */
.activation-steps { display: flex; flex-wrap: wrap; gap: var(--sp-8) var(--sp-16); margin: var(--sp-12) 0; }
.activation-step { display: flex; align-items: center; gap: var(--sp-8); color: var(--text-2); font-size: var(--fs-sub); }
.activation-dot { display: flex; align-items: center; justify-content: center; width: 20px; height: 20px; border: 1.5px solid var(--text-3); border-radius: 50%; font-size: var(--fs-caption); line-height: 1; }
.activation-step--done .activation-dot { border-color: var(--green); background: var(--green); color: var(--green-ink); }
.activation-dot .ui-check { margin-bottom: var(--sp-2); }
.alert-product { display: block; font-size: var(--fs-headline); font-weight: 600; line-height: var(--lh-snug); overflow-wrap: anywhere; }
.alert-meta { display: block; margin: var(--sp-2) 0 var(--sp-8); color: var(--text-3); font-size: var(--fs-caption); overflow-wrap: anywhere; }
.alert-row { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: var(--sp-4) var(--sp-12); padding: var(--sp-8) 0; border-top: 1px solid var(--line); font-size: var(--fs-sub); }
.alert-explanation { padding-top: var(--sp-8); border-top: 1px solid var(--line); color: var(--text-2); font-size: var(--fs-sub); }
.alert-feedback { display: flex; flex-direction: column; align-items: flex-start; gap: var(--sp-8); margin-top: var(--sp-16); padding-top: var(--sp-12); border-top: 1px solid var(--line); }
.alert-feedback-actions { display: flex; flex-wrap: wrap; gap: var(--sp-8); }

/* ── 微信提醒状态 ─────────────────────────────────────── */
.reminder-status-row { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: var(--sp-8); }
.reminder-status-copy { display: flex; flex: 1 1 130px; flex-direction: column; gap: var(--sp-2); min-width: 0; }
.reminder-inline-balance { color: var(--text-2); font-size: var(--fs-sub); }
.reminder-details-toggle.ui-action { flex: none; }
.reminder-health-warning { margin-top: var(--sp-8); color: var(--warn); font-size: var(--fs-sub); overflow-wrap: anywhere; }
.reminder-direct-button.btn { margin-top: var(--sp-12); }
.reminder-direct-compact.btn { display: inline-flex; }
.service-details { margin-top: var(--sp-12); }
.service-row { padding: var(--sp-12) 0; border-top: 1px solid var(--line); }
.service-heading { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: var(--sp-4) var(--sp-12); }
.service-title { font-weight: 600; }
.service-detail { margin-top: var(--sp-2); color: var(--text-2); font-size: var(--fs-sub); overflow-wrap: anywhere; }
.status-footer { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: var(--sp-8); padding-top: var(--sp-4); border-top: 1px solid var(--line); }
.status-footer .service-detail { margin-top: 0; }
.reminder-shortcuts { display: flex; flex-wrap: wrap; gap: var(--sp-8); margin-top: var(--sp-8); }
.reminder-shortcuts .ui-action { flex: 1 1 auto; }

@media (min-width: 900px) {
  .follow-workspace {
    display: grid;
    grid-template-columns: minmax(300px, 0.85fr) minmax(0, 1.5fr);
    align-items: start;
    gap: var(--sp-24);
  }
  .follow-sidebar, .follow-detail-pane { min-width: 0; }
  .follow-list-pane { display: block; }
  .follow-workspace .inventory-home-heading, .follow-list-heading { margin-top: 0; }
  .follow-list { padding: var(--sp-8); }
  .follow-list .follow-list-choice {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--sp-12);
    width: 100%;
    min-height: var(--tap);
    margin: 0;
    padding: var(--sp-12);
    border: 0;
    border-radius: var(--radius-control);
    background: transparent;
    color: var(--text);
    font-size: var(--fs-body);
    font-weight: 400;
    line-height: var(--lh-snug);
    text-align: left;
  }
  .follow-list .follow-list-choice::after { border: 0; }
  .follow-list .follow-list-choice--selected { background: var(--surface-top); }
  .follow-choice-copy { display: flex; flex: 1 1 0; flex-direction: column; gap: var(--sp-2); min-width: 0; }
  .follow-choice-title { font-weight: 600; }
  .follow-choice-meta { color: var(--text-2); font-size: var(--fs-sub); }
  .follow-configurations { order: 0; }
  .follow-configurations .follow { display: none; }
  .follow-configurations .follow--selected { display: block; }
}
