.whistle-heading { display: flex; align-items: center; gap: 20rpx; }
.whistle-mark { display: flex; align-items: center; justify-content: center; flex: 0 0 80rpx; width: 80rpx; height: 80rpx; border-radius: 24rpx; background: var(--green-soft); }
.whistle-heading-image { display: block; width: 54rpx; height: 54rpx; }
.whistle-heading-copy { flex: 1; min-width: 0; }
.whistle-heading-copy .page-subtitle { line-height: 1.65; }
.compact-action.btn { flex: none; width: auto; min-width: 64px; min-height: 44px; padding: 0 20rpx; }
.text-action { display: inline-flex; align-items: center; justify-content: center; flex: none; min-width: 44px; min-height: 44px; height: auto; margin: 0; padding: 8rpx 4rpx; font-size: 26rpx; line-height: 1.45; font-weight: 500; color: var(--green-dark); background: transparent; border: 0; border-radius: 12rpx; white-space: normal; }
.text-action::after { border: 0; }
.text-action[disabled] { color: var(--text-3); background: transparent; }
.section-heading { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 8rpx 16rpx; margin-bottom: 16rpx; }
.section-title { color: var(--text); font-size: 32rpx; line-height: 1.5; font-weight: 650; }
.follow-count { color: var(--text-2); font-size: 26rpx; margin-left: 12rpx; }
.follow-content { display: flex; flex-direction: column; }
.follow-configurations { order: 10; }
.monitor-panel { order: 20; }
.needs-authorization .monitor-panel { order: 5; }
.readiness-task.card { padding: 24rpx; border: 1rpx solid var(--line); background: var(--warn-soft); box-shadow: none; }
.readiness-title { font-size: 30rpx; font-weight: 650; color: var(--text); line-height: 1.5; overflow-wrap: anywhere; }
.readiness-detail { font-size: 28rpx; color: var(--text-2); line-height: 1.6; margin-top: 8rpx; overflow-wrap: anywhere; }
.readiness-action.btn { width: auto; min-height: 44px; margin-top: 16rpx; font-size: 28rpx; white-space: normal; }
.follow.card { padding: 28rpx; border: 1rpx solid var(--line); }
.follow-available.card { border-color: var(--green-dark); }
.follow-product { display: flex; align-items: center; gap: 20rpx; min-width: 0; }
.follow-product .follow-image { width: 100rpx; height: 116rpx; flex: 0 0 100rpx; padding: 6rpx; border-radius: 18rpx; background: var(--image-tile); }
.follow-head { display: flex; flex: 1; flex-direction: column; align-items: flex-start; gap: 10rpx; min-width: 0; }
.follow-title { width: 100%; min-width: 0; color: var(--text); font-size: 32rpx; line-height: 1.45; }
.follow-title .bold { display: block; white-space: normal; overflow-wrap: anywhere; }
.follow-note { margin-top: 16rpx; line-height: 1.6; }
.store-row { margin-top: 20rpx; padding-top: 20rpx; border-top: 1rpx solid var(--line); }
.store-heading { display: flex; align-items: flex-start; justify-content: space-between; gap: 8rpx 12rpx; flex-wrap: wrap; margin-bottom: 8rpx; }
.store-name { flex: 1 1 200rpx; min-width: 0; color: var(--text); font-size: 28rpx; line-height: 1.55; font-weight: 500; overflow-wrap: anywhere; }
.store-heading .pill { flex: 0 1 auto; font-size: 26rpx; white-space: normal; }
.store-observation { color: var(--text-2); font-size: 26rpx; line-height: 1.6; }
.observation-warning { margin-top: 8rpx; color: var(--warn); font-size: 26rpx; line-height: 1.55; }
.follow-actions { gap: 12rpx; margin-top: 24rpx; }
.follow-actions .btn.btn { flex: 1 1 0%; min-width: 0; padding: 12rpx 8rpx; min-height: 44px; height: auto; line-height: 1.45; font-size: 28rpx; white-space: normal; }
.follow-secondary, .follow-management { display: flex; align-items: center; justify-content: space-between; gap: 8rpx 16rpx; flex-wrap: wrap; margin-top: 12rpx; }
.follow-management { border-top: 1rpx solid var(--line); padding-top: 12rpx; }
.danger-action { color: var(--bad); }
.follow-action-error { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 8rpx; margin-top: 16rpx; padding: 16rpx; background: var(--warn-soft); color: var(--warn); border-radius: 16rpx; font-size: 28rpx; line-height: 1.6; }
.follow-action-error text { flex: 1 1 200rpx; }
.follow-empty .empty-symbol { display: flex; justify-content: center; }
.empty-whistle { display: block; width: 64rpx; height: 64rpx; }
.empty-title { margin-top: 16rpx; color: var(--text); font-size: 32rpx; font-weight: 600; }
.follow-empty .btn { margin-top: 28rpx; }
.monitor-panel.card { background: var(--card); border: 1rpx solid var(--line); box-shadow: none; }
.monitor-panel .section-heading { margin-bottom: 4rpx; }
.credit-notice { padding: 16rpx 0; font-size: 28rpx; line-height: 1.6; color: var(--warn); }
.reminder-balances { display: flex; flex-wrap: wrap; gap: 16rpx; margin: 8rpx 0 20rpx; }
.reminder-balance { display: flex; flex: 1 1 0%; min-width: 0; align-items: baseline; justify-content: space-between; gap: 12rpx; padding: 16rpx 20rpx; border-radius: 16rpx; background: var(--surface-soft); }
.reminder-balance-label { font-size: 28rpx; color: var(--text-2); }
.reminder-balance-value { font-size: 36rpx; line-height: 1.4; font-weight: 700; color: var(--green-dark); overflow-wrap: anywhere; }
.reminder-balance-unit { font-size: 26rpx; font-weight: 400; }
.authorization-hint { margin-top: 12rpx; line-height: 1.6; text-align: center; }
.health-summary { display: flex; align-items: flex-start; flex-direction: column; gap: 12rpx; border-top: 1rpx solid var(--line); margin-top: 20rpx; padding-top: 20rpx; line-height: 1.6; }
.health-summary .pill { white-space: normal; }
.service-row { padding: 20rpx 0; border-top: 1rpx solid var(--line); margin-top: 16rpx; }
.service-heading { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 10rpx 16rpx; }
.service-title { font-size: 28rpx; font-weight: 600; color: var(--text); }
.service-heading .pill { font-size: 26rpx; padding: 5rpx 14rpx; white-space: normal; }
.service-detail { font-size: 28rpx; color: var(--text-2); line-height: 1.6; margin-top: 8rpx; overflow-wrap: anywhere; }
.status-footer { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 12rpx; padding-top: 12rpx; }
.subscription-rule { margin-top: 12rpx; line-height: 1.65; }
.alert-card { border: 1rpx solid var(--green-dark); }
.alert-product { display: block; font-size: 32rpx; line-height: 1.5; overflow-wrap: anywhere; }
.alert-meta { display: block; margin-top: 8rpx; overflow-wrap: anywhere; }
.alert-row { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 8rpx 16rpx; padding: 14rpx 0 6rpx; }
.alert-explanation { margin-top: 12rpx; line-height: 1.6; }
.alert-feedback { display: flex; align-items: flex-start; flex-direction: column; gap: 12rpx; margin-top: 20rpx; padding-top: 18rpx; border-top: 1rpx solid var(--line); }
.alert-feedback-actions { display: flex; flex-wrap: wrap; gap: 10rpx; }
.alert-feedback-actions .btn { flex: none; width: auto; min-height: 44px; height: auto; padding: 10rpx 18rpx; white-space: normal; line-height: 1.45; }
@media (prefers-color-scheme: dark) {
  .follow-product .follow-image { background: var(--image-tile); }
  .readiness-task.card { background: var(--warn-soft); }
}
