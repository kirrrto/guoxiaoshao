.whistle-heading { display: flex; align-items: center; gap: 20rpx; }
.whistle-mark { display: flex; align-items: center; justify-content: center; flex: 0 0 84rpx; width: 84rpx; height: 84rpx; border: 1rpx solid var(--glass-line); border-radius: 28rpx; background: rgba(255,255,255,.64); box-shadow: inset 0 2rpx 0 rgba(255,255,255,.86), var(--shadow-soft); }
.whistle-heading-image { display: block; width: 56rpx; height: 56rpx; }
.whistle-heading-copy { flex: 1; min-width: 0; }
.whistle-heading-copy .page-subtitle { line-height: 1.65; }
.empty-whistle { display: block; width: 62rpx; height: 62rpx; }
.monitor-panel { background: linear-gradient(135deg, rgba(255,255,255,.94), rgba(239,253,245,.80)); }
.monitor-heading { align-items: center; margin-bottom: 14rpx; }
.monitor-title { font-size: 30rpx; font-weight: 700; line-height: 1.45; overflow-wrap: anywhere; }
.readiness-summary { padding: 22rpx; border: 1rpx solid rgba(0,122,73,.12); border-radius: 24rpx; background: rgba(234,250,241,.76); margin: 10rpx 0 18rpx; }
.readiness-warn { background: rgba(255,248,232,.84); border-color: rgba(163,109,20,.12); }
.readiness-muted { background: rgba(242,247,244,.84); }
.readiness-title { font-size: 30rpx; font-weight: 700; color: var(--text); line-height: 1.5; overflow-wrap: anywhere; }
.readiness-detail { font-size: 24rpx; color: var(--text-2); line-height: 1.65; margin-top: 10rpx; overflow-wrap: anywhere; }
.readiness-action.btn { width: 100%; min-height: 88rpx; margin-top: 18rpx; font-size: 26rpx; white-space: normal; }
.readiness-metrics { display: flex; gap: 10rpx; padding: 4rpx 0 22rpx; }
.readiness-metric { display: flex; flex: 1 1 0%; min-width: 0; flex-direction: column; align-items: center; text-align: center; gap: 4rpx; }
.readiness-value { color: var(--green-dark); font-size: 34rpx; font-weight: 700; line-height: 1.3; }
.readiness-caption { color: var(--text-2); font-size: 21rpx; line-height: 1.5; white-space: normal; }
.compact-action.btn { flex: none; width: auto; min-width: 132rpx; }
.member-summary { display: flex; flex-wrap: wrap; align-items: center; gap: 8rpx 16rpx; padding-bottom: 12rpx; }
.service-row { padding: 20rpx 0; border-top: 1rpx solid var(--line); }
.service-heading { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 10rpx 16rpx; }
.service-title { font-size: 26rpx; font-weight: 600; color: var(--text); }
.service-heading .pill { font-size: 22rpx; padding: 5rpx 14rpx; }
.service-detail { font-size: 23rpx; color: var(--text-2); line-height: 1.6; margin-top: 8rpx; overflow-wrap: anywhere; }
.authorization-row { display: flex; align-items: center; flex-wrap: wrap; gap: 14rpx; }
.authorization-copy { flex: 1 1 220rpx; min-width: 0; }
.readiness-note { border-radius: 20rpx; padding: 18rpx 20rpx; background: rgba(231,249,239,.86); color: #315E4C; font-size: 23rpx; line-height: 1.65; }
.settings-link, .service-link { color: var(--green-dark); font-size: 23rpx; }
.settings-link { padding-top: 16rpx; }
.status-footer { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 12rpx; padding-top: 18rpx; }
.subscription-rule { margin-top: 14rpx; line-height: 1.65; }
.follow-count { font-size: 25rpx; color: var(--text-2); font-weight: 500; margin-left: 10rpx; }
.follow { padding: 26rpx 0; border-bottom: 1rpx solid var(--line); }
.follow:last-child { border-bottom: none; }
.follow-product { display: flex; align-items: center; gap: 20rpx; min-width: 0; }
.follow-product .follow-image { width: 124rpx; height: 138rpx; flex: 0 0 124rpx; margin: 0; padding: 8rpx; border-radius: 22rpx; background: rgba(255,255,255,.86); border: 1rpx solid var(--glass-line); }
.follow-head { display: flex; flex-direction: column; align-items: flex-start; gap: 12rpx; min-width: 0; }
.follow-head .follow-title { width: 100%; margin-right: 0; }
.follow-head .pill { align-self: flex-start; }
.follow-title { flex: 1; margin-right: 16rpx; min-width: 0; }
.follow-title .bold { display: block; white-space: normal; overflow-wrap: anywhere; }
.follow-note { margin-top: 16rpx; }
.store-row { margin-top: 16rpx; padding: 18rpx 20rpx; background: var(--surface-soft); border: 1rpx solid var(--glass-line); border-radius: 22rpx; }
.store-heading { display: flex; align-items: flex-start; justify-content: space-between; gap: 10rpx 16rpx; flex-wrap: wrap; margin-bottom: 8rpx; }
.store-name { flex: 1 1 220rpx; min-width: 0; font-weight: 500; }
.store-heading .pill { flex: 0 1 auto; font-size: 22rpx; }
.follow-actions { gap: 12rpx; }
.follow-actions .btn.btn { flex: 1 1 0%; padding: 14rpx 8rpx; min-height: 76rpx; font-size: 24rpx; }

.alert-card { border: 2rpx solid rgba(0,122,73,.22); }
.alert-product { display: block; font-size: 30rpx; line-height: 1.5; overflow-wrap: anywhere; }
.alert-meta { display: block; margin-top: 4rpx; overflow-wrap: anywhere; }
.alert-row { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 8rpx 16rpx; padding: 14rpx 0 6rpx; }
.alert-feedback { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 12rpx; margin-top: 20rpx; padding-top: 18rpx; border-top: 1rpx solid var(--line); }
.alert-feedback-actions { display: flex; flex-wrap: wrap; gap: 10rpx; }
.alert-feedback-actions .btn { flex: none; width: auto; }

@media (prefers-color-scheme: dark) {
  .alert-card { border-color: rgba(0, 195, 117, 0.28); }
  .whistle-mark { background: rgba(255, 255, 255, 0.06); box-shadow: var(--shadow-soft); }
  .monitor-panel { background: var(--card); background-image: linear-gradient(135deg, rgba(0, 195, 117, 0.08), rgba(0, 195, 117, 0.02)); }
  .readiness-summary { background: rgba(0, 195, 117, 0.10); border-color: rgba(0, 195, 117, 0.18); }
  .readiness-warn { background: var(--warn-soft); border-color: rgba(232, 177, 92, 0.22); }
  .readiness-muted { background: rgba(255, 255, 255, 0.05); }
  .readiness-note { background: rgba(0, 195, 117, 0.10); color: var(--text-2); }
  .follow-product .follow-image { background: var(--image-tile); }
}
