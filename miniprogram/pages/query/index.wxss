/* 查询页专用样式（公共样式见 app.wxss） */
@import '../../styles/launch-calendar.wxss';
/* Launch calendar + purchase guide: a calm entry row below the heading. It stays
   recognizable as a control without competing with the primary query action. */
.query-guide-entry.query-guide-entry {
  gap: 12px;
  margin: 0 0 26rpx;
  padding: 12px 14px;
  border: 1rpx solid var(--glass-line);
  border-radius: var(--radius-card);
  background: var(--card);
  box-shadow: var(--shadow-soft);
  color: var(--text);
}
.query-guide-icon { display: flex; flex: none; align-items: center; justify-content: center; width: 40px; height: 40px; border-radius: 12px; background: var(--green-soft); }
.query-guide-copy { display: flex; flex: 1 1 0; flex-direction: column; align-items: flex-start; gap: 2px; min-width: 0; text-align: left; }
.query-guide-title { color: var(--text); font-size: max(15px, 30rpx); font-weight: 600; line-height: 1.45; }
.query-guide-note { color: var(--text-2); font-size: max(12px, 24rpx); font-weight: 400; line-height: 1.5; white-space: normal; overflow-wrap: anywhere; }
.query-guide-entry .ui-chevron { color: var(--green-dark); }
.opening-calendar-heading { flex: 1 1 0; min-width: 0; }
.opening-calendar-mask { position: fixed; inset: 0; z-index: 1100; display: flex; align-items: center; justify-content: center; padding: 32rpx; background: rgba(9, 24, 18, .6); }
.opening-calendar-panel { width: 100%; max-width: 440px; max-height: calc(100vh - 64rpx - env(safe-area-inset-top) - env(safe-area-inset-bottom)); display: flex; flex-direction: column; border-radius: 32rpx; background: var(--card); box-shadow: 0 20rpx 80rpx rgba(0, 0, 0, .22); overflow: hidden; }
/* Poster chrome shared via styles/launch-calendar.wxss; only modal chrome below. */
.opening-calendar-header { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; flex: none; padding: 12rpx 24rpx 12rpx 30rpx; }
.opening-calendar-logo { display: block; flex: none; width: 24px; height: 24px; border-radius: 7px; }
button.opening-calendar-close.opening-calendar-close {
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
  width: 44px;
  height: 44px;
  min-height: 44px;
  margin: 0;
  padding: 0;
  border: 1rpx solid var(--line);
  border-radius: 50%;
  background: var(--surface-soft);
  color: var(--text-2);
}
.opening-calendar-close::after { border: 0; }
.opening-calendar-close text { font-size: 26px; line-height: 1; font-weight: 300; }
.opening-calendar-close.ui-control-pressed { background: var(--control-pressed); color: var(--green-dark); }
.opening-calendar-scroll { flex: 0 1 auto; min-height: 0; height: 680rpx; max-height: calc(100vh - 240px - env(safe-area-inset-top) - env(safe-area-inset-bottom)); }
.opening-calendar-scroll--compact { height: 380rpx; }
.opening-calendar-scroll--compact.opening-calendar-scroll--follow-ready { height: 340px; }
.opening-calendar-content { padding: 0 30rpx 18rpx; }
.opening-calendar-content .poster-source { line-height: 1.5; }
.opening-calendar-actions { flex: none; padding: 16rpx 30rpx 18rpx; border-top: 1rpx solid var(--line); }
.opening-calendar-actions .btn { height: auto; min-height: 44px; padding: 20rpx; line-height: 1.4; }
.opening-calendar-mute { display: flex; align-items: center; justify-content: center; min-height: 44px; color: var(--text-2); gap: 8rpx; font-size: 14px; margin-top: 4rpx; }
@media (min-width: 600px) {
  .opening-calendar-mask { padding: 24px; }
  .opening-calendar-panel { max-height: calc(100vh - 48px); border-radius: 24px; }
  .opening-calendar-header { padding: 8px 18px 8px 24px; }
  .opening-calendar-scroll { height: 400px; }
  .opening-calendar-scroll--compact { height: 230px; }
  .opening-calendar-content { padding: 0 24px 12px; }
  .opening-calendar-actions { padding: 10px 24px 12px; }
  .opening-calendar-actions .btn { padding: 12px; }
  .opening-calendar-panel .small { font-size: 14px; line-height: 1.5; }
  .opening-calendar-panel .tiny { font-size: 12px; line-height: 1.5; }
  .opening-calendar-panel .btn { font-size: 16px; line-height: 1.5; padding: 12px 16px; }
  .opening-calendar-panel .mt { margin-top: 10px; }
  .opening-calendar-mute { font-size: 14px; gap: 6px; margin-top: 2px; }
  .query-guide-entry.query-guide-entry { padding: 14px 18px; border-radius: 18px; }
  .query-guide-title { font-size: 16px; }
  .query-guide-note { font-size: 13px; }
  .page .selection-card--empty > .card-title { font-size: 22px; }
}
.card-title text:first-child { flex: 1; min-width: 0; white-space: normal; }
.target-row { padding: 14rpx 0; border-bottom: 2rpx solid var(--line); }
.target-row:last-of-type { border-bottom: none; }
.target-text { flex: 1; min-width: 0; margin-right: 16rpx; }
.target-text .bold { display: block; white-space: normal; overflow-wrap: anywhere; }
.selection-card > .card-title { padding-bottom: 20rpx; border-bottom: 1rpx solid var(--line); margin-bottom: 8rpx; }
.selection-card > .card-title .sub { padding: 7rpx 16rpx; background: var(--green-soft); color: var(--green-dark); border-radius: 999rpx; }
.query-result-card .list-item { padding: 24rpx 0; }
.query-result-card > .small.muted { line-height: 1.65; }
.target-row { padding: 22rpx 0; }
.selection-follow-action { margin-top: 16rpx; gap: 12rpx; }
.selection-follow-action > text { min-width: 0; overflow-wrap: anywhere; }
.selection-whistle { display: block; flex: 0 0 34rpx; width: 34rpx; height: 34rpx; }
.selection-rules { margin-top: 24rpx; padding-top: 22rpx; border-top: 1rpx solid var(--line); }
.selection-rule { display: flex; align-items: flex-start; gap: 20rpx; font-size: 24rpx; line-height: 1.65; text-align: left; }
.selection-rule + .selection-rule { margin-top: 16rpx; }
.selection-rule-label { flex: 0 0 4em; color: var(--text-2); font-weight: 500; white-space: nowrap; }
.selection-rule-copy { flex: 1 1 0; min-width: 0; color: var(--text-2); overflow-wrap: anywhere; }
.selection-rule-detail { margin-top: 4rpx; color: var(--text-3); }
.result-actions { flex-wrap: nowrap; gap: 20rpx; margin-top: 24rpx; }
.result-actions .btn.btn { flex: 1 1 0; min-height: 44px; min-height: max(44px, 88rpx); padding: 18rpx 16rpx; font-size: 26rpx; line-height: 1.5; white-space: nowrap; }
.result-actions .btn-ghost { border: 2rpx solid transparent; }
.selection-summary { padding-top: 14rpx; }
.selection-summary-product { display: flex; align-items: center; gap: 16rpx; min-width: 0; }
.selection-summary-image-box { display: flex; align-items: center; justify-content: center; width: 168rpx; height: 200rpx; flex: 0 0 168rpx; background: var(--surface-soft); border: 1rpx solid var(--glass-line); border-radius: var(--radius-action); overflow: hidden; }
.selection-summary-image { display: block; width: 100%; height: 100%; }
.selection-summary-image-placeholder { display: flex; align-items: center; justify-content: center; height: 100%; font-size: 22rpx; color: var(--text-3); }
.selection-summary-copy { flex: 1 1 0; min-width: 0; }
.selection-summary-title { font-size: 28rpx; font-weight: 600; line-height: 1.5; overflow-wrap: anywhere; }
.selection-summary-city { margin-top: 8rpx; color: var(--text-2); font-size: 23rpx; line-height: 1.5; overflow-wrap: anywhere; }
.selection-summary-footer { display: flex; align-items: center; gap: 16rpx; margin-top: 18rpx; padding-top: 16rpx; border-top: 1rpx solid var(--line); }
/* Size the edit action to its content: a fixed 58–72px box wrapped 「修改」 on
   phones with larger fonts. The store list shrinks/wraps instead. */
.selection-summary-change.ui-action { flex: 0 0 auto; width: auto; min-width: 58px; max-width: none; padding: 12rpx 14rpx; gap: 8rpx; white-space: nowrap; }
.selection-summary-change .ui-action-label { flex: none; white-space: nowrap; word-break: keep-all; overflow-wrap: normal; }
.selection-summary-stores { flex: 1 1 0; min-width: 0; color: var(--text-2); font-size: 24rpx; line-height: 1.6; overflow-wrap: anywhere; }
.selection-done.btn { margin-top: 24rpx; }
.selection-empty { padding: 0 0 8rpx; }
/* Without a saved target the question itself is the card heading. */
.selection-card--empty > .card-title { padding-bottom: 0; border-bottom: 0; margin-bottom: 10rpx; font-size: 36rpx; }
.selection-access-note { margin-top: 20rpx; font-size: 25rpx; line-height: 1.6; color: var(--text-2); }
.selection-rules { margin-top: 0; padding-top: 16rpx; }
.selection-summary-title { font-size: 32rpx; }
.selection-summary-city, .selection-summary-stores { font-size: 25rpx; }
.selection-card > .btn, .selection-done.btn { min-height: 44px; min-height: max(44px, 88rpx); }
.result-target-note { margin-bottom: 20rpx; padding: 14rpx 18rpx; border-radius: 16rpx; background: var(--surface-soft); color: var(--text-2); font-size: 23rpx; line-height: 1.55; overflow-wrap: anywhere; }
.result-target-different { background: var(--warn-soft); color: var(--warn); }
.result-product-row { display: flex; align-items: center; gap: 22rpx; padding: 4rpx 0 24rpx; border-bottom: 1rpx solid var(--line); }
.result-product-media { display: flex; align-items: center; justify-content: center; flex: 0 0 168rpx; width: 168rpx; height: 200rpx; background: var(--surface-soft); border: 1rpx solid var(--line); border-radius: var(--radius-action); overflow: hidden; }
.result-product-image { display: block; width: 100%; height: 100%; }
.product-image-fit-pro { transform: translateY(-3.8%) scale(1.43); }
.product-image-fit-max { transform: translateY(.3%) scale(1.31); }
.result-product-placeholder { color: var(--text-3); font-size: 24rpx; line-height: 1.5; text-align: center; }
.result-product-copy { flex: 1 1 0; min-width: 0; }
.result-product-title { color: var(--text); font-size: 30rpx; font-weight: 600; line-height: 1.5; overflow-wrap: anywhere; }
.result-product-meta { display: flex; align-items: center; flex-wrap: wrap; gap: 8rpx 12rpx; margin-top: 12rpx; }
.result-product-meta .pill { padding: 3rpx 12rpx; font-size: 22rpx; }
.result-product-part { color: var(--text-2); font-size: 24rpx; font-size: max(12px, 24rpx); line-height: 1.5; overflow-wrap: anywhere; }
.result-product-time { margin-top: 8rpx; color: var(--text-3); font-size: 24rpx; font-size: max(12px, 24rpx); line-height: 1.6; overflow-wrap: anywhere; }

/* 首页提示：添加到我的小程序 */
.banner.add-tip { display: flex; align-items: flex-start; gap: 16rpx; }
.add-tip-text { flex: 1; min-width: 0; }
.add-tip-close { flex: none; font-size: 34rpx; line-height: 1.1; color: var(--text-3); }

.observed-store-choices { margin-top: 24rpx; padding: 24rpx; border: 1rpx solid var(--line); border-radius: 20rpx; background: var(--surface-soft); line-height: 1.6; }
.observed-store-choice { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; width: 100%; min-height: 44px; margin-top: 16rpx; padding: 18rpx; background: var(--surface); border: 1rpx solid var(--line); border-radius: 16rpx; color: var(--text); text-align: left; white-space: normal; line-height: 1.6; }
.observed-store-choice-copy { display: flex; flex: 1; min-width: 0; flex-direction: column; gap: 6rpx; overflow-wrap: anywhere; }
.observed-store-choice--selected { border-color: var(--green); background: var(--green-soft); }
.observed-store-choice > text { flex: none; }
.observed-store-choice::after { border: 0; }
.alternative-match { margin-top: 24rpx; padding-top: 24rpx; border-top: 1rpx solid var(--line); overflow-wrap: anywhere; }
.alternative-panel { padding: 24rpx; background: var(--surface); }
.alternative-heading { font-size: 28rpx; font-weight: 600; line-height: 1.45; color: var(--text); }
.alternative-caption { margin-top: 8rpx; font-size: 22rpx; line-height: 1.55; color: var(--text-3); }
.alternative-section-title { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; margin-top: 24rpx; margin-bottom: 12rpx; color: var(--text-2); font-size: 24rpx; font-weight: 500; }
.alternative-count { flex: none; color: var(--text-3); font-size: 22rpx; font-weight: 400; }
.alternative-colors { display: flex; flex-wrap: wrap; align-items: stretch; width: 100%; margin-bottom: -12rpx; }
/* The view owns each 50% column; spacing stays inside it. Separate rpx
   rounding of a calc width and gap must not push the second button to a new row. */
.alternative-color-column { box-sizing: border-box; display: flex; flex: 0 0 50%; width: 50%; max-width: 50%; min-width: 0; padding-bottom: 12rpx; }
.alternative-color-column:nth-child(odd) { padding-right: 6rpx; }
.alternative-color-column:nth-child(even) { padding-left: 6rpx; }
/* Scoped selectors override native button sizing and centering without changing other controls. */
.alternative-panel .alternative-chip, .alternative-panel .alternative-store, .alternative-panel .alternative-query-button, .alternative-panel .alternative-read-button { box-sizing: border-box; margin: 0; min-width: 0; height: auto; min-height: 44px; min-height: max(44px, 80rpx); padding: 14rpx 18rpx; font-size: 24rpx; line-height: 1.4; color: var(--text); white-space: normal; border: 1rpx solid var(--line); border-radius: 14rpx; background: var(--surface-soft); }
.alternative-chip::after, .alternative-store::after, .alternative-query-button::after, .alternative-read-button::after { border: none; }
.alternative-panel .alternative-colors .alternative-chip { display: flex; flex: 1 1 auto; align-items: center; justify-content: space-between; gap: 8rpx; width: 100%; max-width: 100%; text-align: left; }
.alternative-chip-label { flex: 1; min-width: 0; overflow-wrap: anywhere; }
.alternative-current { display: block; margin-top: 2rpx; font-size: 21rpx; color: var(--text-3); }
.alternative-check { display: flex; align-items: center; justify-content: center; flex: 0 0 30rpx; height: 30rpx; border: 1rpx solid var(--line); border-radius: 8rpx; font-size: 22rpx; color: var(--text-3); background: var(--surface); }
.alternative-panel .alternative-chip--selected, .alternative-panel .alternative-store--selected { border-color: var(--green); background: var(--green-soft); }
.alternative-chip--selected .alternative-check, .alternative-store--selected .alternative-check { background: var(--green); border-color: var(--green); color: var(--green-ink); }
.alternative-stores { display: flex; flex-direction: column; gap: 8rpx; }
.alternative-city-picker { margin-bottom: 12rpx; }
.alternative-selected-stores { margin-top: 20rpx; }
.alternative-selected-list { display: flex; flex-wrap: wrap; gap: 10rpx; margin-top: 10rpx; }
.alternative-panel .alternative-selected-store { display: flex; align-items: center; justify-content: space-between; gap: 14rpx; width: auto; max-width: 100%; min-width: 0; min-height: 44px; height: auto; margin: 0; padding: 12rpx 16rpx; border: 1rpx solid var(--green); border-radius: 12rpx; background: var(--green-soft); color: var(--green-dark); font-size: 23rpx; line-height: 1.5; text-align: left; white-space: normal; overflow-wrap: anywhere; }
.alternative-selected-store::after { border: 0; }
.alternative-selected-store text:first-child { flex: 1; min-width: 0; }
.alternative-selected-store text:last-child { flex: none; }
.alternative-panel .alternative-stores .alternative-store { width: 100%; max-width: 100%; display: flex; align-items: center; justify-content: space-between; gap: 12rpx; text-align: left; }
.alternative-store-copy { display: flex; flex: 1; flex-direction: column; min-width: 0; gap: 2rpx; }
.alternative-store-label { font-size: 24rpx; overflow-wrap: anywhere; }
.alternative-store-relation { font-size: 21rpx; color: var(--text-3); overflow-wrap: anywhere; }
.alternative-summary { margin-top: 20rpx; font-size: 23rpx; line-height: 1.55; color: var(--green-dark); overflow-wrap: anywhere; }
.alternative-query-list { margin-top: 12rpx; }
.alternative-query-row { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; padding: 10rpx 0; }
.alternative-query-copy { flex: 1; min-width: 0; }
.alternative-query-color { display: block; font-size: 24rpx; font-weight: 500; overflow-wrap: anywhere; }
.alternative-query-hint { display: block; margin-top: 4rpx; color: var(--text-3); font-size: 21rpx; line-height: 1.45; }
.alternative-panel .alternative-query-button { flex: none; width: 152rpx; min-width: 76px; max-width: 50%; padding: 12rpx; background: var(--green); border-color: var(--green); color: var(--green-ink); font-size: 23rpx; font-weight: 600; white-space: nowrap; }
.alternative-observations { margin-top: 20rpx; padding-top: 20rpx; border-top: 1rpx solid var(--line); }
.alternative-panel .alternative-read-button { width: 100%; max-width: 100%; color: var(--text-2); background: var(--surface-soft); }
.alternative-empty { margin-top: 16rpx; padding: 16rpx; border-radius: 12rpx; background: var(--surface-soft); font-size: 23rpx; line-height: 1.6; color: var(--text-2); }
.alternative-panel button[disabled] { opacity: .55; }

/* 2.0: lead with a state and one next action; preserve the original result. */
.journey-title { font-size: 32rpx; font-weight: 650; line-height: 1.45; overflow-wrap: anywhere; }
.result-next-action { padding: 24rpx; margin-top: 24rpx; border-radius: 20rpx; background: var(--surface-soft); }
.result-next-action--available, .journey-resume { background: var(--green-soft); }
.target-evidence { border-top: 1rpx solid var(--line); padding-top: 22rpx; margin-top: 24rpx; }
.launch-dates { display: flex; flex-wrap: wrap; gap: 12rpx 28rpx; font-size: 30rpx; font-weight: 600; padding: 22rpx 0 14rpx; }
.launch-card .row-between { flex-wrap: wrap; gap: 12rpx; }

.query-notice-region:empty { display: none; }
.query-follow-entry.query-follow-entry { margin-bottom: 24rpx; text-align: left; }
.query-guide-entry.query-guide-entry { padding: 20rpx 24rpx; }
.query-guide-entry .query-guide-note { display: none; }
.selection-follow-action.selection-follow-action { width: 100%; }

/* Compact query hierarchy: target first, one next action, then store evidence. */
.query-page { padding-top: 20rpx; }
.query-page .page-heading { margin: 0 4rpx 22rpx; gap: 16rpx; }
.query-page .page-heading.brand-page-heading {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 16rpx;
}
.query-page .brand-page-copy {
  flex: 1 1 auto;
  min-width: 0;
  overflow: hidden;
}

/* Fixed slot on the right of the title block (announcement board). */
.heading-notice-btn {
  flex: 0 0 72rpx;
  width: 72rpx;
  height: 72rpx;
  margin: 0;
  padding: 0;
  border-radius: 18rpx;
  background: var(--surface-soft);
  border: 1px solid var(--line, rgba(0, 0, 0, 0.06));
  line-height: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  align-self: center;
}
.heading-notice-btn::after { border: none; }
.heading-notice-icon { width: 36rpx; height: 36rpx; display: block; }
.heading-notice-dot {
  position: absolute;
  top: 10rpx;
  right: 10rpx;
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: var(--warn);
}
.query-page .brand-page-logo { width: 36px; height: 36px; border-radius: 10px; }
.query-page .page-title {
  font-size: 20px;
  line-height: 1.35;
  letter-spacing: 0;
  word-break: keep-all;
}
.query-page .page-subtitle {
  margin-top: 4rpx;
  font-size: 12px;
  line-height: 1.5;
  color: var(--text-2);
}

.add-tip--top {
  margin: 0 0 18rpx;
}
.query-page .card { padding: 24rpx; margin-bottom: 20rpx; border-radius: 24rpx; }
.query-page .card-title { font-size: max(15px, 30rpx); gap: 8rpx 12rpx; }
.query-page .selection-card > .card-title { padding-bottom: 14rpx; margin-bottom: 0; }
.query-page .selection-card > .card-title > text:first-child { flex-basis: auto; }
.query-page .selection-card > .card-title .sub { padding: 4rpx 12rpx; font-size: 12px; }
.query-page .selection-card--empty > .card-title { font-size: 18px; padding-bottom: 10rpx; }
.query-page .selection-summary { padding-top: 16rpx; }
.query-page .selection-summary-image-box { width: 112rpx; height: 132rpx; flex-basis: 112rpx; border-radius: 16rpx; }
.query-page .selection-summary-title { font-size: max(14px, 29rpx); line-height: 1.4; }
.query-page .selection-summary-city, .query-page .selection-summary-stores { font-size: 12px; line-height: 1.5; }
.query-page .selection-summary-city { margin-top: 6rpx; }
.query-page .selection-summary-footer { margin-top: 10rpx; padding-top: 6rpx; border-top: 0; gap: 12rpx; }
.query-page .selection-summary-change.ui-action { flex-basis: auto; min-width: 58px; padding: 8rpx 12rpx; }
.query-page .selection-card > .btn { min-height: 44px; padding: 16rpx 20rpx; font-size: max(14px, 28rpx); }
.selection-utilities { display: flex; gap: 12rpx; margin-top: 14rpx; }
.selection-utilities .ui-action, .selection-utilities .ui-disclosure { flex: 1 1 0; min-width: 0; width: auto; margin: 0; padding: 12rpx 16rpx; gap: 8rpx; font-size: 12px; }
.selection-utilities .ui-disclosure-label, .selection-utilities .ui-action-label { font-size: 12px; }
.selection-utilities .ui-disclosure-meta { font-size: 12px; gap: 6rpx; }
.query-page .result-target-note { padding: 0 0 10rpx; margin-bottom: 8rpx; background: transparent; border-radius: 0; font-size: 12px; }
.query-page .result-target-different { padding: 12rpx 16rpx; background: var(--warn-soft); border-radius: 12rpx; }
.query-page .result-product-row { gap: 18rpx; padding: 0 0 16rpx; }
.query-page .result-product-media { width: 104rpx; height: 124rpx; flex-basis: 104rpx; border-radius: 16rpx; }
.query-page .result-product-title { font-size: max(14px, 29rpx); line-height: 1.4; }
.query-page .result-product-meta { margin-top: 6rpx; }
.query-page .result-product-meta .pill { font-size: 11px; padding: 0 10rpx; }
.query-page .result-product-time { margin-top: 4rpx; font-size: 12px; line-height: 1.4; }
.query-page .result-next-action { margin-top: 16rpx; padding: 20rpx; border-radius: 16rpx; }
.query-page .journey-title { font-size: max(15px, 30rpx); line-height: 1.4; }
.query-page .result-next-action > .small { margin-top: 6rpx; font-size: 12px; line-height: 1.5; }
.query-page .result-next-action > .btn { min-height: 44px; padding: 14rpx 18rpx; font-size: 14px; }
.query-page .result-store { padding: 20rpx 0; }
.query-page .result-store--available { margin-top: 12rpx; padding: 18rpx 16rpx; background: var(--green-soft); border: 1rpx solid var(--line); border-radius: 14rpx; }
.result-store-heading.row-between { align-items: flex-start; flex-wrap: nowrap; gap: 12rpx; }
.result-store-heading .result-store-name { flex: 1 1 0; min-width: 0; font-size: max(14px, 28rpx); line-height: 1.5; }
.result-store-name > .small { display: block; font-size: 12px; }
.result-store-heading > .pill { flex: none; font-size: 12px; padding: 4rpx 12rpx; }
.query-page .result-store > .small, .query-page .result-store > .tiny { margin-top: 6rpx; font-size: 12px; line-height: 1.5; }
.query-page .result-actions { margin-top: 14rpx; gap: 12rpx; }
.query-page .query-follow-entry, .query-page .query-guide-entry { margin-bottom: 18rpx; padding: 16rpx 20rpx; border-radius: 20rpx; }
.query-page .query-guide-icon { width: 32px; height: 32px; border-radius: 9px; }
.query-page .query-guide-title { font-size: 14px; }

@media (min-width: 600px) {
  .query-page .card { padding: 20px; border-radius: 16px; }
  .query-page .selection-summary-image-box { width: 64px; height: 76px; flex-basis: 64px; }
  .query-page .result-product-media { width: 60px; height: 72px; flex-basis: 60px; }
  .query-page .selection-summary-title, .query-page .result-product-title { font-size: 17px; }
  .query-page .journey-title, .query-page .card-title { font-size: 18px; }
  .query-page .result-store-name { font-size: 16px; }
}

/* Request feedback stays close to the action, including slow connections. */
.request-progress, .refresh-feedback { padding: 18rpx 22rpx; margin-top: 16rpx; border-radius: 16rpx; background: var(--surface-soft); color: var(--text-2); font-size: 24rpx; line-height: 1.6; }
.refresh-feedback { margin: 0 0 20rpx; }
.request-progress--slow { border-left: 4rpx solid var(--green); }

@media (prefers-color-scheme: dark) {
  .selection-summary-image-box, .result-product-media { background: var(--image-tile); }
}
