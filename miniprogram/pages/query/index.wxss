/* 查询页专用样式（公共样式见 app.wxss） */
.card-title text:first-child { flex: 1; min-width: 0; white-space: normal; }
.target-row { padding: 14rpx 0; border-bottom: 2rpx solid var(--line); }
.target-row:last-of-type { border-bottom: none; }
.target-text { flex: 1; min-width: 0; margin-right: 16rpx; }
.target-text .bold { display: block; white-space: normal; overflow-wrap: anywhere; }
.selection-card > .card-title { padding-bottom: 20rpx; border-bottom: 1rpx solid var(--line); margin-bottom: 8rpx; }
.selection-card > .card-title .sub { padding: 7rpx 16rpx; background: var(--green-soft); color: var(--green-dark); border-radius: 999rpx; }
.query-result-card .list-item { padding: 24rpx 0; }
.query-result-card > .small.muted { line-height: 1.65; }
.target-row { padding: 22rpx 0; }
.selection-follow-action { margin-top: 16rpx; gap: 12rpx; }
.selection-follow-action > text { min-width: 0; overflow-wrap: anywhere; }
.selection-whistle { display: block; flex: 0 0 34rpx; width: 34rpx; height: 34rpx; }
.selection-rules { margin-top: 24rpx; padding-top: 22rpx; border-top: 1rpx solid var(--line); }
.selection-rule { display: flex; align-items: flex-start; gap: 20rpx; font-size: 24rpx; line-height: 1.65; text-align: left; }
.selection-rule + .selection-rule { margin-top: 16rpx; }
.selection-rule-label { flex: 0 0 4em; color: var(--text-2); font-weight: 500; white-space: nowrap; }
.selection-rule-copy { flex: 1 1 0; min-width: 0; color: var(--text-2); overflow-wrap: anywhere; }
.selection-rule-detail { margin-top: 4rpx; color: var(--text-3); }
.result-actions { flex-wrap: nowrap; gap: 20rpx; margin-top: 24rpx; }
.result-actions .btn.btn { flex: 1 1 0; min-height: 44px; min-height: max(44px, 88rpx); padding: 18rpx 16rpx; font-size: 26rpx; line-height: 1.5; white-space: nowrap; }
.result-actions .btn-ghost { border: 2rpx solid transparent; }
.selection-summary { padding-top: 14rpx; }
.selection-summary-product { display: flex; align-items: center; gap: 16rpx; min-width: 0; }
.selection-summary-image-box { display: flex; align-items: center; justify-content: center; width: 168rpx; height: 200rpx; flex: 0 0 168rpx; background: var(--surface-soft); border: 1rpx solid var(--glass-line); border-radius: var(--radius-action); overflow: hidden; }
.selection-summary-image { display: block; width: 100%; height: 100%; }
.selection-summary-image-placeholder { display: flex; align-items: center; justify-content: center; height: 100%; font-size: 22rpx; color: var(--text-3); }
.selection-summary-copy { flex: 1 1 0; min-width: 0; }
.selection-summary-title { font-size: 28rpx; font-weight: 600; line-height: 1.5; overflow-wrap: anywhere; }
.selection-summary-city { margin-top: 8rpx; color: var(--text-2); font-size: 23rpx; line-height: 1.5; overflow-wrap: anywhere; }
.selection-summary-footer { display: flex; align-items: center; gap: 16rpx; margin-top: 18rpx; padding-top: 16rpx; border-top: 1rpx solid var(--line); }
.selection-summary-change.ui-action { flex: 0 0 116rpx; width: 116rpx; min-width: 58px; max-width: 72px; padding: 12rpx 14rpx; gap: 8rpx; }
.selection-summary-stores { flex: 1 1 0; min-width: 0; color: var(--text-2); font-size: 24rpx; line-height: 1.6; overflow-wrap: anywhere; }
.selection-done.btn { margin-top: 24rpx; }
.selection-empty { padding: 28rpx 0 8rpx; }
.selection-empty-title { font-size: 36rpx; font-weight: 600; margin-bottom: 12rpx; }
.selection-access-note { margin-top: 20rpx; font-size: 25rpx; line-height: 1.6; color: var(--text-2); }
.selection-rules { margin-top: 0; padding-top: 16rpx; }
.selection-summary-title { font-size: 32rpx; }
.selection-summary-city, .selection-summary-stores { font-size: 25rpx; }
.selection-card > .btn, .selection-done.btn { min-height: 44px; min-height: max(44px, 88rpx); }
.result-target-note { margin-bottom: 20rpx; padding: 14rpx 18rpx; border-radius: 16rpx; background: var(--surface-soft); color: var(--text-2); font-size: 23rpx; line-height: 1.55; overflow-wrap: anywhere; }
.result-target-different { background: var(--warn-soft); color: var(--warn); }
.result-product-row { display: flex; align-items: center; gap: 22rpx; padding: 4rpx 0 24rpx; border-bottom: 1rpx solid var(--line); }
.result-product-media { display: flex; align-items: center; justify-content: center; flex: 0 0 168rpx; width: 168rpx; height: 200rpx; background: var(--surface-soft); border: 1rpx solid var(--line); border-radius: var(--radius-action); overflow: hidden; }
.result-product-image { display: block; width: 100%; height: 100%; }
.product-image-fit-pro { transform: translateY(-3.8%) scale(1.43); }
.product-image-fit-max { transform: translateY(.3%) scale(1.31); }
.result-product-placeholder { color: var(--text-3); font-size: 24rpx; line-height: 1.5; text-align: center; }
.result-product-copy { flex: 1 1 0; min-width: 0; }
.result-product-title { color: var(--text); font-size: 30rpx; font-weight: 600; line-height: 1.5; overflow-wrap: anywhere; }
.result-product-meta { display: flex; align-items: center; flex-wrap: wrap; gap: 8rpx 12rpx; margin-top: 12rpx; }
.result-product-meta .pill { padding: 3rpx 12rpx; font-size: 22rpx; }
.result-product-part { color: var(--text-2); font-size: 24rpx; font-size: max(12px, 24rpx); line-height: 1.5; overflow-wrap: anywhere; }
.result-product-time { margin-top: 8rpx; color: var(--text-3); font-size: 24rpx; font-size: max(12px, 24rpx); line-height: 1.6; overflow-wrap: anywhere; }

/* 首页提示：添加到我的小程序 */
.banner.add-tip { display: flex; align-items: flex-start; gap: 16rpx; }
.add-tip-text { flex: 1; min-width: 0; }
.add-tip-close { flex: none; font-size: 34rpx; line-height: 1.1; color: var(--text-3); }

.observed-store-choices { margin-top: 24rpx; padding: 24rpx; border: 1rpx solid var(--line); border-radius: 20rpx; background: var(--surface-soft); line-height: 1.6; }
.observed-store-choice { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; width: 100%; min-height: 44px; margin-top: 16rpx; padding: 18rpx; background: var(--surface); border: 1rpx solid var(--line); border-radius: 16rpx; color: var(--text); text-align: left; white-space: normal; line-height: 1.6; }
.observed-store-choice-copy { display: flex; flex: 1; min-width: 0; flex-direction: column; gap: 6rpx; overflow-wrap: anywhere; }
.observed-store-choice--selected { border-color: var(--green); background: var(--green-soft); }
.observed-store-choice > text { flex: none; }
.observed-store-choice::after { border: 0; }
.alternative-match { margin-top: 24rpx; padding-top: 24rpx; border-top: 1rpx solid var(--line); overflow-wrap: anywhere; }
.alternative-panel { padding: 24rpx; background: var(--surface); }
.alternative-heading { font-size: 28rpx; font-weight: 600; line-height: 1.45; color: var(--text); }
.alternative-caption { margin-top: 8rpx; font-size: 22rpx; line-height: 1.55; color: var(--text-3); }
.alternative-section-title { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; margin-top: 24rpx; margin-bottom: 12rpx; color: var(--text-2); font-size: 24rpx; font-weight: 500; }
.alternative-count { flex: none; color: var(--text-3); font-size: 22rpx; font-weight: 400; }
.alternative-colors { display: flex; flex-wrap: wrap; align-items: stretch; width: 100%; margin-bottom: -12rpx; }
/* The view owns each 50% column; spacing stays inside it. Separate rpx
   rounding of a calc width and gap must not push the second button to a new row. */
.alternative-color-column { box-sizing: border-box; display: flex; flex: 0 0 50%; width: 50%; max-width: 50%; min-width: 0; padding-bottom: 12rpx; }
.alternative-color-column:nth-child(odd) { padding-right: 6rpx; }
.alternative-color-column:nth-child(even) { padding-left: 6rpx; }
/* Scoped selectors override native button sizing and centering without changing other controls. */
.alternative-panel .alternative-chip, .alternative-panel .alternative-store, .alternative-panel .alternative-query-button, .alternative-panel .alternative-read-button { box-sizing: border-box; margin: 0; min-width: 0; height: auto; min-height: 44px; min-height: max(44px, 80rpx); padding: 14rpx 18rpx; font-size: 24rpx; line-height: 1.4; color: var(--text); white-space: normal; border: 1rpx solid var(--line); border-radius: 14rpx; background: var(--surface-soft); }
.alternative-chip::after, .alternative-store::after, .alternative-query-button::after, .alternative-read-button::after { border: none; }
.alternative-panel .alternative-colors .alternative-chip { display: flex; flex: 1 1 auto; align-items: center; justify-content: space-between; gap: 8rpx; width: 100%; max-width: 100%; text-align: left; }
.alternative-chip-label { flex: 1; min-width: 0; overflow-wrap: anywhere; }
.alternative-current { display: block; margin-top: 2rpx; font-size: 21rpx; color: var(--text-3); }
.alternative-check { display: flex; align-items: center; justify-content: center; flex: 0 0 30rpx; height: 30rpx; border: 1rpx solid var(--line); border-radius: 8rpx; font-size: 22rpx; color: var(--text-3); background: var(--surface); }
.alternative-panel .alternative-chip--selected, .alternative-panel .alternative-store--selected { border-color: var(--green); background: var(--green-soft); }
.alternative-chip--selected .alternative-check, .alternative-store--selected .alternative-check { background: var(--green); border-color: var(--green); color: var(--green-ink); }
.alternative-stores { display: flex; flex-direction: column; gap: 8rpx; }
.alternative-panel .alternative-stores .alternative-store { width: 100%; max-width: 100%; display: flex; align-items: center; justify-content: space-between; gap: 12rpx; text-align: left; }
.alternative-store-copy { display: flex; flex: 1; flex-direction: column; min-width: 0; gap: 2rpx; }
.alternative-store-label { font-size: 24rpx; overflow-wrap: anywhere; }
.alternative-store-relation { font-size: 21rpx; color: var(--text-3); overflow-wrap: anywhere; }
.alternative-summary { margin-top: 20rpx; font-size: 23rpx; line-height: 1.55; color: var(--green-dark); overflow-wrap: anywhere; }
.alternative-query-list { margin-top: 12rpx; }
.alternative-query-row { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; padding: 10rpx 0; }
.alternative-query-copy { flex: 1; min-width: 0; }
.alternative-query-color { display: block; font-size: 24rpx; font-weight: 500; overflow-wrap: anywhere; }
.alternative-query-hint { display: block; margin-top: 4rpx; color: var(--text-3); font-size: 21rpx; line-height: 1.45; }
.alternative-panel .alternative-query-button { flex: none; width: 152rpx; min-width: 76px; max-width: 50%; padding: 12rpx; background: var(--green); border-color: var(--green); color: var(--green-ink); font-size: 23rpx; font-weight: 600; white-space: nowrap; }
.alternative-observations { margin-top: 20rpx; padding-top: 20rpx; border-top: 1rpx solid var(--line); }
.alternative-panel .alternative-read-button { width: 100%; max-width: 100%; color: var(--text-2); background: var(--surface-soft); }
.alternative-empty { margin-top: 16rpx; padding: 16rpx; border-radius: 12rpx; background: var(--surface-soft); font-size: 23rpx; line-height: 1.6; color: var(--text-2); }
.alternative-panel button[disabled] { opacity: .55; }

@media (prefers-color-scheme: dark) {
  .selection-summary-image-box, .result-product-media { background: var(--image-tile); }
}
