/* 查询页。公共组件见 styles/common.wxss，令牌见 app.wxss。 */

/* ── 页首：公告入口 ───────────────────────────────────── */
.page-heading .heading-notice-btn {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
  width: var(--tap);
  height: var(--tap);
  margin: 0;
  padding: 0;
  border: 0;
  border-radius: 50%;
  background: var(--surface);
}
.page-heading .heading-notice-btn.ui-control-pressed { background: var(--pressed); }
.heading-notice-icon { display: block; width: 20px; height: 20px; filter: var(--icon-filter); }
.heading-notice-dot { position: absolute; top: 10px; right: 10px; width: 8px; height: 8px; border-radius: 50%; background: var(--warn); }

/* ── 当前选择 ─────────────────────────────────────────── */
.pickup-intro { padding-top: var(--sp-4); }
.selection-empty { margin-top: var(--sp-12); }
.pickup-intro-title, .selection-summary-title { display: block; font-size: var(--fs-title); font-weight: 600; line-height: var(--lh-tight); overflow-wrap: anywhere; }
.selection-summary-product { display: flex; align-items: center; gap: var(--sp-12); padding-bottom: var(--sp-16); }
.selection-summary-image-box { width: 64px; height: 72px; }
.product-tile .selection-summary-image { width: 92%; height: 92%; }
/* 个别机型的官方图留白较大，按原比例放大到与其他机型一致。 */
.product-image-fit-pro { transform: translateY(-3.8%) scale(1.43); }
.product-image-fit-max { transform: translateY(0.3%) scale(1.31); }
.selection-summary-copy { flex: 1 1 0; min-width: 0; }
.selection-summary-spec { display: block; margin-top: var(--sp-2); color: var(--text-2); font-size: var(--fs-sub); overflow-wrap: anywhere; }
.selection-summary-footer { display: flex; align-items: center; justify-content: space-between; gap: var(--sp-12); min-height: 52px; padding-top: var(--sp-8); border-top: 1px solid var(--line); }
.selection-summary-location { flex: 1 1 0; min-width: 0; overflow-wrap: anywhere; }
.selection-summary-stores { display: block; line-height: var(--lh-snug); }
.selection-summary-city { display: block; color: var(--text-3); font-size: var(--fs-sub); }
.selection-summary-change.ui-action { flex: none; white-space: nowrap; }
.selection-summary-change .ui-action-label { flex: none; white-space: nowrap; }
.selection-utilities { margin-top: var(--sp-8); }
.pickup-quota { display: block; margin-top: var(--sp-4); color: var(--text-3); font-size: var(--fs-caption); }

/* ── 查询结果：状态与观测时间成对，有货的门店整行转绿 ──── */
.result-target-note { margin-bottom: var(--sp-12); color: var(--text-2); font-size: var(--fs-sub); overflow-wrap: anywhere; }
.result-target-different { padding: var(--sp-8) var(--sp-12); border-radius: var(--radius-control); background: var(--warn-soft); color: var(--warn); }
.result-receipt { padding-bottom: var(--sp-12); }
.result-receipt-line { display: flex; align-items: baseline; justify-content: space-between; flex-wrap: wrap; gap: var(--sp-2) var(--sp-12); }
.result-receipt-title { font-size: var(--fs-headline); font-weight: 600; line-height: var(--lh-snug); }
.result-product-part { color: var(--text-2); font-size: var(--fs-sub); overflow-wrap: anywhere; }
.result-product-time { margin-top: var(--sp-2); color: var(--text-3); font-size: var(--fs-caption); overflow-wrap: anywhere; }
.result-product-row { display: flex; align-items: center; gap: var(--sp-12); padding: var(--sp-12) 0; border-top: 1px solid var(--line); }
.result-product-media { width: 48px; height: 56px; }
.result-product-media--empty { background: transparent; }
.result-product-placeholder { color: var(--text-3); font-size: var(--fs-caption); text-align: center; }
.result-product-copy { flex: 1 1 0; min-width: 0; }
.result-product-title { font-weight: 600; line-height: var(--lh-snug); overflow-wrap: anywhere; }

.result-store { padding: var(--sp-12) 0; border-top: 1px solid var(--line); }
.result-store--available {
  margin: 0 calc(var(--sp-16) * -1);
  padding-left: var(--sp-16);
  padding-right: var(--sp-16);
  border-top-color: transparent;
  background: var(--green-soft);
}
.result-store--available + .result-store, .result-store--available + .result-next-action, .result-store--available + .ui-disclosure.ui-disclosure { border-top-color: transparent; }
.result-store-heading { display: flex; align-items: flex-start; justify-content: space-between; gap: var(--sp-12); }
.result-store-name { flex: 1 1 0; min-width: 0; line-height: var(--lh-snug); }
.result-store-title { font-weight: 600; }
.result-store-city { color: var(--text-3); font-size: var(--fs-sub); }
.result-store-heading > .pill { flex: none; }
.result-store--available .pill-ok { padding-left: 0; padding-right: 0; background: transparent; }
.result-store-quote { margin-top: var(--sp-4); color: var(--text-2); font-size: var(--fs-sub); overflow-wrap: anywhere; }
.result-store-meta { margin-top: var(--sp-2); color: var(--text-3); font-size: var(--fs-caption); overflow-wrap: anywhere; }
.result-store-meta.stale-note { color: var(--warn); }
.result-next-action { padding: var(--sp-16) 0; border-top: 1px solid var(--line); }
.journey-title { font-size: var(--fs-headline); font-weight: 600; line-height: var(--lh-snug); overflow-wrap: anywhere; }
.result-next-detail { margin-top: var(--sp-2); color: var(--text-2); font-size: var(--fs-sub); overflow-wrap: anywhere; }
.target-evidence { padding-bottom: var(--sp-12); }
.result-actions.btn-row { margin-top: 0; padding-top: var(--sp-12); border-top: 1px solid var(--line); }
.result-actions .btn.btn { flex: 1 1 0; white-space: nowrap; }

/* ── 其他可接受的颜色与门店 ───────────────────────────── */
.observed-store-choices { padding: var(--sp-4) 0 var(--sp-12); overflow-wrap: anywhere; }
.alternative-heading { font-weight: 600; line-height: var(--lh-snug); }
.alternative-caption { margin-top: var(--sp-2); color: var(--text-3); font-size: var(--fs-caption); }
.alternative-section-title { display: flex; align-items: center; justify-content: space-between; gap: var(--sp-12); margin: var(--sp-16) 0 var(--sp-8); color: var(--text-2); font-size: var(--fs-sub); }
.alternative-count { flex: none; color: var(--text-3); font-size: var(--fs-caption); }
.alternative-colors { display: flex; flex-wrap: wrap; align-items: stretch; width: 100%; margin-bottom: calc(var(--sp-8) * -1); }
/* 每列各占一半，间距放在列内：宽度与间距分开取整时第二个按钮不会掉到下一行。 */
.alternative-color-column { display: flex; flex: 0 0 50%; width: 50%; max-width: 50%; min-width: 0; padding-bottom: var(--sp-8); }
.alternative-color-column:nth-child(odd) { padding-right: var(--sp-4); }
.alternative-color-column:nth-child(even) { padding-left: var(--sp-4); }
.alternative-panel .alternative-chip, .alternative-panel .alternative-store, .alternative-panel .alternative-query-button,
.alternative-panel .alternative-read-button, .alternative-panel .alternative-selected-store, .observed-store-choices .observed-store-choice {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--sp-8);
  width: 100%;
  max-width: 100%;
  min-width: 0;
  height: auto;
  min-height: var(--tap);
  margin: 0;
  padding: var(--sp-8) var(--sp-12);
  border: 0;
  border-radius: var(--radius-control);
  background: var(--control);
  color: var(--text);
  font-size: var(--fs-sub);
  font-weight: 400;
  line-height: var(--lh-snug);
  text-align: left;
  white-space: normal;
}
.alternative-panel .alternative-chip[disabled], .alternative-panel .alternative-store[disabled], .alternative-panel .alternative-read-button[disabled],
.alternative-panel .alternative-selected-store[disabled], .observed-store-choices .observed-store-choice[disabled] { background: var(--control); color: var(--text); opacity: 0.5; }
.alternative-panel .ui-control-pressed, .observed-store-choices .observed-store-choice.ui-control-pressed { background: var(--pressed); }
.alternative-panel .alternative-colors .alternative-chip { flex: 1 1 auto; }
.alternative-chip-label, .observed-store-choice-copy { flex: 1 1 0; min-width: 0; overflow-wrap: anywhere; }
.observed-store-choice-copy { display: flex; flex-direction: column; }
.observed-store-choices .observed-store-choice { margin-top: var(--sp-8); }
.alternative-current { display: block; color: var(--text-3); font-size: var(--fs-caption); }
.alternative-check { display: flex; align-items: center; justify-content: center; flex: none; width: 22px; height: 22px; border: 1.5px solid var(--text-3); border-radius: 50%; color: transparent; }
.alternative-check--on { border-color: var(--green); background: var(--green); color: var(--green-ink); }
.alternative-check .ui-check { margin-bottom: var(--sp-2); }
.alternative-city-picker { display: flex; align-items: center; justify-content: space-between; gap: var(--sp-12); min-height: var(--tap); margin-bottom: var(--sp-8); padding: var(--sp-8) var(--sp-12); border-radius: var(--radius-control); background: var(--control); }
.alternative-city-name { flex: 1 1 0; min-width: 0; }
.alternative-stores { display: flex; flex-direction: column; gap: var(--sp-8); }
.alternative-store-copy { display: flex; flex: 1 1 0; flex-direction: column; min-width: 0; }
.alternative-store-label { overflow-wrap: anywhere; }
.alternative-store-relation { color: var(--text-3); font-size: var(--fs-caption); overflow-wrap: anywhere; }
.alternative-selected-stores { margin-top: var(--sp-16); }
.alternative-selected-list { display: flex; flex-wrap: wrap; gap: var(--sp-8); margin-top: var(--sp-8); }
.alternative-panel .alternative-selected-store { width: auto; }
.alternative-selected-store > text { flex: 1 1 auto; min-width: 0; }
.alternative-summary { margin-top: var(--sp-16); color: var(--text-2); font-size: var(--fs-sub); overflow-wrap: anywhere; }
.alternative-query-list { margin-top: var(--sp-8); }
.alternative-query-row { display: flex; align-items: center; justify-content: space-between; gap: var(--sp-12); padding: var(--sp-4) 0; }
.alternative-query-copy { flex: 1 1 0; min-width: 0; }
.alternative-query-color { display: block; overflow-wrap: anywhere; }
.alternative-query-hint { display: block; color: var(--text-3); font-size: var(--fs-caption); }
.alternative-panel .alternative-query-button { flex: none; justify-content: center; width: 76px; max-width: 50%; background: var(--green); color: var(--green-ink); font-weight: 600; text-align: center; white-space: nowrap; }
.alternative-panel .alternative-query-button[disabled] { background: var(--green); color: var(--green-ink); opacity: 0.4; }
.alternative-observations { margin-top: var(--sp-16); padding-top: var(--sp-16); border-top: 1px solid var(--line); }
.alternative-panel .alternative-read-button { justify-content: center; text-align: center; }
.alternative-empty { margin-top: var(--sp-12); padding: var(--sp-12); border-radius: var(--radius-control); background: var(--control); color: var(--text-2); font-size: var(--fs-sub); }
.alternative-match { margin-top: var(--sp-16); padding-top: var(--sp-16); border-top: 1px solid var(--line); overflow-wrap: anywhere; }

/* ── 提示与入口 ───────────────────────────────────────── */
.query-notice-region:empty { display: none; }
.query-notice { display: flex; align-items: center; flex-wrap: wrap; gap: var(--sp-8); }
.query-notice > text { flex: 1 1 150px; min-width: 0; }
.ui-icon.query-follow-icon { filter: none; }
.query-link-meta { max-width: 160px; overflow-wrap: anywhere; text-align: right; }
