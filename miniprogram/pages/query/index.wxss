/* 查询页专用样式（公共样式见 app.wxss） */
.card-title text:first-child { flex: 1; min-width: 0; white-space: normal; }
.target-row { padding: 14rpx 0; border-bottom: 2rpx solid var(--line); }
.target-row:last-of-type { border-bottom: none; }
.target-text { flex: 1; min-width: 0; margin-right: 16rpx; }
.target-text .bold { display: block; white-space: normal; overflow-wrap: anywhere; }
.selection-card > .card-title { padding-bottom: 20rpx; border-bottom: 1rpx solid var(--line); margin-bottom: 8rpx; }
.selection-card > .card-title .sub { padding: 7rpx 16rpx; background: var(--green-soft); color: var(--green-dark); border-radius: 999rpx; }
.query-result-card .list-item { padding: 24rpx 0; }
.query-result-card > .small.muted { line-height: 1.65; }
.target-row { padding: 22rpx 0; }
.selection-follow-action { margin-top: 16rpx; gap: 12rpx; }
.selection-follow-action > text { min-width: 0; overflow-wrap: anywhere; }
.selection-whistle { display: block; flex: 0 0 34rpx; width: 34rpx; height: 34rpx; }
.selection-rules { margin-top: 24rpx; padding-top: 22rpx; border-top: 1rpx solid var(--line); }
.selection-rule { display: flex; align-items: flex-start; gap: 20rpx; font-size: 24rpx; line-height: 1.65; text-align: left; }
.selection-rule + .selection-rule { margin-top: 16rpx; }
.selection-rule-label { flex: 0 0 4em; color: var(--text-2); font-weight: 500; white-space: nowrap; }
.selection-rule-copy { flex: 1 1 0; min-width: 0; color: var(--text-2); overflow-wrap: anywhere; }
.selection-rule-detail { margin-top: 4rpx; color: var(--text-3); }
.result-actions { flex-wrap: nowrap; gap: 20rpx; margin-top: 24rpx; }
.result-actions .btn.btn { flex: 1 1 0; min-height: 44px; min-height: max(44px, 88rpx); padding: 18rpx 16rpx; font-size: 26rpx; line-height: 1.5; white-space: nowrap; }
.result-actions .btn-ghost { border: 2rpx solid transparent; }
.selection-summary { padding-top: 14rpx; }
.selection-summary-product { display: flex; align-items: center; gap: 16rpx; min-width: 0; }
.selection-summary-image-box { display: flex; align-items: center; justify-content: center; width: 168rpx; height: 200rpx; flex: 0 0 168rpx; background: var(--surface-soft); border: 1rpx solid var(--glass-line); border-radius: var(--radius-action); overflow: hidden; }
.selection-summary-image { display: block; width: 100%; height: 100%; }
.selection-summary-image-placeholder { display: flex; align-items: center; justify-content: center; height: 100%; font-size: 22rpx; color: var(--text-3); }
.selection-summary-copy { flex: 1 1 0; min-width: 0; }
.selection-summary-title { font-size: 28rpx; font-weight: 600; line-height: 1.5; overflow-wrap: anywhere; }
.selection-summary-city { margin-top: 8rpx; color: var(--text-2); font-size: 23rpx; line-height: 1.5; overflow-wrap: anywhere; }
.selection-summary-footer { display: flex; align-items: center; gap: 16rpx; margin-top: 18rpx; padding-top: 16rpx; border-top: 1rpx solid var(--line); }
.selection-summary-change.ui-action { flex: 0 0 116rpx; width: 116rpx; min-width: 58px; max-width: 72px; padding: 12rpx 14rpx; gap: 8rpx; }
.selection-summary-stores { flex: 1 1 0; min-width: 0; color: var(--text-2); font-size: 24rpx; line-height: 1.6; overflow-wrap: anywhere; }
.selection-done.btn { margin-top: 24rpx; }
.selection-empty { padding: 28rpx 0 8rpx; }
.selection-empty-title { font-size: 36rpx; font-weight: 600; margin-bottom: 12rpx; }
.selection-access-note { margin-top: 20rpx; font-size: 25rpx; line-height: 1.6; color: var(--text-2); }
.selection-rules { margin-top: 0; padding-top: 16rpx; }
.selection-summary-title { font-size: 32rpx; }
.selection-summary-city, .selection-summary-stores { font-size: 25rpx; }
.selection-card > .btn, .selection-done.btn { min-height: 44px; min-height: max(44px, 88rpx); }
.result-target-note { margin-bottom: 20rpx; padding: 14rpx 18rpx; border-radius: 16rpx; background: var(--surface-soft); color: var(--text-2); font-size: 23rpx; line-height: 1.55; overflow-wrap: anywhere; }
.result-target-different { background: var(--warn-soft); color: var(--warn); }
.result-product-row { display: flex; align-items: center; gap: 22rpx; padding: 4rpx 0 24rpx; border-bottom: 1rpx solid var(--line); }
.result-product-media { display: flex; align-items: center; justify-content: center; flex: 0 0 168rpx; width: 168rpx; height: 200rpx; background: var(--surface-soft); border: 1rpx solid var(--line); border-radius: var(--radius-action); overflow: hidden; }
.result-product-image { display: block; width: 100%; height: 100%; }
.product-image-fit-pro { transform: translateY(-3.8%) scale(1.43); }
.product-image-fit-max { transform: translateY(.3%) scale(1.31); }
.result-product-placeholder { color: var(--text-3); font-size: 24rpx; line-height: 1.5; text-align: center; }
.result-product-copy { flex: 1 1 0; min-width: 0; }
.result-product-title { color: var(--text); font-size: 30rpx; font-weight: 600; line-height: 1.5; overflow-wrap: anywhere; }
.result-product-meta { display: flex; align-items: center; flex-wrap: wrap; gap: 8rpx 12rpx; margin-top: 12rpx; }
.result-product-meta .pill { padding: 3rpx 12rpx; font-size: 22rpx; }
.result-product-part { color: var(--text-2); font-size: 24rpx; font-size: max(12px, 24rpx); line-height: 1.5; overflow-wrap: anywhere; }
.result-product-time { margin-top: 8rpx; color: var(--text-3); font-size: 24rpx; font-size: max(12px, 24rpx); line-height: 1.6; overflow-wrap: anywhere; }

/* 首页提示：添加到我的小程序 */
.banner.add-tip { display: flex; align-items: flex-start; gap: 16rpx; }
.add-tip-text { flex: 1; min-width: 0; }
.add-tip-close { flex: none; font-size: 34rpx; line-height: 1.1; color: var(--text-3); }

@media (prefers-color-scheme: dark) {
  .selection-summary-image-box, .result-product-media { background: var(--image-tile); }
}
