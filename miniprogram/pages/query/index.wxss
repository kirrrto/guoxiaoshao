/* 查询页专用样式（公共样式见 app.wxss） */
.query-links { padding: 0 28rpx; border-radius: var(--radius-card); background: var(--card); box-shadow: var(--shadow-soft); }
.query-links .ui-disclosure {
  width: 100%;
  min-height: 48px;
  margin: 0;
  padding: 15rpx 0;
  gap: 16rpx;
  border: 0;
  border-radius: 0;
  background: transparent;
}
.query-links .ui-disclosure + .ui-disclosure, .query-links .selection-rules + .ui-disclosure { border-top: 1rpx solid var(--line); }
.query-links .query-guide-title { flex: 1 1 auto; min-width: 0; color: var(--text); font-size: max(14px, 28rpx); text-align: left; }
.query-link-meta { max-width: 50%; font-size: max(12px, 24rpx); color: var(--text-2); text-align: right; white-space: normal; overflow-wrap: anywhere; }
.query-links .ui-control-pressed { background: var(--control-pressed); }
.card-title text:first-child { flex: 1; min-width: 0; white-space: normal; }
.target-row { padding: 14rpx 0; border-bottom: 2rpx solid var(--line); }
.target-row:last-of-type { border-bottom: none; }
.target-text { flex: 1; min-width: 0; margin-right: 16rpx; }
.target-text .bold { display: block; white-space: normal; overflow-wrap: anywhere; }
.query-result-card .list-item { padding: 24rpx 0; }
.query-result-card > .small.muted { line-height: 1.65; }
.target-row { padding: 22rpx 0; }
.selection-follow-action > text { min-width: 0; overflow-wrap: anywhere; }
.selection-rules { padding: 4rpx 0 24rpx; }
.selection-rule { display: flex; align-items: flex-start; gap: 16rpx; font-size: max(12px, 24rpx); line-height: 1.6; text-align: left; }
.selection-rule + .selection-rule { margin-top: 14rpx; padding-top: 14rpx; border-top: 1rpx solid var(--line); }
.selection-rule-label { flex: 0 0 4em; color: var(--text); font-weight: 600; white-space: nowrap; }
.selection-rule-copy { flex: 1 1 0; min-width: 0; color: var(--text-2); overflow-wrap: anywhere; }
.selection-rule-detail { margin-top: 4rpx; color: var(--text-3); }
.result-actions { flex-wrap: nowrap; gap: 20rpx; margin-top: 24rpx; }
.result-actions .btn.btn { flex: 1 1 0; min-height: 44px; min-height: max(44px, 88rpx); padding: 18rpx 16rpx; font-size: max(12px, 26rpx); line-height: 1.5; white-space: nowrap; }
.result-actions .btn-ghost { border: 2rpx solid transparent; }
/* Size the edit action to its content: a fixed 58–72px box wrapped 「修改」 on
   phones with larger fonts. The store list shrinks/wraps instead. */
.selection-summary-change.ui-action { flex: 0 0 auto; width: auto; min-width: 58px; max-width: none; padding: 12rpx 14rpx; gap: 8rpx; white-space: nowrap; }
.selection-summary-change .ui-action-label { flex: none; white-space: nowrap; word-break: keep-all; overflow-wrap: normal; }
.result-target-note { margin-bottom: 20rpx; padding: 14rpx 18rpx; border-radius: 16rpx; background: var(--surface-soft); color: var(--text-2); font-size: max(12px, 23rpx); line-height: 1.55; overflow-wrap: anywhere; }
.result-target-different { background: var(--warn-soft); color: var(--warn); }
.result-product-row { display: flex; align-items: center; gap: 22rpx; padding: 4rpx 0 24rpx; border-bottom: 1rpx solid var(--line); }
.result-product-media { display: flex; align-items: center; justify-content: center; flex: 0 0 168rpx; width: 168rpx; height: 200rpx; background: var(--image-tile); border-radius: var(--radius-action); overflow: hidden; }
.result-product-image { display: block; width: 100%; height: 100%; }
.result-product-media--empty { background: var(--card); }
.product-image-fit-pro { transform: translateY(-3.8%) scale(1.43); }
.product-image-fit-max { transform: translateY(.3%) scale(1.31); }
.result-product-placeholder { color: var(--text-3); font-size: max(12px, 24rpx); line-height: 1.5; text-align: center; }
.result-product-copy { flex: 1 1 0; min-width: 0; }
.result-product-title { color: var(--text); font-size: 30rpx; font-weight: 600; line-height: 1.5; overflow-wrap: anywhere; }
.result-receipt { padding-bottom: 16rpx; border-bottom: 1rpx solid var(--line); }
.result-receipt-line { display: flex; align-items: baseline; flex-wrap: wrap; justify-content: space-between; gap: 3px 10px; }
.result-receipt-title { color: var(--text); font-size: clamp(17px, 4.6vw, 21px); line-height: 1.4; font-weight: 650; }
.result-product-part { color: var(--text-2); font-size: 24rpx; font-size: max(12px, 24rpx); line-height: 1.5; overflow-wrap: anywhere; }
.result-product-time { margin-top: 8rpx; color: var(--text-3); font-size: 24rpx; font-size: max(12px, 24rpx); line-height: 1.6; overflow-wrap: anywhere; }

.observed-store-choices { margin: 24rpx 0; line-height: 1.6; }
.observed-store-choice { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; width: 100%; min-height: 44px; margin: 16rpx 0 0; padding: 18rpx; background: var(--control-fill); border: 0; border-radius: 16rpx; color: var(--text); text-align: left; white-space: normal; line-height: 1.6; }
.observed-store-choice-copy { display: flex; flex: 1; min-width: 0; flex-direction: column; gap: 6rpx; overflow-wrap: anywhere; }
.observed-store-choice--selected { background: var(--control-pressed); font-weight: 600; }
.observed-store-choice > text { flex: none; }
.observed-store-choice::after { border: 0; }
.alternative-match { margin-top: 24rpx; padding-top: 24rpx; border-top: 1rpx solid var(--line); overflow-wrap: anywhere; }
.alternative-heading { font-size: 28rpx; font-weight: 600; line-height: 1.45; color: var(--text); }
.alternative-caption { margin-top: 8rpx; font-size: max(12px, 22rpx); line-height: 1.55; color: var(--text-3); }
.alternative-section-title { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; margin-top: 24rpx; margin-bottom: 12rpx; color: var(--text-2); font-size: max(12px, 24rpx); font-weight: 500; }
.alternative-count { flex: none; color: var(--text-3); font-size: max(12px, 22rpx); font-weight: 400; }
.alternative-colors { display: flex; flex-wrap: wrap; align-items: stretch; width: 100%; margin-bottom: -12rpx; }
/* The view owns each 50% column; spacing stays inside it. Separate rpx
   rounding of a calc width and gap must not push the second button to a new row. */
.alternative-color-column { box-sizing: border-box; display: flex; flex: 0 0 50%; width: 50%; max-width: 50%; min-width: 0; padding-bottom: 12rpx; }
.alternative-color-column:nth-child(odd) { padding-right: 6rpx; }
.alternative-color-column:nth-child(even) { padding-left: 6rpx; }
/* Scoped selectors override native button sizing and centering without changing other controls. */
.alternative-panel .alternative-chip, .alternative-panel .alternative-store, .alternative-panel .alternative-query-button, .alternative-panel .alternative-read-button { box-sizing: border-box; margin: 0; min-width: 0; height: auto; min-height: 44px; min-height: max(44px, 80rpx); padding: 14rpx 18rpx; font-size: max(12px, 24rpx); line-height: 1.4; color: var(--text); white-space: normal; border: 0; border-radius: 14rpx; background: var(--control-fill); }
.alternative-chip::after, .alternative-store::after, .alternative-query-button::after, .alternative-read-button::after { border: none; }
.alternative-panel .alternative-colors .alternative-chip { display: flex; flex: 1 1 auto; align-items: center; justify-content: space-between; gap: 8rpx; width: 100%; max-width: 100%; text-align: left; }
.alternative-chip-label { flex: 1; min-width: 0; overflow-wrap: anywhere; }
.alternative-current { display: block; margin-top: 2rpx; font-size: max(12px, 21rpx); color: var(--text-3); }
.alternative-check { display: flex; align-items: center; justify-content: center; flex: 0 0 30rpx; height: 30rpx; border: 1rpx solid var(--line); border-radius: 8rpx; font-size: max(12px, 22rpx); color: var(--text-3); background: var(--card); }
.alternative-panel .alternative-chip--selected, .alternative-panel .alternative-store--selected { background: var(--control-pressed); }
.alternative-chip--selected .alternative-check, .alternative-store--selected .alternative-check { background: var(--text); color: var(--card); border-color: transparent; }
.alternative-stores { display: flex; flex-direction: column; gap: 8rpx; }
.alternative-city-picker { margin-bottom: 12rpx; }
.alternative-selected-stores { margin-top: 20rpx; }
.alternative-selected-list { display: flex; flex-wrap: wrap; gap: 10rpx; margin-top: 10rpx; }
.alternative-panel .alternative-selected-store { display: flex; align-items: center; justify-content: space-between; gap: 14rpx; width: auto; max-width: 100%; min-width: 0; min-height: 44px; height: auto; margin: 0; padding: 12rpx 16rpx; border: 0; border-radius: 12rpx; background: var(--control-fill); color: var(--text); font-size: max(12px, 24rpx); line-height: 1.5; text-align: left; white-space: normal; overflow-wrap: anywhere; }
.alternative-selected-store::after { border: 0; }
.alternative-selected-store text:first-child { flex: 1; min-width: 0; }
.alternative-selected-store text:last-child { flex: none; }
.alternative-panel .alternative-stores .alternative-store { width: 100%; max-width: 100%; display: flex; align-items: center; justify-content: space-between; gap: 12rpx; text-align: left; }
.alternative-store-copy { display: flex; flex: 1; flex-direction: column; min-width: 0; gap: 2rpx; }
.alternative-store-label { font-size: max(12px, 24rpx); overflow-wrap: anywhere; }
.alternative-store-relation { font-size: max(12px, 21rpx); color: var(--text-3); overflow-wrap: anywhere; }
.alternative-summary { margin-top: 20rpx; font-size: max(12px, 24rpx); line-height: 1.55; color: var(--text-2); overflow-wrap: anywhere; }
.alternative-query-list { margin-top: 12rpx; }
.alternative-query-row { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; padding: 10rpx 0; }
.alternative-query-copy { flex: 1; min-width: 0; }
.alternative-query-color { display: block; font-size: max(12px, 24rpx); font-weight: 500; overflow-wrap: anywhere; }
.alternative-query-hint { display: block; margin-top: 4rpx; color: var(--text-3); font-size: max(12px, 21rpx); line-height: 1.45; }
.alternative-panel .alternative-query-button { flex: none; width: 152rpx; min-width: 76px; max-width: 50%; padding: 12rpx; background: var(--green); border-color: var(--green); color: var(--green-ink); font-size: max(12px, 23rpx); font-weight: 600; white-space: nowrap; }
.alternative-observations { margin-top: 20rpx; padding-top: 20rpx; border-top: 1rpx solid var(--line); }
.alternative-panel .alternative-read-button { width: 100%; max-width: 100%; color: var(--text-2); background: var(--surface-soft); }
.alternative-empty { margin-top: 16rpx; padding: 16rpx; border-radius: 12rpx; background: var(--surface-soft); font-size: max(12px, 23rpx); line-height: 1.6; color: var(--text-2); }
.alternative-panel .alternative-query-button.ui-control-pressed { opacity: .84; }
.alternative-panel .alternative-chip.ui-control-pressed, .alternative-panel .alternative-store.ui-control-pressed, .alternative-panel .alternative-selected-store.ui-control-pressed, .alternative-panel .alternative-read-button.ui-control-pressed { background: var(--control-pressed); }
.alternative-panel button[disabled] { opacity: .55; }

/* 2.0: lead with a state and one next action; preserve the original result. */
.journey-title { font-size: 32rpx; font-weight: 650; line-height: 1.45; overflow-wrap: anywhere; }
.result-next-action { padding: 24rpx 0; border-bottom: 1rpx solid var(--line); }
.result-next-action--available .journey-title { color: var(--green-dark); }
.target-evidence { margin: 24rpx 0; }

.query-notice-region:empty { display: none; }
.selection-follow-action.selection-follow-action { width: 100%; }

/* Selected target and query controls share one compact section. */
.query-page { padding-top: 20rpx; }
.query-page .page-heading { margin: 0 4rpx 22rpx; gap: 16rpx; }
.query-page .page-heading.brand-page-heading {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 16rpx;
}
.query-page .brand-page-copy {
  flex: 1 1 auto;
  min-width: 0;
  overflow: hidden;
}

/* Fixed slot on the right of the title block (announcement board). */
.heading-notice-btn {
  flex: 0 0 44px;
  width: 44px;
  height: 44px;
  margin: 0;
  padding: 0;
  border-radius: 18rpx;
  background: var(--control-fill);
  border: 0;
  line-height: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  align-self: center;
}
.heading-notice-btn::after { border: none; }
.heading-notice-btn.ui-control-pressed { background: var(--control-pressed); }
.heading-notice-icon { width: 36rpx; height: 36rpx; display: block; filter: grayscale(1); }
.heading-notice-dot {
  position: absolute;
  top: 10rpx;
  right: 10rpx;
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: var(--warn);
}
.query-page .brand-page-logo { width: 36px; height: 36px; border-radius: 10px; }
.query-page .page-title {
  font-size: 20px;
  line-height: 1.35;
  letter-spacing: 0;
  word-break: keep-all;
}

.query-page .card { padding: 28rpx; margin-bottom: 24rpx; }
.query-page .card-title { font-size: max(15px, 30rpx); gap: 8rpx 12rpx; }
/* A single pickup panel for both first use and saved selections. */
.query-page .selection-card {
  padding: 32rpx 28rpx 24rpx;
}
.pickup-intro { padding: 6rpx 0 36rpx; }
.pickup-quota {
  display: block;
  margin-top: 12rpx;
  color: var(--text-3);
  font-size: max(12px, 24rpx);
  line-height: 1.45;
  font-variant-numeric: tabular-nums;
}
.selection-summary-product, .selection-summary-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 22rpx;
}
.selection-summary-copy, .selection-summary-location {
  flex: 1 1 0;
  min-width: 0;
  overflow-wrap: anywhere;
}
.selection-summary-product { justify-content: flex-start; gap: 20rpx; padding-bottom: 20rpx; }
.query-page .selection-summary-title, .pickup-intro-title {
  display: block;
  color: var(--text);
  font-size: clamp(22px, 6vw, 30px);
  line-height: 1.22;
  font-weight: 700;
}
.selection-summary-spec { display: block; margin-top: 8rpx; color: var(--text-2); font-size: max(14px, 28rpx); line-height: 1.45; }
.query-page .selection-summary-image-box {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
  width: clamp(66px, 19vw, 96px);
  height: clamp(74px, 21vw, 104px);
  background: var(--image-tile);
  border-radius: 18rpx;
  overflow: hidden;
}
.query-page .selection-summary-image { display: block; width: 92%; height: 92%; }
.selection-summary-footer { min-height: 48px; padding-top: 18rpx; border-top: 1rpx solid var(--line); }
.selection-summary-city, .selection-summary-stores { display: block; line-height: 1.45; }
.selection-summary-city { margin-top: 4rpx; color: var(--text-3); font-size: max(12px, 24rpx); }
.selection-summary-stores { color: var(--text); font-size: max(14px, 28rpx); font-weight: 600; }
.query-page .selection-card > .btn { min-height: 44px; padding: 16rpx 20rpx; font-size: max(14px, 28rpx); }
.selection-utilities { margin-top: 14rpx; }
.selection-utilities .ui-action { display: flex; width: 100%; margin: 0; font-size: max(14px, 27rpx); }
.query-page .result-target-note { padding: 0 0 10rpx; margin-bottom: 8rpx; background: transparent; border-radius: 0; font-size: 12px; }
.query-page .result-target-different { padding: 12rpx 16rpx; background: var(--warn-soft); border-radius: 12rpx; }
.query-page .result-product-row { gap: 18rpx; padding: 18rpx 0; }
.query-page .result-product-media { width: 104rpx; height: 124rpx; flex-basis: 104rpx; border-radius: 16rpx; }
.query-page .result-product-title { font-size: max(14px, 29rpx); line-height: 1.4; }
.query-page .result-product-time { margin-top: 4rpx; font-size: 12px; line-height: 1.4; }
.query-page .journey-title { font-size: max(15px, 30rpx); line-height: 1.4; }
.query-page .result-next-action > .small { margin-top: 6rpx; font-size: 12px; line-height: 1.5; }
.query-page .result-next-action > .btn { min-height: 44px; padding: 14rpx 18rpx; font-size: 14px; }
.query-page .result-store { padding: 20rpx 0; }
.query-page .result-store--available .result-store-name { color: var(--green-dark); }
.result-store-heading.row-between { align-items: flex-start; flex-wrap: nowrap; gap: 12rpx; }
.result-store-heading .result-store-name { flex: 1 1 0; min-width: 0; font-size: max(14px, 28rpx); line-height: 1.5; }
.result-store-name > .small { display: block; font-size: 12px; }
.result-store-heading > .pill { flex: none; font-size: 12px; padding: 4rpx 12rpx; }
.query-page .result-store > .small, .query-page .result-store > .tiny { margin-top: 6rpx; font-size: 12px; line-height: 1.5; }
.query-page .result-actions { margin-top: 14rpx; gap: 12rpx; }

@media (min-width: 600px) {
  .query-page .card { padding: 20px; }
  .query-page .pickup-intro, .query-page .selection-summary-product { padding-bottom: 20px; }
  .query-page .pickup-quota { font-size: 14px; }
  .query-page .selection-summary-spec { font-size: 16px; }
  .query-page .selection-summary-footer { padding-top: 14px; }
  .query-page .result-product-media { width: 60px; height: 72px; flex-basis: 60px; }
  .query-page .result-product-title { font-size: 17px; }
  .query-page .journey-title, .query-page .card-title { font-size: 18px; }
  .query-page .result-store-name { font-size: 16px; }
}

/* Request feedback stays close to the action, including slow connections. */
.request-progress, .refresh-feedback { padding: 18rpx 22rpx; margin-top: 16rpx; border-radius: 16rpx; background: var(--surface-soft); color: var(--text-2); font-size: max(12px, 24rpx); line-height: 1.6; }
.refresh-feedback { margin: 0 0 20rpx; }
.request-progress--slow { color: var(--warn); background: var(--warn-soft); }

@media (prefers-color-scheme: dark) {
  .heading-notice-icon { filter: grayscale(1) brightness(1.8); }
}
