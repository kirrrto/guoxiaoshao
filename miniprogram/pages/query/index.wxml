<page-meta page-style="{{sheetVisible ? 'overflow:hidden;' : ''}}" />
<view class="page tab-page query-page">
  <view wx:if="{{loadError}}" class="card load-error" role="alert">
    <view class="load-error-title">暂时没有连上</view>
    <view class="load-error-detail">{{loadError}}</view>
    <view class="load-error-hint">检查网络后点重试；网络恢复时也会自动重新加载。</view>
    <button class="btn btn-primary btn-block" bindtap="onRetryLoad">重试</button>
  </view>

  <block wx:elif="{{!ready}}">
    <view class="page-heading"><view class="page-title">门店取货查询</view><view class="page-subtitle">查门店取货信息，有变化让小哨提醒你</view></view>
    <view class="skeleton" aria-busy="true">
      <view class="skeleton-card"><view class="skeleton-line skeleton-title"></view><view class="skeleton-line"></view><view class="skeleton-line skeleton-short"></view><view class="skeleton-bar"></view></view>
      <view class="skeleton-card"><view class="skeleton-line skeleton-title"></view><view class="skeleton-line"></view><view class="skeleton-line skeleton-short"></view></view>
      <view class="loading-line">正在加载商品目录…</view>
    </view>
  </block>

  <block wx:else>
    <view class="page-heading"><view class="page-title">门店取货查询</view><view class="page-subtitle">查门店取货信息，有变化让小哨提醒你</view></view>
    <view wx:if="{{addTipVisible}}" class="banner banner-ok add-tip"><text class="add-tip-text">点右上角「···」选「添加到我的小程序」，下次在微信首页下拉就能打开。</text><text class="add-tip-close tap-target" bindtap="onDismissAddTip" aria-role="button" aria-label="关闭提示">×</text></view>
    <view wx:if="{{announcement}}" class="banner banner-info">{{announcement}}</view>
    <view wx:if="{{!accountReady}}" class="banner banner-info small">{{accountError || '正在连接微信账户，你可以先选择商品和门店。'}}<button wx:if="{{accountError}}" class="btn btn-outline btn-sm mt" bindtap="onRetryAccount">重试账户连接</button></view>
    <view wx:if="{{boot && !boot.member && boot.balance < boot.queryCost}}" class="banner banner-info onboarding">
      <view class="small">{{boot.signedInToday ? '查询次数暂时用完了，可在「我的」查看今日任务和次数。' : '还没有查询次数？先签到领取，再查询已选配置。'}}</view>
      <button wx:if="{{!boot.signedInToday}}" class="btn btn-outline btn-sm mt" loading="{{signing}}" disabled="{{signing || querying || !accountReady}}" bindtap="onSignin">{{signing ? '签到中…' : '签到领取查询次数'}}</button>
      <button wx:else class="btn btn-outline btn-sm mt" bindtap="onGoMine">查看任务 / 查询次数</button>
      <view wx:if="{{signinError}}" class="small mt" role="alert">{{signinError}}</view>
    </view>
    <view wx:if="{{sharedSelection}}" class="banner banner-info small">已载入朋友分享的配置与门店。点击查询，获取当前取货信息。</view>
    <view wx:if="{{sharedTargetPending}}" class="banner banner-info small">
      <view>{{sharedTargetError || (sharedTargetReady ? '朋友分享的配置已保留，可在当前操作结束后切换。' : '分享的配置暂未在商品目录中确认，当前选择已保留。')}}</view>
      <button class="btn btn-outline btn-sm mt" loading="{{loadingSharedTarget}}" disabled="{{sheetVisible || querying || signing || loadingSharedTarget}}" bindtap="onLoadSharedTarget">{{loadingSharedTarget ? '正在确认…' : (sharedTargetReady ? '载入分享配置' : '刷新目录并重试')}}</button>
      <button class="ui-action mt" bindtap="onDismissSharedTarget">忽略这次分享</button>
    </view>

    <view class="card selection-card">
      <view class="card-title">
        <text>当前查询配置</text>
        <text class="sub">{{!accountReady ? '账户连接中' : (boot.member ? '会员 · 不扣次数' : '余 ' + boot.balance + ' 次')}}</text>
      </view>
      <view wx:if="{{selectionSummary}}" class="selection-summary">
        <view class="selection-summary-product">
          <view class="selection-summary-image-box"><image wx:if="{{selectionSummary.imageUrl && !selectionImageFailed}}" class="selection-summary-image {{selectionSummary.imageFitClass}}" src="{{selectionSummary.imageUrl}}" mode="aspectFit" aria-label="{{selectionSummary.imageAlt}}" binderror="onSelectionImageError" /><view wx:else class="selection-summary-image-placeholder">商品</view></view>
          <view class="selection-summary-copy"><view class="selection-summary-title">{{selectionSummary.title}}</view><view class="selection-summary-city">{{selectionSummary.cityLabel}}</view></view>
        </view>
        <view class="selection-summary-footer"><view class="selection-summary-stores">{{selectionSummary.storeLabel}}</view><button class="ui-action selection-summary-change" hover-class="ui-control-pressed" bindtap="onEditSelection"><text class="ui-action-label">修改</text><text class="ui-chevron" aria-hidden="true"></text></button></view>
      </view>
      <view wx:if="{{!selectionSummary}}" class="selection-empty">
        <view class="selection-empty-title">想查哪一款？</view>
        <view class="small text-2">选择型号、容量和门店，即可查询或关注。</view>
        <button class="btn btn-primary btn-block mt" bindtap="onEditSelection">选择配置与门店</button>
      </view>
      <view wx:elif="{{!selectionCanCollapse}}" class="banner banner-warn small mt">请补全或核对配置与门店后查询。</view>
      <view wx:if="{{restriction}}" class="banner banner-warn mt">{{restriction}}</view>
      <button wx:if="{{restrictionReason === 'new_product_restricted'}}" class="btn btn-primary btn-block mt" bindtap="onEditSelection">改查其他配置</button>
      <button wx:elif="{{selectionSummary}}" class="btn btn-primary btn-block mt {{querying || signing ? 'disabled' : ''}}" disabled="{{querying || signing || !accountReady || !selectionCanCollapse}}" bindtap="onQuery">
        {{!accountReady ? '正在连接账户…' : (querying ? '查询中…' : (boot.member ? '立即查询' : '立即查询（消耗 ' + boot.queryCost + ' 次）'))}}
      </button>
      <button wx:if="{{selectionSummary}}" class="btn btn-outline btn-block mt selection-follow-action" disabled="{{!accountReady || querying || !selectionCanCollapse}}" bindtap="onFollowSelection"><image class="selection-whistle" src="/images/brand/whistle-green.png" mode="aspectFit" aria-hidden="true" /><text>{{boot.member ? '关注此配置 · 小哨提醒' : '了解会员 · 关注与提醒'}}</text></button>
      <view wx:if="{{accountReady}}" class="selection-access-note">{{boot.member ? '关注后后台帮你留意变化；微信提醒需授权。' : '关注与到货提醒为会员专属。免费用户可用查询次数实时看货。'}}</view>
      <button class="ui-disclosure" hover-class="ui-control-pressed" bindtap="onToggleRules" aria-expanded="{{rulesExpanded}}"><text class="ui-disclosure-label">查询与提醒规则</text><view class="ui-disclosure-meta"><text>{{rulesExpanded ? '收起' : '展开'}}</text><text class="ui-chevron {{rulesExpanded ? 'ui-chevron--up' : 'ui-chevron--down'}}" aria-hidden="true"></text></view></button>
      <view wx:if="{{accountReady && rulesExpanded}}" class="selection-rules">
        <view class="selection-rule">
          <text class="selection-rule-label">关注提醒</text>
          <view class="selection-rule-copy">
            <view>直接关注，无需先查询。</view>
            <view class="selection-rule-detail">{{boot.member ? '需微信授权及服务就绪。' : '关注与到货提醒为会员专属；免费用户可用查询次数实时看货。'}}</view>
          </view>
        </view>
        <view class="selection-rule">
          <text class="selection-rule-label">查询规则</text>
          <view class="selection-rule-copy">{{boot.member ? '会员查询不扣次数；请求繁忙或数据源限流时，需按页面提示稍后重试。' : '获取新的有效结果扣 ' + boot.queryCost + ' 次；未取得新的有效结果则返还，复用最近结果不扣次数。'}}</view>
        </view>
        <view wx:if="{{!boot.member}}" class="selection-rule">
          <text class="selection-rule-label">新品限制</text>
          <view class="selection-rule-copy">受限新品开售 30 天内，免费用户可查看昨天及更早的历史，暂不可实时查询。</view>
        </view>
      </view>
    </view>

    <view wx:if="{{result}}" id="query-result" class="card query-result-card">
      <view class="result-target-note {{resultTargetDifferent ? 'result-target-different' : ''}}">{{resultTargetDifferent ? '与当前选择不同 · 下方保留原查询结果' : '对应当前所选配置与门店'}}</view>
      <view class="result-product-row">
        <view class="result-product-media">
          <image wx:if="{{result.product.imageUrl}}" class="result-product-image {{result.product.imageFitClass}}" src="{{result.product.imageUrl}}" mode="aspectFit" aria-label="{{result.product.imageAlt || result.product.title}}" binderror="onResultImageError" />
          <view wx:else class="result-product-placeholder">暂无图片</view>
        </view>
        <view class="result-product-copy">
          <view class="result-product-title">{{result.product.title}}</view>
          <view class="result-product-meta"><text class="pill pill-muted">{{resultIsCache ? '本地缓存' : '查询快照'}}</text><text class="result-product-part">{{result.product.partNumber}}</text></view>
          <view class="result-product-time">查询时间 {{result.queriedText}}</view>
        </view>
      </view>
      <view wx:for="{{result.results}}" wx:key="storeNumber" class="list-item">
        <view class="row-between">
          <view>
            <text class="bold">{{item.storeName}}</text>
            <text class="small muted"> {{item.city}}</text>
          </view>
          <view class="pill pill-dot pill-{{item.statusCls}}">{{item.statusLabel}}</view>
        </view>
        <view class="small text-2 mt" wx:if="{{item.quote && item.observationState === 'fresh'}}">{{item.quote}}</view>
        <view class="tiny muted mt">
          观测 {{item.observedText}}
          <text wx:if="{{item.sinceText}}"> · 距本轮首次记录 {{item.sinceText}}</text>
          <text wx:if="{{item.status === 'unknown' && item.reason}}"> · {{item.reason}}</text>
        </view>
        <view wx:if="{{item.observationNote}}" class="tiny muted mt">{{item.observationNote}}</view>
        <view wx:if="{{item.lastKnownText}}" class="tiny muted mt">{{item.lastKnownText}}</view>
        <view wx:if="{{item.freshnessText}}" class="tiny mt {{item.observationState === 'fresh' ? 'muted' : 'stale-note'}}">{{item.freshnessText}}</view>
        <view wx:if="{{item.events.length}}" class="row wrap gap mt">
          <text wx:for="{{item.events}}" wx:for-item="ev" wx:key="type" class="pill pill-{{ev.cls}} tiny">{{ev.label}}</text>
        </view>
      </view>
      <view wx:if="{{storeChoices.length && !alternativeColorChoices.length}}" class="observed-store-choices">
        <view class="small bold">同一配置，可考虑的门店</view>
        <view class="tiny muted mt">仅列出这次结果中最近观测可取货的门店。勾选你能接受的门店后，仍需重新确认；不会自动查询或添加关注。</view>
        <button wx:for="{{storeChoices}}" wx:key="storeNumber" class="observed-store-choice {{item.selected ? 'observed-store-choice--selected' : ''}}" data-store="{{item.storeNumber}}" aria-pressed="{{item.selected}}" disabled="{{querying || signing || sheetVisible}}" bindtap="onToggleAcceptableStore">
          <view class="observed-store-choice-copy"><text>{{item.label}}</text><text class="tiny muted">观测 {{item.observedText}} · {{item.ageText}}</text></view><text class="small">{{item.selected ? '已勾选' : '可接受'}}</text>
        </button>
        <button class="btn btn-outline btn-block mt" disabled="{{!acceptedStoreNumbers.length || querying || signing || sheetVisible}}" bindtap="onUseAcceptableStores">用勾选门店准备查询</button>
        <view wx:if="{{alternativeNotice}}" class="small text-2 mt" role="status">{{alternativeNotice}}</view>
      </view>
      <view wx:if="{{alternativeColorChoices.length && alternativeStoreChoices.length}}" class="observed-store-choices alternative-panel">
        <view class="alternative-heading">换个颜色或门店，继续找货</view>
        <view class="alternative-caption">同机型、同容量。勾选不扣次，点查询才会查询。</view>
        <view class="alternative-section-title"><text>可接受的颜色</text><text class="alternative-count">{{alternativeParts.length}} / 3</text></view>
        <view class="alternative-colors">
          <button wx:for="{{alternativeColorChoices}}" wx:key="partNumber" class="alternative-chip {{item.selected ? 'alternative-chip--selected' : ''}}" hover-class="ui-control-pressed" data-kind="part" data-value="{{item.partNumber}}" aria-pressed="{{item.selected}}" disabled="{{alternativeLoading || querying || signing || sheetVisible}}" bindtap="onToggleAlternative">
            <text class="alternative-chip-label">{{item.label}}<text wx:if="{{item.current}}" class="alternative-current">当前颜色</text></text><text class="alternative-check" aria-hidden="true">{{item.selected ? '✓' : '+'}}</text>
          </button>
        </view>
        <view class="alternative-section-title"><text>可接受的门店</text><text class="alternative-count">{{alternativeStores.length}} / {{boot ? boot.maxStores : 3}}</text></view>
        <view class="alternative-stores">
          <button wx:for="{{alternativeStoreChoices}}" wx:key="storeNumber" class="alternative-store {{item.selected ? 'alternative-store--selected' : ''}}" hover-class="ui-control-pressed" data-kind="store" data-value="{{item.storeNumber}}" aria-pressed="{{item.selected}}" disabled="{{alternativeLoading || querying || signing || sheetVisible}}" bindtap="onToggleAlternative">
            <view class="alternative-store-copy"><text class="alternative-store-label">{{item.label}}</text><text class="alternative-store-relation">{{item.relationText}}</text></view><text class="alternative-check" aria-hidden="true">{{item.selected ? '✓' : '+'}}</text>
          </button>
        </view>
        <view class="alternative-summary" aria-live="polite">{{alternativeSelectionSummary}}</view>
        <view wx:if="{{alternativeSelectedColors.length}}" class="alternative-query-list">
          <view wx:for="{{alternativeSelectedColors}}" wx:key="partNumber" class="alternative-query-row">
            <text class="alternative-query-color">{{item.label}}</text>
            <button class="alternative-query-button" hover-class="ui-control-pressed" data-part="{{item.partNumber}}" disabled="{{!alternativeStores.length || !accountReady || alternativeLoading || querying || signing || sheetVisible}}" loading="{{querying && alternativeQueryPart === item.partNumber}}" bindtap="onQueryAlternative">{{querying && alternativeQueryPart === item.partNumber ? '查询中…' : (!accountReady ? '账户连接中' : (boot.member ? '查询 · 会员不扣次' : '查询 · 消耗 ' + boot.queryCost + ' 次'))}}</button>
          </view>
        </view>
        <view wx:if="{{alternativeQueryNote}}" class="alternative-empty" role="status">{{alternativeQueryNote}}</view>
        <view wx:if="{{alternativeCanRead}}" class="alternative-observations">
          <button class="alternative-read-button" hover-class="ui-control-pressed" disabled="{{!alternativeParts.length || !alternativeStores.length || alternativeLoading || querying || signing || sheetVisible}}" loading="{{alternativeLoading}}" bindtap="onReadAlternatives">查看近期有货记录 · 免费</button>
          <view class="alternative-caption">只读近 2 分钟已有记录；有效至 {{alternativeExpiresText}}。</view>
        </view>
        <view wx:else class="alternative-caption mt">近期记录已不可用，仍可查询上方所选条件。</view>
        <view wx:if="{{alternativeError}}" class="small text-bad mt" role="status">{{alternativeError}} 可直接查询上方所选条件。</view>
        <view wx:if="{{alternativeCanRead && alternativeRead && !alternativeMatches.length && !alternativeError}}" class="alternative-empty" role="status">暂无近期有货记录，不代表无货。可点上方「查询」确认。</view>
        <view wx:for="{{alternativeMatches}}" wx:key="key" class="alternative-match">
          <view class="small bold">{{item.productTitle}}</view>
          <view class="small mt">{{item.storeLabel}}</view>
          <view class="tiny muted mt">观测可取货 · {{item.observedText}} · {{item.ageText}}</view>
          <button class="btn btn-ghost btn-block mt" data-key="{{item.key}}" disabled="{{alternativeLoading || querying || signing || sheetVisible}}" bindtap="onPrepareAlternative">准备这个配置和门店</button>
        </view>
        <view wx:if="{{alternativePreparedNotice}}" class="small text-2 mt" role="status">{{alternativePreparedNotice}}</view>
      </view>
      <view class="btn-row result-actions">
        <button class="btn btn-ghost btn-sm" bindtap="onAddFollow">加入关注</button>
        <button class="btn btn-outline btn-sm {{querying || signing ? 'disabled' : ''}}" disabled="{{querying || signing || !accountReady}}" bindtap="onRequery" aria-label="重新查询此结果的配置与门店">{{querying ? '查询中…' : '重新查询'}}</button>
      </view>
    </view>

    <view wx:if="{{followTargets.length}}" class="card">
      <view class="card-title">
        <text>我的关注 · 最近观测</text>
        <text class="sub">{{followRefreshedText ? '刷新于 ' + followRefreshedText : ''}}</text>
      </view>
      <view wx:if="{{followRefreshError}}" class="banner banner-warn small">刷新失败，以下保留上次观测。</view>
      <view wx:for="{{followTargets}}" wx:key="key" class="row-between target-row">
        <view class="target-text">
          <text class="small bold">{{item.productTitle}}</text>
          <view class="tiny muted">{{item.storeLabel}}</view>
          <view wx:if="{{item.observedText}}" class="tiny muted">{{item.observedText}}</view>
          <view wx:if="{{item.lastKnownText}}" class="tiny muted">{{item.lastKnownText}}</view>
          <view wx:if="{{item.freshnessText}}" class="tiny {{item.observationState === 'fresh' ? 'muted' : 'stale-note'}}">{{item.freshnessText}}</view>
        </view>
        <view class="pill pill-dot pill-{{item.statusCls}} tiny">{{item.statusLabel}}</view>
      </view>
      <view class="tiny muted mt">页面可见时约每分钟读取一次已有观测。后台更新可能延迟，请查看各门店的观测时间；读取列表不会立即重新检测。</view>
    </view>

    <view class="card">
      <view class="row-between">
        <text class="small text-2">自动监测状态</text>
        <view class="pill pill-dot pill-{{collector.cls}}">{{collector.label}}</view>
      </view>
      <view class="tiny muted mt">仅显示是否可取货，不提供剩余件数。结果对应标注的观测时间，之后可能变化；请以苹果官网结算页面为准。</view>
    </view>
  </block>
</view>

<config-sheet id="query-config-sheet" visible="{{sheetVisible}}" title="选择配置与门店" subtitle="保存后返回首页，再选择查询或关注" confirm-text="保存选择" summary="{{draftSummary}}" dirty="{{draftDirty}}" external-close="{{true}}" bindconfirm="onDoneSelection" bindrequestclose="onRequestCloseSelection" bindclose="onCloseSelection">
  <target-picker wx:if="{{sheetVisible}}" id="query-target-picker" catalog-version="{{catalogVersion}}" value="{{draftValue}}" max-stores="{{boot ? boot.maxStores : 3}}" in-sheet="{{true}}" bindchange="onDraftChange" />
</config-sheet>
