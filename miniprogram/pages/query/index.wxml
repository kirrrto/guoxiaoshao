<page-meta page-style="{{sheetVisible ? 'overflow:hidden;' : ''}}" />
<view class="page tab-page query-page">
  <view wx:if="{{networkOffline}}" class="network-notice" role="status">网络已断开，恢复后自动刷新</view>
  <view wx:if="{{loadError}}" class="card load-error" role="alert">
    <view class="load-error-title">暂时没有连上</view>
    <view class="load-error-detail">{{loadError}}</view>
    <view class="load-error-hint">检查网络后点重试；网络恢复时也会自动重新加载。</view>
    <button class="btn btn-primary btn-block" bindtap="onRetryLoad">重试</button>
  </view>

  <block wx:elif="{{!ready}}">
    <view class="page-heading brand-page-heading">
      <image class="brand-page-logo" src="/images/brand/logo-mint-144.png" mode="aspectFit" aria-hidden="true" />
      <view class="brand-page-copy"><view class="page-title">门店取货查询</view><view class="page-subtitle">查取货信息，有变化让小哨提醒</view></view>
      <button class="heading-notice-btn" hover-class="ui-control-pressed" bindtap="onOpenNoticeBoard" aria-label="查看公告">
        <image class="heading-notice-icon" src="/images/ui/news.png" mode="aspectFit" aria-hidden="true" />
        <view wx:if="{{noticeDot}}" class="heading-notice-dot" aria-hidden="true"></view>
      </button>
    </view>
    <view class="skeleton" aria-busy="true">
      <view class="skeleton-card"><view class="skeleton-line skeleton-title"></view><view class="skeleton-line"></view><view class="skeleton-line skeleton-short"></view><view class="skeleton-bar"></view></view>
      <view class="skeleton-card"><view class="skeleton-line skeleton-title"></view><view class="skeleton-line"></view><view class="skeleton-line skeleton-short"></view></view>
      <view class="loading-line">正在加载商品目录…</view>
    </view>
  </block>

  <block wx:else>
    <view wx:if="{{refreshing || refreshMessage}}" class="refresh-feedback" role="status">{{refreshing ? '正在更新账户与页面…' : refreshMessage}}</view>
    <view class="page-heading brand-page-heading">
      <image class="brand-page-logo" src="/images/brand/logo-mint-144.png" mode="aspectFit" aria-hidden="true" />
      <view class="brand-page-copy"><view class="page-title">门店取货查询</view><view class="page-subtitle">查取货信息，有变化让小哨提醒</view></view>
      <button class="heading-notice-btn" hover-class="ui-control-pressed" bindtap="onOpenNoticeBoard" aria-label="查看公告">
        <image class="heading-notice-icon" src="/images/ui/news.png" mode="aspectFit" aria-hidden="true" />
        <view wx:if="{{noticeDot}}" class="heading-notice-dot" aria-hidden="true"></view>
      </button>
    </view>
    <!-- Pin tip belongs at the top of the content, not buried under query cards. -->
    <view wx:if="{{addTipVisible}}" class="banner banner-ok add-tip add-tip--top">
      <text class="add-tip-text">添加到「我的小程序」，微信下拉即可打开。</text>
      <text class="add-tip-close tap-target" bindtap="onDismissAddTip" aria-role="button" aria-label="关闭提示">×</text>
    </view>
    <button class="ui-disclosure query-guide-entry" hover-class="ui-control-pressed" bindtap="onOpenGuide">
      <view class="query-guide-icon" aria-hidden="true"><image class="ui-icon" src="/images/ui/guide.png" mode="aspectFit" /></view>
      <view class="query-guide-copy">
        <text class="query-guide-title">选购与取货攻略</text>
        <text class="query-guide-note">选好配置，了解提醒与取货流程</text>
      </view>
      <view class="ui-chevron" aria-hidden="true"></view>
    </button>
    <view class="card selection-card {{selectionSummary ? '' : 'selection-card--empty'}} {{result ? 'selection-card--has-result' : ''}}">
      <view class="card-title">
        <text>{{selectionSummary ? '当前查询配置' : '想查哪一款？'}}</text>
        <text class="sub">{{!accountReady ? '账户连接中' : (boot.member ? '会员 · 不扣次数' : '余 ' + boot.balance + ' 次')}}</text>
      </view>
      <view wx:if="{{selectionSummary}}" class="selection-summary">
        <view class="selection-summary-product">
          <view class="selection-summary-image-box"><image wx:if="{{selectionSummary.imageDisplayUrl && !selectionImageFailed}}" class="selection-summary-image {{selectionSummary.imageFitClass}}" src="{{selectionSummary.imageDisplayUrl}}" webp="{{true}}" mode="aspectFit" aria-label="{{selectionSummary.imageAlt}}" binderror="onSelectionImageError" /><view wx:else class="selection-summary-image-placeholder">商品</view></view>
          <view class="selection-summary-copy"><view class="selection-summary-title">{{selectionSummary.title}}</view><view class="selection-summary-city">{{selectionSummary.cityLabel}}</view></view>
        </view>
        <view class="selection-summary-footer"><view class="selection-summary-stores">{{selectionSummary.storeLabel}}</view><button class="ui-action selection-summary-change" hover-class="ui-control-pressed" bindtap="onEditSelection"><text class="ui-action-label">修改</text><text class="ui-chevron" aria-hidden="true"></text></button></view>
      </view>
      <view wx:if="{{!selectionSummary}}" class="selection-empty">
        <view class="small text-2">选择型号、容量和门店，即可查询或关注。</view>
        <button class="btn btn-primary btn-block mt" bindtap="onEditSelection">选择配置与门店</button>
      </view>
      <view wx:elif="{{!selectionCanCollapse}}" class="banner banner-warn small mt">{{selectionNotice}}</view>
    <view wx:if="{{!accountReady}}" class="banner banner-info small">{{accountError || '正在连接微信账户，可先选商品与门店。'}}<button wx:if="{{accountError}}" class="btn btn-outline btn-sm mt" bindtap="onRetryAccount">重试账户连接</button></view>
    <view wx:if="{{sharedTargetPending}}" class="banner banner-info small">
      <view>{{sharedTargetError || (sharedTargetReady ? (sharedTargetSource === 'follow' ? '关注配置已保留，可在当前操作结束后切换。' : '朋友分享的配置已保留，可在当前操作结束后切换。') : '配置暂未在商品目录中确认，当前选择已保留。')}}</view>
      <button class="btn btn-outline btn-sm mt" loading="{{loadingSharedTarget}}" disabled="{{sheetVisible || querying || signing || loadingSharedTarget}}" bindtap="onLoadSharedTarget">{{loadingSharedTarget ? '正在确认…' : (sharedTargetReady ? '载入配置' : '刷新目录并重试')}}</button>
      <button class="ui-action mt" bindtap="onDismissSharedTarget">保留当前选择</button>
    </view>

      <view wx:if="{{queryFailureMessage || restriction}}" class="banner banner-warn small mt" role="alert">{{queryFailureMessage || restriction}}</view>
      <view wx:if="{{selectionRestricted}}" class="banner banner-info small mt">此配置实时查询需会员，免费用户可查有权限的历史记录。</view>
      <button wx:if="{{selectionRestricted}}" class="btn btn-primary btn-block mt" disabled="{{!accountReady || !selectionCanCollapse}}" bindtap="onFollowSelection">查看此配置会员权益</button>
      <button wx:elif="{{restrictionReason === 'new_product_restricted'}}" class="btn btn-primary btn-block mt" bindtap="onEditSelection">改查其他配置</button>
      <button wx:elif="{{selectionSummary && !selectionCanCollapse}}" class="btn btn-primary btn-block mt" bindtap="onEditSelection">核对或修改选择</button>
      <button wx:elif="{{selectionSummary && accountReady && !boot.member && boot.balance < boot.queryCost && !boot.signedInToday}}" class="btn btn-primary btn-block mt" loading="{{signing}}" disabled="{{signing || querying}}" bindtap="onSignin">{{signing ? '签到中…' : '签到领取查询次数'}}</button>
      <button wx:elif="{{selectionSummary && accountReady && !boot.member && boot.balance < boot.queryCost}}" class="btn btn-primary btn-block mt" bindtap="onGoMine">查看查询与体验次数</button>
      <button wx:elif="{{selectionSummary}}" class="btn btn-primary btn-block mt {{querying || signing ? 'disabled' : ''}}" loading="{{querying}}" disabled="{{querying || signing || !accountReady || !selectionCanCollapse}}" bindtap="onQuery">
        {{!accountReady ? '正在连接账户…' : (querying ? '查询中…' : (boot.member ? '立即查询' : '立即查询（消耗 ' + boot.queryCost + ' 次）'))}}
      </button>
      <view wx:if="{{querying}}" class="request-progress {{requestSlow ? 'request-progress--slow' : ''}}" role="status">{{requestSlow ? requestProgressText : '正在核实所选门店，结果将标注各店时间。'}}</view>
      <view wx:if="{{signinError}}" class="small text-bad mt" role="alert">{{signinError}}</view>
      <view class="selection-utilities">
      <button wx:if="{{selectionRestricted}}" class="ui-action" hover-class="ui-control-pressed" bindtap="onSelectionHistory">查看可用历史</button>
      <button wx:elif="{{selectionSummary && !result}}" class="ui-action mt selection-follow-action" disabled="{{!accountReady || querying || !selectionCanCollapse}}" bindtap="onFollowSelection"><image class="selection-whistle" src="/images/brand/whistle-green.png" mode="aspectFit" aria-hidden="true" /><text>{{boot.member ? '关注此配置' : (contextualCheckout ? '了解此配置关注服务' : '了解会员关注服务')}}</text></button>
      <button class="ui-disclosure" hover-class="ui-control-pressed" bindtap="onToggleRules" aria-expanded="{{rulesExpanded}}"><text class="ui-disclosure-label">查询与提醒规则</text><view class="ui-disclosure-meta"><text>{{rulesExpanded ? '收起' : '展开'}}</text><text class="ui-chevron {{rulesExpanded ? 'ui-chevron--up' : 'ui-chevron--down'}}" aria-hidden="true"></text></view></button>
      </view>
      <view wx:if="{{accountReady && rulesExpanded}}" class="selection-rules">
        <view class="selection-rule">
          <text class="selection-rule-label">关注提醒</text>
          <view class="selection-rule-copy">
            <view>直接关注，无需先查询。</view>
            <view class="selection-rule-detail">{{boot.member ? '需微信授权及服务就绪。' : '关注与到货提醒为会员专属；免费用户可用查询次数实时看货。'}}</view>
          </view>
        </view>
        <view class="selection-rule">
          <text class="selection-rule-label">查询规则</text>
          <view class="selection-rule-copy">{{boot.member ? '会员查询不扣次；如遇限流请按提示稍后重试。' : '新有效结果扣 ' + boot.queryCost + ' 次；未取得有效结果自动返还，复用近期结果不扣次。'}}</view>
        </view>
        <view wx:if="{{!boot.member}}" class="selection-rule">
          <text class="selection-rule-label">新品限制</text>
          <view class="selection-rule-copy">受限新品开售 30 天内，免费用户可查昨天及更早历史，暂不可实时查询。</view>
        </view>
      </view>
    </view>


    <view wx:if="{{result}}" id="query-result" class="card query-result-card">
      <view wx:if="{{queryFailureMessage}}" class="banner banner-warn small mb">本次查询未完成，下方保留上次查询结果。</view>
      <view wx:else class="result-target-note {{resultTargetDifferent ? 'result-target-different' : ''}}">{{resultTargetDifferent ? '上次查询结果 · 与当前选择不同' : '对应当前所选配置与门店'}}</view>
      <view class="result-product-row">
        <view class="result-product-media">
          <image wx:if="{{result.product.imageDisplayUrl}}" class="result-product-image {{result.product.imageFitClass}}" src="{{result.product.imageDisplayUrl}}" webp="{{true}}" mode="aspectFit" aria-label="{{result.product.imageAlt || result.product.title}}" binderror="onResultImageError" />
          <view wx:else class="result-product-placeholder">暂无图片</view>
        </view>
        <view class="result-product-copy">
          <view class="result-product-title">{{result.product.title}}</view>
          <view class="result-product-meta"><text class="pill pill-muted">{{resultIsCache ? '上次保存的结果' : (result.allShared ? '近期核实结果' : '本次查询结果')}}</text></view>
          <view wx:if="{{!liveResultRestricted}}" class="result-product-time">查询时间 {{result.queriedText}}</view>
        </view>
      </view>
      <view wx:if="{{liveResultRestricted && resultAccessNotice}}" class="banner banner-info small mt" role="status">{{resultAccessNotice}}</view>
      <view wx:if="{{nextAction}}" class="result-next-action result-next-action--{{nextAction.tone}}" aria-live="polite">
        <view class="journey-title">{{nextAction.title}}</view>
        <view class="small text-2 mt">{{nextAction.detail}}</view>
        <button class="btn btn-primary btn-block mt" disabled="{{querying || signing || sheetVisible || !accountReady}}" bindtap="onNextAction">{{nextAction.label}}</button>
      </view>
      <view wx:for="{{liveResultRestricted ? [] : result.results}}" wx:key="storeNumber" class="list-item result-store {{item.pickupReady ? 'result-store--available' : ''}}">
        <view class="row-between result-store-heading">
          <view class="result-store-name">
            <text class="bold">{{item.storeName}}</text>
            <text class="small muted"> {{item.city}}</text>
          </view>
          <view class="pill pill-dot pill-{{item.observationState === 'fresh' && item.status === 'unavailable' ? 'muted' : item.statusCls}}">{{item.statusLabel}}</view>
        </view>
        <view class="small text-2 mt" wx:if="{{item.quote && item.observationState === 'fresh' && (item.pickupReady || evidenceExpanded)}}">{{item.quote}}</view>
        <view class="tiny muted mt">
          观测 {{item.observedText}}
          <text wx:if="{{evidenceExpanded && item.sinceText}}"> · 距本轮首次记录 {{item.sinceText}}</text>
          <text wx:if="{{item.status === 'unknown' && item.reason}}"> · {{item.reason}}</text>
        </view>
        <view wx:if="{{item.observationNote}}" class="tiny muted mt">{{item.observationNote}}</view>
        <view wx:if="{{item.lastKnownText}}" class="tiny muted mt">{{item.lastKnownText}}</view>
        <view wx:if="{{item.freshnessText && (evidenceExpanded || item.observationState !== 'fresh')}}" class="tiny mt {{item.observationState === 'fresh' ? 'muted' : 'stale-note'}}">{{item.freshnessText}}</view>
        <view wx:if="{{evidenceExpanded && item.events.length}}" class="row wrap gap mt">
          <text wx:for="{{item.events}}" wx:for-item="ev" wx:key="type" class="pill pill-{{ev.cls}} tiny">{{ev.label}}</text>
        </view>
      </view>
      <button wx:if="{{!liveResultRestricted && evidenceCard}}" class="ui-disclosure" hover-class="ui-control-pressed" bindtap="onToggleEvidence" aria-expanded="{{evidenceExpanded}}"><text class="ui-disclosure-label">记录详情与范围</text><view class="ui-disclosure-meta"><text>{{evidenceExpanded ? '收起' : '展开'}}</text><text class="ui-chevron {{evidenceExpanded ? 'ui-chevron--up' : 'ui-chevron--down'}}"></text></view></button>
      <view wx:if="{{evidenceExpanded && !liveResultRestricted && evidenceCard}}" class="target-evidence">
        <view class="small bold">{{evidenceCard.title}}</view><view class="tiny muted mt">商品编码 {{result.product.partNumber}}</view>
        <view class="small text-2 mt">{{evidenceCard.time}}</view>
        <view class="small text-2 mt">{{evidenceCard.detail}} {{evidenceCard.note}}</view>
      </view>
      <button wx:if="{{storeChoices.length || alternativeColorChoices.length}}" class="ui-disclosure" hover-class="ui-control-pressed" bindtap="onToggleAlternatives" aria-expanded="{{alternativesExpanded}}"><text class="ui-disclosure-label">看看其他可接受配置</text><view class="ui-disclosure-meta"><text>{{alternativesExpanded ? '收起' : '展开'}}</text><text class="ui-chevron {{alternativesExpanded ? 'ui-chevron--up' : 'ui-chevron--down'}}"></text></view></button>
      <view wx:if="{{alternativesExpanded && storeChoices.length && !alternativeColorChoices.length}}" class="observed-store-choices">
        <view class="small bold">同一配置，可考虑的门店</view>
        <view class="tiny muted mt">仅列本次观测可取货门店。勾选后需手动查询确认，不会自动扣次或关注。</view>
        <button wx:for="{{storeChoices}}" wx:key="storeNumber" class="observed-store-choice {{item.selected ? 'observed-store-choice--selected' : ''}}" data-store="{{item.storeNumber}}" aria-pressed="{{item.selected}}" disabled="{{querying || signing || sheetVisible}}" bindtap="onToggleAcceptableStore">
          <view class="observed-store-choice-copy"><text>{{item.label}}</text><text class="tiny muted">观测 {{item.observedText}} · {{item.ageText}}</text></view><text class="small">{{item.selected ? '已勾选' : '可接受'}}</text>
        </button>
        <button class="btn btn-outline btn-block mt" disabled="{{!acceptedStoreNumbers.length || querying || signing || sheetVisible}}" bindtap="onUseAcceptableStores">用勾选门店准备查询</button>
        <view wx:if="{{alternativeNotice}}" class="small text-2 mt" role="status">{{alternativeNotice}}</view>
      </view>
      <view wx:if="{{alternativesExpanded && alternativeColorChoices.length && alternativeStoreChoices.length}}" class="observed-store-choices alternative-panel">
        <view class="alternative-heading">选择可接受的颜色与门店</view>
        <view class="alternative-caption">同机型、同容量。近期记录不是新查询；勾选不扣次、不添加关注。</view>
        <view class="alternative-section-title"><text>可接受的颜色</text><text class="alternative-count">{{alternativeParts.length}} / {{boot ? boot.alternativeMaxColors : 3}}</text></view>
        <view class="alternative-colors">
          <view wx:for="{{alternativeColorChoices}}" wx:key="partNumber" class="alternative-color-column">
            <button class="alternative-chip {{item.selected ? 'alternative-chip--selected' : ''}}" hover-class="ui-control-pressed" data-kind="part" data-value="{{item.partNumber}}" aria-pressed="{{item.selected}}" disabled="{{alternativeLoading || querying || signing || sheetVisible}}" bindtap="onToggleAlternative">
              <text class="alternative-chip-label">{{item.label}}<text wx:if="{{item.current}}" class="alternative-current">当前颜色</text></text><text class="alternative-check" aria-hidden="true">{{item.selected ? '✓' : '+'}}</text>
            </button>
          </view>
        </view>
        <view class="alternative-section-title"><text>可接受的门店</text><text class="alternative-count">{{alternativeStores.length}} / {{boot ? boot.maxStores : 3}}</text></view>
        <picker mode="selector" range="{{alternativeCityNames}}" value="{{alternativeCityIndex}}" disabled="{{alternativeLoading || querying || signing || sheetVisible}}" bindchange="onAlternativeCityChange">
          <view class="ui-disclosure alternative-city-picker" role="button" aria-label="{{'切换城市，当前' + alternativeCity}}"><text class="ui-disclosure-label">{{alternativeCity}}</text><view class="ui-disclosure-meta"><text>切换城市</text><view class="ui-chevron ui-chevron--down" aria-hidden="true"></view></view></view>
        </picker>
        <view class="alternative-stores">
          <button wx:for="{{alternativeVisibleStores}}" wx:key="storeNumber" class="alternative-store {{item.selected ? 'alternative-store--selected' : ''}}" hover-class="ui-control-pressed" data-kind="store" data-value="{{item.storeNumber}}" aria-pressed="{{item.selected}}" disabled="{{alternativeLoading || querying || signing || sheetVisible}}" bindtap="onToggleAlternative">
            <view class="alternative-store-copy"><text class="alternative-store-label">{{item.label}}</text><text wx:if="{{item.relationText}}" class="alternative-store-relation">{{item.relationText}}</text></view><text class="alternative-check" aria-hidden="true">{{item.selected ? '✓' : '+'}}</text>
          </button>
        </view>
        <view wx:if="{{alternativeSelectedStores.length}}" class="alternative-selected-stores">
          <view class="tiny muted">已选门店 · 可跨城市选择</view>
          <view class="alternative-selected-list"><button wx:for="{{alternativeSelectedStores}}" wx:key="storeNumber" class="alternative-selected-store" hover-class="ui-control-pressed" data-kind="store" data-value="{{item.storeNumber}}" aria-label="{{'移除' + item.label}}" disabled="{{alternativeLoading || querying || signing || sheetVisible}}" bindtap="onToggleAlternative"><text>{{item.label}}</text><text aria-hidden="true">×</text></button></view>
        </view>
        <view class="alternative-summary" aria-live="polite">{{alternativeSelectionSummary}}</view>
        <view wx:if="{{alternativeSelectedColors.length}}" class="alternative-query-list">
          <view wx:for="{{alternativeSelectedColors}}" wx:key="partNumber" class="alternative-query-row">
            <view class="alternative-query-copy"><text class="alternative-query-color">{{item.label}}</text><text class="alternative-query-hint">{{!accountReady ? '账户连接中' : (boot.member ? '会员不扣次' : '消耗 ' + boot.queryCost + ' 次')}}</text></view>
            <button class="alternative-query-button" hover-class="ui-control-pressed" data-part="{{item.partNumber}}" aria-label="{{'查询' + item.label + '，' + (!accountReady ? '账户连接中' : (boot.member ? '会员不扣次' : '消耗 ' + boot.queryCost + ' 次'))}}" disabled="{{!alternativeStores.length || !accountReady || alternativeLoading || querying || signing || sheetVisible}}" loading="{{querying && alternativeQueryPart === item.partNumber}}" bindtap="onQueryAlternative">{{querying && alternativeQueryPart === item.partNumber ? '查询中' : '查询'}}</button>
          </view>
        </view>
        <view wx:if="{{alternativeQueryNote}}" class="alternative-empty" role="status">{{alternativeQueryNote}}</view>
        <view wx:if="{{alternativeCanRead}}" class="alternative-observations">
          <button class="alternative-read-button" hover-class="ui-control-pressed" disabled="{{!alternativeParts.length || !alternativeStores.length || alternativeLoading || querying || signing || sheetVisible}}" loading="{{alternativeLoading}}" bindtap="onReadAlternatives">查看近期有货记录 · 免费</button>
          <view class="alternative-caption">只读近 2 分钟已有记录；有效至 {{alternativeExpiresText}}。</view>
        </view>
        <view wx:elif="{{alternativeObservationOutOfScope}}" class="alternative-caption mt">所选门店不在近期记录范围，可点「查询」确认。</view>
        <view wx:else class="alternative-caption mt">近期记录已不可用，仍可查询上方所选条件。</view>
        <view wx:if="{{alternativeError}}" class="small text-bad mt" role="status">{{alternativeError}} 可直接查询上方所选条件。</view>
        <view wx:if="{{alternativeCanRead && alternativeRead && !alternativeMatches.length && !alternativeError}}" class="alternative-empty" role="status">暂无近期有货记录，不代表无货。可点上方「查询」确认。</view>
        <view wx:for="{{alternativeMatches}}" wx:key="key" class="alternative-match">
          <view class="small bold">{{item.productTitle}}</view>
          <view class="small mt">{{item.storeLabel}}</view>
          <view class="tiny muted mt">观测可取货 · {{item.observedText}} · {{item.ageText}}</view>
          <button class="btn btn-ghost btn-block mt" data-key="{{item.key}}" disabled="{{alternativeLoading || querying || signing || sheetVisible}}" bindtap="onPrepareAlternative">准备这个配置和门店</button>
        </view>
        <view wx:if="{{alternativePreparedNotice}}" class="small text-2 mt" role="status">{{alternativePreparedNotice}}</view>
      </view>
      <view class="btn-row result-actions">
        <button wx:if="{{!nextAction || nextAction.action === 'guide'}}" class="btn btn-outline btn-sm" bindtap="onAddFollow">加入关注</button>
        <button class="btn btn-outline btn-sm {{querying || signing ? 'disabled' : ''}}" disabled="{{querying || signing || !accountReady}}" bindtap="onRequery" aria-label="重新查询此结果的配置与门店">{{querying ? '查询中…' : '重新查询'}}</button>
      </view>
    </view>

    <view class="query-notice-region" aria-live="polite">
      <view wx:if="{{sharedSelection}}" class="banner banner-info small">{{sharedTargetSource === 'follow' ? '已带入关注配置，点击查询确认最新库存。' : '已载入朋友分享的配置与门店。点击查询，获取当前取货信息。'}}</view>
      <view wx:elif="{{queryNotice}}" class="banner banner-{{queryNotice.tone === 'ok' ? 'ok' : queryNotice.tone === 'warn' ? 'warn' : 'info'}} small">
        <text>{{queryNotice.text}}</text>
        <button wx:if="{{queryNotice.action === 'open_settings'}}" class="ui-action" bindtap="onOpenSubscribeSetting">前往微信设置</button>
        <button wx:elif="{{queryNotice.action === 'refresh'}}" class="ui-action" bindtap="onRequery">刷新状态</button>
      </view>
      <view wx:elif="{{announcement}}" class="banner banner-info small">{{announcement}}</view>
    </view>
    <view wx:if="{{resumeSetup}}" class="card journey-resume">
      <view class="journey-title">会员已生效，继续完成关注设置</view>
      <view class="small text-2 mt">你准备关注的配置已保留，保存关注后再确认微信提醒条件。</view>
      <button class="btn btn-primary btn-block mt" bindtap="onContinueSetup">继续设置</button>
    </view>

    <button wx:if="{{boot && boot.followCount}}" class="ui-disclosure query-follow-entry" hover-class="ui-control-pressed" bindtap="onGoFollow"><view class="query-guide-copy"><text class="query-guide-title">继续查看{{followTargets.length ? ' · ' + followTargets[0].productTitle : '我的关注'}}</text><text class="query-guide-note">{{boot.followCount}} 个关注配置 · 到小哨查看任务</text></view><text class="ui-chevron"></text></button>

    <view class="card">
      <view class="row-between">
        <text class="small text-2">自动监测状态</text>
        <view class="pill pill-dot pill-{{collector.cls}}">{{collector.label}}</view>
      </view>
      <view class="tiny muted mt">仅展示是否可取货，不含剩余件数；库存随时间变化，请以 Apple 官网结算页为准。</view>
    </view>
  </block>
</view>

<config-sheet id="query-config-sheet" visible="{{sheetVisible}}" title="选择配置与门店" subtitle="保存后返回首页，再选择查询或关注" confirm-text="保存选择" summary="{{draftSummary}}" dirty="{{draftDirty}}" external-close="{{true}}" bindconfirm="onDoneSelection" bindrequestclose="onRequestCloseSelection" bindclose="onCloseSelection">
  <target-picker wx:if="{{sheetVisible}}" id="query-target-picker" catalog-version="{{catalogVersion}}" value="{{draftValue}}" max-stores="{{boot ? boot.maxStores : 3}}" in-sheet="{{true}}" bindchange="onDraftChange" />
</config-sheet>

<reminder-nudge enabled="{{ready}}" blocked="{{!accountReady || querying || signing || sheetVisible || alternativeLoading}}" />

