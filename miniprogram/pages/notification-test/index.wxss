/* 体验微信提醒：授权、发送、查收三步；结果与下一步各占一处。 */
.test-heading { font-size: var(--fs-headline); font-weight: 600; line-height: var(--lh-snug); }
.test-copy { margin-top: var(--sp-4); color: var(--text-2); font-size: var(--fs-sub); line-height: var(--lh-normal); overflow-wrap: anywhere; }

.test-progress { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--sp-8); margin-bottom: var(--sp-16); padding-bottom: var(--sp-16); border-bottom: 1px solid var(--line); }
.test-progress-step { min-width: 0; color: var(--text-2); text-align: center; }
.test-progress-number { display: flex; align-items: center; justify-content: center; width: 28px; height: 28px; margin: 0 auto var(--sp-8); border: 1.5px solid var(--line); border-radius: 50%; background: var(--surface-top); color: var(--text-2); font-size: var(--fs-sub); font-weight: 600; line-height: 1; }
.test-progress-done .test-progress-number { border-color: var(--green); background: var(--green); color: var(--green-ink); }
.test-progress-warn .test-progress-number { border-color: var(--warn); color: var(--warn); }
.test-progress-title { color: var(--text); font-size: var(--fs-sub); font-weight: 600; line-height: var(--lh-snug); }
.test-progress-detail { margin-top: var(--sp-2); font-size: var(--fs-caption); overflow-wrap: anywhere; }

.test-status-heading { display: flex; align-items: center; gap: var(--sp-8); min-width: 0; }
.test-status-heading .test-heading { flex: 1 1 0; min-width: 0; }
.test-status-dot { flex: none; width: 8px; height: 8px; border-radius: 50%; background: var(--text-3); }
.test-status-accepted { background: var(--green); }
.test-status-sending, .test-status-uncertain, .test-status-authorized, .test-status-needs_authorization { background: var(--warn); }
.test-status-failed { background: var(--bad); }
.test-receipt { margin-top: var(--sp-8); color: var(--text-3); font-size: var(--fs-caption); }
.test-inbox-guide { margin-top: var(--sp-12); padding: var(--sp-12); border-radius: var(--radius-control); background: var(--green-soft); color: var(--green-text); font-size: var(--fs-sub); }
.test-error { margin-top: var(--sp-12); padding: var(--sp-12); border-radius: var(--radius-control); background: var(--bad-soft); color: var(--bad); font-size: var(--fs-sub); overflow-wrap: anywhere; }
.test-operation { margin-top: var(--sp-8); color: var(--text-2); font-size: var(--fs-sub); overflow-wrap: anywhere; }

.test-feedback { margin-top: var(--sp-16); padding-top: var(--sp-16); border-top: 1px solid var(--line); }
.test-feedback-title { font-weight: 600; line-height: var(--lh-snug); }
.test-feedback-actions { display: flex; gap: var(--sp-8); margin-top: var(--sp-12); }
.test-feedback-actions .btn.test-feedback-choice { flex: 1 1 0; width: 0; min-width: 0; padding-left: var(--sp-8); padding-right: var(--sp-8); border: 1.5px solid transparent; }
.test-feedback-actions .btn.test-choice-selected { border-color: var(--text); }
.test-feedback-note { margin-top: var(--sp-8); color: var(--text-2); font-size: var(--fs-sub); }
.test-feedback .test-return.btn { margin-top: var(--sp-12); }
.test-troubleshooting { margin-top: var(--sp-8); }
.test-troubleshooting .test-disclosure.ui-disclosure { margin-top: var(--sp-8); border-top: 1px solid var(--line); }
.test-help-steps { color: var(--text-2); font-size: var(--fs-sub); }
.test-help-step + .test-help-step { margin-top: var(--sp-8); }

.test-actions { margin-top: var(--sp-16); }
.test-actions-after-result { padding-top: var(--sp-16); border-top: 1px solid var(--line); }
.test-cost { display: flex; align-items: baseline; justify-content: space-between; flex-wrap: wrap; gap: var(--sp-4) var(--sp-12); margin-bottom: var(--sp-12); color: var(--text-2); font-size: var(--fs-sub); }
.test-cost-number { color: var(--text); font-weight: 600; }
.test-action-caption { margin: var(--sp-8) 0; color: var(--text-3); font-size: var(--fs-caption); }
.test-actions .test-check.btn, .test-actions .test-signin.btn { margin-top: var(--sp-8); }

.test-rules { padding-bottom: var(--sp-12); }
.test-rule { color: var(--text-2); font-size: var(--fs-sub); line-height: var(--lh-normal); }
.test-rule + .test-rule { margin-top: var(--sp-12); }
.test-rule-title { margin-bottom: var(--sp-2); color: var(--text); font-weight: 600; }
.test-tip { margin-bottom: var(--sp-12); color: var(--text-3); font-size: var(--fs-caption); text-align: center; }
