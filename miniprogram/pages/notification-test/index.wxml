<wxs module="i18n" src="../../i18n/render.wxs" />
<view class="page test-page">
  <view class="page-heading test-hero"><view class="page-title test-title">{{i18n.t(ui,'体验微信提醒')}}</view></view>
  <view class="card test-card test-main">
    <view class="test-progress" aria-label="{{i18n.t(ui,'微信提醒体验进度')}}">
      <view wx:for="{{progress}}" wx:key="id" class="test-progress-step test-progress-{{item.state}}">
        <view class="test-progress-number">{{i18n.t(ui,(index + 1))}}</view><view class="test-progress-title">{{i18n.t(ui,(item.title))}}</view><view class="test-progress-detail">{{i18n.t(ui,(item.detail))}}</view>
      </view>
    </view>
    <block wx:if="{{test}}">
      <view class="test-status-heading"><view class="test-status-dot test-status-{{test.status}}" aria-hidden="true"></view><view class="test-heading">{{i18n.t(ui,(statusTitle))}}</view></view>
      <view class="test-copy test-status-note">{{i18n.t(ui,(statusNote))}}</view>
      <view class="test-receipt">{{i18n.m(ui,'本次扣除 {0} 次 · 已退回 {1} 次',[(test.charged),(test.refunded)])}}</view>
      <view wx:if="{{test.status === 'accepted' && test.feedback !== 'received'}}" class="test-inbox-guide">{{i18n.t(ui,'查收位置：返回微信 → 搜索「服务通知」→ 找到果小哨的【测试】消息。')}}</view>
      <view wx:if="{{test.status === 'accepted' || test.status === 'uncertain'}}" class="test-feedback">
        <view class="test-feedback-title">{{i18n.t(ui,'在微信「服务通知」中收到了吗？')}}</view>
        <view class="test-feedback-actions">
          <button class="btn test-secondary test-feedback-choice {{test.feedback === 'received' ? 'test-choice-selected' : ''}}" hover-class="ui-control-pressed" bindtap="onFeedback" data-outcome="received" disabled="{{busy || loading}}">{{i18n.t(ui,(test.feedback === 'received' ? '已确认收到' : '我收到了'))}}</button>
          <button class="btn test-secondary test-feedback-choice {{test.feedback === 'not_received' ? 'test-choice-selected' : ''}}" hover-class="ui-control-pressed" bindtap="onFeedback" data-outcome="not_received" disabled="{{busy || loading}}">{{i18n.t(ui,(test.feedback === 'not_received' ? '已反馈未收到' : '暂时没收到'))}}</button>
        </view>
        <view wx:if="{{feedbackNote}}" class="test-feedback-note" aria-live="polite">{{i18n.t(ui,(feedbackNote))}}</view>
        <button wx:if="{{test.feedback === 'received'}}" class="btn btn-primary btn-block test-primary test-return" hover-class="btn-primary-pressed" bindtap="onReturnTask" disabled="{{busy || loading}}">{{i18n.t(ui,(returnLabel))}}</button>
        <view wx:if="{{test.feedback === 'not_received'}}" class="test-troubleshooting">
          <view class="test-copy">{{i18n.t(ui,'先返回微信，搜索并打开「服务通知」，查找【测试】消息。')}}</view>
          <button class="ui-disclosure test-disclosure" hover-class="ui-control-pressed" bindtap="onToggleTroubleshooting" aria-expanded="{{showTroubleshooting}}"><text class="ui-disclosure-label test-disclosure-label">{{i18n.t(ui,'仍未找到？查看排查方法')}}</text><view class="ui-chevron {{showTroubleshooting ? 'ui-chevron--up' : 'ui-chevron--down'}}" aria-hidden="true"></view></button>
          <view wx:if="{{showTroubleshooting}}" class="test-help-steps">
            <view class="test-help-step">{{i18n.t(ui,'1. 查看小程序右上角「…」中的设置与订阅消息选项。')}}</view>
            <view class="test-help-step">{{i18n.t(ui,'2. 查看微信通知设置及手机系统的微信通知权限。')}}</view>
            <view class="test-help-step">{{i18n.t(ui,'入口可能随版本不同。开启权限也不保证及时弹出锁屏提醒。')}}</view>
          </view>
        </view>
      </view>
    </block>
    <block wx:else>
      <view class="test-heading">{{i18n.t(ui,'先给自己发一条')}}</view>
      <view class="test-copy">{{i18n.t(ui,'允许微信授权后，在「服务通知」中查收标注【测试】的消息。')}}</view>
    </block>
    <view wx:if="{{error}}" class="test-error" aria-role="alert">{{i18n.t(ui,(error))}}</view>
    <view wx:if="{{operationNote}}" class="test-operation" aria-live="polite">{{i18n.t(ui,(operationNote))}}</view>
    <view wx:if="{{checkNote}}" class="test-operation" aria-live="polite">{{i18n.t(ui,(checkNote))}}</view>
    <view class="test-actions {{test ? 'test-actions-after-result' : ''}}">
      <view wx:if="{{pendingOther}}" class="test-copy">{{i18n.t(ui,'另有一条待确认测试，请先查看它，避免重复操作。')}}</view>
      <button wx:if="{{pendingOther}}" class="btn btn-primary btn-block test-primary" hover-class="btn-primary-pressed" bindtap="onViewPending" disabled="{{busy || loading}}">{{i18n.t(ui,'查看另一个待确认测试')}}</button>
      <block wx:elif="{{canContinue}}">
        <view class="test-action-caption">{{i18n.t(ui,'继续这次测试，无需再次授权')}}</view>
        <button class="btn btn-primary btn-block test-primary" hover-class="btn-primary-pressed" bindtap="onContinue" disabled="{{busy || loading || !ready || blocked}}" loading="{{busy}}">{{i18n.t(ui,cost === 0 ? '继续原测试 · 不扣次' : '继续原测试 · 本次最多 1 次')}}</button>
      </block>
      <block wx:elif="{{!blocked}}">
        <view wx:if="{{cost === 0}}" class="test-cost">{{i18n.t(ui,'本次测试不扣次数。')}}</view>
        <view wx:else class="test-cost"><text>{{i18n.t(ui,'每条消耗')}} <text class="test-cost-number">{{i18n.t(ui,'1 次')}}</text>{{i18n.t(ui,'查询／体验次数')}}</text><text>{{i18n.m(ui,'可用 {0} 次',[(balance)])}}</text></view>
        <view wx:if="{{test && test.status === 'uncertain' && test.feedback}}" class="test-action-caption">{{i18n.t(ui,cost === 0 ? '原测试结果仍未知。再次体验会新建测试。' : '原测试结果仍未知，扣次记录保留。再次体验会新建测试，另消耗 1 次。')}}</view>
        <button class="btn btn-block {{test && (test.status === 'accepted' || test.status === 'uncertain') ? 'test-secondary test-again' : 'btn-primary test-primary'}}" hover-class="btn-primary-pressed" bindtap="onStart" disabled="{{busy || loading || !ready || balance < cost}}" loading="{{busy}}">{{i18n.t(ui,(test && test.status === 'uncertain' ? (cost === 0 ? '重新授权新测试' : '重新授权新测试 · 1 次') : test && test.status === 'accepted' ? (cost === 0 ? '再体验一条' : '再体验一条 · 1 次') : (cost === 0 ? '授权并发送测试' : '授权并发送测试 · 1 次')))}}</button>
        <view wx:if="{{!test && cost > 0}}" class="test-action-caption">{{i18n.t(ui,'免费用户也可体验，会员同样消耗 1 次额度。')}}</view>
      </block>
      <button wx:if="{{test || error || !ready || canContinue || pendingOther}}" class="btn btn-block test-secondary test-check" hover-class="ui-control-pressed" bindtap="onCheck" disabled="{{busy || loading}}">{{i18n.t(ui,(loading ? '读取中…' : '查看原测试结果'))}}</button>
      <button wx:if="{{ready && balance < cost && !blocked && !canContinue && !pendingOther}}" class="btn btn-block test-secondary test-signin" hover-class="ui-control-pressed" bindtap="onGoMine">{{i18n.t(ui,'去「我的」签到获取次数')}}</button>
    </view>
  </view>
  <view class="card card-list test-card test-rules-card">
    <button class="ui-disclosure test-disclosure test-rules-toggle" hover-class="ui-control-pressed" bindtap="onToggleTestRules" aria-expanded="{{showTestRules}}"><text class="ui-disclosure-label">{{i18n.t(ui,'体验说明')}}</text><view class="ui-chevron {{showTestRules ? 'ui-chevron--up' : 'ui-chevron--down'}}" aria-hidden="true"></view></button>
    <view wx:if="{{showTestRules}}" class="test-rules">
      <view class="test-rule"><view class="test-rule-title">{{i18n.t(ui,'次数如何扣除')}}</view><view>{{i18n.t(ui,cost === 0 ? '本次测试不扣次数。' : '每条消耗 1 次查询次数，会员同样扣次。明确发送失败自动退回；结果不明时暂不退回，不会重复发送。')}}</view></view>
      <view class="test-rule"><view class="test-rule-title">{{i18n.t(ui,'授权与送达')}}</view><view>{{i18n.t(ui,'微信授权次数与查询额度分开计算。微信受理不代表已送达，也不保证手机弹出横幅。')}}</view></view>
      <view class="test-rule"><view class="test-rule-title">{{i18n.t(ui,'正式提醒需要什么')}}</view><view>{{i18n.t(ui,'测试仅体验提醒，不查询库存或创建监测。正式到货和断货提醒需要会员、有效关注与微信授权。')}}</view></view>
    </view>
  </view>
  <view class="test-tip">{{i18n.t(ui,'【测试】非真实放货 · 微信受理不等于已送达')}}</view>
  <button wx:if="{{!test || test.feedback !== 'received'}}" class="btn btn-block test-secondary test-return" hover-class="ui-control-pressed" bindtap="onReturnTask" disabled="{{busy || loading}}">{{i18n.t(ui,(returnLabel))}}</button>
</view>
