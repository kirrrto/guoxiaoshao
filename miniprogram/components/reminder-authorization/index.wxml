<wxs module="i18n" src="../../i18n/render.wxs" />
<view class="authorization-panel">
  <view wx:if="{{member && subscription.templateCount}}" class="reminder-balances" aria-live="polite" aria-busy="{{authorization.syncing}}">
    <view class="reminder-balance"><text class="reminder-balance-label">{{i18n.t(ui,'到货提醒')}}</text><text class="reminder-balance-value">{{i18n.m(ui,'{0} 次',[(subscription.credits)])}}</text><text wx:if="{{authorization.errorMessage && authorization.pendingRestock}}" class="reminder-balance-pending">{{i18n.m(ui,'待同步 +{0}',[(authorization.pendingRestock)])}}</text></view>
    <view wx:if="{{subscription.soldoutEnabled}}" class="reminder-balance"><text class="reminder-balance-label">{{i18n.t(ui,'断货提醒')}}</text><text class="reminder-balance-value">{{i18n.m(ui,'{0} 次',[(subscription.soldoutCredits)])}}</text><text wx:if="{{authorization.errorMessage && authorization.pendingSoldout}}" class="reminder-balance-pending">{{i18n.m(ui,'待同步 +{0}',[(authorization.pendingSoldout)])}}</text></view>
  </view>
  <button id="increase-reminders" class="btn btn-primary btn-block" hover-class="btn-primary-pressed" disabled="{{busy || authorization.storageBlocked}}" loading="{{busy}}" bindtap="onAuthorize">{{i18n.t(ui,(busy ? '等待微信授权…' : !subscription.templateCount ? '查看原因' : member ? '增加提醒次数' : '了解会员'))}}</button>
  <view wx:if="{{feedback}}" class="authorization-feedback" aria-live="polite">{{i18n.t(ui,(feedback))}}</view>
  <view wx:if="{{authorization.errorMessage}}" class="authorization-sync-error" aria-role="status"><text>{{i18n.t(ui,(authorization.errorMessage))}}</text><button class="ui-action" loading="{{authorization.syncing}}" disabled="{{authorization.syncing}}" bindtap="onRetry">{{i18n.t(ui,'重试同步')}}</button></view>
  <view wx:if="{{!member || subscription.soldoutEnabled}}" class="authorization-hint">{{i18n.t(ui,(member ? '到货和断货可分别授权。' : '持续关注与微信提醒需会员，查询与体验次数单独计算。'))}}</view>
</view>
