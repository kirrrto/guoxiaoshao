/* 选配器（隔离组件）：只用类选择器，不 @import；令牌经继承取自页面。
   选项尺寸固定，切换选中时名称与位置都不移动。 */
.picker, .field, .label, .value, .chip, .banner, .product-preview, .product-image-box, .product-image, .product-copy, .image-placeholder, .store-result, .search-glass { box-sizing: border-box; }
.picker { width: 100%; min-width: 0; color: var(--text); font-size: var(--fs-body); overflow-wrap: anywhere; }
.ui-icon { display: block; flex: none; width: 20px; height: 20px; filter: var(--icon-filter); }
.small { font-size: var(--fs-sub); }
.tiny { font-size: var(--fs-caption); }
.bold { font-weight: 600; }
.muted { color: var(--text-3); }
.mono { word-break: break-all; }
.mt { margin-top: var(--sp-12); }

/* ── 当前选择、分区标题 ───────────────────────────────── */
.picker-current-summary { position: sticky; top: 0; z-index: 1; margin-bottom: var(--sp-12); padding: var(--sp-4) 0 var(--sp-12); border-bottom: 1px solid var(--line); background: var(--elevated); line-height: var(--lh-snug); }
.picker-section-heading { display: flex; align-items: center; flex-wrap: wrap; gap: var(--sp-8); min-width: 0; margin: 0 0 var(--sp-4); font-size: var(--fs-headline); font-weight: 600; line-height: var(--lh-snug); }
.picker-store-heading { margin: var(--sp-20) 0 var(--sp-12); padding-top: var(--sp-16); border-top: 1px solid var(--line); }
.picker-count { margin-left: auto; color: var(--text-2); font-size: var(--fs-sub); font-weight: 400; }
.section-label { margin: var(--sp-16) 0 var(--sp-8); color: var(--text-3); font-size: var(--fs-sub); line-height: var(--lh-snug); }

/* ── 选项 ─────────────────────────────────────────────── */
.chips { display: flex; flex-wrap: wrap; gap: var(--sp-8); }
.chip {
  display: flex;
  align-items: center;
  max-width: 100%;
  min-height: var(--tap);
  padding: var(--sp-8) var(--sp-12);
  border: 1.5px solid transparent;
  border-radius: var(--radius-control);
  background: var(--control);
  color: var(--text);
  font-size: var(--fs-body);
  line-height: var(--lh-snug);
  overflow-wrap: anywhere;
  transition: border-color var(--dur-fast) var(--ease), background-color var(--dur-fast) var(--ease), color var(--dur-fast) var(--ease), opacity var(--dur-fast) var(--ease);
}
.chip.on { border-color: var(--green-text); background: var(--green-soft); color: var(--green-text); }
.chip.is-pressed, .store-result.is-pressed { opacity: 0.6; }
/* 固定列宽：类别三列，内存与容量三列，颜色两列。 */
.category-chips { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); }
.category-chips .chip { justify-content: center; min-width: 0; padding: var(--sp-8) var(--sp-4); text-align: center; white-space: nowrap; }
.choice-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); }
.memory-chips, .capacity-chips { grid-template-columns: repeat(3, minmax(0, 1fr)); }
.choice-chip { position: relative; justify-content: center; min-width: 0; padding: var(--sp-8) var(--sp-24) var(--sp-8) var(--sp-8); text-align: center; }
.choice-label { min-width: 0; max-width: 100%; }
.choice-check { position: absolute; right: 7px; top: 50%; display: flex; align-items: center; justify-content: center; width: 14px; height: 14px; opacity: 0; transform: translateY(-50%); transition: opacity var(--dur-fast) var(--ease); }
.choice-check-visible { opacity: 1; }
.picker-check { width: 4px; height: 8px; margin-bottom: var(--sp-2); border-right: 2px solid currentColor; border-bottom: 2px solid currentColor; transform: rotate(40deg); }
.picker-chevron { flex: none; width: 7px; height: 7px; margin: 0 var(--sp-2); border-top: 1.5px solid var(--text-3); border-right: 1.5px solid var(--text-3); transform: rotate(45deg); transition: transform var(--dur) var(--ease-out); }
.picker-close { position: relative; flex: none; width: 10px; height: 10px; }
.picker-close::before, .picker-close::after { content: ''; position: absolute; left: 0; top: 4px; width: 10px; height: 2px; border-radius: var(--radius-pill); background: currentColor; }
.picker-close::before { transform: rotate(45deg); }
.picker-close::after { transform: rotate(-45deg); }

.field { display: flex; align-items: center; justify-content: space-between; gap: var(--sp-12); min-width: 0; min-height: 52px; padding: var(--sp-8) 0; border-bottom: 1px solid var(--line); }
.field-summary { min-height: var(--tap); }
.label { flex: 0 0 auto; max-width: 30%; color: var(--text-2); }
.value { flex: 1 1 0; min-width: 0; color: var(--text); text-align: right; overflow-wrap: anywhere; }

/* ── 配置预览与提示 ───────────────────────────────────── */
.banner { padding: var(--sp-12); border-radius: var(--radius-control); background: var(--control); color: var(--text-2); line-height: var(--lh-normal); overflow-wrap: anywhere; }
.banner-warn { background: var(--warn-soft); color: var(--warn); }
.product-preview { display: flex; align-items: center; gap: var(--sp-12); min-width: 0; padding: var(--sp-12); border-radius: var(--radius-control); background: var(--control); }
.product-image-box { flex: none; width: 56px; height: 64px; overflow: hidden; border-radius: var(--radius-tile); background: var(--image-tile); }
.product-image { display: block; width: 56px; height: 64px; mix-blend-mode: var(--image-blend); }
.image-placeholder { display: flex; align-items: center; justify-content: center; width: 100%; height: 100%; color: var(--text-3); font-size: var(--fs-caption); text-align: center; }
.product-copy { flex: 1 1 0; min-width: 0; line-height: var(--lh-snug); overflow-wrap: anywhere; }

/* 官网定制范围只作参考，不改变当前可查询的标准配置。 */
.configuration-scope { margin: var(--sp-12) 0 var(--sp-4); border-bottom: 1px solid var(--line); }
.configuration-scope-heading { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: var(--sp-4) var(--sp-12); padding-bottom: var(--sp-8); }
.configuration-scope .configuration-action {
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  width: auto;
  max-width: 100%;
  min-height: var(--tap);
  margin: 0;
  padding: var(--sp-8) var(--sp-12);
  border: 0;
  border-radius: var(--radius-control);
  background: var(--control);
  color: var(--text);
  font-size: var(--fs-sub);
  font-weight: 400;
  line-height: var(--lh-snug);
  white-space: normal;
}
.configuration-scope .configuration-action-disabled { opacity: 0.4; }
.configuration-scope .configuration-copy { width: 100%; }
.configuration-details { padding-bottom: var(--sp-12); }
.configuration-status { margin: var(--sp-4) 0 var(--sp-8); }
.configuration-option { padding: var(--sp-12) 0; border-top: 1px solid var(--line); }
.configuration-chip-name { margin-bottom: var(--sp-4); font-weight: 600; line-height: var(--lh-snug); }
.configuration-range { display: flex; gap: var(--sp-12); font-size: var(--fs-sub); line-height: var(--lh-normal); }
.configuration-range-label { flex: 0 0 auto; color: var(--text-2); }
.configuration-error { margin-top: var(--sp-8); color: var(--bad); font-size: var(--fs-sub); }

/* ── 门店：搜索、常用城市、已选 ───────────────────────── */
.store-search { display: flex; align-items: center; gap: var(--sp-8); min-height: var(--btn-height); padding: 0 var(--sp-4) 0 var(--sp-12); border-radius: var(--radius-control); background: var(--control); }
.search-glass { position: relative; flex: none; width: 13px; height: 13px; margin-right: var(--sp-4); border: 2px solid var(--text-3); border-radius: 50%; }
.search-glass::after { content: ''; position: absolute; right: -5px; bottom: -3px; width: 6px; height: 2px; border-radius: var(--radius-pill); background: var(--text-3); transform: rotate(45deg); }
.search-input { display: block; flex: 1 1 0; width: 0; min-width: 0; height: var(--tap); min-height: var(--tap); padding: 0; background: transparent; color: var(--text); font-size: var(--fs-body); line-height: var(--lh-snug); }
.search-placeholder { color: var(--text-3); }
.search-clear { display: flex; flex: none; align-items: center; justify-content: center; min-width: var(--tap); min-height: var(--tap); color: var(--text-2); font-size: var(--fs-sub); }
.search-summary { margin: var(--sp-12) 0 var(--sp-8); color: var(--text-2); font-size: var(--fs-sub); line-height: var(--lh-snug); }
.search-results { height: 256px; max-width: 100%; border-radius: var(--radius-control); background: var(--control); }
.search-results.results-1 { height: 64px; }
.search-results.results-2 { height: 128px; }
.search-results.results-3 { height: 192px; }
.store-result { display: flex; align-items: center; gap: var(--sp-12); min-height: 64px; padding: var(--sp-8) var(--sp-12); border-bottom: 1px solid var(--line); transition: background-color var(--dur-fast) var(--ease), opacity var(--dur-fast) var(--ease); }
.store-result.chosen { background: var(--green-soft); }
.store-result-copy { flex: 1 1 0; min-width: 0; }
.store-result-name { line-height: var(--lh-snug); overflow-wrap: anywhere; }
.store-result-city { color: var(--text-2); font-size: var(--fs-sub); line-height: var(--lh-snug); }
.store-result-action { flex: none; color: var(--text-2); font-size: var(--fs-sub); }
.chosen .store-result-action { color: var(--green-text); font-weight: 600; }
.search-empty { padding: var(--sp-12); border-radius: var(--radius-control); background: var(--control); color: var(--text-2); font-size: var(--fs-sub); line-height: var(--lh-normal); }
.hot-city-chips { display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); gap: var(--sp-4); }
.hot-city-chip { justify-content: center; min-width: 0; padding: var(--sp-8) var(--sp-2); font-size: var(--fs-sub); text-align: center; white-space: nowrap; }
.selected { padding-top: var(--sp-12); border-top: 1px solid var(--line); }
.selected-chip { gap: var(--sp-8); }

@media (max-width: 359px) {
  .hot-city-chips { grid-template-columns: repeat(3, minmax(0, 1fr)); }
}
/* 键盘弹起后的矮窗口里，当前选择不再吸顶，留出表单空间。 */
@media (max-height: 600px) {
  .picker-current-summary { position: static; }
}
@media (prefers-reduced-motion: reduce) {
  .chip, .choice-check, .picker-chevron, .store-result { transition: none; }
}
