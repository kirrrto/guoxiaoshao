/* Component styles intentionally use class selectors only (WeChat isolation). */
.ui-icon { display: block; flex: none; width: 20px; height: 20px; }
.picker, .field, .label, .value, .chip, .banner, .product-preview, .product-image-box, .product-image, .product-copy, .image-placeholder { box-sizing: border-box; }
.picker { width: 100%; min-width: 0; color: var(--text); overflow-wrap: anywhere; }
.section-label { color: var(--text-2); font-size: 24rpx; margin: 22rpx 0 14rpx; }
/* Categories wrap like other choices, so every option stays visible on narrow phones. */
.category-chips { margin-bottom: 8rpx; }
.field { display: flex; gap: 16rpx; align-items: center; justify-content: space-between; padding: 25rpx 0; border-bottom: 1rpx solid var(--line); min-width: 0; }
.label { color: var(--text-2); font-size: 28rpx; flex: 0 0 auto; max-width: 30%; }
.value { color: var(--text); font-size: 28rpx; text-align: right; flex: 1; min-width: 0; max-width: 76%; white-space: normal; overflow-wrap: anywhere; }
.chips { display: flex; flex-wrap: wrap; gap: 16rpx; }
.chip { max-width: 100%; min-height: 68rpx; padding: 14rpx 24rpx; border-radius: 999rpx; background: rgba(238,246,242,0.82); color: var(--text-2); font-size: 26rpx; border: 1rpx solid rgba(255,255,255,0.88); overflow-wrap: anywhere; }
.chip.on { background: var(--green-soft); color: var(--green-dark); border-color: rgba(0,195,117,0.52); font-weight: 600; box-shadow: inset 0 1rpx 0 rgba(255,255,255,0.85); }
.mt { margin-top: 16rpx; }
.small { font-size: 24rpx; }
.tiny { font-size: 22rpx; }
.bold { font-weight: 600; }
.muted { color: #65776c; }
.mono { font-family: Menlo, Consolas, monospace; word-break: break-all; }
.banner { padding: 18rpx 24rpx; border-radius: 18rpx; line-height: 1.6; overflow-wrap: anywhere; }
.banner-warn { background: var(--warn-soft); color: #915600; }
.banner-info { background: var(--info-soft); color: var(--green-dark); }
.product-preview { display: flex; gap: 20rpx; padding: 20rpx; border: 1rpx solid var(--glass-line); border-radius: 26rpx; background: linear-gradient(135deg, rgba(222,249,234,0.78), rgba(247,253,249,0.72)); align-items: center; min-width: 0; }
.product-image-box { width: 164rpx; height: 164rpx; flex: 0 0 164rpx; background: rgba(255,255,255,0.86); border-radius: 22rpx; overflow: hidden; }
.product-image { width: 164rpx; height: 164rpx; display: block; }
.product-copy { flex: 1; min-width: 0; overflow-wrap: anywhere; }
.image-placeholder { width: 100%; height: 100%; padding: 16rpx; display: flex; align-items: center; justify-content: center; text-align: center; color: #65776c; font-size: 22rpx; }
.store-search { box-sizing: border-box; display: flex; align-items: center; gap: 18rpx; min-height: 92rpx; padding: 0 24rpx; border: 1rpx solid rgba(122,157,139,0.24); border-radius: 24rpx; background: rgba(255,255,255,0.75); box-shadow: inset 0 2rpx 5rpx rgba(71,107,90,0.04); }
.search-glass { position: relative; box-sizing: border-box; flex: 0 0 25rpx; width: 25rpx; height: 25rpx; border: 3rpx solid #71877a; border-radius: 50%; margin-right: 4rpx; }
.search-glass::after { content: ''; position: absolute; width: 12rpx; height: 3rpx; right: -9rpx; bottom: -5rpx; background: #71877a; transform: rotate(45deg); border-radius: 2rpx; }
.search-input { display: block; flex: 1; width: 0; min-width: 0; height: 72rpx; padding: 0; border: 0; outline: none; background: transparent; line-height: 72rpx; font-size: 27rpx; color: var(--text); }
.search-placeholder { color: #52665B; font-size: 26rpx; opacity: 1; }
.search-clear { flex: 0 0 68rpx; min-height: 88rpx; display: flex; align-items: center; justify-content: flex-end; font-size: 24rpx; color: var(--green-dark); }
.search-hint { color: #73877b; font-size: 21rpx; line-height: 1.5; margin-top: 10rpx; }
.search-summary { color: #65776c; font-size: 23rpx; line-height: 1.5; margin: 18rpx 0 10rpx; }
.search-results { height: 360rpx; max-width: 100%; border: 1rpx solid var(--glass-line); border-radius: 22rpx; background: var(--surface-soft); }
.search-results.results-1 { height: 112rpx; }
.search-results.results-2 { height: 224rpx; }
.search-results.results-3 { height: 336rpx; }
.store-result { box-sizing: border-box; display: flex; align-items: center; gap: 20rpx; min-height: 112rpx; padding: 16rpx 20rpx; border-bottom: 2rpx solid #e7eee9; }
.store-result.chosen { background: var(--green-soft); }
.store-result-copy { flex: 1; min-width: 0; }
.store-result-name { font-size: 27rpx; line-height: 1.45; color: #203d2c; overflow-wrap: anywhere; }
.store-result-city { font-size: 22rpx; line-height: 1.4; color: #65776c; margin-top: 5rpx; }
.store-result-action { flex: 0 0 auto; font-size: 24rpx; color: var(--green-dark); }
.search-empty { padding: 24rpx 20rpx; background: #f7faf8; border-radius: 14rpx; color: #65776c; font-size: 25rpx; line-height: 1.7; }
.picker-section-heading { display: flex; align-items: center; flex-wrap: wrap; gap: 12rpx; margin: 24rpx 0 4rpx; min-width: 0; color: var(--text); font-size: 28rpx; font-weight: 600; line-height: 1.5; }
.picker-step { display: inline-flex; align-items: center; justify-content: center; flex: 0 0 42rpx; width: 42rpx; height: 42rpx; border: 1rpx solid rgba(255,255,255,0.92); border-radius: 14rpx; color: var(--green-dark); background: var(--green-soft); font-size: 21rpx; font-weight: 600; }
.picker-store-heading { padding-top: 26rpx; margin-top: 28rpx; margin-bottom: 18rpx; border-top: 1rpx solid var(--line); }
.picker-count { margin-left: auto; color: var(--text-2); font-size: 24rpx; font-weight: 400; }
.selected { padding: 18rpx 20rpx; border: 1rpx solid var(--glass-line); border-radius: 24rpx; background: rgba(244,250,246,0.72); }

/* The sheet keeps actions fixed; choices stay compact and easy to tap. */
.chip { min-height: 44px; min-height: max(44px, 88rpx); padding: 20rpx 24rpx; border-radius: 16rpx; background: var(--surface-soft); border-color: var(--line); }
.chip.on { border-color: var(--green-dark); box-shadow: none; }
.choice-check { font-weight: 700; }
.product-preview { background: var(--surface-soft); border-color: var(--line); border-radius: 20rpx; }
.product-image-box, .product-image { width: 112rpx; height: 112rpx; }
.product-image-box { flex-basis: 112rpx; }
.picker-section-heading { margin-top: 0; font-size: 30rpx; }
.picker-store-heading { margin-top: 28rpx; }
.search-hint, .search-summary, .store-result-city, .tiny { font-size: 24rpx; }
.store-search, .selected { background: var(--surface-soft); border-color: var(--line); }
.search-hint, .search-summary, .muted, .store-result-city { color: var(--text-2); }
.store-result-name { color: var(--text); }
.search-clear { min-height: 44px; }

/* Isolated components do not receive page typography. Keep small-phone choices readable. */
.label, .value, .chip, .search-input, .search-placeholder, .store-result-name, .store-result-action { font-size: max(14px, 28rpx); }
.section-label, .small, .tiny, .image-placeholder, .search-clear, .search-hint, .search-summary, .store-result-city, .search-empty, .picker-count { font-size: max(12px, 24rpx); }
.picker-section-heading { font-size: max(16px, 30rpx); }
.product-copy { font-size: max(14px, 28rpx); }
.search-input { min-height: 44px; }

/* Dark mode: page color variables inherit into this isolated component. */
/* 按下反馈 */
.chip.is-pressed, .store-result.is-pressed { opacity: 0.66; transform: scale(0.97); }

.picker-current-summary { position: sticky; top: 0; z-index: 1; padding: 16rpx 0 22rpx; margin-bottom: 16rpx; background: var(--card); border-bottom: 1rpx solid var(--line); font-size: max(14px, 28rpx); line-height: 1.6; }
.field-summary { border-bottom-style: dashed; }

/* Keep choices within reach while preserving native-sized tap areas. */
.picker-current-summary { padding: 8rpx 0 14rpx; margin-bottom: 14rpx; line-height: 1.4; }
.picker-current-summary > .small { margin-top: 4rpx; }
.picker-section-heading { font-size: max(15px, 28rpx); gap: 10rpx; }
.section-label { margin: 16rpx 0 10rpx; }
.chips { gap: 10rpx; }
.chip { min-height: 44px; padding: 16rpx 20rpx; line-height: 1.45; border-radius: 14rpx; }
/* Fixed tracks keep names intact and choices stationary when selection changes. */
.category-chips { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); }
.category-chips .chip { display: flex; align-items: center; justify-content: center; min-width: 0; padding: 8rpx; text-align: center; white-space: nowrap; overflow-wrap: normal; word-break: normal; font-weight: 500; }
.choice-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); }
.capacity-chips { grid-template-columns: repeat(3, minmax(0, 1fr)); }
.choice-chip { position: relative; display: flex; align-items: center; justify-content: center; min-width: 0; padding: 8px 22px 8px 8px; text-align: center; }
.choice-chip, .choice-chip.on { font-weight: 500; }
.choice-label { min-width: 0; max-width: 100%; }
.choice-check { position: absolute; right: 6px; top: 50%; transform: translateY(-50%); width: 14px; line-height: 1; text-align: center; opacity: 0; }
.choice-check-visible { opacity: 1; }
.field { min-height: 44px; padding: 18rpx 0; }
.field-summary { min-height: 34px; padding: 12rpx 0; border-bottom-style: solid; }
.field-summary .label, .field-summary .value { font-size: max(13px, 26rpx); }
.product-preview { gap: 16rpx; padding: 16rpx; border-radius: 16rpx; }
.product-image-box, .product-image { width: 96rpx; height: 112rpx; }
.product-image-box { flex-basis: 96rpx; border-radius: 12rpx; }
.product-copy { line-height: 1.45; }
.product-copy .mt { margin-top: 6rpx; }
.picker-store-heading { margin-top: 20rpx; padding-top: 18rpx; margin-bottom: 14rpx; }
.store-search { min-height: 44px; padding: 0 18rpx; border-radius: 16rpx; gap: 14rpx; }
.search-hint { margin-top: 6rpx; }
.hot-city-chips { display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); gap: 8rpx; margin-bottom: 4rpx; }
.hot-city-chip.chip { display: flex; align-items: center; justify-content: center; min-height: 36px; padding: 8rpx 4rpx; border-radius: 12rpx; font-size: max(12px, 24rpx); text-align: center; white-space: nowrap; }
.selected { padding: 14rpx 16rpx; border-radius: 16rpx; }

@media (prefers-color-scheme: dark) {
  .ui-icon { filter: brightness(1.5); }
  .chip { background: rgba(255, 255, 255, 0.07); border-color: rgba(255, 255, 255, 0.06); }
  .chip.on { box-shadow: none; }
  .muted, .search-hint, .search-summary, .store-result-city { color: var(--text-3); }
  .banner-warn { color: var(--warn); }
  .product-preview, .search-empty, .selected { background: rgba(255, 255, 255, 0.04); }
  .product-image-box { background: var(--image-tile); }
  .store-search { border-color: rgba(255, 255, 255, 0.12); background: rgba(255, 255, 255, 0.05); }
  .search-glass { border-color: #8FA398; }
  .search-glass::after { background: #8FA398; }
  .search-placeholder { color: #B7C8BD; }
  .store-result { border-bottom-color: var(--line); }
  .store-result-name { color: var(--text); }
  .search-empty { color: var(--text-3); }
  .picker-step { border-color: rgba(255, 255, 255, 0.06); }
}
