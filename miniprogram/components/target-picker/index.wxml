<wxs module="i18n" src="../../i18n/render.wxs" />
<view class="picker">
  <view class="picker-current-summary" aria-live="polite"><view class="bold">{{i18n.t(ui,(product ? product.selectionTitle : '请选择商品配置'))}}</view><view class="small muted">{{i18n.m(ui,'已选 {0} 家门店 · 当前最多 {1} 家',[(selectedStores.length),(maxStores)])}}</view></view>
  <view class="picker-section-heading"><image class="ui-icon" src="/images/ui/device.png" mode="aspectFit" aria-hidden="true" /><text>{{i18n.t(ui,'选商品')}}</text></view>
  <block wx:if="{{categories.length}}">
  <view class="section-label">{{i18n.t(ui,'产品类别')}}</view>
  <view class="chips category-chips"><view wx:for="{{categories}}" wx:key="key" class="chip {{index === categoryIndex ? 'on' : ''}}" data-index="{{index}}" hover-class="{{disabled ? 'none' : 'is-pressed'}}" hover-stay-time="60" bindtap="onCategoryTap" aria-role="button" aria-disabled="{{disabled}}" aria-label="{{i18n.t(ui,(item.name + (index === categoryIndex ? '，已选' : '')))}}">{{i18n.t(ui,(item.name))}}</view></view>
  <view wx:if="{{families.length === 1}}" class="field field-summary"><text class="label">{{i18n.t(ui,'系列')}}</text><text class="value">{{i18n.t(ui,(families[0].name))}}</text></view>
  <picker disabled="{{disabled}}" wx:else mode="selector" range="{{i18n.options(ui,(familyNames),'')}}" value="{{familyIndex}}" bindchange="onFamilyChange"><view class="field"><text class="label">{{i18n.t(ui,'系列')}}</text><text class="value">{{i18n.t(ui,(families[familyIndex].name || '请选择'))}}</text><view class="picker-chevron" aria-hidden="true"></view></view></picker>
  <view wx:if="{{models.length === 1}}" class="field field-summary"><text class="label">{{i18n.t(ui,'型号')}}</text><text class="value">{{i18n.t(ui,(models[0]))}}</text></view>
  <picker disabled="{{disabled}}" wx:else mode="selector" range="{{i18n.options(ui,(models),'')}}" value="{{modelIndex}}" bindchange="onModelChange"><view class="field"><text class="label">{{i18n.t(ui,'型号')}}</text><text class="value">{{i18n.t(ui,(models[modelIndex] || '请选择'))}}</text><view class="picker-chevron" aria-hidden="true"></view></view></picker>
  <view wx:if="{{officialConfiguration}}" class="configuration-scope">
    <view class="configuration-scope-heading">
      <text class="small muted">{{i18n.m(ui,'已接入 {0} 个可查询标准配置',[(officialConfiguration.supportedCount)])}}</text>
      <button class="configuration-action {{disabled ? 'configuration-action-disabled' : ''}}" disabled="{{disabled}}" bindtap="onToggleConfigurations" aria-label="{{i18n.t(ui,(configurationsExpanded ? '收起定制款配置参考' : '展开定制款配置参考'))}}">{{i18n.t(ui,(configurationsExpanded ? '收起定制款配置' : '查看定制款配置'))}}</button>
    </view>
    <view wx:if="{{configurationsExpanded}}" class="configuration-details">
      <view class="banner banner-info small configuration-status">{{i18n.m(ui,'官网定制款共 {0} 种已核实组合，不支持 Apple Store 店内取货；以下仅作配置参考，不参与库存查询或自动关注。',[(officialConfiguration.customCount)])}}</view>
      <view wx:for="{{officialConfiguration.chips}}" wx:key="chipId" class="configuration-option">
        <view class="configuration-chip-name">{{i18n.m(ui,'{0} · {1}',[(item.chipName),(item.chip)])}}</view>
        <view class="configuration-range"><text class="configuration-range-label">{{i18n.t(ui,'内存')}}</text><text>{{i18n.t(ui,(item.memoryText))}}</text></view>
        <view class="configuration-range"><text class="configuration-range-label">{{i18n.t(ui,'存储')}}</text><text>{{i18n.t(ui,(item.storageText))}}</text></view>
      </view>
      <button class="configuration-action configuration-copy {{disabled || copyingConfigurationLink ? 'configuration-action-disabled' : ''}}" disabled="{{disabled || copyingConfigurationLink}}" loading="{{copyingConfigurationLink}}" bindtap="onCopyConfigurationLink">{{i18n.t(ui,'复制官网链接')}}</button>
      <view wx:if="{{configurationLinkError}}" class="configuration-error" aria-live="polite">{{i18n.t(ui,(configurationLinkError))}}</view>
    </view>
  </view>
  <view wx:if="{{memories.length === 1}}" class="field field-summary"><text class="label">{{i18n.t(ui,'内存')}}</text><text class="value">{{i18n.t(ui,(memories[0]))}}</text></view>
  <block wx:elif="{{memories.length > 1 && memories.length <= 6}}"><view class="section-label">{{i18n.t(ui,'内存')}}</view><view class="chips choice-grid memory-chips"><view wx:for="{{memories}}" wx:key="*this" class="chip choice-chip {{index === memoryIndex ? 'on' : ''}}" data-index="{{index}}" hover-class="{{disabled ? 'none' : 'is-pressed'}}" hover-stay-time="60" bindtap="onMemoryTap" aria-role="button" aria-disabled="{{disabled}}" aria-label="{{i18n.t(ui,(item + (index === memoryIndex ? '，已选' : '')))}}"><text class="choice-label">{{i18n.t(ui,(item))}}</text><view class="choice-check {{index === memoryIndex ? 'choice-check-visible' : ''}}" aria-hidden="true"><view class="picker-check"></view></view></view></view></block>
  <picker disabled="{{disabled}}" wx:elif="{{memories.length > 6}}" mode="selector" range="{{i18n.options(ui,(memories),'')}}" value="{{memoryIndex}}" bindchange="onMemoryChange"><view class="field"><text class="label">{{i18n.t(ui,'内存')}}</text><text class="value">{{i18n.t(ui,(memories[memoryIndex]))}}</text><view class="picker-chevron" aria-hidden="true"></view></view></picker>
  <view wx:if="{{capacities.length === 1 && capacities[0] !== '标准配置'}}" class="field field-summary"><text class="label">{{i18n.t(ui,'容量')}}</text><text class="value">{{i18n.t(ui,(capacities[0]))}}</text></view>
  <block wx:elif="{{capacities.length > 1 && capacities.length <= 6}}"><view class="section-label">{{i18n.t(ui,'容量')}}</view><view class="chips choice-grid capacity-chips"><view wx:for="{{capacities}}" wx:key="*this" class="chip choice-chip {{index === capacityIndex ? 'on' : ''}}" data-index="{{index}}" hover-class="{{disabled ? 'none' : 'is-pressed'}}" hover-stay-time="60" bindtap="onCapacityTap" aria-role="button" aria-disabled="{{disabled}}" aria-label="{{i18n.t(ui,(item + (index === capacityIndex ? '，已选' : '')))}}"><text class="choice-label">{{i18n.t(ui,(item))}}</text><view class="choice-check {{index === capacityIndex ? 'choice-check-visible' : ''}}" aria-hidden="true"><view class="picker-check"></view></view></view></view></block>
  <picker disabled="{{disabled}}" wx:elif="{{capacities.length > 6}}" mode="selector" range="{{i18n.options(ui,(capacities),'')}}" value="{{capacityIndex}}" bindchange="onCapacityChange"><view class="field"><text class="label">{{i18n.t(ui,'容量')}}</text><text class="value">{{i18n.t(ui,(capacities[capacityIndex]))}}</text><view class="picker-chevron" aria-hidden="true"></view></view></picker>
  <view wx:if="{{colors.length === 1 && colors[0] !== '标准外观'}}" class="field field-summary"><text class="label">{{i18n.t(ui,'颜色')}}</text><text class="value">{{i18n.t(ui,(colors[0]))}}</text></view>
  <block wx:elif="{{colors.length > 1}}"><view class="section-label">{{i18n.t(ui,'颜色')}}</view><view class="chips choice-grid color-chips"><view wx:for="{{colors}}" wx:key="*this" class="chip choice-chip {{index === colorIndex ? 'on' : ''}}" data-index="{{index}}" hover-class="{{disabled ? 'none' : 'is-pressed'}}" hover-stay-time="60" bindtap="onColorTap" aria-role="button" aria-disabled="{{disabled}}" aria-label="{{i18n.t(ui,(item + (index === colorIndex ? '，已选' : '')))}}"><text class="choice-label">{{i18n.t(ui,(item))}}</text><view class="choice-check {{index === colorIndex ? 'choice-check-visible' : ''}}" aria-hidden="true"><view class="picker-check"></view></view></view></view></block>
  <picker disabled="{{disabled}}" wx:if="{{candidates.length > 1}}" mode="selector" range="{{i18n.options(ui,(productTitles),'')}}" value="{{productIndex}}" bindchange="onProductChange"><view class="field"><text class="label">{{i18n.t(ui,'具体配置')}}</text><text class="value">{{i18n.t(ui,(product.configurationLabel || product.title || '请选择具体配置'))}}</text><view class="picker-chevron" aria-hidden="true"></view></view></picker>
  <view wx:elif="{{product && product.specSummary}}" class="field field-summary"><text class="label">{{i18n.t(ui,'具体配置')}}</text><text class="value">{{i18n.t(ui,(product.configurationLabel))}}</text></view>
  <view wx:if="{{product}}" class="product-preview mt"><view class="product-image-box"><image wx:if="{{product.imageDisplayUrl && !imageFailed}}" class="product-image" src="{{product.imageDisplayUrl}}" webp="{{true}}" mode="aspectFit" aria-label="{{i18n.t(ui,(product.imageAlt))}}" binderror="onImageError" /><view wx:else class="image-placeholder">{{i18n.t(ui,'暂无图片')}}</view></view><view class="product-copy"><view class="bold">{{i18n.t(ui,(product.title))}}</view><view wx:if="{{product.targetType !== 'apple_cto'}}" class="tiny muted mono">{{i18n.t(ui,(product.partNumber))}}</view><view wx:if="{{product.priceCny}}" class="small muted">{{i18n.m(ui,'官网参考价 ¥{0}',[(product.priceCny)])}}</view></view></view>
  <view wx:if="{{product && product.targetType === 'apple_cto'}}" class="banner banner-info small mt">{{i18n.t(ui,'官网定制款不支持 Apple Store 店内取货，请选择可查询的标准配置。')}}</view>
  <view wx:elif="{{product && !product.querySupported}}" class="banner banner-warn small mt">{{i18n.t(ui,'可先保存选择，取货查询和关注暂未开放。')}}</view>
  <view wx:elif="{{product && !product.monitorSupported}}" class="small muted mt">{{i18n.t(ui,'可手动查询，自动关注暂未开放。')}}</view>
  </block>
  <view wx:if="{{selectionNote}}" class="banner banner-info small mt">{{i18n.t(ui,(selectionNote))}}</view>
  <view class="picker-section-heading picker-store-heading"><image class="ui-icon" src="/images/ui/store.png" mode="aspectFit" aria-hidden="true" /><text>{{i18n.m(ui,'选门店{0}',[(storesOptional ? '（可选）' : '')])}}</text><text class="picker-count">{{i18n.m(ui,'{0} / {1}',[(selectedStores.length),(maxStores)])}}</text></view>
  <view class="store-search"><view class="search-glass" aria-hidden="true"></view><input disabled="{{disabled}}" aria-label="{{i18n.t(ui,'搜索城市、商场或门店')}}" class="search-input" value="{{searchKeyword}}" maxlength="60" placeholder="{{i18n.t(ui,'搜索城市、商场或门店')}}" placeholder-class="search-placeholder" confirm-type="search" adjust-position="{{!inSheet}}" bindinput="onSearchInput" /><view wx:if="{{searchKeyword}}" class="search-clear" bindtap="onClearSearch" aria-role="button" aria-disabled="{{disabled}}" aria-label="{{i18n.t(ui,'清空搜索')}}">{{i18n.t(ui,'清空')}}</view></view>
  <block wx:if="{{searchActive}}">
    <view class="search-summary">{{i18n.m(ui,'找到 {0} 家门店',[(searchResults.length)])}}</view>
    <scroll-view wx:if="{{searchResults.length}}" class="search-results results-{{searchResults.length}}" scroll-y enhanced show-scrollbar="{{true}}">
      <view wx:for="{{searchResults}}" wx:key="storeNumber" class="store-result {{item.on ? 'chosen' : ''}}" data-store="{{item.storeNumber}}" hover-class="{{disabled ? 'none' : 'is-pressed'}}" hover-stay-time="60" bindtap="onStoreTap" aria-role="button" aria-disabled="{{disabled}}" aria-label="{{i18n.t(ui,(item.city + ' ' + item.name + (item.on ? '，已选，点击移除' : '，点击选择')))}}">
        <view class="store-result-copy"><view class="store-result-name">{{i18n.t(ui,(item.name))}}</view><view class="store-result-city">{{i18n.t(ui,(item.province === item.city ? item.city : item.province + ' · ' + item.city))}}</view></view><view class="store-result-action">{{i18n.t(ui,(item.on ? '已选' : '选择'))}}</view>
      </view>
    </scroll-view>
    <view wx:else class="search-empty">{{i18n.t(ui,'没有找到相关直营店，试试城市名称或其他关键词。')}}</view>
  </block>
  <block wx:else>
    <view wx:if="{{hotCities.length > 1}}" class="chips hot-city-chips mt" aria-label="{{i18n.t(ui,'常用城市')}}"><view wx:for="{{hotCities}}" wx:key="name" class="chip hot-city-chip {{item.index === cityIndex ? 'on' : ''}}" data-index="{{item.index}}" hover-class="{{disabled ? 'none' : 'is-pressed'}}" hover-stay-time="60" bindtap="onHotCityTap" aria-role="button" aria-disabled="{{disabled}}" aria-label="{{i18n.t(ui,(item.name + (item.index === cityIndex ? '，当前城市' : '')))}}">{{i18n.t(ui,(item.name))}}</view></view>
    <picker disabled="{{disabled}}" mode="selector" range="{{i18n.options(ui,(cities),'')}}" value="{{cityIndex}}" bindchange="onCityChange"><view class="field"><text class="label">{{i18n.t(ui,'城市')}}</text><text class="value">{{i18n.t(ui,(cities[cityIndex] || '暂无门店'))}}</text><view class="picker-chevron" aria-hidden="true"></view></view></picker>
    <view class="chips mt"><view wx:for="{{cityStores}}" wx:key="storeNumber" class="chip {{item.on ? 'on' : ''}}" data-store="{{item.storeNumber}}" hover-class="{{disabled ? 'none' : 'is-pressed'}}" hover-stay-time="60" bindtap="onStoreTap" aria-role="button" aria-disabled="{{disabled}}" aria-label="{{i18n.t(ui,(item.city + ' ' + item.name + (item.on ? '，已选，点击移除' : '，点击选择')))}}">{{i18n.t(ui,(item.name))}}</view></view>
  </block>
  <view wx:if="{{selectedStores.length}}" class="selected mt"><view class="chips"><view wx:for="{{selectedStores}}" wx:key="storeNumber" class="chip on selected-chip" data-store="{{item.storeNumber}}" hover-class="{{disabled ? 'none' : 'is-pressed'}}" hover-stay-time="60" bindtap="onRemoveStore" aria-role="button" aria-disabled="{{disabled}}" aria-label="{{i18n.t(ui,('移除 ' + item.label))}}"><text>{{i18n.t(ui,(item.label))}}</text><view class="picker-close" aria-hidden="true"></view></view></view></view>
</view>
