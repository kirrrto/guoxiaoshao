/* 隔离组件：只用类选择器，令牌经继承取自页面。 */
.reminder-overlay { position: fixed; inset: 0; z-index: 1300; display: flex; align-items: center; justify-content: center; padding: var(--sp-24); box-sizing: border-box; background: var(--scrim); }
.reminder-dialog { box-sizing: border-box; width: 100%; max-width: 320px; padding: var(--sp-24) var(--sp-20) var(--sp-16); border-radius: var(--radius-tray); background: var(--elevated); color: var(--text); }
.reminder-title { font-size: var(--fs-headline); font-weight: 600; line-height: var(--lh-snug); }
.reminder-counts { display: flex; gap: var(--sp-8); margin-top: var(--sp-16); }
.reminder-count { display: flex; flex: 1 1 0; align-items: baseline; justify-content: space-between; padding: var(--sp-12); border-radius: var(--radius-control); background: var(--surface); color: var(--text-2); font-size: var(--fs-sub); }
.reminder-number { color: var(--text); font-size: var(--fs-title); font-weight: 600; line-height: var(--lh-tight); }
.reminder-unit { color: var(--text-2); font-size: var(--fs-sub); font-weight: 400; }
.reminder-detail { margin: var(--sp-16) 0; color: var(--text-2); font-size: var(--fs-sub); line-height: var(--lh-normal); }
/* 三个类压过原生按钮的禁用配色；组件样式不使用属性选择器。 */
.reminder-overlay .reminder-dialog .reminder-allow, .reminder-overlay .reminder-dialog .reminder-later {
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  width: 100%;
  min-width: 0;
  max-width: 100%;
  min-height: var(--btn-height);
  margin: 0;
  padding: var(--sp-12) var(--sp-20);
  border: 0;
  border-radius: var(--radius-control);
  font-size: var(--fs-body);
  font-weight: 600;
  line-height: var(--lh-snug);
  transition: transform var(--dur-fast) var(--ease), opacity var(--dur-fast) var(--ease);
}
.reminder-overlay .reminder-dialog .reminder-allow { background: var(--green); color: var(--green-ink); }
.reminder-overlay .reminder-dialog .reminder-busy { opacity: 0.5; }
.reminder-overlay .reminder-dialog .reminder-button-pressed { opacity: 0.86; transform: scale(0.985); }
.reminder-overlay .reminder-dialog .reminder-later { margin-top: var(--sp-4); background: transparent; color: var(--text-2); font-weight: 400; }
.reminder-footnote { color: var(--text-3); font-size: var(--fs-caption); text-align: center; }
@media (prefers-reduced-motion: reduce) {
  .reminder-overlay .reminder-dialog .reminder-allow, .reminder-overlay .reminder-dialog .reminder-later { transition: none; }
  .reminder-overlay .reminder-dialog .reminder-button-pressed { transform: none; }
}
