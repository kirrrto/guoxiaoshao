<wxs module="i18n" src="../../i18n/render.wxs" />
<view wx:if="{{open}}" class="reminder-overlay" catchtouchmove="swallow" bindtap="dismiss">
  <view class="reminder-dialog" aria-role="dialog" aria-modal="true" aria-label="{{i18n.t(ui,(prompt.title))}}" catchtap="swallow">
    <view class="reminder-title">{{i18n.t(ui,(prompt.title))}}</view>
    <view class="reminder-counts">
      <view class="reminder-count"><text>{{i18n.t(ui,'到货')}}</text><text class="reminder-number">{{i18n.t(ui,(prompt.restockCount))}}<text class="reminder-unit"> {{i18n.t(ui,'次')}}</text></text></view>
      <view wx:if="{{prompt.soldoutEnabled}}" class="reminder-count"><text>{{i18n.t(ui,'断货')}}</text><text class="reminder-number">{{i18n.t(ui,(prompt.soldoutCount))}}<text class="reminder-unit"> {{i18n.t(ui,'次')}}</text></text></view>
    </view>
    <view class="reminder-detail">{{i18n.t(ui,(prompt.detail))}}</view>
    <button class="reminder-allow {{submitting ? 'reminder-busy' : ''}}" hover-class="reminder-button-pressed" bindtap="authorize" loading="{{submitting}}" disabled="{{submitting}}">{{i18n.t(ui,'补充提醒次数')}}</button>
    <button class="reminder-later {{submitting ? 'reminder-busy' : ''}}" hover-class="reminder-button-pressed" bindtap="dismiss" disabled="{{submitting}}">{{i18n.t(ui,'稍后再说')}}</button>
    <view class="reminder-footnote">{{i18n.t(ui,'24 小时内不再主动提示')}}</view>
  </view>
</view>
