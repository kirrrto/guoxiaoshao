.config-sheet-root { position: fixed; inset: 0; z-index: 1000; color: var(--text); }
.config-sheet-scrim { position: absolute; inset: 0; background: rgba(10, 24, 17, .42); }
.config-sheet-panel { box-sizing: border-box; position: absolute; left: 0; right: 0; display: flex; flex-direction: column; height: 88vh; min-height: 0; background: var(--card, #fff); border-radius: 20px 20px 0 0; overflow: hidden; box-shadow: 0 -6px 32px rgba(0, 0, 0, .13); font-size: 14px; }
.config-sheet-header { display: flex; flex: none; align-items: center; gap: 12px; padding: 8px 16px; border-bottom: 1px solid var(--line); }
.config-sheet-heading { flex: 1; min-width: 0; }
.config-sheet-title { font-size: 18px; line-height: 1.4; font-weight: 600; overflow-wrap: anywhere; }
.config-sheet-subtitle { margin-bottom: 12px; color: var(--text-2); font-size: 13px; line-height: 1.5; }
.config-sheet-close { display: flex; align-items: center; justify-content: center; width: 44px; height: 44px; flex: 0 0 44px; margin: 0; padding: 0; border: none; border-radius: 50%; background: var(--surface-soft); color: var(--text-2); font-size: 24px; line-height: 1; }
.config-sheet-close::after { border: none; }
.config-sheet-body { flex: 1 1 0%; height: 0; min-height: 0; }
/* Descriptions and long selections scroll with the form, leaving its controls
   reachable when the keyboard or a fold reduces the available height. */
.config-sheet-content { padding: 12px 16px 16px; }
.config-sheet-footer { flex: none; padding: 10px 16px calc(10px + env(safe-area-inset-bottom)); border-top: 1px solid var(--line); background: var(--card, #fff); }
.config-sheet-keyboard { padding-bottom: 10px; }
.config-sheet-summary { font-size: 13px; color: var(--text-2); line-height: 1.5; margin-top: 16px; padding-top: 12px; border-top: 1px solid var(--line); overflow-wrap: anywhere; }
.config-sheet-confirm.btn { width: 100%; min-height: 44px; height: auto; padding: 10px 16px; border-radius: 12px; font-size: 16px; line-height: 1.5; }
@media (min-width: 600px) {
  .config-sheet-panel { width: calc(100% - 48px); max-width: 640px; margin-left: auto; margin-right: auto; border-radius: 24px 24px 0 0; }
  .config-sheet-header, .config-sheet-content, .config-sheet-footer { padding-left: 24px; padding-right: 24px; }
  .config-sheet-title { font-size: 20px; }
}
@media (prefers-color-scheme: dark) { .config-sheet-panel, .config-sheet-footer { background: var(--card, #1B251F); } }
