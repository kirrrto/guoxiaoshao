/* 底部抽屉：正文独立滚动，标题与保存操作始终可见。 */
.config-sheet-root { position: fixed; inset: 0; z-index: 1000; color: var(--text); }
.config-sheet-scrim { position: absolute; inset: 0; background: var(--scrim); }
.config-sheet-panel {
  --control: var(--surface);
  position: absolute;
  left: 0;
  right: 0;
  display: flex;
  flex-direction: column;
  height: 88vh;
  min-height: 0;
  overflow: hidden;
  border-radius: var(--radius-tray) var(--radius-tray) 0 0;
  background: var(--elevated);
  box-shadow: var(--shadow-sheet);
  font-size: var(--fs-body);
  transform: translate3d(0, 0, 0);
  transition: transform var(--dur-sheet) var(--ease-out), bottom var(--dur) var(--ease-out);
}
.config-sheet-panel--dragging { transition: none; }
.config-sheet-grabber-bar { display: flex; flex: none; justify-content: center; padding: var(--sp-8) 0 var(--sp-2); }
.config-sheet-grabber { width: 36px; height: 4px; border-radius: var(--radius-pill); background: var(--pressed); }
.config-sheet-header { display: flex; flex: none; align-items: center; gap: var(--sp-12); padding: var(--sp-8) var(--sp-8) var(--sp-8) var(--sp-16); border-bottom: 1px solid var(--line); }
.config-sheet-heading { flex: 1 1 0; min-width: 0; }
.config-sheet-title { font-size: var(--fs-headline); font-weight: 600; line-height: var(--lh-snug); overflow-wrap: anywhere; }
.config-sheet-subtitle { margin-bottom: var(--sp-12); color: var(--text-2); font-size: var(--fs-sub); }
/* 三个类压过原生按钮的禁用配色；组件样式不使用属性选择器。 */
.config-sheet-panel .config-sheet-header .config-sheet-close {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
  width: var(--tap);
  height: var(--tap);
  margin: 0;
  padding: 0;
  border: 0;
  border-radius: 50%;
  background: transparent;
  color: var(--text-2);
}
.config-sheet-panel .config-sheet-header .config-sheet-close--busy { opacity: 0.4; }
.config-sheet-body { flex: 1 1 0%; height: 0; min-height: 0; }
/* 说明与长选项随表单滚动，键盘或折叠屏压缩高度时控件仍可到达。 */
.config-sheet-content { padding: var(--sp-12) var(--sp-16) var(--sp-16); }
.config-sheet-footer { flex: none; padding: var(--sp-12) var(--sp-16) calc(var(--sp-12) + env(safe-area-inset-bottom)); border-top: 1px solid var(--line); background: var(--elevated); }
.config-sheet-keyboard { padding-bottom: var(--sp-12); }
@media (max-height: 600px) {
  .config-sheet-keyboard { padding-top: var(--sp-4); padding-bottom: var(--sp-4); }
}
.config-sheet-summary { margin-top: var(--sp-16); padding-top: var(--sp-12); border-top: 1px solid var(--line); color: var(--text-2); font-size: var(--fs-sub); overflow-wrap: anywhere; }
@media (min-width: 600px) {
  .config-sheet-panel { width: calc(100% - 48px); max-width: 600px; margin-left: auto; margin-right: auto; }
}

/* 宽窗口中，选择器嵌在查询条件栏；结果与页面仍可独立阅读。 */
.config-sheet-root--docked { position: static; }
.config-sheet-root--docked .config-sheet-panel {
  position: relative;
  width: 100%;
  max-width: none;
  height: min(76vh, 720px);
  border-radius: var(--radius-tray);
  background: var(--surface);
  box-shadow: none;
  --control: var(--surface-top);
}
.config-sheet-root--docked .config-sheet-footer { background: var(--surface); }
@media (prefers-reduced-motion: reduce) {
  .config-sheet-panel { transition: none; }
}
