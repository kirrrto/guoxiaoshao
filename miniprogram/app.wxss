/* 果小哨 · 页面全局样式。隔离组件使用独立的 class 样式。 */
@import "styles/common.wxss";

page {
  /* Brand green follows the supplied reference; ink stays dark for legibility. */
  --green: #00C375;
  --green-dark: #007A49;
  --green-ink: #073C2C;
  --green-soft: rgba(217, 249, 233, 0.85);
  --green-mist: #F0FBF6;
  --text: #183C2D;
  --text-2: #47685A;
  --text-3: #637C70;
  --line: rgba(0, 145, 87, 0.12);
  --card: rgba(255, 255, 255, 0.80);
  --surface-soft: rgba(242, 252, 246, 0.86);
  --glass-line: rgba(255, 255, 255, 0.92);
  --shadow-soft: 0 12rpx 34rpx rgba(21, 106, 65, 0.055);
  --warn: #946019;
  --warn-soft: #FFF3DD;
  --bad: #B54848;
  --bad-soft: #FCECED;
  --info-soft: #EAF7F1;
  /* Static light and translucent surfaces keep scrolling inexpensive on phones.
     No full-page filters, animated gradients, or backdrop-filter dependency. */
  background-color: var(--green-mist);
  background-image: radial-gradient(ellipse at 0% 0%, rgba(149, 240, 190, 0.22) 0%, rgba(149, 240, 190, 0) 58%), radial-gradient(ellipse at 100% 24%, rgba(203, 251, 222, 0.26) 0%, rgba(203, 251, 222, 0) 58%), linear-gradient(160deg, #F3FCF7 0%, #F7FCF9 48%, #F4FBF7 100%);
  min-height: 100%;
  color: var(--text);
  font-size: 28rpx;
  line-height: 1.5;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", Helvetica, sans-serif;
}

/* Dark mode follows the phone's system theme (app.json darkmode + theme.json).
   Only colors change. Each stylesheet keeps its dark overrides in one block at
   its end, so the light theme above stays exactly as designed. */
@media (prefers-color-scheme: dark) {
  page {
    --green-dark: #3DDC97;
    --green-soft: rgba(0, 195, 117, 0.16);
    --green-mist: #0E1714;
    --text: #E3EEE8;
    --text-2: #A9BDB3;
    --text-3: #889B91;
    --line: rgba(163, 224, 194, 0.12);
    --card: rgba(24, 36, 31, 0.94);
    --surface-soft: rgba(255, 255, 255, 0.05);
    --glass-line: rgba(255, 255, 255, 0.07);
    --shadow-soft: 0 12rpx 34rpx rgba(0, 0, 0, 0.32);
    --warn: #E8B15C;
    --warn-soft: rgba(232, 177, 92, 0.14);
    --bad: #F29B93;
    --bad-soft: rgba(242, 155, 147, 0.14);
    --info-soft: rgba(0, 195, 117, 0.10);
    /* Product photos are shot for light backgrounds: a dimmed light tile keeps
       dark devices on transparent images visible without a glaring white box. */
    --image-tile: #DCE3DF;
    background-image: radial-gradient(ellipse at 0% 0%, rgba(0, 195, 117, 0.10) 0%, rgba(0, 195, 117, 0) 58%), radial-gradient(ellipse at 100% 24%, rgba(0, 150, 95, 0.07) 0%, rgba(0, 150, 95, 0) 58%), linear-gradient(160deg, #0F1916 0%, #0D1613 48%, #0E1714 100%);
  }
}
