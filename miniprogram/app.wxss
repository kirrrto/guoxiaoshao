/* 果小哨设计体系 · 令牌层。规范见 DESIGN.md，约束由 tests/design-system.test.mjs 执行。
   页面与组件只引用这里的令牌：不写色值、不写 rpx、不自造字号与间距。 */
@import "styles/common.wxss";

page {
  /* 表面：白色页面，内容放在浅灰托盘里；托盘上的控件回到白色。 */
  --bg: #FFFFFF;
  --surface: #F5F5F3;
  --surface-top: #FFFFFF;
  --elevated: #FFFFFF;
  --pressed: #E8E8E5;
  --control: var(--surface);
  --scrim: rgba(0, 0, 0, 0.45);
  --line: rgba(17, 20, 18, 0.08);

  /* 文字：一级墨色，两级灰阶。 */
  --text: #111412;
  --text-2: #545956;
  --text-3: #626764;

  /* 绿色只用于主操作与「有货 / 已就绪」。绿底上的文字用 --green-ink，不用白色。 */
  --green: #00C375;
  --green-ink: #073C2C;
  --green-text: #006B3F;
  --green-soft: rgba(0, 195, 117, 0.12);

  /* 语义色成对使用：前景配同名 soft 底。 */
  --warn: #895806;
  --warn-soft: #FBF1DC;
  --bad: #A83E3E;
  --bad-soft: #FBECEC;

  /* 会员卡：全站唯一的深色物件，金色只出现在这里。 */
  --pass: #151816;
  --pass-fill: linear-gradient(135deg, #20241F 0%, #101311 100%);
  --pass-edge: transparent;
  --pass-text: #F4F5F3;
  --pass-text-2: rgba(244, 245, 243, 0.66);
  --pass-line: rgba(244, 245, 243, 0.12);
  --pass-gold: #E9CE9A;

  /* 商品图托：与托盘上的控件同色，深色模式保留浅底以看清深色机身。 */
  --image-tile: #FFFFFF;
  --image-blend: normal;
  --icon-filter: grayscale(1);
  --skeleton: rgba(17, 20, 18, 0.07);

  /* 字号六级、字重两种（400 / 600）、行高三档。 */
  --fs-display: 28px;
  --fs-title: 22px;
  --fs-headline: 17px;
  --fs-body: 15px;
  --fs-sub: 13px;
  --fs-caption: 12px;
  --lh-tight: 1.25;
  --lh-snug: 1.4;
  --lh-normal: 1.5;

  /* 间距阶梯（数字即像素）。 */
  --sp-2: 2px;
  --sp-4: 4px;
  --sp-8: 8px;
  --sp-12: 12px;
  --sp-16: 16px;
  --sp-20: 20px;
  --sp-24: 24px;
  --sp-32: 32px;
  --sp-40: 40px;

  /* 圆角：托盘、控件、小托、胶囊。 */
  --radius-tray: 16px;
  --radius-control: 12px;
  --radius-tile: 10px;
  --radius-pill: 999px;

  /* 尺寸与动效。 */
  --tap: 44px;
  --btn-height: 48px;
  --shadow-sheet: 0 -8px 32px rgba(0, 0, 0, 0.12);
  --ease: cubic-bezier(0.2, 0, 0, 1);
  --dur-fast: 120ms;
  --dur: 200ms;

  min-height: 100%;
  background-color: var(--bg);
  color: var(--text);
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", Helvetica, sans-serif;
  font-size: var(--fs-body);
  font-variant-numeric: tabular-nums;
  line-height: var(--lh-normal);
}

/* 深色模式跟随系统（app.json darkmode + theme.json），只改颜色令牌。 */
@media (prefers-color-scheme: dark) {
  page {
    --bg: #0B0D0C;
    --surface: #171A18;
    --surface-top: #252927;
    --elevated: #1F2320;
    --pressed: #2E3230;
    --scrim: rgba(0, 0, 0, 0.6);
    --line: rgba(255, 255, 255, 0.08);
    --text: #EEF2EF;
    --text-2: #B7C0BB;
    --text-3: #9BA59F;
    --green-text: #5CE0A8;
    --green-soft: rgba(0, 195, 117, 0.16);
    --warn: #E8B15C;
    --warn-soft: rgba(232, 177, 92, 0.14);
    --bad: #F29B93;
    --bad-soft: rgba(242, 155, 147, 0.14);
    --pass: #1B1F1C;
    --pass-fill: linear-gradient(135deg, #262B26 0%, #171A18 100%);
    --pass-edge: rgba(233, 206, 154, 0.22);
    --image-tile: #DCE1DE;
    --image-blend: multiply;
    --icon-filter: grayscale(1) brightness(2.1);
    --skeleton: rgba(255, 255, 255, 0.07);
    --shadow-sheet: 0 -8px 32px rgba(0, 0, 0, 0.5);
  }
}
