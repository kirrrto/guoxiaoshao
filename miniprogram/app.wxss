/* 果小哨 · 页面全局样式。隔离组件使用独立的 class 样式。 */
@import "styles/common.wxss";

/* Neutral paper surface, borderless white cards, type-led hierarchy.
   Brand green fills the primary action and marks positive states only. */
page {
  --green: #00C375;
  --green-dark: #007A49;
  --green-ink: #073C2C;
  --green-soft: rgba(0, 195, 117, 0.10);
  --green-mist: #F3F4F2;
  --text: #121814;
  --text-2: #565F59;
  --text-3: #656D68;
  --line: #E7E9E6;
  --card: #FFFFFF;
  --surface-soft: #F4F5F3;
  --glass-line: transparent;
  --shadow-soft: 0 1px 2px rgba(18, 24, 20, 0.04), 0 6px 20px rgba(18, 24, 20, 0.04);
  --action-fill: var(--green);
  --action-text: var(--green-ink);
  --control-fill: #EEF0ED;
  --control-line: transparent;
  --control-pressed: #E3E6E2;
  --radius-card: 32rpx;
  --radius-action: 24rpx;
  --warn: #895806;
  --warn-soft: #FBF1DC;
  --bad: #A83E3E;
  --bad-soft: #FBECEC;
  --info-soft: #F4F5F3;
  --skeleton-base: #EEF0ED;
  --skeleton-shine: #E7E9E6;
  --image-tile: #F4F5F3;
  background-color: var(--green-mist);
  background-image: none;
  min-height: 100%;
  color: var(--text);
  font-size: 28rpx;
  line-height: 1.5;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", Helvetica, sans-serif;
}

/* Dark mode follows the phone's system theme (app.json darkmode + theme.json).
   Only colors change. */
@media (prefers-color-scheme: dark) {
  page {
    --green-dark: #56DDA4;
    --green-soft: rgba(0, 195, 117, 0.14);
    --green-mist: #0E1210;
    --text: #EEF2EF;
    --text-2: #B4BDB7;
    --text-3: #A0A9A3;
    --line: rgba(255, 255, 255, 0.08);
    --card: #181D1A;
    --control-fill: rgba(255, 255, 255, 0.07);
    --control-line: transparent;
    --control-pressed: rgba(255, 255, 255, 0.12);
    --surface-soft: rgba(255, 255, 255, 0.05);
    --glass-line: transparent;
    --shadow-soft: none;
    --warn: #E8B15C;
    --warn-soft: rgba(232, 177, 92, 0.12);
    --bad: #F29B93;
    --bad-soft: rgba(242, 155, 147, 0.12);
    --info-soft: rgba(255, 255, 255, 0.05);
    --skeleton-base: rgba(255, 255, 255, 0.05);
    --skeleton-shine: rgba(255, 255, 255, 0.09);
    /* Product photos are shot for light backgrounds: a dimmed light tile keeps
       dark devices on transparent images visible without a glaring white box. */
    --image-tile: #DCE1DE;
    background-image: none;
  }
}
