/* 果小哨 · 页面全局样式。隔离组件使用独立的 class 样式。 */
@import "styles/common.wxss";

/* Neutral paper surface, borderless white cards, type-led hierarchy.
   Brand green fills the primary action and marks positive states only. */
page {
  --green: #00C375;
  --green-dark: #006B3F;
  --accent-text: #006B3F;
  --green-ink: #073C2C;
  --green-soft: rgba(0, 195, 117, 0.10);
  --green-mist: #F4F4F2;
  --text: #111412;
  --text-2: #545956;
  --text-3: #626764;
  --line: #ECECEA;
  --card: #FFFFFF;
  --card-elevated: #FFFFFF;
  --surface-soft: #F6F6F4;
  --glass-line: transparent;
  --shadow-soft: 0 1px 2px rgba(17, 20, 18, 0.04), 0 8px 24px rgba(17, 20, 18, 0.05);
  --shadow: var(--shadow-soft);
  --action-fill: var(--green);
  --action-text: var(--green-ink);
  --control-fill: #EFEFED;
  --control-line: transparent;
  --control-pressed: #E5E5E2;
  --header-glass: rgba(244, 244, 242, 0.82);
  --member-card-gradient: linear-gradient(135deg, #FFFFFF 0%, #F4F7F5 100%);
  --member-card-annual-gradient: linear-gradient(135deg, #FFFFFF 0%, #F7F3EA 100%);
  --image-tile: #F6F6F4;
  --image-tile-gradient: radial-gradient(circle at 50% 40%, #FFFFFF 0%, #F0F0EE 100%);
  --fs-display: max(26px, 56rpx);
  --fs-title: max(20px, 40rpx);
  --fs-headline: max(16px, 34rpx);
  --fs-body: max(14px, 30rpx);
  --fs-sub: max(13px, 26rpx);
  --fs-caption: max(12px, 24rpx);
  --fs-section: max(12px, 24rpx);
  --radius-card: 28rpx;
  --radius-inner: 20rpx;
  --radius-action: 22rpx;
  --radius-chip: 999rpx;
  --space-page: 32rpx;
  --space-card: 32rpx;
  --space-section: 40rpx;
  --space-row: 28rpx;
  --warn: #895806;
  --warn-soft: #FBF1DC;
  --bad: #A83E3E;
  --bad-soft: #FBECEC;
  --info-soft: #F6F6F4;
  --skeleton-base: #EFEFED;
  --skeleton-shine: #E5E5E2;
  background-color: var(--green-mist);
  background-image: none;
  min-height: 100%;
  color: var(--text);
  font-size: 28rpx;
  line-height: 1.5;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", Helvetica, sans-serif;
}

/* Dark mode follows the phone's system theme (app.json darkmode + theme.json).
   Only colors change. */
@media (prefers-color-scheme: dark) {
  page {
    --text: #EEF2EF;
    --text-2: #B7C0BB;
    --text-3: #9BA59F;
    --green-dark: #5CE0A8;
    --accent-text: #5CE0A8;
    --green-soft: rgba(0, 195, 117, 0.14);
    --green-mist: #0B0D0C;
    --line: rgba(255, 255, 255, 0.07);
    --card: #171A18;
    --card-elevated: #1F2320;
    --control-fill: rgba(255, 255, 255, 0.09);
    --control-line: transparent;
    --control-pressed: rgba(255, 255, 255, 0.14);
    --surface-soft: #202422;
    --glass-line: transparent;
    --shadow-soft: none;
    --shadow: none;
    --header-glass: rgba(11, 13, 12, 0.82);
    --member-card-gradient: linear-gradient(135deg, #171A18 0%, #1C231F 100%);
    --member-card-annual-gradient: linear-gradient(135deg, #1F2320 0%, #241F17 100%);
    --warn: #E8B15C;
    --warn-soft: rgba(232, 177, 92, 0.12);
    --bad: #F29B93;
    --bad-soft: rgba(242, 155, 147, 0.12);
    --info-soft: #202422;
    --skeleton-base: rgba(255, 255, 255, 0.05);
    --skeleton-shine: rgba(255, 255, 255, 0.09);
    /* Product photos are shot for light backgrounds: a dimmed light tile keeps
       dark devices on transparent images visible without a glaring white box. */
    --image-tile: #DCE1DE;
    --image-tile-gradient: radial-gradient(circle at 50% 40%, #E6EBE8 0%, #D4DAD6 100%);
    background-image: none;
  }
}
